+void vulkan_shutdown_output()
+{
+	// The embedded compositor has stopped painting, but its backend and the
+	// NVIDIA driver are still alive. Swapchain backends have a detached present
+	// worker and are outside this narrowly diagnosed DRM shutdown path.
+	if ( !GetBackend() || !GetBackend()->IsSessionBased() ||
+	     GetBackend()->UsesVulkanSwapchain() || !g_device.device() )
+		return;
+	VkPhysicalDeviceProperties properties = {};
+	g_device.vk.GetPhysicalDeviceProperties(g_device.physDev(), &properties);
+	if ( properties.vendorID != 0x10de )
+		return;
+
+	extern void ClearUpscaleImages();
+	release_nvidia_output_before_driver_exit(g_device, g_output, []() {
+		ClearUpscaleImages();
+		g_reshadeManager.clear();
+	});
+	std::fprintf(stderr, "marwanos: released NVIDIA embedded Vulkan output and command buffers before backend teardown pid=%ld\n", static_cast<long>(getpid()));
+}
