+    void CBufferMemoizer::Clear()
+    {
+        // Match destroy callbacks: Wayland lock before the memo-map mutex.
+        // Memo destructors unlink their listeners before dropping private
+        // texture refs, so later client destruction cannot revisit the map.
+        wlserver_lock();
+        {
+            std::scoped_lock lock{ m_mutBufferMemos };
+            m_BufferMemos.clear();
+        }
+        wlserver_unlock();
