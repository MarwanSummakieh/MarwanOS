[Unit]
# The way out of an application that will not let go. See the script's header
# for the evening that made it necessary: Steam Big Picture took the Guide
# button, its own Shut Down did nothing, there is no console login and sshd was
# down -- so the only exit from a launched app was the physical power button.
#
# Deliberately NOT ordered against greetd or the session. This must be running
# when the session is wedged, which is exactly when unit ordering that waits on
# the session would leave it unstarted.
Description=MarwanOS panic exit (hold Select+Start to release the screen)
Documentation=file:///usr/lib/marwanos/panic-exit
After=systemd-udev-settle.service
DefaultDependencies=no
After=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/lib/marwanos/panic-exit
# Root because it reads /dev/input/event* directly and because the escalation
# path restarts greetd. The evdev read is the reason it cannot be the player's:
# the seat ACL follows the active session, and this has to work when the active
# session is the thing being escaped.
User=root
# ALWAYS, and with a short backoff. A crash here is not visible on the
# television and the machine silently loses its only exit; better a restart loop
# in the journal than a one-way door.
Restart=always
RestartSec=2
# Unbuffered so a log line reaches journald at the moment it is written rather
# than when a block fills -- this is a diagnostic that matters most when the
# machine is misbehaving.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
