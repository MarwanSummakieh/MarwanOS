[Unit]
# Installs one Flathub application on the first boot that has a network. The
# instance name IS the application id, e.g.
#
#   marwanos-flatpak-install@app.zen_browser.zen.service
#
# A template rather than one unit per app: the units differ only in that id,
# and a second hand-written copy is a second place for a timeout or an
# ordering to drift. See the script header.
#
# Deliberately NOT ordered before greetd. The shell must come up whether or not
# this unit ever succeeds -- a machine that shows a black screen because a
# download is slow is exactly the failure this project keeps designing against.
# So the rail is on the TV while the apps arrive behind it, and if there is no
# network the only consequence is a <3> line in the journal and a card that
# says so.
Description=Install %i from Flathub (first boot with a network)
Documentation=file:///usr/lib/marwanos/flatpak-install
After=network-online.target flatpak-add-fedora-repos.service
Wants=network-online.target

# The stamp is the whole idempotency story: once an install is proven, this
# instance stops running at all rather than re-checking a multi-GB download
# every boot.
ConditionPathExists=!/var/marwanos/installed.%i

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/marwanos/flatpak-install %i

# Journal-shaped like everything else here, so `journalctl -t marwanos-install`
# is the whole story across every app, and the <N> prefixes survive as syslog
# priorities. The script tags each line with the app id, so one identifier for
# all instances stays readable rather than losing track of which app spoke.
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
SyslogIdentifier=marwanos-install

# A multi-GB download over a slow link is not a hang. The default 90s would
# kill it mid-transfer and leave a partial install behind.
TimeoutStartSec=3600

# Failure must never cascade. This unit not succeeding is a missing app, not a
# broken appliance.
Restart=no

[Install]
WantedBy=multi-user.target
