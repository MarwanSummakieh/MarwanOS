[Unit]
# Runs marwanos-storeart shortly after boot and then every fifteen minutes.
#
# WHY A TIMER AND NOT JUST A BOOT-TIME ONESHOT. The interesting machine is the
# one that boots offline: a plain oneshot would say `offline` once and the
# store would stay bare until the next reboot, even after the person fixed
# their wifi from the settings screen minutes later. The timer is the retry.
# It keeps firing after success too, and that is fine by construction -- a run
# with nothing missing is a handful of stats, writes `done N`, and exits
# without a word in the journal.
#
# Fifteen minutes because icons are decoration: netcheck answers in fifteen
# SECONDS because the top bar is live UI, but nobody is staring at a bare
# store card timing how long the logo takes once the network heals.
#
# FIFTEEN STILL HOLDS now that the service also fetches Steam game portraits,
# and that is a judgement rather than an oversight. The worst case moved: a
# game installed one minute after a run shows a bare card for fourteen more,
# where before this only mattered on a network that had just healed. It is
# still the right number, because the person who just installed a game spent
# minutes watching it download inside Steam and is going to play it from
# there, not walk back to a rail to admire the artwork -- and by the next time
# they come to the rail looking for it, the picture is on disk. Firing faster
# would buy a nicer first glance at the cost of polling Valve's CDN four times
# an hour forever, including for the appids that will never have art.
#
# The service's own cost per run does not change with the second job: a full
# library is one stat per game and no requests, so this stays the same cheap
# no-op it always was between the runs that have something to do.
Description=Prefetch store and Steam game artwork, retrying while anything is missing

[Timer]
# Soon after boot rather than at it: the service orders itself after
# network-online anyway, and half a minute keeps this download off the
# critical path while greetd and the shell are still fighting for the stick.
OnStartupSec=30
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
