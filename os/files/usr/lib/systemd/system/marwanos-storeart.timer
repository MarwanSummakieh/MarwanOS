[Unit]
# Runs marwanos-storeart shortly after boot and then every fifteen minutes.
#
# WHY A TIMER AND NOT JUST A BOOT-TIME ONESHOT. The interesting machine is the
# one that boots offline: a plain oneshot would say `offline` once and the
# store would stay bare until the next reboot, even after the person fixed
# their wifi from the settings screen minutes later. The timer is the retry.
# It keeps firing after success too, and that is fine by construction -- a run
# with nothing missing is a handful of stats, writes `done N`, and exits
# without a word in the journal.
#
# Fifteen minutes because icons are decoration: netcheck answers in fifteen
# SECONDS because the top bar is live UI, but nobody is staring at a bare
# store card timing how long the logo takes once the network heals.
Description=Prefetch store artwork, retrying while anything is missing

[Timer]
# Soon after boot rather than at it: the service orders itself after
# network-online anyway, and half a minute keeps this download off the
# critical path while greetd and the shell are still fighting for the stick.
OnStartupSec=30
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
