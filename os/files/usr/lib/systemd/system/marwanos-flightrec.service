[Unit]
# Writes the doors' post-mortem where the Files screen can reach it -- see
# the script's header for the 2026-08-10 lockout this exists because of.
#
# After multi-user so sshd has had its chance to start (or visibly fail)
# before the report reads its state; a report written at second two would
# always say "inactive" and mean nothing. After the netcheck too, so the
# firewall answer reflects a settled network. Never blocks anything: nothing
# is ordered after this, and the shell neither knows nor cares that it ran.
Description=Write door diagnostics to ~player/Downloads (flight recorder)
Documentation=file:///usr/lib/marwanos/flightrec
After=multi-user.target marwanos-netcheck.service

[Service]
Type=oneshot
# A settle delay, then the report: sshd's retry loop (see its drop-in) gets
# a minute of attempts on the record before the state is photographed.
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/lib/marwanos/flightrec
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
SyslogIdentifier=marwanos-flightrec
