[Unit]
# Steam's public storefront, fetched on request so the shell can draw it
# natively. See the script header for the request protocol, for why the shell
# is not allowed to make these calls itself, and for what keeps this polite to
# somebody else's public endpoint.
Description=Fetch Steam's storefront for the shell (/run/marwanos/steamfront)
Documentation=file:///usr/lib/marwanos/steamfront
# After netcheck because its state file is the only network answer this
# consults, and after network-online because every request this serves is a
# download. Ordering does not guarantee netcheck has an answer yet -- a request
# that early is simply answered `offline`, and the person pressing the button
# is still there to press it again.
#
# Deliberately NOT ordered before greetd, same as storeart: the shell must come
# up whether or not a storefront ever arrives, and a store tab that says it is
# fetching is a working appliance, not a broken one.
After=network-online.target marwanos-netcheck.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/lib/marwanos/steamfront

# A fetch service that died silently would leave the store tab saying "fetching
# the storefront" forever -- the exact shape of failure this project keeps
# designing against, since it looks identical to a slow link on a machine with
# no console. Restart=always makes it loud and repeated instead.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
SyslogIdentifier=marwanos-steamfront

[Install]
WantedBy=multi-user.target
