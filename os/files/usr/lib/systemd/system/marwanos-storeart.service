[Unit]
# Prefetches artwork into /var/marwanos/store/icons: each shipped
# application's Flathub icon, so the store screen renders logos from disk for
# things that are not installed yet, and the library portrait for any Steam
# game marwanos-appscan reported without one, so the home rail's game cards are
# never bare. See the script header for why the shell cannot fetch this itself,
# and appscan's steam_art() for how the second job's request and answer are
# both just files.
#
# Started by marwanos-storeart.timer, not by a wants link of its own: the
# timer is what gives an offline boot a second chance, and one starter means
# one story about when this runs.
#
# After network-online like marwanos-flatpak-install, because on the boot path
# this is pure download; after netcheck because its state file is the only
# network answer this consults -- ordering does not guarantee the file has an
# answer yet (netcheck needs one probe first), but a run that early just says
# `offline` and the timer comes back.
#
# Deliberately NOT ordered before greetd, same as flatpak-install: the shell
# must come up whether or not artwork ever arrives, and a missing icon is a
# fallback wash on a card, not a broken appliance.
#
# NOT ordered against marwanos-appscan either, although it now reads that
# service's output file. It does not need to be: a missing or stale apps.tsv
# means this run finds no games to fetch for, and the timer's next pass reads
# whatever appscan has published by then. Ordering would buy nothing, because
# the interesting file appears minutes after appscan STARTS, not at its start.
Description=Prefetch store and Steam game artwork (/var/marwanos/store/icons)
Documentation=file:///usr/lib/marwanos/storeart
After=network-online.target marwanos-netcheck.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/marwanos/storeart

# Seven icons at ~10 KB each is seconds, but the link this runs on has been
# measured taking minutes to do anything -- and the default 90s would turn a
# slow fetch into a kill mid-write. The script's own curl timeouts keep any
# single icon bounded.
# Bounded by the WORST run, not the usual one: each artless-but-unreachable
# appid can legitimately burn ~180 s (two names x --max-time 30 x --retry 2),
# so 300 s was two bad games on a bad link and then SIGTERM mid-write. Fifteen
# minutes matches the timer's own cadence -- a run may take up to one full
# period before the next one is due, and the script's per-curl timeouts keep
# any single fetch bounded.
TimeoutStartSec=900

# Failure must never cascade, and never loop hot: the TIMER is the retry
# mechanism, so the unit itself does not restart. A run that failed says so
# in storeart.state and gets another chance in fifteen minutes.
Restart=no

# Journal-shaped like everything else here, so `journalctl -t marwanos-storeart`
# is the whole story and the <N> prefixes survive as syslog priorities.
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
SyslogIdentifier=marwanos-storeart
