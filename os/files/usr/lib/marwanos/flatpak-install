#!/usr/bin/env bash
#
# Install one Flathub application, unattended, on the first boot that has a
# network. The application id is the only argument, which is what lets one
# script and one templated unit serve every app the appliance ships with.
#
# THIS REPLACED marwanos-steam-install, WHICH DID THIS FOR EXACTLY ONE APP.
# The second app (Zen, the browser) made the choice explicit: either a near
# copy of a 100-line script with one identifier changed, or the identifier
# becomes a parameter. Two copies of an installer drift -- one gains a retry
# or a disk-space check the other does not -- and the drift is invisible until
# the boot where the wrong one runs.
#
# WHY A ONESHOT AND NOT A COMMAND SOMEONE TYPES. This project's build host and
# its target are the same machine (the Predator boots Windows off the internal
# drive and MarwanOS off the stick), so at the moment MarwanOS is running there
# is nobody to ssh in FROM. Every install step therefore has to be baked in
# before the boot and read back out of the journal afterwards.
#
# WHY NOT IN THE IMAGE. A flatpak lands in /var/lib/flatpak, and /var is per
# stick rather than part of the ostree commit -- so baking these into the
# Containerfile would put gigabytes into every image and still not survive as
# installed apps. Installing at runtime is also what Phase 1 does for real
# (marwand talks to Flathub), so this is the throwaway version of a permanent
# path rather than a detour.
#
# A NETWORK IS REQUIRED, and the machine may not have one. With no route to
# Flathub this says so at <3> and exits without pretending otherwise. It does
# not stamp, so the next boot with a network retries.
#
set -uo pipefail

APP="${1:-}"
if [ -z "$APP" ]; then
    printf '<3>marwanos-install: no application id given\n' >&2
    exit 1
fi

TAG="marwanos-install"
STATE_DIR=/run/marwanos
STATE="$STATE_DIR/install.$APP.state"
## Shared by every instance of the template -- see the flock below.
LOCK=/run/marwanos/install.lock
STAMP="/var/marwanos/installed.$APP"
FLATHUB=https://dl.flathub.org/repo/flathub.flatpakrepo

info() { printf '<6>%s[%s]: %s\n' "$TAG" "$APP" "$*"; }
err()  { printf '<3>%s[%s]: %s\n' "$TAG" "$APP" "$*" >&2; }


## What the TV calls this application while it is still arriving.
##
## An app that is not installed yet has no desktop entry, so there is nothing
## to read a name out of -- and "app.zen_browser.zen" is not a name to show
## someone on a sofa. The table is small because the set of apps the image
## ships with is small and hand-picked; anything not in it falls back to its
## id, which is ugly but true. Phase 1 gets this from AppStream, which is
## exactly the metadata this table stands in for.
display_name() {
    case "$1" in
        com.valvesoftware.Steam) printf 'Steam' ;;
        app.zen_browser.zen)     printf 'Zen Browser' ;;
        *)                       printf '%s' "$1" ;;
    esac
}


## Where this install stands, for the shell: one line, `<state>TAB<name>`.
##
## The name rides along because the shell shows a card for an app that is
## still downloading, and until the install lands there is no other source for
## it. Removed on success -- from then on the desktop entry is the truth and
## the stamp is the durable record.
##
## /run empties every boot, so a stale word cannot outlive the boot that wrote
## it. Atomic via rename: the shell polls this and must never read half a line.
## A failed write is logged rather than fatal -- narration must not be able to
## kill the thing it narrates.
## `<state>TAB<display name>TAB<detail>`. The third field is free text the
## shell shows verbatim while an install is running -- see progress_ticker for
## why an install with no visible progress is the same as a broken one.
state() {
    install -d "$STATE_DIR" || true
    { printf '%s\t%s\t%s\n' "$1" "$(display_name "$APP")" "${2:-}" > "$STATE.tmp" \
        && mv -f "$STATE.tmp" "$STATE"; } \
        || err "cannot write $STATE (state '$1') -- the TV will not learn this"
}


## Rewrites the state file every few seconds while flatpak runs, so the card on
## the rail carries a number that MOVES.
##
## THIS IS THE FIX FOR THE 2026-08-07 BOOT. Everything worked that night --
## wifi associated, both installs started, the pending cards appeared and said
## "Installing" -- and it still read as broken, because half an hour later the
## screen said exactly what it had said at the start. A progress indicator is
## not decoration on a multi-gigabyte download over a domestic line; it is the
## difference between "working" and "hung" to the only person who can see it.
##
## MEASURED BY FREE SPACE, not by parsing flatpak. `flatpak install
## --noninteractive` deliberately prints almost nothing, and its ostree
## progress goes to a tty it does not have here. Watching the filesystem
## shrink needs one statfs, costs nothing on a slow USB stick, counts the
## runtimes as well as the app, and reports the one number that can also kill
## this install -- how much room is left.
## Every 10 s to the state file; every 12th tick (two minutes) to the journal
## as well. The screen wants a number that moves; the JOURNAL wants enough to
## prove afterwards that it did. This machine has no console, so a boot that
## went wrong is read back off the stick hours later -- and "the card said
## downloading" is not evidence that anything was being downloaded. Two minutes
## keeps a half-hour install to about fifteen lines, which is a record rather
## than spam.
progress_ticker() {
    local start_free="$1" free used line ticks=0
    while :; do
        sleep 10
        free="$(df -Pm /var | awk 'NR==2 {print $4}')"
        [ -n "$free" ] || continue
        used=$(( start_free - free ))
        [ "$used" -lt 0 ] && used=0
        line="$(printf '%s MB fetched, %s MB free' "$used" "$free")"
        state downloading "$line"

        ticks=$(( ticks + 1 ))
        if [ $(( ticks % 12 )) -eq 0 ]; then
            info "still downloading: $line"
        fi
    done
}


if [ -e "$STAMP" ]; then
    info "already installed (stamp $STAMP); nothing to do"
    rm -f "$STATE"
    exit 0
fi

# Free space before anything. The root filesystem is 15.4 GiB with ~7 GiB of OS
# on it, and these apps run to gigabytes -- worth refusing early and loudly
# rather than filling the disk of a machine with no console.
install -d "$STATE_DIR" 2>/dev/null
avail_mb=$(df -Pm /var | awk 'NR==2 {print $4}')
info "free space on /var: ${avail_mb} MiB"
if [ "${avail_mb:-0}" -lt 3000 ]; then
    err "under 3 GiB free -- refusing to start an install that would fill the disk"
    # Its own word, not "failed": this is the one failure with a physical
    # remedy (a bigger stick), and "go read the journal" is exactly the wrong
    # thing to tell a person standing in front of a machine with no console.
    state no-space
    exit 1
fi

# The network. NetworkManager-wait-online has already run by the time this unit
# does, but "online" per NM is not the same as "Flathub answers", and a DNS or
# route problem here is the difference between a large download and a hang.
info "waiting for Flathub to answer"
state waiting-network
reachable=""
for attempt in $(seq 1 30); do
    if curl -fsS --max-time 10 -o /dev/null "$FLATHUB"; then
        reachable=yes
        info "Flathub reachable after ${attempt} attempt(s)"
        break
    fi
    sleep 5
done

if [ -z "$reachable" ]; then
    err "no route to Flathub after 150s -- is there a network?"
    err "if wifi is missing, see docs/handoff.md on Windows Fast Startup"
    ip -brief address 2>&1 | while read -r line; do err "  addr: $line"; done
    # A distinct word from waiting-network: this unit has now given up until
    # the next boot, and the card should say so rather than promise a wait
    # that is no longer happening.
    state no-network
    exit 1
fi

# From here to success is one phase as far as the TV is concerned. remote-add
# is seconds; the install is the minutes the word exists to explain.
state downloading

info "adding the flathub remote"
if ! flatpak remote-add --system --if-not-exists flathub "$FLATHUB"; then
    err "flatpak remote-add failed"
    state failed
    exit 1
fi

# ONE INSTALL AT A TIME, ACROSS INSTANCES. The 2026-08-07 boot ran Steam and
# Zen concurrently, and they spent the whole time pulling the SAME runtimes
# (org.freedesktop.Platform.GL.default appears in both instances' logs, minutes
# apart) while contending for one USB stick's write bandwidth and for flatpak's
# own repo lock. Serialising makes the first app arrive far sooner, makes the
# progress number mean one thing rather than two, and stops two independent
# free-space checks from each deciding there is room for a download the other
# is also about to make.
#
# flock on a shared file rather than systemd ordering: the unit is a template,
# so an `After=` naming a sibling instance would have to be written per app in
# the Containerfile, and adding an app would then mean editing the chain.
exec 9>"$LOCK"
info "waiting for the install lock"
flock 9 || { err "could not take the install lock"; state failed; exit 1; }
info "holding the install lock"

# Re-check the disk INSIDE the lock. The check above happened before waiting,
# and the app that held the lock may have consumed the room in the meantime.
avail_mb=$(df -Pm /var | awk 'NR==2 {print $4}')
if [ "${avail_mb:-0}" -lt 3000 ]; then
    err "only ${avail_mb} MiB left after waiting -- refusing to fill the disk"
    state no-space
    exit 1
fi

# --noninteractive matters: without it flatpak asks which remote to use and
# blocks forever on a machine with no keyboard attached to this process.
info "installing $APP -- this is a large download, expect several minutes"
progress_ticker "$avail_mb" &
ticker_pid=$!
# Killed on every exit path, including the TimeoutStartSec kill and a shutdown
# mid-download: a ticker outliving its install would keep rewriting a state
# file claiming a download that is no longer happening.
trap 'kill "$ticker_pid" 2>/dev/null' EXIT INT TERM

if flatpak install --system --noninteractive --assumeyes flathub "$APP"; then
    info "flatpak install reported success"
else
    rc=$?
    err "flatpak install failed (exit $rc)"
    kill "$ticker_pid" 2>/dev/null
    # Distinguish the one failure with a physical remedy from the rest.
    avail_mb=$(df -Pm /var | awk 'NR==2 {print $4}')
    if [ "${avail_mb:-0}" -lt 500 ]; then
        err "the disk is full (${avail_mb} MiB left)"
        state no-space
    else
        state failed
    fi
    exit 1
fi

kill "$ticker_pid" 2>/dev/null

# Prove it rather than trust the exit code, in the spirit of the Containerfile's
# assertions: the failure this catches is an install that half-happened.
if ! flatpak info --system "$APP" >/dev/null 2>&1; then
    err "$APP is not installed despite a successful exit -- not stamping"
    state failed
    exit 1
fi

install -d /var/marwanos
date -u +'%Y-%m-%dT%H:%M:%SZ' > "$STAMP"

# Stamp first, then clear the state: the shell treats the stamp as overriding
# whatever the state file says, so this order can only ever show "installed"
# a poll early rather than a gap where the card claims nothing.
rm -f "$STATE"

info "installed: $(flatpak info --system "$APP" --show-ref 2>/dev/null)"
info "free space now: $(df -Pm /var | awk 'NR==2 {print $4}') MiB"
info "done"
