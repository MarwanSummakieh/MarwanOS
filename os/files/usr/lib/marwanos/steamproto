#!/usr/bin/python3
"""Protobuf wire encoding for Valve's authentication endpoints, by hand.

WHY HAND-ROLLED. marwanos-steamfront's QR sign-in talks to
IAuthenticationService, whose requests and responses are protobuf rather than
JSON. The messages involved are tiny -- three or four fields each, all of them
strings, bytes and varints -- and the alternative is a protobuf runtime plus
generated stubs from .proto files Valve does not publish, pinned in an image
that otherwise carries no Python packages at all. Wire format is stable by
protobuf's own compatibility contract, so encoding a handful of fields by hand
is less machinery to trust, not more. Verified live against Valve 2026-08-11
before this file was written.

WHY PYTHON AND NOT jq. The steamfront header argues jq over python3 for
JSON-to-JSON reshapes, and that argument stands where it was made. This is not
a reshape: it is binary wire encoding, which jq cannot express at all. python3
is already in the image from the ublue base (asserted in the Containerfile's
verify block, same as jq, for the same reason).

SECRETS TRAVEL ON STDIN AND STDOUT, NEVER IN ARGV. /proc/<pid>/cmdline is
world-readable for every process on the system, so a refresh token passed as
an argument would be readable by the session user for as long as the process
runs. Every subcommand that touches a token reads it from stdin or prints it
to stdout, both of which are pipes owned by the root-side caller.

The subcommands mirror the three calls the service makes, one encoder and one
decoder each, plus one JWT reader:

  begin-req                 -> b64 protobuf for BeginAuthSessionViaQR
  begin-resp   b64 on stdin -> TSV: client_id, challenge_url, request_id_b64,
                               poll interval in seconds
  poll-req CLIENT_ID REQUEST_ID_B64
                            -> b64 protobuf for PollAuthSessionStatus
  poll-resp    b64 on stdin -> TSV: new_challenge_url, refresh_token,
                               account_name (any of them may be empty)
  token-req STEAMID, refresh token on stdin
                            -> b64 protobuf for GenerateAccessTokenForApp
  token-resp   b64 on stdin -> the access token, or nothing
  jwt-sub      JWT on stdin -> the token's subject (a SteamID64), digits only
  jwt-shape    JWT on stdin -> a one-line, secret-free description of why
                               jwt-sub might have refused it

Field numbers were measured against the live service rather than taken from
any published .proto, and the decoder is a WALKER rather than a schema: it
returns whatever fields are present and the caller picks the ones it knows.
An unknown field is skipped, which is what protobuf itself promises about
forward compatibility, so a Valve-side addition cannot break the parse.
"""

import base64
import json
import struct
import sys


def _fail(message: str) -> "None":
    # stderr and a nonzero exit -- the bash caller treats any failure here as
    # "the answer could not be read", the same rendering as a dead link.
    print("steamproto: %s" % message, file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# Wire primitives
# ---------------------------------------------------------------------------

def _varint(value: int) -> bytes:
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        if value:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return bytes(out)


def _tag(field: int, wire_type: int) -> bytes:
    return _varint((field << 3) | wire_type)


def _string(field: int, value: str) -> bytes:
    data = value.encode("utf-8")
    return _tag(field, 2) + _varint(len(data)) + data


def _bytes(field: int, value: bytes) -> bytes:
    return _tag(field, 2) + _varint(len(value)) + value


def _uint(field: int, value: int) -> bytes:
    return _tag(field, 0) + _varint(value)


def _read_varint(data: bytes, pos: int) -> "tuple[int, int]":
    value = 0
    shift = 0
    while True:
        if pos >= len(data):
            _fail("truncated varint")
        byte = data[pos]
        pos += 1
        value |= (byte & 0x7F) << shift
        if not byte & 0x80:
            return value, pos
        shift += 7
        if shift > 63:
            _fail("varint too long")


def _walk(data: bytes) -> "dict[int, list]":
    """Every field in a message, keyed by field number.

    Values are ints for varints, bytes for length-delimited fields, and raw
    4- or 8-byte strings for the fixed types -- the caller knows which shape
    it expects. A repeated field accumulates; the callers below want either
    the first or the only occurrence.
    """
    fields: "dict[int, list]" = {}
    pos = 0
    while pos < len(data):
        key, pos = _read_varint(data, pos)
        field, wire_type = key >> 3, key & 0x07
        if wire_type == 0:
            value, pos = _read_varint(data, pos)
        elif wire_type == 1:
            if pos + 8 > len(data):
                _fail("truncated fixed64")
            value, pos = data[pos:pos + 8], pos + 8
        elif wire_type == 2:
            length, pos = _read_varint(data, pos)
            if pos + length > len(data):
                _fail("truncated field")
            value, pos = data[pos:pos + length], pos + length
        elif wire_type == 5:
            if pos + 4 > len(data):
                _fail("truncated fixed32")
            value, pos = data[pos:pos + 4], pos + 4
        else:
            # Groups (3 and 4) have been dead since proto2 and Valve does not
            # send them; anything else is not protobuf.
            _fail("unsupported wire type %d" % wire_type)
        fields.setdefault(field, []).append(value)
    return fields


def _first_str(fields: "dict[int, list]", field: int) -> str:
    for value in fields.get(field, []):
        if isinstance(value, bytes):
            return value.decode("utf-8", "replace")
    return ""


def _first_bytes(fields: "dict[int, list]", field: int) -> bytes:
    for value in fields.get(field, []):
        if isinstance(value, bytes):
            return value
    return b""


def _first_int(fields: "dict[int, list]", field: int) -> int:
    for value in fields.get(field, []):
        if isinstance(value, int):
            return value
    return 0


def _stdin_b64() -> bytes:
    raw = sys.stdin.read().strip()
    if not raw:
        _fail("nothing on stdin")
    try:
        return base64.b64decode(raw, validate=True)
    except (ValueError, base64.binascii.Error):
        _fail("stdin is not base64")
    return b""  # unreachable; keeps the type checker honest


def _print_b64(data: bytes) -> None:
    sys.stdout.write(base64.b64encode(data).decode("ascii"))


# ---------------------------------------------------------------------------
# The subcommands
# ---------------------------------------------------------------------------

def begin_req() -> None:
    # Field numbers measured live 2026-08-11: 1 device_friendly_name,
    # 2 platform_type (2 is the value the web client sends), 4 website_id.
    # The device name is what the person's phone shows in the approval sheet,
    # so it is the machine's own name rather than anything configurable.
    _print_b64(
        _string(1, "MarwanOS")
        + _uint(2, 2)
        + _string(4, "Store")
    )


def begin_resp() -> None:
    fields = _walk(_stdin_b64())
    client_id = _first_int(fields, 1)
    challenge_url = _first_str(fields, 2)
    request_id = _first_bytes(fields, 3)
    if not client_id or not challenge_url or not request_id:
        _fail("begin response is missing a field")

    # The poll interval arrives as a float in field 6 (fixed32). Read
    # defensively -- a varint there is taken at face value, and anything
    # unreadable falls back to the five seconds Valve has always answered.
    interval = 5.0
    for value in fields.get(6, []):
        if isinstance(value, bytes) and len(value) == 4:
            interval = struct.unpack("<f", value)[0]
        elif isinstance(value, int):
            interval = float(value)
    if not 0.5 <= interval <= 60.0:
        interval = 5.0

    sys.stdout.write("%d\t%s\t%s\t%.1f" % (
        client_id, challenge_url,
        base64.b64encode(request_id).decode("ascii"), interval))


def poll_req(client_id: str, request_id_b64: str) -> None:
    if not client_id.isdigit():
        _fail("client id must be digits")
    try:
        request_id = base64.b64decode(request_id_b64, validate=True)
    except (ValueError, base64.binascii.Error):
        _fail("request id is not base64")
        return
    _print_b64(_uint(1, int(client_id)) + _bytes(2, request_id))


def poll_resp() -> None:
    # An EMPTY body is the normal answer for "not approved yet" -- every field
    # of the response is optional and Valve omits them all until something
    # happens. So no field is required here, and the caller reads three empty
    # columns as "keep waiting".
    fields = _walk(_stdin_b64())
    # Every field is stripped of the TSV separators, not just the account name:
    # all three came out of someone else's response body, and a tab in the
    # challenge URL (field 2) would shift the real refresh token into the
    # caller's account-name column. A URL and a JWT never legitimately contain
    # a tab or newline, so replacing them costs nothing and closes the shift.
    def clean(value: str) -> str:
        return value.replace("\t", " ").replace("\n", " ").replace("\r", " ")
    new_challenge = clean(_first_str(fields, 2))
    refresh_token = clean(_first_str(fields, 3))
    account_name = clean(_first_str(fields, 6))
    sys.stdout.write("%s\t%s\t%s" % (new_challenge, refresh_token, account_name))


def token_req(steamid: str) -> None:
    if not steamid.isdigit():
        _fail("steamid must be digits")
    refresh_token = sys.stdin.read().strip()
    if not refresh_token:
        _fail("no refresh token on stdin")
    # 1 refresh_token, 2 steamid, 3 renewal_type (0, no renewal requested).
    # A zero varint is omitted by convention and by every encoder; leaving the
    # field out entirely is the same bytes on the wire.
    _print_b64(_string(1, refresh_token) + _uint(2, int(steamid)))


def token_resp() -> None:
    fields = _walk(_stdin_b64())
    sys.stdout.write(_first_str(fields, 1))


def jwt_sub() -> None:
    """The subject of a Steam JWT, which is the account's SteamID64.

    The token is parsed, not verified: nothing here trusts a claim for
    security. The subject only names the file the root-side caller stores the
    token in and the steamid the token exchange sends -- both of which Valve
    itself checks against the token's real contents on every use.
    """
    token = sys.stdin.read().strip()
    parts = token.split(".")
    if len(parts) != 3:
        _fail("not a JWT")
    payload = parts[1]
    # base64url without padding, which is what JWT uses and what the strict
    # decoder refuses; pad it back out.
    payload += "=" * (-len(payload) % 4)
    try:
        claims = json.loads(base64.urlsafe_b64decode(payload))
    except (ValueError, base64.binascii.Error):
        _fail("unreadable JWT payload")
        return
    sub = str(claims.get("sub", ""))
    # 15..20 digits rather than exactly 17, and this is NOT the fix for the
    # 2026-08-11 sign-in failure -- that was a tab-splitting bug in the caller
    # (marwanos-steamfront's tsv_field) which fed this function an account
    # name, and no width check here would have saved it. The relaxation stands
    # on its own smaller argument: nothing in this image depends on the width.
    # The subject names the token's file and rides the token exchange as a
    # parameter Valve re-validates against the token's real contents on every
    # use, so a future SteamID that is not 17 digits should not be refused by
    # this machine's arithmetic. All digits and SteamID-sized is the whole of
    # what is actually required; jwt-shape below says which part a refused
    # token failed, which is the part that was really missing.
    if not sub.isdigit() or not 15 <= len(sub) <= 20:
        _fail("JWT subject is not a SteamID64")
    sys.stdout.write(sub)


def jwt_shape() -> None:
    """A secret-free description of a token jwt-sub refused.

    2026-08-11, on the bench: the first QR approval a phone ever granted this
    machine ended in "an approved sign-in carried a token this machine could
    not read" -- and the token was rightly never stored, so nothing remained
    to diagnose. This prints only SHAPE: lengths, part counts, claim NAMES and
    whether the subject is digits. No token material, no claim values, so the
    root-side caller can put the answer straight in the journal and the next
    refused approval diagnoses itself.
    """
    token = sys.stdin.read().strip()
    parts = token.split(".")
    out = ["length=%d" % len(token), "parts=%d" % len(parts)]
    if len(parts) == 3:
        payload = parts[1] + "=" * (-len(parts[1]) % 4)
        try:
            claims = json.loads(base64.urlsafe_b64decode(payload))
        except (ValueError, base64.binascii.Error):
            claims = None
        if isinstance(claims, dict):
            sub = str(claims.get("sub", ""))
            out.append("payload=json")
            out.append("claims=%s" % ",".join(sorted(str(k) for k in claims)[:12]))
            out.append("sub_len=%d" % len(sub))
            out.append("sub_digits=%s" % ("yes" if sub.isdigit() else "no"))
        else:
            out.append("payload=unreadable")
    sys.stdout.write(" ".join(out))


def main() -> None:
    argv = sys.argv[1:]
    if not argv:
        _fail("no subcommand")
    command, args = argv[0], argv[1:]
    if command == "begin-req" and not args:
        begin_req()
    elif command == "begin-resp" and not args:
        begin_resp()
    elif command == "poll-req" and len(args) == 2:
        poll_req(args[0], args[1])
    elif command == "poll-resp" and not args:
        poll_resp()
    elif command == "token-req" and len(args) == 1:
        token_req(args[0])
    elif command == "token-resp" and not args:
        token_resp()
    elif command == "jwt-sub" and not args:
        jwt_sub()
    elif command == "jwt-shape" and not args:
        jwt_shape()
    else:
        _fail("unknown subcommand or wrong arguments")


if __name__ == "__main__":
    main()
