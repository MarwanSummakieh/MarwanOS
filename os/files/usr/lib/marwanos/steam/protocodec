#!/usr/bin/python3
"""Protobuf wire encoding for Valve's authentication endpoints, by hand.

WHY HAND-ROLLED. The QR sign-in talks to IAuthenticationService, whose requests
and responses are protobuf rather than JSON. The messages involved are tiny --
three or four fields each, all of them strings, bytes and varints -- and the
alternative is a protobuf runtime plus generated stubs from .proto files Valve
does not publish, pinned into an image that otherwise carries no Python
packages at all. Wire format is stable by protobuf's own compatibility
contract, so encoding a handful of fields by hand is less machinery to trust,
not more.

WHY PYTHON AND NOT jq. Elsewhere in this tree jq wins every JSON-to-JSON
reshape, and that argument stands where it is made. This is not a reshape: it
is binary wire encoding, which jq cannot express at all. python3 arrives from
the ublue base and the Containerfile's verify block asserts it for exactly this
reason.

SECRETS TRAVEL ON STDIN AND STDOUT, NEVER IN ARGV. /proc/<pid>/cmdline is
world-readable for every process on this machine, and the session user runs the
shell, the browser and Valve's client. A refresh token passed as an argument
would be readable by all three for as long as the process lived. Every
subcommand that touches a token reads it from stdin or prints it to stdout,
both of which are pipes owned by the root-side caller.

THE ONE THING THIS FILE EXISTS TO GET RIGHT is in begin_req(): the session is
begun as the Steam CLIENT, not as a web browser. Read that comment before
changing anything there -- the deleted implementation had it the other way and
the resulting token cannot download a game.

  begin-req                 -> b64 protobuf for BeginAuthSessionViaQR
  begin-resp   b64 on stdin -> TSV: client_id, challenge_url, request_id_b64,
                               poll interval in seconds
  poll-req CLIENT_ID REQUEST_ID_B64
                            -> b64 protobuf for PollAuthSessionStatus
  poll-resp    b64 on stdin -> TSV: new_challenge_url, refresh_token,
                               account_name, new_client_id. Any of them may be
                               empty; an EMPTY MESSAGE is the normal answer.
  token-req STEAMID, refresh token on stdin
                            -> b64 protobuf for GenerateAccessTokenForApp
  token-resp   b64 on stdin -> the access token, or nothing
  jwt-sub      JWT on stdin -> the token's subject (a SteamID64), digits only
  jwt-shape    JWT on stdin -> a one-line, secret-free description of why
                               jwt-sub might have refused it

There is deliberately no appinfo subcommand. The library comes from
IPlayerService/GetOwnedGames, which answers plain JSON once it has an access
token, so the only protobuf on this machine is the four auth messages above.

Field numbers were measured against the live service on 2026-08-11 rather than
taken from any published .proto, and the decoder is a WALKER rather than a
schema: it returns whatever fields are present and the caller picks the ones it
knows. An unknown field is skipped by its wire type, which is what protobuf
itself promises about forward compatibility, so a Valve-side addition cannot
break the parse. What is NOT tolerated is a malformed stream -- groups, an
overlong varint, a length that runs off the end -- because those mean the bytes
are not the message we think they are, and guessing at that point is how a
parser starts inventing credentials.

EVERY FIELD THIS FILE PRINTS IS STRIPPED OF TAB, NEWLINE AND CARRIAGE RETURN.
The output format is TSV and the values came out of somebody else's response
body. A tab inside a challenge URL would forge a column and shift a refresh
token into the caller's account-name slot -- which is not a hypothetical here:
a leading EMPTY column did exactly that on 2026-08-11 and cost this project its
first live approval. The caller reads columns with a hand-walked positional
extractor for the same reason; both halves of that fix are load-bearing.
"""

import base64
import json
import struct
import sys


def _fail(message: str) -> "None":
    # stderr and a nonzero exit -- the bash caller treats any failure here as
    # "the answer could not be read", which renders the same as a dead link.
    # Nothing that came off the wire is ever echoed into the message.
    print("protocodec: %s" % message, file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# Wire primitives
# ---------------------------------------------------------------------------

def _varint(value: int) -> bytes:
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        if value:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return bytes(out)


def _tag(field: int, wire_type: int) -> bytes:
    return _varint((field << 3) | wire_type)


def _string(field: int, value: str) -> bytes:
    # PROTO3 OMITS DEFAULTS. An empty string is the default for a string field,
    # and every conforming encoder leaves it off the wire entirely; writing a
    # zero-length field instead is legal but is not what Valve's own clients
    # send, and this file's whole safety argument is "look like a client".
    if not value:
        return b""
    data = value.encode("utf-8")
    return _tag(field, 2) + _varint(len(data)) + data


def _bytes(field: int, value: bytes) -> bytes:
    if not value:
        return b""
    return _tag(field, 2) + _varint(len(value)) + value


def _uint(field: int, value: int) -> bytes:
    # Same omission rule, and it is the reason GenerateAccessTokenForApp's
    # renewal_type is simply absent below rather than written as a zero: the
    # two are the same bytes on the wire, and the shorter one is the one a real
    # client produces.
    if value == 0:
        return b""
    return _tag(field, 0) + _varint(value)


def _read_varint(data: bytes, pos: int) -> "tuple[int, int]":
    value = 0
    shift = 0
    while True:
        if pos >= len(data):
            _fail("truncated varint")
        byte = data[pos]
        pos += 1
        value |= (byte & 0x7F) << shift
        if not byte & 0x80:
            return value, pos
        shift += 7
        if shift > 63:
            # Past 64 bits the value cannot be anything protobuf produced.
            # Refusing beats accumulating an unbounded integer out of a stream
            # somebody else controls.
            _fail("varint too long")


def _walk(data: bytes) -> "dict[int, list]":
    """Every field in a message, keyed by field number.

    Values are ints for varints, bytes for length-delimited fields, and the raw
    4- or 8-byte strings for the fixed types -- the caller knows which shape it
    expects. A repeated field accumulates; the callers below want either the
    first or the only occurrence.

    An unknown field number is not an error, it is skipped by wire type. That
    asymmetry is the point: Valve adding a field must not break this parse,
    while bytes that are not a protobuf message at all must not be walked past
    as though they were.
    """
    fields: "dict[int, list]" = {}
    pos = 0
    while pos < len(data):
        key, pos = _read_varint(data, pos)
        field, wire_type = key >> 3, key & 0x07
        if wire_type == 0:
            value, pos = _read_varint(data, pos)
        elif wire_type == 1:
            if pos + 8 > len(data):
                _fail("truncated fixed64")
            value, pos = data[pos:pos + 8], pos + 8
        elif wire_type == 2:
            length, pos = _read_varint(data, pos)
            if pos + length > len(data):
                _fail("truncated field")
            value, pos = data[pos:pos + length], pos + length
        elif wire_type == 5:
            if pos + 4 > len(data):
                _fail("truncated fixed32")
            value, pos = data[pos:pos + 4], pos + 4
        else:
            # Groups (3 START and 4 END) have been dead since proto2, Valve
            # does not send them, and skipping one correctly means recursing
            # over a nested framing this file has no other reason to
            # understand. 6 and 7 are not wire types at all. Either way the
            # bytes are not the message we think they are.
            _fail("unsupported wire type %d" % wire_type)
        fields.setdefault(field, []).append(value)
    return fields


def _first_str(fields: "dict[int, list]", field: int) -> str:
    for value in fields.get(field, []):
        if isinstance(value, bytes):
            return value.decode("utf-8", "replace")
    return ""


def _first_bytes(fields: "dict[int, list]", field: int) -> bytes:
    for value in fields.get(field, []):
        if isinstance(value, bytes):
            return value
    return b""


def _first_int(fields: "dict[int, list]", field: int) -> int:
    for value in fields.get(field, []):
        if isinstance(value, int):
            return value
    return 0


def _clean(value: str) -> str:
    """A field made safe to be a TSV column. See the module docstring."""
    return value.replace("\t", " ").replace("\n", " ").replace("\r", " ")


def _stdin_b64(allow_empty: bool = False) -> bytes:
    raw = sys.stdin.read().strip()
    if not raw:
        if allow_empty:
            return b""
        _fail("nothing on stdin")
    try:
        return base64.b64decode(raw, validate=True)
    except (ValueError, base64.binascii.Error):
        _fail("stdin is not base64")
    return b""  # unreachable; keeps the type checker honest


def _print_b64(data: bytes) -> None:
    # No trailing newline, deliberately. The caller pipes this straight into
    # `curl --data-urlencode input_protobuf_encoded@-`, and a newline read from
    # stdin becomes part of the parameter value -- base64 with a stray byte on
    # the end is a request Valve rejects for no visible reason.
    sys.stdout.write(base64.b64encode(data).decode("ascii"))


# ---------------------------------------------------------------------------
# The subcommands
# ---------------------------------------------------------------------------

def begin_req() -> None:
    """BeginAuthSessionViaQR, begun AS THE STEAM CLIENT.

    THIS IS THE FIELD THAT DECIDES WHETHER GAMES CAN BE DOWNLOADED, and the
    deleted implementation had it wrong. It sent platform_type = 2
    (k_EAuthTokenPlatformType_WebBrowser) with website_id = "Store", which is
    the natural shape for a sign-in designed around web API calls, and it
    works perfectly for those: the resulting refresh token carries an audience
    of ["web"] and GetOwnedGames is happy with it.

    What such a token CANNOT do is log a Steam client in. SteamKit -- and
    therefore DepotDownloader, which is how this appliance actually fetches a
    game -- stores one refresh token per account and will only submit one whose
    audience includes "client". Handed a web-audience token it does not error;
    it declines to use it and falls back to prompting for a password, on a
    machine with no keyboard and a person sitting on a sofa. The symptom is a
    sign-in that plainly succeeded and a download that asks for a password
    nobody can type.

    platform_type = 1 (k_EAuthTokenPlatformType_SteamClient) with
    website_id = "Client" yields ["web", "client"] instead: one token that
    serves both our own API calls and the downloader, which is what makes ONE
    scan enough for the whole feature rather than two sign-ins for one account.
    Measured 2026-08-12; see docs/adr/0010-our-own-steam-client.md, trap 1.

    Field numbers measured live 2026-08-11: 1 device_friendly_name,
    2 platform_type, 4 website_id. The device name is what the person's phone
    shows in its approval sheet, so it is the machine's own name rather than
    anything configurable -- somebody approving a scan should see the appliance
    that asked.
    """
    _print_b64(
        _string(1, "MarwanOS")
        + _uint(2, 1)
        + _string(4, "Client")
    )


def begin_resp() -> None:
    fields = _walk(_stdin_b64())
    client_id = _first_int(fields, 1)
    challenge_url = _clean(_first_str(fields, 2))
    request_id = _first_bytes(fields, 3)
    if not client_id or not challenge_url or not request_id:
        # Every one of the three is needed to poll or to draw anything, so a
        # partial answer is not a session that can be continued.
        _fail("begin response is missing a field")

    # The poll interval arrives as a float in field 6 (fixed32). Read
    # defensively -- a varint there is taken at face value, and anything
    # unreadable falls back to the five seconds Valve has always answered.
    # The CALLER floors this regardless of what arrives; see steamd.
    interval = 5.0
    for value in fields.get(6, []):
        if isinstance(value, bytes) and len(value) == 4:
            interval = struct.unpack("<f", value)[0]
        elif isinstance(value, int):
            interval = float(value)
    if not 0.5 <= interval <= 60.0:
        interval = 5.0

    sys.stdout.write("%d\t%s\t%s\t%.1f" % (
        client_id, challenge_url,
        base64.b64encode(request_id).decode("ascii"), interval))


def poll_req(client_id: str, request_id_b64: str) -> None:
    if not client_id.isdigit():
        _fail("client id must be digits")
    try:
        request_id = base64.b64decode(request_id_b64, validate=True)
    except (ValueError, base64.binascii.Error):
        _fail("request id is not base64")
        return
    _print_b64(_uint(1, int(client_id)) + _bytes(2, request_id))


def poll_resp() -> None:
    """PollAuthSessionStatus, whose usual answer is nothing at all.

    AN EMPTY BODY IS NORMAL AND IS NEVER AN ERROR. Every field of this response
    is optional and Valve omits all of them until something happens, so an
    empty message decodes to four empty columns and the caller reads that as
    "keep waiting". That is the answer most of the time, for minutes, while
    somebody looks for their phone.

    Field 1 is new_client_id, and it is emitted LAST so that the three columns
    the caller has always read keep their positions. It is used only when a
    rotation also arrives: Valve reissues the client id alongside the new
    challenge, and polling on with the old one is a slow way to time out. If
    this field number were ever wrong the value reads as zero and the caller
    keeps the id it has, which is exactly the old behaviour -- so a mistake
    here costs nothing that was working before.
    """
    fields = _walk(_stdin_b64(allow_empty=True))
    new_challenge = _clean(_first_str(fields, 2))
    refresh_token = _clean(_first_str(fields, 3))
    account_name = _clean(_first_str(fields, 6))
    new_client_id = _first_int(fields, 1)
    sys.stdout.write("%s\t%s\t%s\t%d" % (
        new_challenge, refresh_token, account_name, new_client_id))


def token_req(steamid: str) -> None:
    if not steamid.isdigit():
        _fail("steamid must be digits")
    refresh_token = sys.stdin.read().strip()
    if not refresh_token:
        _fail("no refresh token on stdin")
    # 1 refresh_token, 2 steamid, 3 renewal_type. renewal_type is 0 (no renewal
    # requested) and therefore not written at all -- see _uint.
    _print_b64(_string(1, refresh_token) + _uint(2, int(steamid)))


def token_resp() -> None:
    fields = _walk(_stdin_b64())
    # No _clean: this is printed alone on stdout, not as a TSV column, and the
    # caller feeds it straight back to curl on stdin. Nothing splits it.
    sys.stdout.write(_first_str(fields, 1))


def jwt_sub() -> None:
    """The subject of a Steam JWT, which is the account's SteamID64.

    THE TOKEN IS PARSED, NOT VERIFIED, and nothing here trusts a claim for
    security. The subject only names the file the root-side caller stores the
    token in and the steamid the token exchange sends -- both of which Valve
    itself checks against the token's real contents on every use. Verifying a
    signature would mean shipping Valve's public keys and a rotation story for
    them, to learn something we are told again by the first API call.
    """
    token = sys.stdin.read().strip()
    parts = token.split(".")
    if len(parts) != 3:
        _fail("not a JWT")
    payload = parts[1]
    # base64url without padding, which is what JWT uses and what the strict
    # decoder refuses; pad it back out.
    payload += "=" * (-len(payload) % 4)
    try:
        claims = json.loads(base64.urlsafe_b64decode(payload))
    except (ValueError, base64.binascii.Error):
        _fail("unreadable JWT payload")
        return
    if not isinstance(claims, dict):
        _fail("JWT payload is not an object")
        return
    sub = str(claims.get("sub", ""))
    # 15..20 digits rather than exactly 17. Nothing in this image depends on
    # the width: the subject names the token's file and rides the token
    # exchange as a parameter Valve re-validates against the token's real
    # contents, so a future SteamID that is not seventeen digits should not be
    # refused by this machine's arithmetic. Digits and SteamID-sized is the
    # whole of what is actually required; jwt-shape below says which part a
    # refused token failed.
    if not sub.isdigit() or not 15 <= len(sub) <= 20:
        _fail("JWT subject is not a SteamID64")
    sys.stdout.write(sub)


def jwt_shape() -> None:
    """A secret-free description of a token jwt-sub refused.

    2026-08-11, on the bench: the first QR approval a phone ever granted this
    machine ended in "an approved sign-in carried a token this machine could
    not read" -- and the token was rightly never stored, so nothing remained to
    diagnose. The cause turned out to be a tab-splitting bug in the caller,
    which had handed this function an account name instead of a credential, and
    one line of shape would have said `length=11 parts=1` and ended the
    question in seconds instead of costing a bench session and a spent scan.

    This prints only SHAPE: lengths, part counts, claim NAMES and whether the
    subject is digits. No token material and no claim VALUES, so the root-side
    caller can put the answer straight into the journal.
    """
    token = sys.stdin.read().strip()
    parts = token.split(".")
    out = ["length=%d" % len(token), "parts=%d" % len(parts)]
    if len(parts) == 3:
        payload = parts[1] + "=" * (-len(parts[1]) % 4)
        try:
            claims = json.loads(base64.urlsafe_b64decode(payload))
        except (ValueError, base64.binascii.Error):
            claims = None
        if isinstance(claims, dict):
            sub = str(claims.get("sub", ""))
            out.append("payload=json")
            out.append("claims=%s" % ",".join(sorted(str(k) for k in claims)[:12]))
            out.append("sub_len=%d" % len(sub))
            out.append("sub_digits=%s" % ("yes" if sub.isdigit() else "no"))
            # The audience is the one CLAIM VALUE printed here, and it earns
            # the exception: it is not a secret, it is a fixed vocabulary, and
            # it is the single fact that tells "this token cannot download a
            # game" apart from every other reason a sign-in disappoints. See
            # begin_req.
            aud = claims.get("aud", [])
            if isinstance(aud, list):
                names = [str(a) for a in aud if isinstance(a, (str, int))]
                out.append("aud=%s" % (",".join(names[:6]) or "none"))
        else:
            out.append("payload=unreadable")
    sys.stdout.write(" ".join(out))


def main() -> None:
    argv = sys.argv[1:]
    if not argv:
        _fail("no subcommand")
    command, args = argv[0], argv[1:]
    if command == "begin-req" and not args:
        begin_req()
    elif command == "begin-resp" and not args:
        begin_resp()
    elif command == "poll-req" and len(args) == 2:
        poll_req(args[0], args[1])
    elif command == "poll-resp" and not args:
        poll_resp()
    elif command == "token-req" and len(args) == 1:
        token_req(args[0])
    elif command == "token-resp" and not args:
        token_resp()
    elif command == "jwt-sub" and not args:
        jwt_sub()
    elif command == "jwt-shape" and not args:
        jwt_shape()
    else:
        _fail("unknown subcommand or wrong arguments")


if __name__ == "__main__":
    main()
