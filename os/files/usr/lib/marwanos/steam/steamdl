#!/usr/bin/env bash
#
# The download half of this appliance's own Steam client: a root worker that
# drains a queue, drives DepotDownloader, and writes the two files that make a
# download VISIBLE -- the appmanifest the rail already renders, and the
# downloads JSON the store page polls.
#
# WHY THIS IS A SEPARATE PROCESS FROM steamd. steamd answers requests: sign in,
# who am I, what do I own. Every one of those is seconds of network and then a
# file. A download is HOURS, and a single-threaded request loop that ran one
# would stop answering anything -- press A on a second game and nothing happens
# until the first one finishes, with no way to cancel it because the loop that
# would notice the cancel is the loop that is busy. So steamd appends
# `<verb>TAB<appid>` to /run/marwanos/steam.queue and returns immediately, and
# this file is the thing with the long-running child.
#
# WHAT THIS OWNS AND WHAT IT DOES NOT. It owns the library under
# ~player/Games, the appmanifests in it, and /run/marwanos/steam.downloads.json.
# It never writes /run/marwanos/steam.state -- the contract says that file has
# ONE writer and it is steamd. A worker narrating through the request loop's
# state word would produce exactly the bug that rule exists to prevent: a
# `working` that is never cleared because two writers disagreed about whose turn
# it was.
#
# THE THREE THINGS THAT DECIDE WHETHER THIS WORKS AT ALL, all measured
# 2026-08-12 and each of them a build's worth of confusion if got wrong. They
# are restated at their use sites; here is the short form so a reader knows what
# the length of this file is buying:
#
#   1. `StateFlags 4` alone does NOT stop Valve's client re-downloading the
#      game we just fetched. It compares our manifest's `buildid` against the
#      branch's current buildid and ORs in UpdateRequired on a mismatch. A
#      believable manifest needs the REAL buildid, `TargetBuildID 0`, and an
#      `InstalledDepots.<depotid>.manifest` equal to the manifest id actually
#      pulled. See commit_install(). This is SteamRE issue #274 exactly.
#   2. Bit 8 (DataEncrypted) must NEVER be set. The payload DepotDownloader
#      writes is plaintext; a client told it is encrypted redoes everything.
#   3. The client must be STOPPED while the final manifest is written, because
#      it flushes its in-memory copy of the app state over the file on exit.
#      This asks the SESSION to stop it -- see pause_client() -- rather than
#      running `flatpak kill` behind the supervisor's back, which would be a
#      second lifecycle owner racing the first one.
#
# THE BINARY'S PATH IS FROZEN, AND SO IS $HOME. DepotDownloader's credential
# cache lives in .NET isolated storage, in a directory whose name is a hash of
# the executable's own absolute path -- so moving the binary orphans every
# stored refresh token in silence, and the symptom is a machine that asks for a
# fresh QR scan for no visible reason. The same is true of $HOME, because
# isolated storage is rooted under it: this file therefore PINS neither and
# ASSERTS both, logging what it resolved, so a drift shows up as a journal line
# rather than as a mystery.
#
set -euo pipefail

TAG=marwanos-steamdl

# ---------------------------------------------------------------------------
# Paths. Every one of these is from docs/steam-client-contract.md; nothing here
# invents a location, because the shell half and steamd are written against the
# same table and a path invented here would simply never be read.

RUN_DIR=/run/marwanos

## steamd appends `<verb>TAB<appid>` lines here.
##
## IN root-OWNED /run/marwanos, EMPHATICALLY NOT IN /run/marwanos/steam, and the
## difference is a privilege escalation rather than a preference. The `steam`
## directory is player-owned 0700 so the shell can create `request` in it --
## which also means `player` may unlink any name in there and put a symlink in
## its place. A root process appending to a file at a name the session user
## controls is a write-anywhere primitive: swap `queue` for a symlink to
## /etc/shadow and steamd's `>>` follows it. So the queue sits beside
## steam.state and steam.downloads.json, in a directory only root can write.
##
## Nothing in this file creates or touches /run/marwanos/steam. That directory
## and its ownership belong to steamd; a worker that helpfully created it as
## root:root would leave the shell unable to write a request at all, and the
## symptom would be every button in the store page doing nothing.
QUEUE="$RUN_DIR/steam.queue"
## Where a taken queue is moved before being read, in the same root-owned
## directory. See drain_queue() for why the move rather than an offset.
QUEUE_TAKEN="$RUN_DIR/steam-queue.taken"

## Published for the shell. In /run because it is only true about this boot: a
## download in flight does not survive a reboot, and a file under /var claiming
## one would be a lie the first time somebody power-cycled the machine.
DOWNLOADS="$RUN_DIR/steam.downloads.json"

VAR_DIR=/var/marwanos/steam
## What steamd learned from appinfo, per app, as `<key>TAB<value>` lines. See
## read_appinfo() for the keys and for the long argument about why this file
## exists rather than this script asking Steam anything itself.
APPINFO_DIR="$VAR_DIR/appinfo"
## And the thing that WRITES those files: it reads Valve's own binary appinfo
## cache off this disk and emits the rows read_appinfo()/appinfo_get() below
## expect. Named next to the directory it fills so the pair cannot drift apart.
APPINFO_TOOL=/usr/lib/marwanos/steam/appinfo
## The owned-games list steamd publishes. Read ONLY as a fallback source of a
## game's display name; nothing here depends on it existing.
LIBRARY_JSON="$VAR_DIR/library.json"
## Scratch: DepotDownloader logs, manifest listings, exit-status files. Under
## /var rather than /run so a manifest listing survives a reboot and a resumed
## install does not have to re-query it -- that query is the one that gets
## rate-limited (see RATE_LIMIT_BACKOFF).
WORK_DIR="$VAR_DIR/work"

## Root-owned 0700, and the reason it exists is a privilege escalation rather
## than tidiness. Every temp file this root process builds for a destination
## the SESSION user owns is built in here first and renamed across. The whole
## argument is at "Writing into directories the player owns" below; the short
## form is that a `> "$dest.tmp"` in a player-owned directory follows a symlink
## the player put there, and rename(2) does not.
STAGE_DIR="$VAR_DIR/staging"

## Root-only, 0700, and TWO files per signed-in account rather than one:
##
##   steam-refresh.<steamid64>.token   the refresh token steamd's QR scan won
##   steam-persona.<steamid64>         the account NAME, for -username
##
## THE TOKEN FILE IS THE IDENTITY, and the persona is looked up BY its steamid
## rather than chosen on its own. The contract says the active identity is the
## newest TOKEN file resolved root-side, and steamd resolves it exactly that
## way; the persona sidecar is written best-effort and steamd's own comment
## calls it cosmetic. Picking the newest PERSONA instead -- which this file did
## -- means a machine whose sidecar write failed answers "sign in again" for
## every download while the token it is complaining about sits in the same
## directory, valid. See active_account() for the two-account half of it.
SECRETS=/var/marwanos/secrets
TOKEN_PREFIX="steam-refresh."
TOKEN_SUFFIX=".token"
PERSONA_PREFIX="steam-persona."

## FROZEN. See the header. Asserted rather than searched for: a fallback path
## would be a way to silently orphan every token.
DEPOTDOWNLOADER=/usr/lib/marwanos/steam/DepotDownloader

# THE NESTING IS NOT DECORATIVE, and getting it wrong produces a failure with
# no error message anywhere. The flatpak client must be granted the PARENT of a
# library folder; granted the library root itself it fails to add it and reports
# nothing at all (Valve issue #10487). So `Games` is what the flatpak override
# exposes and `Games/SteamLibrary` is what the client mounts.
#
# /var/home rather than /home for a second, unrelated reason: /home is a symlink
# on ostree and Steam does not follow symlinks inside a library path.
GAMES_PARENT=/var/home/player/Games
LIBRARY_ROOT="$GAMES_PARENT/SteamLibrary"
STEAMAPPS="$LIBRARY_ROOT/steamapps"
COMMON="$STEAMAPPS/common"
COMPATDATA="$STEAMAPPS/compatdata"

## Valve's client's own private library. Read to find the file that tells it our
## library exists (see register_library), and never written except through that
## one function.
CLIENT_STEAM=/var/home/player/.var/app/com.valvesoftware.Steam/.local/share/Steam
CLIENT_STEAMAPPS="$CLIENT_STEAM/steamapps"
LIBRARYFOLDERS="$CLIENT_STEAMAPPS/libraryfolders.vdf"

## The one user this appliance has, created by sysusers at uid 1000. Resolved
## rather than hardcoded because the pause seam below needs the uid, and
## hardcoding 1000 in a second file is how two files come to disagree.
PLAYER=player

# How often the loop looks for work and for progress. A person has just pressed
# Install and is watching the screen; one second is under what reads as lag and
# costs nothing on a machine that is otherwise saturating a USB stick.
POLL=1

# How often the appmanifest and the downloads file are rewritten while a
# download runs. DepotDownloader emits one progress line PER COMPLETED FILE, so
# a game of small files produces thousands of them a minute -- rewriting two
# files on a USB stick that many times would cost real bandwidth from the
# download itself. Ten seconds also happens to be marwanos-appscan's poll
# interval, so a faster rewrite could not reach the rail any sooner.
PUBLISH_INTERVAL=10

# How long to wait for the session to actually stop the client after being
# asked. The supervisor polls its wish file every two seconds and then runs
# `flatpak kill`, so this is generous by a factor of thirty; it is long because
# the cost of giving up early is the client flushing its stale state over the
# manifest we are about to write, which is trap 3 and the whole reason the pause
# exists.
CLIENT_STOP_TIMEOUT=60

# `RateLimitExceeded` is IP-scoped and comes mostly from hammering manifest
# queries -- which is exactly what an install does before it downloads anything.
# The first backoff is five minutes, doubling to an hour, and it gates the START
# of an install rather than aborting one in flight.
RATE_LIMIT_BACKOFF_START=300
RATE_LIMIT_BACKOFF_MAX=3600

# ALL THREE WRITE TO STDERR, and it is a correctness requirement rather than a
# convention -- several functions here hand data back through command
# substitution, and a log line on stdout becomes that data. This has already
# broken two features in this tree. systemd captures both streams identically
# and parses the <N> prefixes on both, so the journal is unchanged.
info() { printf '<6>%s: %s\n' "$TAG" "$*" >&2; }
warn() { printf '<4>%s: %s\n' "$TAG" "$*" >&2; }
err()  { printf '<3>%s: %s\n' "$TAG" "$*" >&2; }


# ---------------------------------------------------------------------------
# Text handling
# ---------------------------------------------------------------------------

## Field <n> (1-based) of a tab-separated record, WITHOUT `read`.
##
## THIS EXISTS BECAUSE TAB IS IFS WHITESPACE. `IFS=$'\t' read -r a b c` looks
## like it splits on tabs and does not: under the default IFS rules a leading
## empty field is swallowed and every value shifts one place left, silently.
## That has broken two features in this tree, one of them the sign-in, on the
## single response that mattered -- and it fails in the shape that is hardest to
## see, because the fields are all still plausible strings, just the wrong ones.
##
## Walking the record by hand cannot do that: an empty field between two tabs is
## an empty field, and a record with fewer fields than asked for returns nothing
## rather than the tail of the previous one.
tsv_field() {
    local rest="$1" want="$2" i=1 field
    while :; do
        field="${rest%%$'\t'*}"
        if [ "$i" -eq "$want" ]; then
            printf '%s' "$field"
            return 0
        fi
        case "$rest" in
            *$'\t'*) rest="${rest#*$'\t'}" ;;
            *)       return 0 ;;
        esac
        i=$(( i + 1 ))
    done
}


## The producer's half of the same contract: no field this script writes into a
## tab-delimited record may contain a tab, a newline or a carriage return.
## Applied at the point a value crosses from "something a game is called" to
## "something in a file this code later parses".
tsv_clean() {
    local value="$1"
    value="${value//$'\t'/ }"
    value="${value//$'\n'/ }"
    value="${value//$'\r'/}"
    printf '%s' "$value"
}


## JSON string body, escaped. Not a general JSON encoder -- the only values that
## reach it are game names and short sentences this file composed, and the two
## characters that can break the document are the two handled here. Control
## characters are removed rather than escaped, because a control character in a
## game name is not a thing to faithfully preserve into a file a renderer parses.
json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\t'/ }"
    value="${value//$'\n'/ }"
    value="${value//$'\r'/}"
    printf '%s' "$value"
}


## Human-readable bytes for a line read at three metres, integer arithmetic
## only. Deliberately the same shape as marwanos-appscan's human_bytes: the two
## files write the same sentence about the same download, from different sides,
## and a reader who saw "3.1 GB" on the rail and "3.14 GB" on the store page
## would reasonably wonder which was lying.
human_bytes() {
    local bytes="${1:-0}"
    case "$bytes" in ''|*[!0-9]*) printf '0 KB'; return ;; esac
    if [ "$bytes" -ge 1073741824 ]; then
        printf '%s.%s GB' "$(( bytes / 1073741824 ))" "$(( (bytes % 1073741824) * 10 / 1073741824 ))"
    elif [ "$bytes" -ge 1048576 ]; then
        printf '%s MB' "$(( bytes / 1048576 ))"
    else
        printf '%s KB' "$(( bytes / 1024 ))"
    fi
}


## Digits only, at most ten. Validated at BOTH ends per the contract, and this
## is the end that matters: an appid reaches a path (`appmanifest_<id>.acf`,
## `compatdata/<id>`) and an argv, and the writer of the queue is a different
## process from this one.
valid_appid() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${#1}" -le 10 ]
}


# ---------------------------------------------------------------------------
# Writing into directories the player owns
# ---------------------------------------------------------------------------

# THIS SECTION IS ONE SECURITY ARGUMENT, and it is the same argument the
# contract already makes about why the queue is a SIBLING of the request
# directory rather than a file inside it. It is restated here because the queue
# is not the only place this process writes near the session user.
#
# This service runs as root and has no `User=`. Three of the files it produces
# land in directories owned by `player`: the session's service wish file, the
# appmanifest in the games library, and Valve's own libraryfolders.vdf. And
# `player` is not only the person on the couch -- it is the uid mowser's CEF
# renderers run as, which is to say arbitrary web content.
#
# THE ATTACK, concretely, against the shape all three of these had
# (`printf … > "$path.tmp"`, then `chown player:player "$path.tmp"`, then
# `mv -f`): pre-create `<library>/steamapps/appmanifest_620.acf.tmp` as a
# symlink to /etc/shadow, then press Install on app 620. Root's redirection
# FOLLOWS the symlink and truncates and rewrites /etc/shadow; the chown then
# hands it to `player`, because coreutils chown dereferences by default; and
# the `mv` renames the symlink away, leaving nothing on disk to say what
# happened. The same trick against ensure_library's `install -d` + `chown`
# needed no pre-created temp file at all: replace `Games` with a symlink to
# /etc and the first install chowns /etc to the session user.
#
# TWO MECHANISMS CLOSE IT, and both are needed because neither covers
# everything.
#
#   1. BUILD THE FILE WHERE THE PLAYER CANNOT REACH IT, then rename(2) it
#      across. rename does not follow a symlink at the final component of
#      either path, so a player-owned DESTINATION directory then only lets them
#      unlink the result -- never redirect the write.
#
#   2. WHERE (1) IS IMPOSSIBLE, CREATE THE TEMP FILE WITH O_EXCL. bash's
#      `set -C` (noclobber) opens `>` with O_CREAT|O_EXCL, and POSIX requires
#      that open to fail with EEXIST when the path names a symbolic link,
#      whatever the link points at. The worst case degrades from "root writes
#      wherever you aim it" to "the install fails", which is a denial of
#      service available to somebody who could already unplug the machine.
#
# (1) IS IMPOSSIBLE ACROSS A MOUNT, because rename(2) answers EXDEV and there
# is no atomic substitute for it. That decides where the staging directory can
# live, and the answer is different for the two kinds of destination here:
#
#   * The games library and Valve's client's steamapps are both under
#     /var/home, and on an ostree system /var is one filesystem that contains
#     both /var/home and /var/marwanos. So a root-owned staging directory at
#     /var/marwanos/steam/staging serves both, and -- this is the part that
#     matters -- every component of ITS path is root-owned. A staging directory
#     placed inside the library instead could never claim that: `player` owns
#     ~player and may rename anything under it aside between our check and our
#     write, so a `.marwanos-staging` in there would be a guarantee in name
#     only.
#
#   * The session's wish file is under /run/user/<uid>, which pam_systemd
#     mounts as its OWN tmpfs, separate from the /run this service's staging
#     would sit on. There is nothing root-owned to stage into there and nothing
#     that could be made root-owned, for the reason just given about
#     player-owned parents. That site therefore gets (2), and what remains
#     exposed is written down at write_wish() rather than pretended away.
#
# THE SAME-FILESYSTEM CLAIM IS CHECKED, NOT ASSUMED. stage_for() compares
# device numbers per write and falls back to (2) when they differ, so a machine
# that mounts /var/home separately loses the stronger guarantee and says so at
# startup, instead of renaming into EXDEV and failing every install for a
# reason no message would explain.
#
# THE MODE COMES FROM umask, NOT FROM chmod-AFTER-WRITE, and that is the third
# leg of it. chmod follows symlinks, so a chmod on a path the player can
# replace between our create and our chmod is the original bug performed with a
# different syscall. steamd already writes its token files this way and says so
# for exactly this reason.


## A path to build DEST at before renaming it into place.
##
## The name is derived from the pid and the destination's basename rather than
## from a counter, deliberately: a counter incremented inside this function
## would be incremented in a COMMAND SUBSTITUTION SUBSHELL and thrown away --
## the same trap probe_manifests documents -- so it would silently hand every
## caller the same name while looking like it did not. Pid plus basename is
## unique across the callers that exist and stable across calls, and the
## caller unlinks it first anyway.
stage_for() {
    local dest="$1"
    local dir="${dest%/*}" sdev="" ddev=""

    if [ -d "$STAGE_DIR" ] && [ ! -L "$STAGE_DIR" ]; then
        sdev="$(stat -c %d "$STAGE_DIR" 2>/dev/null)" || sdev=""
        ddev="$(stat -c %d "$dir" 2>/dev/null)" || ddev=""
        if [ -n "$sdev" ] && [ "$sdev" = "$ddev" ]; then
            printf '%s/%s.%s' "$STAGE_DIR" "$$" "${dest##*/}"
            return 0
        fi
    fi
    # Same filesystem unavailable: build it in place, and the caller's `set -C`
    # is what stops that being the bug this whole section is about.
    printf '%s.tmp' "$dest"
}


## Put a staged file where it belongs: owner FIRST, then rename(2).
##
## THE ORDER IS THE POINT and is written out rather than left to taste. A chown
## of a path sitting in a player-owned directory is a race the player wins by
## unlinking our file and leaving a symlink in its place, and chown follows
## symlinks unless told not to -- so the chown happens while the file is still
## in the staging directory, and `-h` covers the fallback case where "still in
## the staging directory" means "still at <dest>.tmp, where they can reach it".
## A chown of a symlink they substituted is harmless; a chown of what it points
## at is the vulnerability.
stage_commit() {
    local tmp="$1" dest="$2" owner="$3"

    if [ -n "$owner" ]; then
        chown -h "$owner" "$tmp" 2>/dev/null || true
    fi
    if ! mv -f -- "$tmp" "$dest" 2>/dev/null; then
        rm -f -- "$tmp" 2>/dev/null || true
        return 1
    fi
    return 0
}


## Throw a staged file away without placing it.
stage_discard() {
    rm -f -- "$1" 2>/dev/null || true
    return 0
}


# ---------------------------------------------------------------------------
# The published download list
# ---------------------------------------------------------------------------

# One record per app this boot has been asked about, as
#   <appid>TAB<name>TAB<state>TAB<percent>TAB<detail>TAB<error>
# Ordered: the array order is publication order, which is the order somebody
# pressed the buttons in, which is the order the store page should list them.
ITEMS=()
ACTIVE_APPID=""


## Insert or replace one item, preserving its position in the list.
##
## Percent is an integer 0-100, detail is free text the shell shows verbatim,
## error is empty unless state is `failed`. Every field is cleaned on the way in
## rather than on the way out, so nothing downstream has to remember to.
item_set() {
    local appid="$1" name="$2" state="$3" percent="$4" detail="$5" error="$6"
    local record i found=""

    record="$(printf '%s\t%s\t%s\t%s\t%s\t%s' \
        "$appid" "$(tsv_clean "$name")" "$state" "$percent" \
        "$(tsv_clean "$detail")" "$(tsv_clean "$error")")"

    for i in "${!ITEMS[@]}"; do
        if [ "$(tsv_field "${ITEMS[$i]}" 1)" = "$appid" ]; then
            ITEMS[$i]="$record"
            found=1
            break
        fi
    done
    [ -n "$found" ] || ITEMS+=("$record")
}


## THE `if` IS NOT STYLE. Under `set -e` a bare `[ test ] && action` is a
## compound command whose status is the test's when the test fails, so a
## false test at statement position kills the whole service. That is not a
## hypothetical in a daemon whose entire job is a loop: the failure looks like
## the unit exiting cleanly in the middle of a download. Every conditional in
## this file is written as a full `if` for that reason, including the ones where
## it reads as ceremony.
item_drop() {
    local appid="$1" record kept=()
    for record in "${ITEMS[@]}"; do
        [ -n "$record" ] || continue
        if [ "$(tsv_field "$record" 1)" = "$appid" ]; then
            continue
        fi
        kept+=("$record")
    done
    ITEMS=("${kept[@]}")
}


## Write /run/marwanos/steam.downloads.json.
##
## TEMP-THEN-RENAME, like everything else that crosses this seam. The shell
## polls this file twice a second; a poll landing inside a truncating open()
## reads an empty document, and a renderer that saw one would blank the list for
## a frame. rename(2) means every read is of a complete file or of the previous
## complete file.
##
## `fetched` is not in the contract's sketch of this file and is written anyway,
## for the reason the contract gives two sections earlier: a re-publish of
## unchanged content has to be distinguishable from nothing having happened, and
## an extra key costs a reader nothing while a missing one costs it the ability
## to tell. NO URL appears here, ever -- the picture for an item is
## `art/<appid>.jpg`, a path the shell derives from the appid it already has.
publish_downloads() {
    local record appid name state percent detail error first=1 body=""

    for record in "${ITEMS[@]}"; do
        [ -n "$record" ] || continue
        appid="$(tsv_field "$record" 1)"
        name="$(tsv_field "$record" 2)"
        state="$(tsv_field "$record" 3)"
        percent="$(tsv_field "$record" 4)"
        detail="$(tsv_field "$record" 5)"
        error="$(tsv_field "$record" 6)"
        [ -n "$percent" ] || percent=0

        [ "$first" = 1 ] || body="$body,"
        first=0
        body="$body
    { \"appid\": $appid, \"name\": \"$(json_escape "$name")\", \"state\": \"$state\","
        body="$body \"percent\": $percent, \"detail\": \"$(json_escape "$detail")\","
        body="$body \"error\": \"$(json_escape "$error")\" }"
    done

    {
        printf '{ "active": %s,\n' "${ACTIVE_APPID:-0}"
        printf '  "fetched": %s,\n' "$(date +%s)"
        printf '  "items": [%s%s] }\n' "$body" "$([ -n "$body" ] && printf '\n  ')"
    } > "$DOWNLOADS.tmp" 2>/dev/null || { err "cannot write $DOWNLOADS"; return 0; }

    # EXPLICIT chmod, not a trusted umask: the reader is a different uid running
    # under a different unit's UMask=, and a 0600 file here is a store page that
    # shows nothing with no error anywhere to say why.
    chmod 0644 "$DOWNLOADS.tmp" 2>/dev/null || true
    mv -f "$DOWNLOADS.tmp" "$DOWNLOADS" 2>/dev/null \
        || err "cannot place $DOWNLOADS -- the store page will not see this download"
}


# ---------------------------------------------------------------------------
# What we know about a game before we fetch it
# ---------------------------------------------------------------------------

# THE ONE FACT THIS FILE CANNOT DISCOVER FOR ITSELF, and the honest place to say
# so is here rather than in a summary nobody reads.
#
# A believable appmanifest needs the branch's current `buildid` (trap 1). That
# number lives in appinfo, at `depots.branches.<branch>.buildid`, and appinfo is
# a PICS response over the Steam protocol. DepotDownloader reads it and does not
# print it; its `-manifest-only` listings carry depot ids, manifest ids and
# sizes but no buildid; Valve's client caches it in appcache/appinfo.vdf, which
# is a BINARY KeyValues blob that a shell script has no business pretending to
# parse. There is no fourth source on this machine.
#
# steamd already asks for product info -- the contract has it reading
# `common.library_assets_full` before fetching art and
# `config.launch.<n>.config.oslist` to decide whether a title is native Linux --
# so the number is already in its hands. So the seam is a FILE, written by
# steamd when it has appinfo and read here when it needs it, in the shape every
# other seam in this project uses:
#
#   /var/marwanos/steam/appinfo/<appid>.tsv, `<key>TAB<value>` per line:
#
#     name           <store name>
#     installdir     <config.installdir -- the directory name Valve expects>
#     branch         <public, normally>
#     buildid        <depots.branches.<branch>.buildid>
#     native_linux   <1 when some config.launch.<n>.config.oslist has linux>
#     depot          <depotid>            (repeatable, informational)
#
# ABSENT IS A FIRST-CLASS ANSWER and every caller here treats it as one, because
# the alternative -- refusing to download a game because a cache file has not
# been written yet -- would make the feature depend on two services having run
# in the right order, which is the thing this project's file seams exist to
# avoid. What is lost when it is absent is stated exactly where it is lost.
##
## THE PATH IS BUILT ON A SECOND `local` LINE, and that is a bug fix rather than
## formatting. Bash expands every word of a `local` command before it runs any
## of the assignments, so `local appid="$1" file="…/$appid.tsv"` reads the
## CALLER's `appid`, not this one's -- which under bash's dynamic scoping is a
## variable that usually happens to exist and hold the right value, so the fault
## hides everywhere except the one caller that has no `appid` of its own. There
## it is an unbound variable, and under `set -u` that ends the service in the
## middle of a download.
appinfo_get() {
    local appid="$1" key="$2" line
    local file="$APPINFO_DIR/$appid.tsv"
    [ -r "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        [ "$(tsv_field "$line" 1)" = "$key" ] || continue
        tsv_field "$line" 2
        return 0
    done < "$file"
    return 0
}


## Refresh one app's sidecar from Valve's cache, immediately before the three
## decisions that read it.
##
## HERE AND NOWHERE ELSE, because here is the last moment at which the answer
## can still change anything: install_dir_name(), target_os() and the
## in-progress manifest are all decided from the sidecar in the next twenty
## lines, and a refresh after that point would be a file nobody reads until the
## next install. Not at startup either -- the cache is only as current as the
## last time the client ran, and the appid we care about is the one somebody
## just pressed Install on.
##
## FAILURE IS NOT AN ERROR HERE, and the `if` is deliberate: a nonzero exit
## means "the cache could not tell us about this app", which is the same state
## as having no sidecar at all -- already a first-class answer everywhere below,
## and already said out loud by commit_install() at the moment it costs
## something. The tool's own stderr carries the reason into the journal with its
## own priority prefixes, so nothing is repeated here.
##
## Under `set -e` a bare invocation whose status is nonzero would end the
## service in the middle of a download; the `if` is what stops a missing cache
## file from being fatal to a feature that works fine without one.
refresh_appinfo() {
    local appid="$1"
    if [ ! -x "$APPINFO_TOOL" ]; then
        warn "$APPINFO_TOOL is missing: no buildid, no installdir, no oslist"
        return 0
    fi
    if ! "$APPINFO_TOOL" "$appid"; then
        warn "no appinfo for $appid from Valve's cache; continuing without it"
    fi
    return 0
}


## A game's display name, best effort, in falling order of trust.
##
## The library JSON is scanned as TEXT rather than parsed as JSON, and that is a
## deliberate limit rather than laziness: this is a fallback for a label on a
## card, the file is written by a sibling process in this repo against a schema
## in the contract, and a real JSON parser in bash would be a hundred lines of
## new surface to be wrong in for a string that only decorates a progress row.
## If the scan misses, the appid stands in, which is ugly and true.
game_name() {
    local appid="$1" name line rest

    name="$(appinfo_get "$appid" name)"
    if [ -n "$name" ]; then printf '%s' "$name"; return 0; fi

    if [ -r "$LIBRARY_JSON" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                *"\"appid\": $appid,"*|*"\"appid\":$appid,"*) ;;
                *) continue ;;
            esac
            case "$line" in
                *'"name":'*) rest="${line#*\"name\":}" ;;
                *) continue ;;
            esac
            case "$rest" in
                *'"'*'"'*)
                    rest="${rest#*\"}"
                    printf '%s' "${rest%%\"*}"
                    return 0
                    ;;
            esac
        done < "$LIBRARY_JSON"
    fi

    printf 'App %s' "$appid"
}


## The directory name under steamapps/common that this game must land in.
##
## THIS IS NOT COSMETIC. Valve's client resolves a game's files as
## `<library>/steamapps/common/<installdir>`, with installdir taken from
## appinfo. Get it wrong and the client finds no files where its own metadata
## says they should be, decides the game is not installed, and downloads the
## whole thing again into the correct directory -- leaving ours on the disk
## forever as several gigabytes nothing will ever read.
##
## So appinfo's value wins whenever we have it. The fallback is the game's name
## with the characters a path cannot carry removed, which is what Valve's own
## installdir usually IS -- and when it is not, the cost is the re-download
## above, which is why the degrade is logged at warning rather than quietly.
install_dir_name() {
    local appid="$1" want safe

    want="$(appinfo_get "$appid" installdir)"
    if [ -n "$want" ]; then
        # A path separator or a leading dot in a value from outside this script
        # decides where files land; strip both rather than trusting appinfo to
        # be well-behaved about a string that becomes a directory.
        want="${want//\//_}"
        want="${want//$'\\'/_}"
        case "$want" in .*) want="_${want#.}" ;; esac
        printf '%s' "$want"
        return 0
    fi

    safe="$(game_name "$appid")"
    safe="${safe//[^A-Za-z0-9._ -]/}"
    safe="${safe#"${safe%%[! ]*}"}"
    safe="${safe%"${safe##*[! ]}"}"
    [ -n "$safe" ] || safe="app_$appid"
    printf '%s' "$safe"
}


## `windows` or `linux`, which is the -os DepotDownloader is given.
##
## A title is native-Linux only if some appinfo `config.launch.<n>.config.oslist`
## contains `linux`; the store-level `common.oslist` is a coarser claim and does
## not guarantee a runnable Linux entry point, so steamd is asked to compute the
## precise one and this reads its answer.
##
## UNKNOWN MEANS WINDOWS, and that is the right way round on this machine. A
## Windows build of a game that also ships a Linux build runs under Proton; a
## Linux build of a game that does not have one does not exist. The failure
## modes are "slower than it needed to be" and "there are no files", and only
## one of those is a game somebody can play.
##
## A DEPOT WITH NO oslist IS NOT FILTERED and is always downloaded whatever this
## returns. That is deliberate upstream behaviour -- shared engine content, data
## packs, redistributables -- and it is not a bug to be fixed here.
target_os() {
    local appid="$1"
    if [ "$(appinfo_get "$appid" native_linux)" = "1" ]; then
        printf 'linux'
    else
        printf 'windows'
    fi
}


## The account name for -username and the steamid64 it belongs to, as
## `<account>TAB<steamid64>`. Nothing at all when nobody has signed in, and an
## EMPTY FIRST FIELD when a token exists whose persona sidecar does not -- two
## states the caller has to tell apart, because only one of them is "sign in".
##
## THE NEWEST TOKEN FILE DECIDES WHO WE ARE, and the persona is then looked up
## BY that steamid. That is the contract's rule -- "the active identity is the
## newest token file, resolved root-side" -- and steamd's token_steamid()
## resolves it the same way, which is the whole reason to spell it out here.
##
## THE VERSION THAT PICKED THE NEWEST PERSONA WAS WRONG TWICE OVER. steamd
## writes the persona best-effort and its own comment calls it cosmetic, so on
## a machine where that one write failed there was no persona at all and every
## download reported `sign in again` while the token sat in the same directory,
## working, with the shelf drawn from it. And with two accounts on the machine
## the two halves could disagree outright: steamd fetching the library for the
## newest token while this file downloaded as the newest persona, which
## produces `not owned` on a game the shelf has just said is owned, and nothing
## anywhere connecting the two facts.
##
## The steamid comes out of a FILENAME and is re-validated here even though
## steamd wrote it -- digits, 15 to 20 of them, matching steamd's own check --
## because the value goes on to build a path to a credential, and "we wrote it
## earlier" is a weaker property than "it is digits right now".
active_account() {
    local file newest="" account="" steamid persona

    for file in "$SECRETS/$TOKEN_PREFIX"*"$TOKEN_SUFFIX"; do
        [ -f "$file" ] || continue
        if [ -z "$newest" ] || [ "$file" -nt "$newest" ]; then
            newest="$file"
        fi
    done
    [ -n "$newest" ] || return 0

    # Both prefixes QUOTED SEPARATELY inside the expansion (SC2295): unquoted
    # they are glob patterns rather than literals, which is a difference that
    # only shows up once somebody puts a metacharacter in one of them.
    steamid="${newest##*/"$TOKEN_PREFIX"}"
    steamid="${steamid%"$TOKEN_SUFFIX"}"
    case "$steamid" in ''|*[!0-9]*) return 0 ;; esac
    case "${#steamid}" in 1[5-9]|20) ;; *) return 0 ;; esac

    persona="$SECRETS/$PERSONA_PREFIX$steamid"
    if [ -f "$persona" ]; then
        # `|| true`, NOT `|| account=""`, AND THAT IS THE WHOLE OF IT. steamd
        # writes this file with `printf '%s'` and no trailing newline, on
        # purpose -- it does the same for the token, because a stray byte on
        # the end of a credential is a credential that stops working. `read`
        # hitting EOF without a delimiter STILL ASSIGNS what it managed to
        # read, and then returns 1. So the old `|| account=""` threw away the
        # account name it had just successfully read, every single time, for
        # every persona file steamd has ever written.
        #
        # That is the second half of the dead-download bug and it would have
        # survived the first: resolve identity from the right file, hand the
        # token to DepotDownloader correctly, and still report `sign in again`
        # forever, because the name arrived empty. Found by the test suite for
        # this fix, not by reading.
        IFS= read -r account < "$persona" 2>/dev/null || true
        account="$(tsv_clean "$account")"
        # Whitespace only; anything else is passed through, because an account
        # name is Valve's to define and this is not the place to guess its
        # charset.
        account="${account#"${account%%[![:space:]]*}"}"
        account="${account%"${account##*[![:space:]]}"}"
    fi

    printf '%s\t%s' "$account" "$steamid"
}


# ---------------------------------------------------------------------------
# Asking the session to stand the client down
# ---------------------------------------------------------------------------

# TRAP 3, AND THE REASON IT IS ASKED FOR RATHER THAN TAKEN.
#
# The client flushes its in-memory app state over the appmanifest when it exits,
# so a manifest written underneath a running client is a manifest that may be
# gone thirty seconds later -- and the symptom is trap 1's symptom, a game that
# re-downloads itself, arrived at by a completely different route.
#
# The obvious fix is `flatpak kill com.valvesoftware.Steam`. It is the wrong
# one. marwanos-session SUPERVISES that client: it restarts it when it exits,
# counts fast exits against a crash guard, and parks in a `crashed` state with
# an ever-slower retry once the guard trips. Killing the client from outside
# that loop is indistinguishable, from inside it, from the client dying -- so a
# handful of installs would walk the supervisor into `crashed`, the bell would
# go amber, and the journal would say Steam had failed five times when in fact
# nothing had gone wrong at all.
#
# The session already has a mechanism for this and it is the one the shell's
# service menu uses: `$XDG_RUNTIME_DIR/marwanos/services/steam.wanted`, `0` for
# stop and `1` for start, honoured within about two seconds, with the state
# echoed back in `steam.state`. Writing a wish is the supported way to stand the
# client down, and it means the supervisor knows the exit was asked for and does
# not count it.
#
# THE PRIOR VALUE IS RESTORED, NOT ASSUMED. Somebody may have turned Steam off
# from the couch; an install that turned it back on afterwards would be this
# script overruling a person, which it has no standing to do. Absent means yes
# (the session's own default), so restoring an absent file means DELETING ours.

CLIENT_PAUSE_PRIOR=""     # "", "none", "absent", or the previous file contents
CLIENT_PAUSED=""


## The session's service directory for the player uid, or nothing when there is
## no session -- a boot before greetd has started one, or a headless test bench.
## No session means no client to stop, which is a complete and correct answer
## rather than a failure.
service_dir() {
    local uid
    uid="$(id -u "$PLAYER" 2>/dev/null)" || return 0
    [ -n "$uid" ] || return 0
    local dir="/run/user/$uid/marwanos/services"
    [ -d "$dir" ] || return 0
    printf '%s' "$dir"
}


## Write a wish into the session's directory, keeping it OWNED BY THE PLAYER.
##
## The shell rewrites this same file when somebody uses the service menu, and it
## does so by creating `<name>.tmp` and renaming. The rename works whoever owns
## the old file -- the directory is the player's -- so a root-owned file here
## would not actually break the menu. It is chowned anyway, because a file this
## uid can only replace and never open for writing is a trap laid for whoever
## next changes how the shell writes it.
##
## THIS IS THE SITE THAT CANNOT HAVE A ROOT-OWNED STAGING DIRECTORY, and saying
## exactly what that costs is better than implying it was fixed. /run/user/<uid>
## is its own tmpfs, so nothing staged on /run can be renamed into it; and a
## directory we created inside it would sit under a player-owned parent, which
## the player may rename aside between any check and any use. So mechanism (2)
## from the section above is all there is here: `set -C` makes the create fail
## rather than follow a symlink, `umask` sets the mode without a chmod that
## could be redirected, `chown -h` cannot be pointed at anything else, and
## rename(2) does not follow a symlink at the destination either.
##
## WHAT `player` CAN STILL DO, precisely: squat on `steam.wanted.tmp` so this
## returns 1, which makes pause_client warn and write the manifest without
## standing the client down -- trap 3, self-inflicted, costing at worst a
## manifest the client overwrites on its next exit. And leave a symlink at
## `steam.wanted` itself, which rename replaces rather than follows. Both of
## those are things the session user can already do to their own session by
## other means; neither reaches a file root cares about. The CONTENT is `0` or
## `1`, in the player's own runtime directory, so there is nothing here to
## disclose either. The read side of the same file is a different matter and is
## handled at session_line().
write_wish() {
    # TWO `local` LINES, and the second one is a bug fix rather than a style
    # choice -- the same one appinfo_get() carries. Bash expands every word of
    # a `local` before it runs any of the assignments, so
    # `local dir="$1" path="$dir/steam.wanted"` builds the path out of the
    # CALLER's `dir`. Both callers happen to have a `local dir` holding the
    # right value, so it works today by coincidence; a caller without one would
    # send this to `/steam.wanted`, as root, and the only symptom would be a
    # service menu that stopped working.
    local dir="$1" value="$2" tmp
    local path="$dir/steam.wanted"

    tmp="$(stage_for "$path")"
    stage_discard "$tmp"
    # 022, so the file lands 0644 without a chmod -- see the staging section on
    # why chmod-after-write is the same bug with a different syscall.
    if ! ( umask 022; set -C; printf '%s\n' "$value" > "$tmp" ) 2>/dev/null; then
        return 1
    fi
    stage_commit "$tmp" "$path" "$PLAYER:$PLAYER" || return 1
    return 0
}


## The first line of a file in the SESSION's directory, refusing anything that
## is not a plain regular file.
##
## THE READ SIDE IS AN EXPOSURE TOO, and it is the half that is easy to miss
## while fixing the writes. /run/user/<uid>/marwanos/services is player-owned,
## so `steam.wanted` may be a symlink to /etc/shadow -- and the value read out
## of it used to be written straight back by resume_client, into a file the
## player reads. That is root disclosing its own password hash, on request,
## through a file whose entire content is meant to be the character `0`.
##
## It may also be a FIFO, in which case the open blocks a single-threaded
## downloader forever with the unit still reporting active (running) -- the
## same trap the contract records against the request file.
##
## So: not a symlink, a regular file, and the read is done by a process that
## can be killed, because the -L test and the open are not atomic and nothing
## available to a shell makes them so. The CALLER then whitelists the value it
## got, which is what actually closes the disclosure: no byte that is not a `0`
## or a `1` is ever written back out.
session_line() {
    local path="$1" out=""

    if [ -L "$path" ] || [ ! -f "$path" ]; then
        return 0
    fi
    out="$(timeout 5 head -n 1 -- "$path" 2>/dev/null)" || out=""
    printf '%s' "$(tsv_clean "$out")"
}


pause_client() {
    local dir prior="" waited=0 word

    dir="$(service_dir)"
    if [ -z "$dir" ]; then
        # No session, so no supervised client, so nothing to stand down. Said at
        # info because on a bench this is the normal case and a warning here
        # would train a reader to ignore warnings.
        CLIENT_PAUSE_PRIOR="none"
        CLIENT_PAUSED=""
        info "no session running: nothing to stop before writing the manifest"
        return 0
    fi

    # WHITELISTED, not merely cleaned, and that is what closes session_line()'s
    # disclosure rather than narrowing it. The only values this file may carry
    # are `0` and `1`; anything else -- a truncated write, a symlink to
    # somebody else's file that slipped past the -L test, a FIFO that timed out
    # -- is treated as absent, which restores by DELETING our file rather than
    # by writing the bytes back into a place the session user reads.
    prior="$(session_line "$dir/steam.wanted")"
    case "$prior" in
        0|1) ;;
        *)   prior="absent" ;;
    esac
    CLIENT_PAUSE_PRIOR="$prior"

    if [ "$prior" = "0" ]; then
        # Already stopped by a person. Nothing to ask for, and nothing to
        # restore afterwards either.
        CLIENT_PAUSED=""
        info "the client is already stopped by request; writing the manifest as-is"
        return 0
    fi

    if ! write_wish "$dir" 0; then
        warn "cannot ask the session to stop the client ($dir/steam.wanted)"
        warn "writing the manifest anyway -- the client may flush its own state over it"
        CLIENT_PAUSED=""
        return 0
    fi
    CLIENT_PAUSED=1

    # The trap is armed only while a pause is outstanding. A steamdl that was
    # killed between the wish and its restoration would otherwise leave Steam
    # switched off for the rest of the boot, with the service menu the only way
    # back and nothing anywhere explaining it.
    trap 'resume_client; exit 143' TERM
    trap 'resume_client; exit 130' INT
    trap 'resume_client' EXIT

    info "asked the session to stop the background client"
    while [ "$waited" -lt "$CLIENT_STOP_TIMEOUT" ]; do
        # Through session_line for the FIFO half of its argument rather than
        # the disclosure half: this value is only ever compared against two
        # words and never written anywhere, but an open() that blocks here
        # blocks the whole downloader, mid-install, with the unit still green.
        word="$(session_line "$dir/steam.state")"
        case "$word" in
            stopped|crashed) break ;;
        esac
        sleep 2
        waited=$(( waited + 2 ))
    done

    if [ "$waited" -ge "$CLIENT_STOP_TIMEOUT" ]; then
        warn "the client did not report stopped within ${CLIENT_STOP_TIMEOUT}s; writing anyway"
    fi
    # A short grace after the state word: `flatpak kill` returns before the
    # sandbox has finished tearing down, and the flush this pause exists to
    # avoid happens during that teardown.
    sleep 3
    return 0
}


resume_client() {
    local dir
    [ -n "$CLIENT_PAUSED" ] || return 0
    CLIENT_PAUSED=""
    trap - TERM INT EXIT

    dir="$(service_dir)"
    [ -n "$dir" ] || return 0

    case "$CLIENT_PAUSE_PRIOR" in
        absent)
            # Absent means "wanted", and it is the state of a machine nobody has
            # touched. Restoring it means removing our file, not writing a 1:
            # leaving a 1 behind would make every later reading of "has anybody
            # chosen anything here" answer yes.
            rm -f "$dir/steam.wanted" 2>/dev/null || true
            ;;
        ""|none) ;;
        *)
            write_wish "$dir" "$CLIENT_PAUSE_PRIOR" \
                || warn "cannot restore $dir/steam.wanted -- use the service menu to start Steam"
            ;;
    esac
    info "released the client back to the session"
}


# ---------------------------------------------------------------------------
# The library on disk
# ---------------------------------------------------------------------------

## Create the library, owned by the player, and hand the ownership question one
## answer.
##
## THE DOWNLOADER RUNS AS ROOT AND THE PLAYER HAS TO OWN THE RESULT. Everything
## under Games is read, written and executed by the session uid: Valve's client
## reads the manifests, Proton writes prefixes into compatdata, saves land beside
## the game. Root-owned files there are a game that starts and cannot save.
##
## WHICH IS EXACTLY WHY THIS FUNCTION WAS THE WORST OF THE THREE. It used to
## `install -d` then `chown` each component unconditionally, and every one of
## those paths has a parent the session user owns -- ~player owns `Games`,
## `Games` owns `SteamLibrary`, and so on down. Replace `Games` with a symlink
## to /etc and the first install chowns /etc to `player`: `install -d` treats
## an existing symlink-to-directory as success, and chown dereferences by
## default. One press of Install and the machine belongs to whoever wrote the
## page mowser was showing.
##
## SO: A COMPONENT THAT IS A SYMLINK REFUSES THE WHOLE INSTALL rather than
## being repaired. That is not only the safe answer, it is the correct one --
## the contract says symlinks in a library path are unsupported by Steam
## anyway, which is why every path in this file is /var/home and not the /home
## symlink. And a component we did NOT create is never chowned: an existing
## directory with the wrong owner is a real problem, said out loud, not one to
## fix by force through a name somebody else controls.
##
## WHAT REMAINS, honestly: the -L test and the mkdir are not atomic, and no
## shell can make them so. `player` can swap a checked component for a symlink
## in that window. What that wins is a mkdir and a chown of a directory that
## did not previously exist, inside a directory of their choosing -- not a
## write into an existing file, and not the ownership of one. The exposure went
## from "any file on the machine" to "a new empty directory".
ensure_library() {
    local dir owner
    for dir in "$GAMES_PARENT" "$LIBRARY_ROOT" "$STEAMAPPS" "$COMMON" "$COMPATDATA"; do
        if [ -L "$dir" ]; then
            err "$dir is a symbolic link; refusing to install anything through it"
            err "root would follow it, and Steam does not support one in a library path"
            return 1
        fi
        if [ -e "$dir" ]; then
            if [ ! -d "$dir" ]; then
                err "$dir exists and is not a directory -- no download can land"
                return 1
            fi
            owner="$(stat -c %U "$dir" 2>/dev/null)" || owner=""
            if [ -n "$owner" ] && [ "$owner" != "$PLAYER" ]; then
                warn "$dir is owned by $owner rather than $PLAYER"
                warn "leaving it alone -- a chown through a name $PLAYER controls is how this went wrong before"
            fi
            continue
        fi
        # mkdir, NOT `install -d`. install -d creates missing parents (so a
        # check on the parent buys nothing) and accepts an existing
        # symlink-to-directory as success (so the check above buys nothing
        # either). mkdir's final component behaves like O_EXCL: it fails with
        # EEXIST on a symlink rather than following it.
        if ! mkdir -m 0755 -- "$dir" 2>/dev/null; then
            err "cannot create $dir -- no download can land"
            return 1
        fi
        chown -h "$PLAYER:$PLAYER" "$dir" 2>/dev/null \
            || warn "cannot chown $dir to $PLAYER -- the client may not be able to read it"
    done
    return 0
}


## Free megabytes on the filesystem holding the library.
##
## Read from the CONTAINING directory rather than from a path that does not
## exist yet: `df` on a missing path answers about nothing at all, and a
## free-space check that silently measures the wrong filesystem is worse than no
## check, because it reports a number.
##
## RETURNS 0 EVEN WHEN IT ANSWERS NOTHING, and that `|| true` is load-bearing.
## Under `set -euo pipefail` a pipeline whose right-hand side is missing -- an
## image without awk, a `df` that refused a path -- fails, and a failing command
## substitution on the right of an assignment carries its status to the
## assignment, which ends the service. A free-space check that cannot run should
## cost a check, not the download.
free_mb() {
    local dir="$1"
    while [ -n "$dir" ] && [ ! -d "$dir" ]; do dir="${dir%/*}"; done
    [ -n "$dir" ] || dir=/
    df -Pm "$dir" 2>/dev/null | awk 'NR==2 {print $4}' || true
}


## Tell Valve's client that our library exists.
##
## WITHOUT THIS, TIER 1 CANNOT WORK. `steam://rungameid/<appid>` is handled by
## the client, and the client only knows about apps in libraries listed in its
## own steamapps/libraryfolders.vdf. A perfect appmanifest in a library the
## client has never heard of is a game that shows on our rail, launches through
## the client, and produces an error dialog nobody can see.
##
## APPEND-ONLY, AND BACKED UP FIRST. This file is the client's index of every
## library it has; a malformed one loses the machine's whole game list, and this
## script is not a KeyValues editor. So it does exactly two things: it reads the
## file to see whether our path is already named in it, and if not it inserts one
## new block before the final closing brace. Existing text is never rewritten,
## and a copy is kept beside it. Anything unexpected -- no file, no closing
## brace, a client that has never run -- is a skip with a message, not a repair
## attempt.
##
## The key of the new block has to be a number the file does not already use;
## the client indexes libraries by consecutive strings starting at "0", so the
## count of existing `"<n>"` keys is the next free one.
##
## WHICH KEYS COUNT IS THE WHOLE OF IT, and the version of this walk that took
## the first quoted token of ANY line got it wrong in a way that reads as
## working. libraryfolders.vdf carries an `"apps"` block PER LIBRARY whose keys
## are APPIDS:
##
##     "libraryfolders"          depth 0
##     {                                        -> depth 1
##         "0"                   depth 1        <- a library index. These.
##         {                                    -> depth 2
##             "path"  "/…"      depth 2        <- a key/value PAIR, not a key
##             "apps"            depth 2
##             {                                -> depth 3
##                 "228980"  "5" depth 3        <- an APPID, and a pair
##             }
##         }
##     }
##
## So `highest` became 228980 and the new library was inserted as "228981".
## Valve's client indexes libraries by consecutive strings from "0" and a file
## claiming a library number two hundred thousand places past the end is not
## something to find out about on somebody's television.
##
## TWO DISCRIMINATORS, both needed. Depth: only a bare key at depth 1 is a
## library index. And alone-ness: a line holding a quoted token ALONE is a
## block header, while `"key" "value"` is a pair and must never be read as one
## -- the same test steamd's loginusers.vdf walk needed for the same reason.
## The appids fail both, which is the point.
##
## Braces are counted only on lines that are EXACTLY `{` or `}`, because a `}`
## inside a quoted path value is a character in a string and not a scope. The
## old walk's `*'}'*` match would have taken one for the file's last brace.
register_library() {
    local line stripped inner highest=-1 depth=0 last_close=0 n=0 total=0

    if [ -L "$LIBRARYFOLDERS" ]; then
        # Read-side symlink guard, and not a theoretical one: this file is read
        # into a backup and its bytes are copied into the replacement, so a
        # symlink here is root reading a file of the player's choosing and
        # writing it back out into a file the player can read.
        warn "$LIBRARYFOLDERS is a symbolic link -- refusing to read or edit it"
        return 0
    fi

    if [ ! -f "$LIBRARYFOLDERS" ]; then
        # The client has never run on this machine, so it has no index to add to
        # and will build one on its first start -- from libraryfolders.vdf,
        # which it will then create WITHOUT our library in it. Writing the file
        # from scratch here is possible and is deliberately not done: getting it
        # wrong costs the client's own library, and the recovery path (start the
        # client once, then install) costs one download's delay.
        warn "no $LIBRARYFOLDERS yet -- the client has not run on this machine"
        warn "our library will be registered on the first install AFTER the client has started once"
        return 0
    fi

    if grep -qF "$LIBRARY_ROOT" "$LIBRARYFOLDERS" 2>/dev/null; then
        return 0
    fi

    # The line count comes from this same walk rather than from `wc -l`, which
    # would disagree by one on a file that does not end in a newline -- and a
    # disagreement there reads as "this file does not end in a closing brace"
    # and refuses to register a perfectly good library.
    while IFS= read -r line || [ -n "$line" ]; do
        n=$(( n + 1 ))
        # Leading and trailing whitespace stripped so every test below is about
        # structure rather than about indentation, which Valve's writer has
        # changed before.
        stripped="${line#"${line%%[![:space:]]*}"}"
        stripped="${stripped%"${stripped##*[![:space:]]}"}"

        case "$stripped" in
            '{')
                depth=$(( depth + 1 ))
                continue
                ;;
            '}')
                depth=$(( depth - 1 ))
                if [ "$depth" -eq 0 ]; then
                    last_close="$n"
                fi
                continue
                ;;
        esac

        # A block header is a quoted token ALONE on its line. `"key" "value"`
        # has a quote inside once the outer pair is peeled off, which is the
        # test that keeps `"228980"  "5"` out of the running.
        case "$stripped" in
            \"*\")
                inner="${stripped#\"}"
                inner="${inner%\"}"
                case "$inner" in
                    *\"*) continue ;;
                esac
                ;;
            *) continue ;;
        esac

        # Depth 1 is a library index; depth 2 is `"apps"` and friends; depth 3
        # is an appid. Only the first of those may set `highest`.
        [ "$depth" -eq 1 ] || continue
        case "$inner" in
            ''|*[!0-9]*) ;;
            *)
                if [ "$inner" -gt "$highest" ]; then
                    highest="$inner"
                fi
                ;;
        esac
    done < "$LIBRARYFOLDERS"
    total="$n"

    if [ "$last_close" -eq 0 ] || [ "$last_close" -ne "$total" ] || [ "$depth" -ne 0 ]; then
        warn "$LIBRARYFOLDERS does not end in a balanced closing brace -- refusing to edit it"
        warn "the game will download but the client will not see the library"
        return 0
    fi

    # THE BACKUP IS STAGED AND RENAMED LIKE EVERYTHING ELSE. `cp -f` to a
    # destination in a player-owned directory FOLLOWS a symlink at that name --
    # so `libraryfolders.vdf.marwanos.bak` pointed at /etc/shadow was root
    # truncating it and writing the client's library index over it. rename(2)
    # replaces the symlink instead.
    local bak new
    bak="$(stage_for "$LIBRARYFOLDERS.marwanos.bak")"
    stage_discard "$bak"
    if ( umask 022; set -C; cat -- "$LIBRARYFOLDERS" > "$bak" ) 2>/dev/null; then
        stage_commit "$bak" "$LIBRARYFOLDERS.marwanos.bak" "$PLAYER:$PLAYER" \
            || warn "cannot place the libraryfolders.vdf backup"
    else
        stage_discard "$bak"
        warn "cannot copy $LIBRARYFOLDERS aside; editing it without a backup"
    fi

    new="$(stage_for "$LIBRARYFOLDERS")"
    stage_discard "$new"
    if ! (
        umask 022
        set -C
        {
            head -n $(( last_close - 1 )) "$LIBRARYFOLDERS"
            printf '\t"%s"\n' "$(( highest + 1 ))"
            printf '\t{\n'
            printf '\t\t"path"\t\t"%s"\n' "$LIBRARY_ROOT"
            printf '\t\t"label"\t\t""\n'
            printf '\t\t"contentid"\t\t"0"\n'
            printf '\t\t"totalsize"\t\t"0"\n'
            printf '\t\t"update_clean_bytes_tally"\t\t"0"\n'
            printf '\t\t"time_last_update_verified"\t\t"0"\n'
            printf '\t\t"apps"\n'
            printf '\t\t{\n'
            printf '\t\t}\n'
            printf '\t}\n'
            printf '}\n'
        } > "$new"
    ) 2>/dev/null; then
        stage_discard "$new"
        warn "cannot build the replacement $LIBRARYFOLDERS -- the client will not see our library"
        return 0
    fi

    if ! stage_commit "$new" "$LIBRARYFOLDERS" "$PLAYER:$PLAYER"; then
        warn "cannot place $LIBRARYFOLDERS -- the client will not see our library"
        return 0
    fi
    info "registered $LIBRARY_ROOT with the client as library $(( highest + 1 ))"
    return 0
}


# ---------------------------------------------------------------------------
# The appmanifest
# ---------------------------------------------------------------------------

## Write appmanifest_<appid>.acf.
##
## THE KEYS ARE THE INTEGRATION, twice over.
##
## marwanos-appscan reads `appid`, `StateFlags`, `name`, `BytesDownloaded` and
## `BytesToDownload` out of this file with a line-oriented reader that takes the
## FIRST occurrence of each quoted key. That is what turns a download this repo
## is performing into a live percentage on the rail with no second code path
## anywhere -- so the keys are spelled Valve's way, at Valve's nesting level,
## and nothing above them may contain the same quoted word.
##
## Valve's client reads far more, and the three that decide whether it accepts
## the install are argued for at commit_install(). This function does not decide
## them; it writes what it is handed.
##
## Arguments:
##   appid name installdir stateflags buildid bytes_done bytes_total size_on_disk
##   last_owner depots_tsv
## where depots_tsv is zero or more `<depotid>TAB<manifestid>TAB<size>` lines.
write_manifest() {
    local appid="$1" name="$2" installdir="$3" flags="$4" buildid="$5"
    local done_bytes="$6" total_bytes="$7" size_on_disk="$8" last_owner="$9"
    local depots="${10}"
    local path="$STEAMAPPS/appmanifest_$appid.acf" line depot manifest size tmp

    # A double quote or a backslash inside a KeyValues string ends or escapes
    # it. appscan's reader loses the tail of such a value and Valve's parser may
    # lose the rest of the FILE, so both characters are removed from the one
    # field that can carry them. A game whose title contains a quote gets a
    # slightly wrong label; a manifest that ends early gets a game that will not
    # start.
    name="$(tsv_clean "$name")"
    name="${name//\"/}"
    name="${name//$'\\'/}"
    installdir="${installdir//\"/}"
    installdir="${installdir//$'\\'/}"

    # STAGED IN A ROOT-OWNED DIRECTORY AND RENAMED ACROSS. `steamapps` is
    # player-owned by design -- Valve's client has to write in it -- so
    # `> "$path.tmp"` from a root process is a write-anywhere primitive: the
    # session user pre-creates `appmanifest_620.acf.tmp` as a symlink to
    # /etc/shadow, presses Install on 620, and root truncates and rewrites it
    # before chowning it to them. The full argument is in the staging section;
    # `set -C` covers the case where the staging directory is not on this
    # filesystem, and `umask 022` is why there is no chmod here any more.
    tmp="$(stage_for "$path")"
    stage_discard "$tmp"
    if ! (
        umask 022
        set -C
        {
        printf '"AppState"\n{\n'
        printf '\t"appid"\t\t"%s"\n' "$appid"
        printf '\t"Universe"\t\t"1"\n'
        printf '\t"name"\t\t"%s"\n' "$name"
        printf '\t"StateFlags"\t\t"%s"\n' "$flags"
        printf '\t"installdir"\t\t"%s"\n' "$installdir"
        printf '\t"LastUpdated"\t\t"%s"\n' "$(date +%s)"
        printf '\t"SizeOnDisk"\t\t"%s"\n' "$size_on_disk"
        printf '\t"StagingSize"\t\t"0"\n'
        printf '\t"buildid"\t\t"%s"\n' "$buildid"
        printf '\t"LastOwner"\t\t"%s"\n' "$last_owner"
        printf '\t"UpdateResult"\t\t"0"\n'
        printf '\t"BytesToDownload"\t\t"%s"\n' "$total_bytes"
        printf '\t"BytesDownloaded"\t\t"%s"\n' "$done_bytes"
        printf '\t"BytesToStage"\t\t"0"\n'
        printf '\t"BytesStaged"\t\t"0"\n'
        printf '\t"TargetBuildID"\t\t"0"\n'
        # 1 is "only update this game when I launch it", and it is doing real
        # work rather than expressing a preference: the manifest exists on disk
        # from the moment the download STARTS, in a state that says an update is
        # required, and a client set to update automatically would answer that
        # by starting its own download into the directory we are writing into.
        # Two downloaders, one directory. This is the flag that stops it.
        printf '\t"AutoUpdateBehavior"\t\t"1"\n'
        printf '\t"AllowOtherDownloadsWhileRunning"\t\t"0"\n'
        printf '\t"ScheduledAutoUpdate"\t\t"0"\n'
        printf '\t"InstalledDepots"\n\t{\n'
        if [ -n "$depots" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                [ -n "$line" ] || continue
                depot="$(tsv_field "$line" 1)"
                manifest="$(tsv_field "$line" 2)"
                size="$(tsv_field "$line" 3)"
                [ -n "$depot" ] || continue
                printf '\t\t"%s"\n\t\t{\n' "$depot"
                printf '\t\t\t"manifest"\t\t"%s"\n' "${manifest:-0}"
                printf '\t\t\t"size"\t\t"%s"\n' "${size:-0}"
                printf '\t\t}\n'
            done <<< "$depots"
        fi
        printf '\t}\n'
        printf '\t"UserConfig"\n\t{\n\t\t"language"\t\t"english"\n\t}\n'
        printf '\t"MountedConfig"\n\t{\n\t\t"language"\t\t"english"\n\t}\n'
        printf '}\n'
        } > "$tmp"
    ) 2>/dev/null; then
        stage_discard "$tmp"
        err "cannot write $path"
        return 1
    fi

    # Temp-then-rename: marwanos-appscan stats and re-parses these files every
    # ten seconds, and a parse landing inside a truncating open() would read a
    # manifest with no StateFlags in it and drop the game off the rail for a
    # cycle. It is also what makes a symlink at $path harmless -- rename(2)
    # replaces it rather than following it.
    if ! stage_commit "$tmp" "$path" "$PLAYER:$PLAYER"; then
        err "cannot place $path"
        return 1
    fi
    return 0
}


# ---------------------------------------------------------------------------
# DepotDownloader
# ---------------------------------------------------------------------------

# THE INVOCATION, and every word of it was measured on 2026-08-12.
#
#   -app <id> -dir <path> -os <windows|linux> -osarch 64 -validate
#   -username <account> -remember-password
#
# BOTH -username AND -remember-password are required. With only one of them the
# stored refresh token is never read and the tool prompts for a password, on a
# machine with no keyboard and no terminal, forever.
#
# -dir MAKES THE LAYOUT FLAT. Files land directly in the directory given; the
# depots/<id>/<manifest>/ tree people expect only appears when -dir is omitted.
# So -dir points at <library>/steamapps/common/<installdir>/, which is exactly
# where Valve's client expects to find them, and no move is needed afterwards.
# It also drops a .DepotDownloader/ sidecar in there, which is LEFT ALONE: it
# caches manifests so a resumed or repeated install does not re-query them, and
# re-querying is the thing that gets this IP rate-limited.
#
# -validate IS NOT "VERIFY INTEGRITY OF GAME FILES". The contract forbids the
# client's verify because that re-hashes against the CURRENT branch manifest and
# pulls the whole delta. DepotDownloader's -validate hashes local chunks against
# the manifest it is downloading, which is what makes a resumed download resume
# rather than restart. Different operation, opposite effect.
#
# STDIN IS A REAL, EMPTY FILE -- not /dev/null, and not closed. Closed stdin is
# how some auth paths reach an unhandled .NET exception instead of an exit code,
# and an exception exits with a status that is neither 0 nor 1. That is the
# whole reason the status handling below has three branches rather than two:
#
#   0  success, INCLUDING "already up to date" (`Total downloaded: 0 bytes`)
#   1  failure -- no licence, no disk, a network that went away
#   *  auth is wedged: the stored token is gone or unusable, and the answer is a
#      fresh sign-in rather than a retry


## Where a game's scratch lives: the DepotDownloader log, the manifest listings,
## the empty stdin, the exit status.
work_dir() {
    printf '%s/%s' "$WORK_DIR" "$1"
}


# ---------------------------------------------------------------------------
# Handing DepotDownloader the token we already hold
# ---------------------------------------------------------------------------

# WITHOUT THIS SECTION THE WHOLE FEATURE IS DEAD, and dead in the shape that is
# hardest to diagnose: the QR scan succeeds, the account appears, the shelf
# draws every game the account owns -- and then every single install fails with
# `sign in again`, forever, on a machine where signing in demonstrably worked.
#
# `-username <account> -remember-password` DOES NOT MEAN "use the token in
# /var/marwanos/secrets". It means "look in .NET isolated storage for a token
# you stored there yourself", and DepotDownloader only ever stores one after
# DepotDownloader itself performed a login. On this appliance it never does:
# the login happens in steamd, over the QR flow, and the token lands in
# /var/marwanos/secrets/steam-refresh.<steamid>.token. The two halves have
# always held the same credential and have never been introduced. steamdl read
# only the persona sidecar -- the account NAME -- and never opened the token at
# all.
#
# SO WE WRITE ITS CREDENTIAL STORE FOR IT. Measured 2026-08-12:
#
#   * the file is <HOME>/.local/share/IsolatedStorage/<a>/<b>/Url.<hash>/
#     AssemFiles/account.config, where `Url.<hash>` is derived from a hash of
#     the downloader's own ABSOLUTE PATH -- which is the second, sharper reason
#     that path is frozen and asserted at build time;
#   * its contents are a protobuf-net contract, RAW DEFLATE compressed
#     (RFC1951, no zlib header -- what .NET's DeflateStream writes);
#   * field 2 is ContentServerPenalty, field 4 is LoginTokens (a
#     map<string,string> of account name to refresh token), field 5 is
#     GuardData;
#   * a hand-built file with field 4 set WAS VERIFIED to work: DepotDownloader
#     read it and submitted the token to Steam without prompting for anything.
#
# The token has to carry the `client` audience, and ours does, because steamd
# begins the QR session as platform_type = SteamClient. That is ADR 0010's
# first trap and nothing here may change it.
#
# THE EXISTING FILE IS MERGED, NOT REPLACED. DepotDownloader rewrites this file
# itself, and what it keeps in there includes ContentServerPenalty -- how it
# remembers which CDN edge just failed -- and GuardData. Stamping a
# single-field file over the top would throw both away on every install. So the
# seeder inflates what is there, keeps every record it does not understand byte
# for byte, drops only the LoginTokens entry for THIS account, appends ours and
# re-deflates. An unparseable file is started from scratch, loudly.
#
# RE-SEEDED BEFORE EVERY INSTALL rather than once. Seeding once and assuming it
# holds fails silently the first time anything else rewrites the store, and the
# symptom would be this section's own bug coming back weeks later. The risk in
# the other direction is that we overwrite a FRESHER token than ours: on the
# path this appliance uses, DepotDownloader logs on WITH the stored token and
# has no interactive session to mint a replacement from, so there should be no
# fresher token to lose -- and if a future version starts rotating them, ours
# is the one a new QR scan refreshes, so the recovery is the same scan either
# way. That is reasoning, not a measurement, and it is the one claim in this
# section that has not been checked against the binary.
#
# THE TOKEN NEVER APPEARS IN ARGV. /proc/<pid>/cmdline is world-readable and
# `player` runs the shell, the browser and Valve's client; the token reaches
# python on STDIN, exactly as it reaches protocodec in steamd. The account name
# does go in argv, on the DepotDownloader invocations -- it is not a secret,
# and the contract requires it there.


## Set by seed_login_token() when it fails, read by its caller. Declared here
## because `set -u` makes an unset read fatal, and the caller's error path is
## precisely where that must not happen -- the same reason PROBE_REASON exists.
SEED_REASON=""


## The python that builds account.config. Held in a variable rather than in a
## second file so that the whole of this fix lives in the one file that owns
## it; passed with `-c`, so the SCRIPT is in argv and the CREDENTIALS are not.
##
## Stdin is two lines: the account name, then the refresh token. argv[1] is the
## account.config to merge into and replace.
IFS= read -r -d '' SEED_PY <<'PYTHON' || true
import os, sys, zlib


def varint(n):
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        out.append(b | (0x80 if n else 0))
        if not n:
            return bytes(out)


def field(num, payload):
    """One length-delimited record: tag, length, body."""
    return varint((num << 3) | 2) + varint(len(payload)) + payload


def read_varint(buf, i):
    shift = 0
    val = 0
    while True:
        if i >= len(buf) or shift > 63:
            raise ValueError("bad varint")
        b = buf[i]
        i += 1
        val |= (b & 0x7F) << shift
        if not (b & 0x80):
            return val, i
        shift += 7


def records(buf):
    """(field number, whole record bytes) for each top-level record.

    A WALKER, NOT A SCHEMA. Everything this does not recognise is handed back
    verbatim so it can be written out again unchanged -- which is what keeps
    ContentServerPenalty and GuardData alive across a re-seed. A malformed
    stream raises instead of guessing: bytes we cannot parse are not the
    message we think they are.
    """
    i = 0
    while i < len(buf):
        start = i
        key, i = read_varint(buf, i)
        wire = key & 7
        if wire == 0:
            _, i = read_varint(buf, i)
        elif wire == 1:
            i += 8
        elif wire == 2:
            ln, i = read_varint(buf, i)
            i += ln
        elif wire == 5:
            i += 4
        else:
            raise ValueError("unsupported wire type %d" % wire)
        if i > len(buf):
            raise ValueError("record runs off the end")
        yield key >> 3, buf[start:i]


def entry_key(rec):
    """The map entry's key (field 1) inside one LoginTokens record."""
    _, i = read_varint(rec, 0)
    ln, i = read_varint(rec, i)
    for num, sub in records(rec[i:i + ln]):
        if num == 1:
            _, j = read_varint(sub, 0)
            klen, j = read_varint(sub, j)
            return sub[j:j + klen]
    return None


path = sys.argv[1]
lines = sys.stdin.read().split("\n")
account = lines[0] if lines else ""
token = lines[1] if len(lines) > 1 else ""
if not account or not token:
    sys.stderr.write("seed: empty account name or token on stdin\n")
    sys.exit(1)

kept = b""
try:
    with open(path, "rb") as fh:
        blob = fh.read()
    if blob:
        # -15: RAW deflate. .NET's DeflateStream writes no zlib header, and
        # asking zlib for one here fails on every real file.
        for num, rec in records(zlib.decompress(blob, -15)):
            if num == 4 and entry_key(rec) == account.encode():
                continue
            kept += rec
except FileNotFoundError:
    pass
except Exception as exc:
    sys.stderr.write("seed: %s could not be read (%s); writing a fresh store\n"
                     % (path, exc))
    kept = b""

msg = kept + field(4, field(1, account.encode()) + field(2, token.encode()))
comp = zlib.compressobj(9, zlib.DEFLATED, -15)
blob = comp.compress(msg) + comp.flush()

# 0600 AT CREATION, not by a chmod afterwards: this file is a credential and
# there must be no window in which it is anything else. The directory is under
# root's own home, so temp-then-rename here is about atomicity rather than
# about anybody else reaching it.
tmp = path + ".marwanos.tmp"
try:
    os.unlink(tmp)
except FileNotFoundError:
    pass
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    os.write(fd, blob)
finally:
    os.close(fd)
os.replace(tmp, path)
PYTHON


## The isolated-storage directories DepotDownloader would read account.config
## from, one per line. Empty when it has never run under this $HOME.
dd_store_dirs() {
    local root="$HOME/.local/share/IsolatedStorage"
    [ -d "$root" ] || return 0
    find "$root" -maxdepth 4 -type d -name AssemFiles 2>/dev/null || true
}


## Make DepotDownloader build its own isolated storage, so there is somewhere
## to put the token.
##
## THE DIRECTORY NAMES CANNOT BE COMPUTED HERE. Two of the levels are .NET's
## per-identity hashes and the third is a hash of the executable's absolute
## path; nothing available to a shell derives them, so the only way to learn
## the path is to let the tool build it and then look for it. It builds it on
## any run that gets as far as loading its store, so this uses the one
## invocation this project has actually measured: app 480 (Spacewar),
## `-manifest-only`, and ANONYMOUS -- no `-username`, so it cannot fail on the
## very credential we are trying to install. Measured 2026-08-12 as exiting 0.
##
## ONCE PER MACHINE, not once per install: the store persists under root's
## home, so this is paid on the first download this appliance ever performs.
dd_materialize_store() {
    local scratch="$WORK_DIR/store-init" log="$WORK_DIR/store-init.log" rc=0

    rm -rf -- "$scratch" 2>/dev/null || true
    install -d -m 0700 "$scratch" 2>/dev/null || return 1
    : > "$scratch/stdin.empty" 2>/dev/null || return 1

    info "DepotDownloader has no credential store under $HOME yet; making it build one"
    # Bounded, because this is on the path of somebody pressing Install: a
    # network that is merely slow must not hold the whole downloader.
    ( cd "$scratch" && timeout 120 "$DEPOTDOWNLOADER" \
        -app 480 -dir "$scratch" -manifest-only \
        < "$scratch/stdin.empty" > "$log" 2>&1 ) || rc=$?
    if [ "$rc" -ne 0 ]; then
        warn "the anonymous probe that creates the credential store exited $rc (see $log)"
    fi
    rm -rf -- "$scratch" 2>/dev/null || true
    return 0
}


## Put the refresh token steamd won into the store DepotDownloader reads.
##
## Returns 0 when the token is in place; 1 with SEED_REASON set otherwise. The
## caller FAILS THE INSTALL on 1 rather than running anyway, because "running
## anyway" is a DepotDownloader that asks for a password on a machine with no
## keyboard, writes nothing to say so, and hangs until its stdin runs out.
seed_login_token() {
    local account="$1" steamid="$2"
    local token_file="$SECRETS/$TOKEN_PREFIX$steamid$TOKEN_SUFFIX"
    local dirs="" dir count=0

    SEED_REASON=""

    if [ ! -f "$token_file" ] || [ ! -r "$token_file" ]; then
        SEED_REASON="sign in again"
        err "no readable refresh token at $token_file"
        return 1
    fi

    dirs="$(dd_store_dirs)"
    if [ -z "$dirs" ]; then
        dd_materialize_store
        dirs="$(dd_store_dirs)"
    fi
    if [ -z "$dirs" ]; then
        SEED_REASON="cannot write"
        err "DepotDownloader has no isolated storage under $HOME and would not create one"
        err "there is nowhere to leave the token, and the download would ask for a password instead"
        return 1
    fi

    # EVERY MATCH IS SEEDED, not just one. There should be exactly one -- the
    # binary's path is frozen, so its store directory is too -- and if there is
    # more than one we cannot tell from out here which the next run will pick.
    # They are all root-owned 0600 files under root's home, so writing all of
    # them costs nothing and guessing wrong costs the feature.
    while IFS= read -r dir || [ -n "$dir" ]; do
        [ -n "$dir" ] || continue
        # The token goes down the pipe, never into argv. printf for the account
        # name, cat for the token: steamd stores it with NO trailing newline,
        # deliberately, so the newline python splits on is added here.
        if ! { printf '%s\n' "$account"; cat -- "$token_file"; printf '\n'; } \
            | python3 -c "$SEED_PY" "$dir/account.config"; then
            SEED_REASON="cannot write"
            err "could not write $dir/account.config"
            return 1
        fi
        count=$(( count + 1 ))
    done <<< "$dirs"

    if [ "$count" -eq 0 ]; then
        SEED_REASON="cannot write"
        err "found no place to seed the token, which should be impossible here"
        return 1
    fi
    # WHETHER, never the token, and not the account name either -- the journal
    # is readable by more than this service.
    info "seeded the stored sign-in into $count DepotDownloader credential store(s)"
    return 0
}


## Learn the depot ids, manifest ids and total size for an app.
##
## `-manifest-only` writes one human-readable `manifest_<depot>_<manifest>.txt`
## per depot it would download, and the FILENAME is the part that matters: it
## carries both ids, which is what trap 1 needs for the InstalledDepots block
## and what nothing else on this machine can tell us. The file's CONTENT gives
## `Total bytes on disk`, which is what makes BytesToDownload a real number
## rather than an estimate -- and therefore what makes the rail's percentage
## mean something before a single byte has arrived.
##
## THE COST IS A SECOND SET OF MANIFEST QUERIES, and manifest queries are what
## `RateLimitExceeded` is usually about. It is paid once per install and its
## output is cached under /var, so a resumed install after a reboot does not pay
## it again. The alternative -- parsing the ids out of the download run's own
## stdout -- was rejected because that output's shape is a moving target across
## DepotDownloader versions while these filenames are the documented interface.
##
## WRITES its `<depotid>TAB<manifestid>TAB<size>` rows into the file named by
## its fourth argument, and returns 0 or 1. It does NOT print them, and that is
## a bug fix rather than a preference: a function whose output is collected with
## `depots="$(probe_manifests …)"` runs in a COMMAND SUBSTITUTION SUBSHELL, so
## every global it sets -- here, the classified failure reason -- is discarded
## when that subshell exits. The symptom was a rate-limited manifest query
## reported to the caller as a generic download failure, which then started a
## download that could only be rate limited too. Same family as the pipeline
## trap in read_percent: if the caller needs state afterwards, the callee must
## not be a subshell.
##
## An empty result file after a successful run is a real answer (an app with no
## depots for this platform), not a failure.
probe_manifests() {
    local appid="$1" account="$2" os="$3" outfile="$4"
    local scratch log rc file base rest depot manifest size line out=""

    PROBE_REASON=""
    : > "$outfile" 2>/dev/null || return 1
    scratch="$(work_dir "$appid")/manifests"
    log="$(work_dir "$appid")/manifest-only.log"
    rm -rf "$scratch" 2>/dev/null || true
    install -d -m 0700 "$scratch" 2>/dev/null || return 1
    : > "$(work_dir "$appid")/stdin.empty"

    # Run with the scratch as the working directory AS WELL as passing -dir.
    # Which of the two a given DepotDownloader writes the listings relative to
    # is a detail that has changed before; making both answers the same
    # directory means this never has to care.
    rc=0
    ( cd "$scratch" && "$DEPOTDOWNLOADER" \
        -app "$appid" -dir "$scratch" -os "$os" -osarch 64 -manifest-only \
        -username "$account" -remember-password \
        < "$(work_dir "$appid")/stdin.empty" > "$log" 2>&1 ) || rc=$?

    if [ "$rc" -ne 0 ]; then
        PROBE_REASON="$(classify_exit "$rc" "$log")"
        return 1
    fi

    for file in "$scratch"/manifest_*_*.txt; do
        [ -f "$file" ] || continue
        base="${file##*/}"
        base="${base%.txt}"
        rest="${base#manifest_}"
        depot="${rest%%_*}"
        manifest="${rest#*_}"
        case "$depot" in ''|*[!0-9]*) continue ;; esac
        case "$manifest" in ''|*[!0-9]*) continue ;; esac

        size=0
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                *"bytes on disk"*)
                    size="${line##*:}"
                    size="${size//[!0-9]/}"
                    [ -n "$size" ] || size=0
                    break
                    ;;
            esac
        done < "$file"

        out="$out$depot	$manifest	$size
"
    done

    printf '%s' "$out" > "$outfile" 2>/dev/null || return 1
    return 0
}


## Turn an exit status and a log into a short reason a person can act on.
##
## The reasons are the contract's vocabulary where one fits (`sign in again`,
## `no space`, `not owned`) because the shell already draws those words. Prints
## the reason on stdout; the caller decides what to do with it.
classify_exit() {
    local rc="$1" log="$2"

    if [ -f "$log" ]; then
        if grep -qi 'RateLimitExceeded' "$log" 2>/dev/null; then
            printf 'rate limited'
            return 0
        fi
        if grep -qiE 'password|STEAM GUARD|two-factor|Enter the auth code' "$log" 2>/dev/null; then
            # A prompt reached a process whose stdin is an empty file, so there
            # was never going to be an answer. The stored token is the thing
            # that failed, and no retry fixes it.
            printf 'sign in again'
            return 0
        fi
        if grep -qiE 'no space left|not enough space|disk full' "$log" 2>/dev/null; then
            printf 'no space'
            return 0
        fi
        if grep -qiE 'not have license|no license|AccessDenied|Invalid App ID' "$log" 2>/dev/null; then
            printf 'not owned'
            return 0
        fi
    fi

    case "$rc" in
        0) printf 'ok' ;;
        1) printf 'download failed' ;;
        # Anything else is the unhandled-exception path, which on this tool is
        # nearly always an auth path that could not complete.
        *) printf 'sign in again' ;;
    esac
}


# ---------------------------------------------------------------------------
# The install
# ---------------------------------------------------------------------------

# State carried across polls for the one download that is running. Bash has no
# structs and this is one download at a time by design -- two concurrent ones on
# a single USB stick make both slower and the progress numbers meaningless -- so
# a handful of globals is the honest shape rather than an array of records.
DL_PID=""
DL_APPID=""
DL_NAME=""
DL_INSTALLDIR=""
DL_LOG=""
DL_TOTAL=0
DL_DEPOTS=""
DL_OWNER=""
DL_LAST_PUBLISH=0
DL_LAST_PERCENT=0

# When an install may next be started. Set by the rate-limit backoff; compared
# against the clock at the top of start_next().
RATE_LIMIT_UNTIL=0
RATE_LIMIT_BACKOFF="$RATE_LIMIT_BACKOFF_START"


## Everything that has to happen before a byte can be fetched, then the fetch
## itself, backgrounded.
##
## SYNCHRONOUS UP TO THE `&`, and that is a real cost worth naming: the manifest
## probe is a network round trip and this loop answers nothing while it runs, so
## a cancel pressed in that window waits. It is bounded by the probe's own
## timeout and it is the price of not writing a second concurrency mechanism for
## a step that happens once per install.
start_install() {
    local appid="$1"
    local account_row account owner os installdir name target avail depots buildid

    DL_APPID=""
    ACTIVE_APPID="$appid"

    # TWO FAILURES, NOT ONE, and telling them apart is the whole of defect 3.
    # An empty steamid means there is no token under $SECRETS at all: nobody
    # has signed in, and `no token` is the contract's word for it. An empty
    # ACCOUNT NAME with a steamid present means the opposite -- the sign-in
    # worked and its best-effort persona sidecar did not -- which used to be
    # reported as the same thing and sent people back to a QR code that was
    # never the problem.
    account_row="$(active_account)"
    account="$(tsv_field "$account_row" 1)"
    owner="$(tsv_field "$account_row" 2)"
    if [ -z "$owner" ]; then
        err "no sign-in token under $SECRETS; cannot download $appid"
        item_set "$appid" "$(game_name "$appid")" failed 0 "" "no token"
        ACTIVE_APPID=""
        publish_downloads
        return 0
    fi
    if [ -z "$account" ]; then
        err "a token for $owner exists but $SECRETS/$PERSONA_PREFIX$owner does not"
        err "DepotDownloader needs the ACCOUNT NAME for -username and nothing else here knows it"
        err "steamd writes that sidecar beside the token best-effort; a fresh scan rewrites it"
        item_set "$appid" "$(game_name "$appid")" failed 0 "" "sign in again"
        ACTIVE_APPID=""
        publish_downloads
        return 0
    fi

    if [ ! -x "$DEPOTDOWNLOADER" ]; then
        # The path is frozen and asserted at build time, so this is a broken
        # image rather than a configuration mistake -- said as an error, with
        # the path in it, because that is the whole diagnosis.
        err "$DEPOTDOWNLOADER is missing or not executable; no download is possible"
        item_set "$appid" "$(game_name "$appid")" failed 0 "" "cannot write"
        ACTIVE_APPID=""
        publish_downloads
        return 0
    fi

    ensure_library || {
        item_set "$appid" "$(game_name "$appid")" failed 0 "" "cannot write"
        ACTIVE_APPID=""
        publish_downloads
        return 0
    }

    # THE SIDECAR IS WRITTEN HERE, one line before the three things that read
    # it. Without it every value below falls back: a guessed installdir, a
    # Windows assumption, and a manifest carrying `buildid 0` that makes Valve's
    # client re-download the game we are about to spend hours fetching.
    refresh_appinfo "$appid"

    name="$(game_name "$appid")"
    installdir="$(install_dir_name "$appid")"
    os="$(target_os "$appid")"
    target="$COMMON/$installdir"

    if [ -z "$(appinfo_get "$appid" installdir)" ]; then
        warn "no appinfo cache for $appid: installing into '$installdir' guessed from the name"
        warn "if that is not Valve's installdir the client will re-download the game beside ours"
    fi

    install -d -m 0700 "$(work_dir "$appid")" 2>/dev/null || true

    # One level deeper than ensure_library, and its argument applies unchanged:
    # `install -d` would create parents and would take an existing
    # symlink-to-directory as success, so a symlink at `common/<installdir>`
    # would be a root download and a root chown aimed wherever it pointed.
    if [ -L "$target" ]; then
        err "$target is a symbolic link; refusing to download into it"
        item_set "$appid" "$name" failed 0 "" "cannot write"
        ACTIVE_APPID=""
        publish_downloads
        return 0
    fi
    if [ ! -d "$target" ]; then
        if ! mkdir -m 0755 -- "$target" 2>/dev/null; then
            err "cannot create $target"
            item_set "$appid" "$name" failed 0 "" "cannot write"
            ACTIVE_APPID=""
            publish_downloads
            return 0
        fi
        chown -h "$PLAYER:$PLAYER" "$target" 2>/dev/null || true
    fi

    item_set "$appid" "$name" downloading 0 "Looking up the game" ""
    publish_downloads

    # THE TOKEN GOES IN BEFORE ANYTHING ASKS STEAM FOR ANYTHING. Both the
    # manifest probe below and the download itself are invoked with
    # `-username … -remember-password`, which reads a credential store this
    # process is the only thing that ever writes. Without this call both of
    # them reach a password prompt on a machine with no keyboard, and the
    # person is told to sign in again on the strength of a sign-in that worked.
    if ! seed_login_token "$account" "$owner"; then
        err "cannot hand DepotDownloader the stored sign-in; not starting $appid"
        item_set "$appid" "$name" failed 0 "" "${SEED_REASON:-sign in again}"
        ACTIVE_APPID=""
        publish_downloads
        return 0
    fi

    # The manifest probe, cached across restarts. Its output is what trap 1
    # needs; without it the install still runs and the manifest is written
    # without InstalledDepots, which means Valve's client re-downloads the game.
    # Loud, and not fatal: a game in the wrong place still plays through tier 2
    # or 3, and refusing to download because a listing failed would be worse.
    depots=""
    local depot_file="$(work_dir "$appid")/depots.tsv"
    if probe_manifests "$appid" "$account" "$os" "$depot_file"; then
        # Read back rather than captured from the call, so probe_manifests is
        # not a subshell and its PROBE_REASON survives -- see its header.
        depots="$(cat "$depot_file" 2>/dev/null || true)"
    else
        local reason="${PROBE_REASON:-download failed}"
        if [ "$reason" = "rate limited" ]; then
            # BACK TO THE FRONT OF THE QUEUE, not failed. Being rate limited is
            # a statement about this IP in the next few minutes, not about this
            # game or this account, and turning it into a failed card would make
            # somebody press Install again -- which is the one action that makes
            # it worse.
            warn "rate limited while listing manifests for $appid; waiting ${RATE_LIMIT_BACKOFF}s"
            RATE_LIMIT_UNTIL=$(( $(date +%s) + RATE_LIMIT_BACKOFF ))
            RATE_LIMIT_BACKOFF=$(( RATE_LIMIT_BACKOFF * 2 ))
            if [ "$RATE_LIMIT_BACKOFF" -gt "$RATE_LIMIT_BACKOFF_MAX" ]; then
                RATE_LIMIT_BACKOFF="$RATE_LIMIT_BACKOFF_MAX"
            fi
            item_set "$appid" "$name" queued 0 "Waiting -- Steam is rate limiting this machine" ""
            PENDING=("$appid" "${PENDING[@]}")
            ACTIVE_APPID=""
            publish_downloads
            return 0
        fi
        if [ "$reason" = "sign in again" ] || [ "$reason" = "not owned" ]; then
            err "cannot list manifests for $appid: $reason"
            item_set "$appid" "$name" failed 0 "" "$reason"
            ACTIVE_APPID=""
            publish_downloads
            return 0
        fi
        warn "could not list manifests for $appid ($reason)"
        warn "the download will run, but the manifest will carry no InstalledDepots"
        warn "and Valve's client will decide the game needs downloading again"
        depots=""
    fi

    DL_TOTAL=0
    if [ -n "$depots" ]; then
        local line size
        while IFS= read -r line || [ -n "$line" ]; do
            [ -n "$line" ] || continue
            size="$(tsv_field "$line" 3)"
            case "$size" in ''|*[!0-9]*) size=0 ;; esac
            DL_TOTAL=$(( DL_TOTAL + size ))
        done <<< "$depots"
    fi

    avail="$(free_mb "$target")"
    if [ -n "$avail" ] && [ "$DL_TOTAL" -gt 0 ]; then
        local need_mb=$(( DL_TOTAL / 1048576 ))
        if [ "$avail" -lt $(( need_mb + 500 )) ]; then
            err "$name needs about ${need_mb} MiB and only ${avail} MiB are free"
            item_set "$appid" "$name" failed 0 "" "no space"
            ACTIVE_APPID=""
            publish_downloads
            return 0
        fi
    fi

    # The in-progress manifest, written BEFORE the download starts. StateFlags
    # without bit 4 is what marwanos-appscan renders as a pending card with a
    # percentage on the rail; writing it now rather than at the first progress
    # line is what puts a card on screen within one poll of somebody pressing
    # Install, which is the difference between "working" and "did that do
    # anything".
    #
    # 1026 is UpdateRequired(2) | UpdateStarted(1024): what Valve's own client
    # writes at exactly this moment. Bit 8 (DataEncrypted) is not set and never
    # will be -- the payload is plaintext and a client told otherwise redoes the
    # whole download.
    buildid="$(appinfo_get "$appid" buildid)"
    case "$buildid" in ''|*[!0-9]*) buildid=0 ;; esac
    write_manifest "$appid" "$name" "$installdir" 1026 "$buildid" \
        0 "$DL_TOTAL" 0 "${owner:-0}" "$depots" || true

    info "downloading $name ($appid) as $os into $target"
    : > "$(work_dir "$appid")/stdin.empty"
    DL_LOG="$(work_dir "$appid")/download.log"
    : > "$DL_LOG"

    # BACKGROUNDED so the loop stays answerable: a cancel has to be able to
    # arrive during the hours this runs, and the loop that would notice it is
    # this one. The pid is DepotDownloader's own, not a wrapper's, so a cancel
    # signals the process actually holding the sockets and the files.
    "$DEPOTDOWNLOADER" \
        -app "$appid" -dir "$target" -os "$os" -osarch 64 -validate \
        -username "$account" -remember-password \
        < "$(work_dir "$appid")/stdin.empty" >> "$DL_LOG" 2>&1 &
    DL_PID=$!

    DL_APPID="$appid"
    DL_NAME="$name"
    DL_INSTALLDIR="$installdir"
    DL_DEPOTS="$depots"
    DL_OWNER="${owner:-0}"
    DL_LAST_PUBLISH=0
    DL_LAST_PERCENT=0

    item_set "$appid" "$name" downloading 0 "$(progress_detail 0)" ""
    publish_downloads
}


## "3.1 GB of 7.4 GB", or a bare percentage when the total is unknown.
##
## The total is unknown exactly when the manifest probe failed, and saying "42%"
## with no sizes is more honest there than inventing a denominator.
progress_detail() {
    local percent="$1" done_bytes
    if [ "$DL_TOTAL" -gt 0 ]; then
        done_bytes=$(( DL_TOTAL / 100 * percent ))
        printf '%s of %s' "$(human_bytes "$done_bytes")" "$(human_bytes "$DL_TOTAL")"
    else
        printf '%s%% downloaded' "$percent"
    fi
}


## The last cumulative percentage DepotDownloader printed, as an integer.
##
## ONE LINE PER COMPLETED FILE, cumulative and monotonic, `^\s*(\d{2,3}\.\d{2})%
## (.+)$`, no ANSI on Linux and none when stdout is redirected. Because it is
## monotonic the LAST matching line is the answer, so only the tail of the log
## is read -- a game of many small files writes tens of thousands of these
## lines, and re-reading all of them every ten seconds would take real bandwidth
## from the download.
read_percent() {
    local log="$1" line last="" whole
    [ -f "$log" ] || { printf '0'; return 0; }
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            *%*) ;;
            *) continue ;;
        esac
        if [[ "$line" =~ ^[[:space:]]*([0-9]{2,3})\.[0-9]{2}%[[:space:]] ]]; then
            last="${BASH_REMATCH[1]}"
        fi
    done < <(tail -c 65536 "$log" 2>/dev/null)
    [ -n "$last" ] || { printf '0'; return 0; }
    # 10# so a two-digit reading like `08` is decimal eight rather than an
    # invalid octal literal, which under `set -e` would take the service down.
    whole=$(( 10#$last ))
    if [ "$whole" -gt 100 ]; then
        whole=100
    fi
    printf '%s' "$whole"
}


## Called once per poll while a download is running.
poll_download() {
    local percent now rc=0 done_bytes buildid

    # `kill -0` on a child bash has already reaped answers ESRCH, which is what
    # ends this branch. There is a window between the child exiting and bash
    # noticing where this still succeeds; the cost is that the reap happens one
    # poll later, which is a second.
    if kill -0 "$DL_PID" 2>/dev/null; then
        now="$(date +%s)"
        if [ $(( now - DL_LAST_PUBLISH )) -ge "$PUBLISH_INTERVAL" ]; then
            DL_LAST_PUBLISH="$now"
            percent="$(read_percent "$DL_LOG")"
            # Monotonic on our side too. A truncated tail read can produce a
            # smaller number than the last one, and a percentage that goes
            # backwards on the TV reads as a download that has gone wrong.
            if [ "$percent" -lt "$DL_LAST_PERCENT" ]; then
                percent="$DL_LAST_PERCENT"
            fi
            DL_LAST_PERCENT="$percent"

            item_set "$DL_APPID" "$DL_NAME" downloading "$percent" \
                "$(progress_detail "$percent")" ""
            publish_downloads

            # And the same numbers into the appmanifest, which is what puts the
            # percentage on the HOME RAIL -- appscan turns StateFlags-without-4
            # plus these two counters into a pending card, with no code path
            # that knows this repo is the thing doing the downloading.
            done_bytes=0
            if [ "$DL_TOTAL" -gt 0 ]; then
                done_bytes=$(( DL_TOTAL / 100 * percent ))
            fi
            buildid="$(appinfo_get "$DL_APPID" buildid)"
            case "$buildid" in ''|*[!0-9]*) buildid=0 ;; esac
            write_manifest "$DL_APPID" "$DL_NAME" "$DL_INSTALLDIR" 1026 \
                "$buildid" "$done_bytes" "$DL_TOTAL" "$done_bytes" \
                "$DL_OWNER" "$DL_DEPOTS" || true
        fi
        return 0
    fi

    # Gone. `wait` hands back the status bash recorded when it reaped the child;
    # guarded because a nonzero status from `wait` under `set -e` would take the
    # whole service down at the exact moment it had something to report.
    if wait "$DL_PID"; then rc=0; else rc=$?; fi
    finish_download "$rc"
}


## Everything between "DepotDownloader exited 0" and "the client believes the
## game is installed".
##
## THIS IS WHERE THE THREE TRAPS ARE PAID. The download itself is the easy half.
commit_install() {
    local appid="$DL_APPID" name="$DL_NAME" installdir="$DL_INSTALLDIR"
    local target="$COMMON/$DL_INSTALLDIR" buildid size_on_disk

    item_set "$appid" "$name" installing 100 "Finishing up" ""
    publish_downloads

    # THE DOWNLOADER RAN AS ROOT AND THE PLAYER HAS TO OWN THE RESULT. Done
    # before the client is asked to come back, so the first thing it sees is a
    # library it can actually read. Recursive over one game rather than the
    # whole library: a `chown -R` over every installed game after every install
    # would walk hundreds of thousands of files on a USB stick for no reason.
    #
    # `-h` because games ship symlinks and a recursive chown that DEREFERENCES
    # one walks straight out of the directory it was pointed at. The archive
    # here was written by root from a depot, so this is defence against the
    # payload rather than against the session user -- but it is the same
    # mistake as the one this file's staging section exists to stop, and the
    # flag costs nothing.
    chown -R -h "$PLAYER:$PLAYER" "$target" 2>/dev/null \
        || warn "cannot chown $target to $PLAYER -- the game may not be able to save"

    # `|| true` for free_mb's reason: a `du` that failed must cost a number, not
    # the commit. The manifest's own total stands in, which is the figure the
    # depot listing gave and is right to within whatever the sidecar weighs.
    size_on_disk="$(du -sb "$target" 2>/dev/null | awk '{print $1}' || true)"
    case "$size_on_disk" in ''|*[!0-9]*) size_on_disk="$DL_TOTAL" ;; esac

    # TRAP 1. `StateFlags 4` on its own does NOT stop the client re-downloading
    # what we just fetched -- it compares this manifest's `buildid` against the
    # branch's current buildid and ORs in UpdateRequired on a mismatch. So the
    # three things that have to be true together are: the REAL buildid,
    # `TargetBuildID 0`, and an `InstalledDepots.<depotid>.manifest` equal to the
    # manifest id actually pulled. SteamRE issue #274 is exactly this failing.
    #
    # A ZERO BUILDID IS A KNOWN, NAMED DEGRADE rather than a silent one. It
    # happens when steamd has not written an appinfo cache for this app, and its
    # consequence is precise: the client will consider the game out of date and
    # will re-download it the first time it is launched through tier 1. The game
    # still runs, the disk still fills twice. Said at warning level with the fix
    # in it, because a person reading the journal after a mysterious second
    # download deserves to find this line.
    buildid="$(appinfo_get "$appid" buildid)"
    case "$buildid" in ''|*[!0-9]*) buildid=0 ;; esac
    if [ "$buildid" = "0" ]; then
        warn "no buildid known for $appid (no $APPINFO_DIR/$appid.tsv)"
        warn "the client will treat this install as out of date and re-download it on first launch"
    fi
    if [ -z "$DL_DEPOTS" ]; then
        warn "no depot/manifest ids for $appid: InstalledDepots will be empty"
        warn "the client cannot match this install to what it thinks the game is"
    fi

    # TRAP 3. The client flushes its in-memory app state over these files when
    # it exits, so it is stood down for the write and released after -- through
    # the session's own wish file, never with `flatpak kill`, so the supervisor
    # knows the exit was asked for and does not count it against its crash guard.
    pause_client
    register_library
    # StateFlags 4 is StateFullyInstalled and NOTHING ELSE. Bit 8 is
    # DataEncrypted and is never set here: the payload DepotDownloader wrote is
    # plaintext, and a client told it is encrypted starts again from zero.
    write_manifest "$appid" "$name" "$installdir" 4 "$buildid" \
        "$size_on_disk" "$size_on_disk" "$size_on_disk" "$DL_OWNER" "$DL_DEPOTS" \
        || warn "could not write the final manifest for $appid"
    resume_client

    info "$name ($appid) is installed in $target ($(human_bytes "$size_on_disk"))"
    item_set "$appid" "$name" done 100 "$(human_bytes "$size_on_disk")" ""
}


finish_download() {
    local rc="$1" reason

    reason="$(classify_exit "$rc" "$DL_LOG")"

    if [ "$rc" -eq 0 ]; then
        # `Total downloaded: 0 bytes` means already up to date, and it is a
        # SUCCESS: it is what a re-install of something already present looks
        # like, and what a resumed install that had nothing left to do looks
        # like. Nothing special is done with it beyond saying so.
        if grep -q 'Total downloaded: 0 bytes' "$DL_LOG" 2>/dev/null; then
            info "$DL_NAME ($DL_APPID) was already up to date"
        fi
        # The rate-limit penalty is forgiven by a clean run, so a single bad
        # afternoon does not leave an hour-long delay in place for the rest of
        # the boot.
        RATE_LIMIT_BACKOFF="$RATE_LIMIT_BACKOFF_START"
        commit_install
    else
        err "DepotDownloader exited $rc for $DL_APPID: $reason"
        if [ "$reason" = "rate limited" ]; then
            RATE_LIMIT_UNTIL=$(( $(date +%s) + RATE_LIMIT_BACKOFF ))
            RATE_LIMIT_BACKOFF=$(( RATE_LIMIT_BACKOFF * 2 ))
            if [ "$RATE_LIMIT_BACKOFF" -gt "$RATE_LIMIT_BACKOFF_MAX" ]; then
                RATE_LIMIT_BACKOFF="$RATE_LIMIT_BACKOFF_MAX"
            fi
        fi
        # THE PARTIAL FILES ARE LEFT ON DISK, deliberately. DepotDownloader's
        # .DepotDownloader sidecar plus -validate make the next attempt resume
        # rather than restart, and throwing away six hours of a domestic
        # connection because a router rebooted would be the appliance punishing
        # somebody for its own bad luck. `cancel` is the verb that removes them,
        # and it exists precisely so this one does not have to guess.
        item_set "$DL_APPID" "$DL_NAME" failed "$DL_LAST_PERCENT" \
            "$(progress_detail "$DL_LAST_PERCENT")" "$reason"
    fi

    DL_PID=""
    DL_APPID=""
    ACTIVE_APPID=""
    publish_downloads
}


# ---------------------------------------------------------------------------
# cancel and uninstall
# ---------------------------------------------------------------------------

## Is this game in OUR library -- one this repo downloaded?
##
## The manifest is the test because start_install writes it BEFORE the first
## byte arrives, so it is present for a download in flight, a finished install
## and an abandoned partial alike. Not a symlink: the file lives in a directory
## `player` owns, and one pointing at somebody else's manifest would answer
## this question about the wrong game.
we_installed() {
    # Second `local` line: see appinfo_get() and write_wish() for why a path
    # built on the same line reads the CALLER's appid.
    local appid="$1"
    local file="$STEAMAPPS/appmanifest_$appid.acf"
    if [ -L "$file" ]; then return 1; fi
    [ -f "$file" ]
}


## Does Valve's own client have this game in ITS library?
client_installed() {
    local appid="$1"
    local file="$CLIENT_STEAMAPPS/appmanifest_$appid.acf"
    if [ -L "$file" ]; then return 1; fi
    [ -f "$file" ]
}


## The directory under steamapps/common a game's files are ACTUALLY in.
##
## THE MANIFEST WINS OVER THE GUESS, and both verbs need that rather than one
## of them. install_dir_name() answers from appinfo or, failing that, from the
## game's NAME -- and a name-derived guess is exactly what a cancel must not
## use, because the install being cancelled may have landed under a name the
## guess no longer reproduces: the appinfo sidecar is refreshed at the top of
## every install, so a cache that arrived (or changed) between the install and
## the cancel moves the answer. uninstall preferred the manifest and cancel did
## not, and the cost of that difference was a cancelled retry orphaning its
## partial files under the old name -- several gigabytes nothing would ever
## look at again, on the one disk this appliance has.
installdir_for() {
    local appid="$1" want=""
    local file="$STEAMAPPS/appmanifest_$appid.acf"

    if [ ! -L "$file" ] && [ -f "$file" ]; then
        want="$(acf_value "$file" installdir)"
    fi
    [ -n "$want" ] || want="$(install_dir_name "$appid")"
    printf '%s' "$want"
}


## Stop a download and remove what it had written.
##
## A QUEUED APP IS ALSO CANCELLED, which is the case somebody actually hits:
## press Install on four games, change your mind about the third. It never
## started, there is nothing to kill and nothing to delete, and it simply leaves
## the queue.
do_cancel() {
    local appid="$1" waited=0 name installdir

    # Out of the pending list whatever else is true. WHETHER IT WAS THERE is
    # remembered, because it decides whether the guard below applies: dropping
    # a queued install is always ours to do, even for a game the client also
    # has a copy of.
    local kept=() pending was_pending=""
    for pending in "${PENDING[@]}"; do
        [ -n "$pending" ] || continue
        if [ "$pending" = "$appid" ]; then
            was_pending=1
            continue
        fi
        kept+=("$pending")
    done
    PENDING=("${kept[@]}")

    if [ "$DL_APPID" = "$appid" ] && [ -n "$DL_PID" ]; then
        info "cancelling the download of $DL_NAME ($appid)"
        kill -TERM "$DL_PID" 2>/dev/null || true
        while [ "$waited" -lt 10 ] && kill -0 "$DL_PID" 2>/dev/null; do
            sleep 1
            waited=$(( waited + 1 ))
        done
        # A .NET process that ignored TERM is holding open files in the
        # directory that is about to be deleted; KILL is the only thing left,
        # and the download is being thrown away regardless.
        kill -KILL "$DL_PID" 2>/dev/null || true
        wait "$DL_PID" 2>/dev/null || true
        installdir="$DL_INSTALLDIR"
        name="$DL_NAME"
        DL_PID=""
        DL_APPID=""
        ACTIVE_APPID=""
    else
        name="$(game_name "$appid")"
        if [ -z "$was_pending" ] && ! we_installed "$appid" && client_installed "$appid"; then
            refuse_client_game "$appid" "$name" cancel
            return 0
        fi
        # The MANIFEST's installdir, not the guess -- see installdir_for().
        installdir="$(installdir_for "$appid")"
    fi

    remove_game "$appid" "$installdir"
    item_drop "$appid"
    publish_downloads
    info "cancelled $name ($appid)"
}


## Say no to a delete request for a game that is not ours, and say it where the
## person can see it.
##
## THE ONLY CHANNEL THIS FILE HAS IS THE DOWNLOADS LIST. It must never write
## /run/marwanos/steam.state -- the contract gives that file exactly one writer
## and it is steamd -- so a refusal is published as a failed item, which is how
## every other thing that cannot be done here is already reported. A card that
## says why is strictly better than the previous behaviour, which was to accept
## the request, drop the card, delete nothing, and let the game reappear on the
## next scan: a button that lies, with nothing in the journal either.
refuse_client_game() {
    local appid="$1" name="$2" verb="$3"

    err "$verb refused for $appid: it is installed in Valve's client's own library"
    err "deleting files out from under the client's bookkeeping makes it repair the game,"
    err "which is the update loop ADR 0010's third trap describes, entered from the other side"
    item_set "$appid" "$name" failed 0 "" "installed by Steam -- remove it in Steam"
    publish_downloads
    return 0
}


## Delete an installed game.
##
## THE MANIFEST GOES LAST AND UNDER A PAUSE, for trap 3's reason run backwards:
## a running client with this app in memory will happily write the appmanifest
## back out after we have deleted it, leaving a manifest describing a directory
## that no longer exists -- which is a rail card for a game whose files are
## gone, and a launch that fails with no explanation.
##
## AND IT ONLY EVER TOUCHES OUR LIBRARY, which is why it now refuses rather
## than pretending. marwanos-appscan walks BOTH libraries and the shelf marks a
## game installed from either, so Uninstall is offered on games Valve's client
## fetched into its own steamapps -- and for those this function used to accept
## the request and remove nothing at all.
do_uninstall() {
    local appid="$1" installdir name

    if [ "$DL_APPID" = "$appid" ]; then
        # Uninstalling something that is being downloaded is a cancel with a
        # different word on the button; treat it as one rather than deleting the
        # directory out from under a live process.
        do_cancel "$appid"
        return 0
    fi

    name="$(game_name "$appid")"
    if ! we_installed "$appid" && client_installed "$appid"; then
        refuse_client_game "$appid" "$name" uninstall
        return 0
    fi
    installdir="$(installdir_for "$appid")"

    info "uninstalling $name ($appid)"
    pause_client
    remove_game "$appid" "$installdir"
    resume_client
    item_drop "$appid"
    publish_downloads
}


## The file removal both verbs share. Never given a bare appid to interpolate
## into a path without validation -- see the guard, which is the difference
## between deleting one game and deleting the library.
remove_game() {
    local appid="$1" installdir="$2"

    valid_appid "$appid" || return 0

    # A PATH SEPARATOR IN installdir IS A DELETE-ANYWHERE PRIMITIVE, and this
    # is the guard for it. The value reaches here from an .acf file sitting in
    # a directory `player` owns -- a file this repo wrote, and one the session
    # user may rewrite afterwards -- so `../../../../etc` is a thing it can
    # say, and `$COMMON/../../../../etc` is a real directory that the `rm -rf`
    # below would walk. install_dir_name() strips separators out of appinfo's
    # answer; this strips them out of the manifest's, which is the answer
    # nobody in this repo controls at the moment it is read.
    case "$installdir" in
        ''|.|..|*/*) installdir="" ;;
    esac

    if [ -n "$installdir" ] && [ -d "$COMMON/$installdir" ]; then
        rm -rf -- "$COMMON/$installdir" 2>/dev/null \
            || warn "cannot remove $COMMON/$installdir"
    fi
    rm -f -- "$STEAMAPPS/appmanifest_$appid.acf" 2>/dev/null || true
    # Proton's prefix. Client-created, but it is this game's state and leaving
    # it behind means a reinstall inherits a prefix from a version that may no
    # longer exist.
    if [ -d "$COMPATDATA/$appid" ]; then
        rm -rf -- "$COMPATDATA/$appid" 2>/dev/null || true
    fi
    rm -rf -- "$(work_dir "$appid")" 2>/dev/null || true
    return 0
}


## One top-level value out of a KeyValues (.acf) file.
##
## The same pure-bash line walk marwanos-appscan uses, and deliberately so:
## these two files read each other's manifests, and two different parsers would
## agree right up until the first title that broke one of them. First match
## wins; the value is what sits between the next pair of quotes.
acf_value() {
    local file="$1" key="$2" line
    [ -r "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            *"\"$key\""*)
                line="${line#*\""$key"\"}"
                case "$line" in
                    *\"*\"*)
                        line="${line#*\"}"
                        printf '%s' "${line%%\"*}"
                        return 0
                        ;;
                esac
                ;;
        esac
    done < "$file"
    return 0
}


# ---------------------------------------------------------------------------
# The queue
# ---------------------------------------------------------------------------

PENDING=()


## Take everything steamd has appended and turn it into work.
##
## RENAMED ASIDE BEFORE BEING READ, and here the reason is not the security one
## the shell's request file has -- both ends of this queue are root, and the
## queue deliberately lives outside the directory the session user can write
## (see QUEUE). It is that the file is APPEND-ONLY and this reader would
## otherwise have to remember an offset across polls, which goes wrong the first
## time the file is truncated or recreated. Moving it means this reader owns
## everything that was in it and steamd's next `>>` creates a fresh one.
##
## The race that remains is a single append landing between the rename and the
## read; it lands in the renamed inode, which is the one being read, so the only
## way to lose a line is an append that started before the rename and completed
## after this reader hit EOF. That is microseconds wide, its cost is one request
## that has to be pressed again, and closing it properly needs a lock on both
## sides -- which is steamd's half of a change neither half can make alone.
drain_queue() {
    local line verb appid

    [ -f "$QUEUE" ] || return 0
    mv -f "$QUEUE" "$QUEUE_TAKEN" 2>/dev/null || return 0

    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        verb="$(tsv_field "$line" 1)"
        appid="$(tsv_field "$line" 2)"

        if ! valid_appid "$appid"; then
            # The line's CONTENT is not logged. Everything in this file came
            # from another process, and copying unexpected bytes into the
            # journal is how a log becomes an injection surface.
            warn "ignoring a queue line with no valid appid"
            continue
        fi

        case "$verb" in
            install)
                if [ "$DL_APPID" = "$appid" ]; then
                    info "$appid is already downloading"
                    continue
                fi
                local already="" pending
                for pending in "${PENDING[@]}"; do
                    if [ "$pending" = "$appid" ]; then
                        already=1
                    fi
                done
                if [ -n "$already" ]; then
                    continue
                fi
                PENDING+=("$appid")
                item_set "$appid" "$(game_name "$appid")" queued 0 "Waiting to start" ""
                publish_downloads
                ;;
            cancel)
                do_cancel "$appid"
                ;;
            uninstall)
                do_uninstall "$appid"
                ;;
            *)
                warn "ignoring a queue line with an unrecognised verb"
                ;;
        esac
    done < "$QUEUE_TAKEN"

    rm -f "$QUEUE_TAKEN" 2>/dev/null || true
    return 0
}


start_next() {
    local appid now

    [ "${#PENDING[@]}" -gt 0 ] || return 0

    now="$(date +%s)"
    if [ "$now" -lt "$RATE_LIMIT_UNTIL" ]; then
        return 0
    fi

    appid="${PENDING[0]}"
    PENDING=("${PENDING[@]:1}")
    start_install "$appid"
}


# ---------------------------------------------------------------------------
# Startup
# ---------------------------------------------------------------------------

## Set by probe_manifests when it fails; read by its caller. Declared here as
## well as assigned there because `set -u` makes an unset read fatal, and the
## caller's error path is exactly where that must not happen.
PROBE_REASON=""

install -d -m 0755 "$RUN_DIR" 2>/dev/null \
    || { err "cannot create $RUN_DIR -- no queue could ever be read"; exit 1; }
install -d -m 0755 "$VAR_DIR" 2>/dev/null || true
install -d -m 0755 "$APPINFO_DIR" 2>/dev/null || true
install -d -m 0700 "$WORK_DIR" 2>/dev/null || true

# 0700 AND ROOT-OWNED, which is the entire property the staging section buys.
# Anything left behind by a killed run is cleared: the writers open with
# O_EXCL, so a leftover at a name we are about to reuse would fail every write
# to that destination for the rest of the boot.
install -d -m 0700 "$STAGE_DIR" 2>/dev/null || true
rm -f -- "$STAGE_DIR"/* 2>/dev/null || true

# THE SAME-FILESYSTEM CLAIM, CHECKED AND SAID OUT LOUD. rename(2) answers EXDEV
# across a mount, so a staging directory on a different filesystem from the
# library would make every manifest write fail -- and it would fail in the one
# place where "the download worked but the client never saw it" is the symptom.
# /var/marwanos and /var/home are the same filesystem on an ostree system, so
# this normally says the first thing; a machine that mounts /var/home
# separately gets the O_EXCL fallback, which is still symlink-safe, and gets
# told so rather than finding out through a failed install.
#
# INFORMATIONAL ONLY: stage_for() asks the same question per write, against the
# real destination, so this cannot decide anything wrongly. It exists so the
# answer is in the journal from the first line rather than inferred from a
# failure hours later.
stage_dev="$(stat -c %d "$STAGE_DIR" 2>/dev/null || true)"
lib_dev="$(stat -c %d "$GAMES_PARENT" 2>/dev/null || stat -c %d /var/home 2>/dev/null || true)"
if [ -z "$stage_dev" ]; then
    warn "cannot create $STAGE_DIR; every temp file will be built in place under O_EXCL"
elif [ -z "$lib_dev" ]; then
    # Neither the library nor /var/home exists yet, which on this appliance
    # means something is wrong with /var rather than that the check failed.
    warn "cannot find the library's filesystem to compare $STAGE_DIR against"
elif [ "$stage_dev" = "$lib_dev" ]; then
    info "staging temp files in $STAGE_DIR, which is on the library's filesystem"
else
    warn "$STAGE_DIR is not on the library's filesystem ($stage_dev vs $lib_dev)"
    warn "temp files will be built in place under O_EXCL instead: still symlink-safe,"
    warn "but a squatted <name>.tmp can then fail an install rather than being ignored"
fi

# ASSERTED, AND NOW ALSO OURS TO WRITE. DepotDownloader's credential cache
# lives in .NET isolated storage, under a directory named from a hash of the
# executable's absolute path -- and isolated storage itself is rooted under
# $HOME. Both are therefore load-bearing paths whose CHANGE orphans every
# stored refresh token in silence, and the symptom is a machine that asks for a
# fresh QR scan for no visible reason.
#
# THIS COMMENT USED TO ARGUE AGAINST SETTING HOME, on the grounds that whoever
# writes the token into that storage has to agree with this process about where
# it is and a value invented here would be a second opinion. That argument has
# inverted: since seed_login_token() exists, THIS PROCESS is the thing that
# writes the token into that storage, so there is no second opinion to
# contradict -- there is only the requirement that the value be a directory
# this service owns and can write. So it is resolved, checked, and logged.
export HOME="${HOME:-/root}"
if [ ! -d "$HOME" ] || [ ! -w "$HOME" ] || [ "$(stat -c %u "$HOME" 2>/dev/null || echo 1)" != "0" ]; then
    warn "HOME=$HOME is not a root-owned writable directory; using /root instead"
    warn "the credential store lives under it, so this must be somewhere only root can reach"
    export HOME=/root
fi
info "DepotDownloader at $DEPOTDOWNLOADER, HOME=$HOME (both decide where the stored token lives)"
if [ ! -x "$DEPOTDOWNLOADER" ]; then
    err "$DEPOTDOWNLOADER is missing or not executable -- installs will fail until the image is fixed"
fi

# python3 IS A HARD DEPENDENCY OF THE DOWNLOAD PATH, not a nicety, and saying
# so at startup is cheaper than discovering it at the moment somebody presses
# Install. It is what writes DepotDownloader's credential store, and without
# that store every install reaches a password prompt on a machine with no
# keyboard. It arrives from the ublue base and the Containerfile's verify block
# already asserts it for protocodec's sake; this is the second thing that needs
# it and the assertion is worth repeating where the failure would land.
if ! command -v python3 >/dev/null 2>&1; then
    err "python3 is missing: the stored sign-in cannot be handed to DepotDownloader"
    err "every install will fail with 'sign in again' on a machine that is signed in"
fi

# THE FACT NOTHING ELSE IN THIS TREE CAN SUPPLY, said once at startup rather
# than only at the moment a download commits. steamd builds library.json from
# GetOwnedGames, which carries no buildid, no installdir and no per-launch
# oslist. Without those, every install commits with `buildid 0` and Valve's
# client decides the game is out of date and re-downloads it on first launch --
# trap 1, arrived at by absence rather than by error. The manifest is still
# written, the game still appears on the rail and still launches; the cost is
# the disk filling twice.
#
# The producer is $APPINFO_TOOL, which reads Valve's OWN binary appinfo cache
# off this disk -- so this directory being empty at startup is normal on a fresh
# machine and fills in as games are installed (see refresh_appinfo). What is NOT
# normal is the tool being absent, which is a broken image and is said as such.
if [ ! -x "$APPINFO_TOOL" ]; then
    err "$APPINFO_TOOL is missing: every install will commit with buildid 0"
    err "and the client will re-download each game on first launch -- see ADR 0010 trap 3"
elif [ -z "$(find "$APPINFO_DIR" -maxdepth 1 -name '*.tsv' -print -quit 2>/dev/null)" ]; then
    info "no appinfo sidecars under $APPINFO_DIR yet; each install writes its own first"
fi

# Published empty at startup so the shell finds a FILE rather than nothing. The
# contract's own warning applies: consumers load results at startup and render
# synchronously rather than waiting for a signal, so "no downloads" and "the
# service has not started" must not look the same.
publish_downloads

info "ready; watching $QUEUE"

while :; do
    drain_queue

    if [ -n "$DL_PID" ]; then
        poll_download
    else
        start_next
    fi

    sleep "$POLL"
done
