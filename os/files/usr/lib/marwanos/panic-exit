#!/usr/bin/python3
"""Hold Select+Start for two seconds and whatever is on the screen goes away.

WHY THIS EXISTS, and it is not a convenience. On 2026-08-13 the owner launched
Steam Big Picture on the appliance and could not get out of it. Every exit this
machine had was unavailable at once:

  * The shell's home button is JOY_BUTTON_GUIDE, and Steam Big Picture binds the
    Guide button for its own menu, so the shell never sees the press.
  * Steam's own Power -> Shut Down did nothing: Big Picture's power actions
    expect SteamOS's steamos-manager / steamos-session-select, which this image
    does not ship. The screen blanked and the menu came back.
  * There is no console login. `player` has /usr/sbin/nologin and no account in
    this image is given a password, so Ctrl+Alt+F2 offers a prompt nobody can
    satisfy.
  * sshd was not listening.

That left the physical power button as the only way out of an application. An
appliance where launching an app is a one-way door is not finished, and no
amount of menu work fixes it, because every menu above depends on the very
process that is refusing to yield.

SO THIS DOES NOT ASK ANY OF THEM. It is a root service that reads the evdev
nodes directly and answers to a chord that nothing else claims.

WHY A CHORD AND NOT THE GUIDE BUTTON. Guide is the button a person already
knows means "get me out", and it is the one the shell uses at the rail -- but
Steam takes it in Big Picture, and whether that can be disabled INSIDE gamepadui
is precisely the thing that could not be confirmed from any source. An escape
hatch that depends on the cooperation of the program you are escaping is not an
escape hatch. Select+Start is bound by nothing in Steam's default layout, and
the two-second hold is what keeps it away from the Select+Start a game uses.

WHY READING EVDEV WORKS EVEN WHILE STEAM HOLDS THE PAD, measured by others and
worth stating because the opposite was believed here for a while: Steam Input
does NOT take exclusive ownership. There is no EVIOCGRAB and no udev inhibit --
the physical node keeps delivering, and a DualSense reports every press twice,
once through the original device and once through Steam's virtual pad. So this
sees the chord no matter who else does. It also means the chord may reach the
game as well, which is why the hold is long enough not to be pressed by
accident.

THE VIRTUAL PAD IS SKIPPED DELIBERATELY. Steam Input's uinput device carries the
same product id as the real one and does NOT carry every button; a watcher that
picked it would miss presses for reasons nobody could see. Devices are taken
from /proc/bus/input/devices, which names the handlers, and only ones with a
`js` handler are opened -- that is the kernel's own opinion about what a gamepad
is, rather than a guess from a name.
"""

import errno
import glob
import os
import select
import struct
import subprocess
import sys
import time

TAG = "marwanos-panic-exit"

# struct input_event on 64-bit: struct timeval (two longs), then type, code,
# value. 24 bytes. Unpacked native-endian with no padding surprises because
# every field is naturally aligned.
EVENT_FORMAT = "=qqHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
assert EVENT_SIZE == 24

EV_KEY = 0x01
BTN_SELECT = 0x13A   # Create on a DualSense, View on an Xbox pad
BTN_START = 0x13B    # Options / Menu

CHORD = frozenset((BTN_SELECT, BTN_START))

# Long enough that a game using both buttons cannot trip it, short enough that
# somebody who is stuck does not give up and reach for the power button. The
# whole point is to be reachable while panicking.
HOLD_SECONDS = 2.0

# Devices come and go (a pad sleeps, Steam creates its virtual one). Rescan on
# this cadence rather than depending on any hotplug mechanism, because this
# process must keep working when everything else on the machine is wedged.
RESCAN_SECONDS = 5.0

STEAM_FLATPAK_ID = "com.valvesoftware.Steam"


def log(message):
    # <5> is notice. journald reads the prefix; this unit has no other output.
    sys.stderr.write("<5>%s: %s\n" % (TAG, message))
    sys.stderr.flush()


def gamepad_event_nodes():
    """Every /dev/input/event* the KERNEL considers a joystick.

    /proc/bus/input/devices lists a Handlers= line per device; a gamepad gets a
    `js` handler and a keyboard does not. Parsing that is more honest than
    matching on names, and it is how the virtual pad question answers itself --
    Steam's uinput device does not get a js handler.
    """
    nodes = []
    try:
        with open("/proc/bus/input/devices", "r") as handle:
            block = ""
            for line in handle:
                if line.strip():
                    block += line
                    continue
                nodes.extend(_nodes_from_block(block))
                block = ""
            nodes.extend(_nodes_from_block(block))
    except OSError as exc:
        log("cannot read /proc/bus/input/devices: %s" % exc)
    return nodes


def _nodes_from_block(block):
    if not block:
        return []
    handlers = ""
    for line in block.splitlines():
        if line.startswith("H: Handlers="):
            handlers = line.split("=", 1)[1]
    if not handlers:
        return []
    fields = handlers.split()
    if not any(f.startswith("js") for f in fields):
        return []
    return ["/dev/input/%s" % f for f in fields if f.startswith("event")]


def open_nodes(paths, already):
    """Open what is not open yet. Returns {fd: (path, file object)}."""
    opened = {}
    for path in paths:
        if path in already:
            continue
        try:
            handle = open(path, "rb", buffering=0)
        except OSError as exc:
            if exc.errno not in (errno.EACCES, errno.ENOENT):
                log("cannot open %s: %s" % (path, exc))
            continue
        os.set_blocking(handle.fileno(), False)
        opened[handle.fileno()] = (path, handle)
        log("watching %s" % path)
    return opened


def escape():
    """Get the screen back, gently first and then not.

    TWO STEPS, because the gentle one is not reliable here. `flatpak kill` is
    what the session itself uses and it leaves the rest of the session alone --
    but it has to run as the session user to see the instance, and if Steam is
    wedged rather than merely running it may not answer. Restarting greetd is
    the hammer that always works: it tears the session down and brings the shell
    back, at the cost of anything else that was running.
    """
    log("chord held -- releasing the screen")
    try:
        subprocess.run(
            ["runuser", "-u", "player", "--", "flatpak", "kill", STEAM_FLATPAK_ID],
            timeout=10, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log("flatpak kill did not run: %s" % exc)

    # Give the gentle path a moment to actually take effect before escalating.
    time.sleep(3.0)
    if not steam_running():
        log("Steam is gone; the session was left alone")
        return

    log("Steam is still up -- restarting the session")
    try:
        subprocess.run(["systemctl", "restart", "greetd"], timeout=30, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        log("could not restart greetd: %s" % exc)


def steam_running():
    for path in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            with open(path, "rb") as handle:
                if STEAM_FLATPAK_ID.encode() in handle.read():
                    return True
        except OSError:
            continue
    return False


def main():
    log("watching for Select+Start held %.0fs" % HOLD_SECONDS)
    handles = {}          # fd -> (path, file object)
    paths_open = set()
    pressed = set()
    held_since = None
    last_scan = 0.0

    while True:
        now = time.monotonic()
        if now - last_scan >= RESCAN_SECONDS:
            last_scan = now
            for fd, (path, handle) in list(handles.items()):
                if not os.path.exists(path):
                    log("gone: %s" % path)
                    handle.close()
                    del handles[fd]
                    paths_open.discard(path)
            fresh = open_nodes(gamepad_event_nodes(), paths_open)
            handles.update(fresh)
            for _fd, (path, _h) in fresh.items():
                paths_open.add(path)

        if not handles:
            time.sleep(0.5)
            continue

        try:
            ready, _, _ = select.select(list(handles), [], [], 0.25)
        except (OSError, ValueError):
            continue

        for fd in ready:
            entry = handles.get(fd)
            if entry is None:
                continue
            path, handle = entry
            try:
                data = handle.read(EVENT_SIZE * 64)
            except OSError:
                handle.close()
                del handles[fd]
                paths_open.discard(path)
                continue
            if not data:
                continue
            for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                _s, _us, etype, code, value = struct.unpack_from(
                    EVENT_FORMAT, data, offset)
                if etype != EV_KEY or code not in CHORD:
                    continue
                # value 2 is autorepeat, which for a button means still down.
                if value:
                    pressed.add(code)
                else:
                    pressed.discard(code)

        if CHORD <= pressed:
            if held_since is None:
                held_since = time.monotonic()
            elif time.monotonic() - held_since >= HOLD_SECONDS:
                held_since = None
                pressed.clear()
                escape()
        else:
            held_since = None


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
