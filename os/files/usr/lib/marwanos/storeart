#!/usr/bin/env bash
#
# Prefetch what the machine cannot produce itself, so cards render from disk.
#
# TWO JOBS, ONE TIMER, and they are kept as two sections below rather than
# folded together because only the download is shared. The Flathub half fetches
# a FIXED list -- the applications the image ships -- once and forever. The
# Steam half fetches a list that changes whenever somebody installs a game, and
# it learns that list by reading what another service published. Same fetch
# shape, opposite lifetimes; a merged loop would have to carry both stories in
# every line of it.
#
# THE STEAM HALF NOW FETCHES THREE THINGS PER GAME, and only the first of them
# is about a gap somebody reported. The portrait (and its header fallback)
# fills an empty icon column appscan published. The hero -- library_hero.jpg,
# the wide text-free key art -- and the store description are wanted for EVERY
# installed game, because a card with a perfectly good portrait still has
# nothing behind it and nothing under it. Two different questions, so two
# different lists: steam_wanted answers the first, steam_appids the second.
#
# ONE OF THE THREE IS NOT A PICTURE. The description comes from Valve's public
# appdetails endpoint as JSON and lands as JSON, in a directory of its own
# under /var/marwanos/store/meta, parsed with jq -- which the base image ships
# and the Containerfile's verify block now asserts. What lands is the RAW
# `data` object rather than the two fields the shell draws today; see
# STEAM_META_URL for why a cache with no invalidation story should store
# everything it was given.
#
# WHY THIS EXISTS. The store screen draws a card for every application the
# image ships, installed or not (catalogue.gd's AVAILABLE_APPS) -- and for the
# not-installed ones there is nothing on the machine to draw. No flatpak, no
# desktop entry, no exported icon: marwanos-appscan can only name icons for
# things that are actually here. So an available card was a coloured rectangle
# with a title on it, and the real logo arrived only after the multi-gigabyte
# install it was supposed to be advertising. A store whose shelves are blank
# until you buy something has it exactly backwards -- the PS5 look this shell
# is chasing shows the artwork FIRST.
#
# So this fetches each shipped application's icon from Flathub's appstream
# tree once, into /var/marwanos/store/icons/<id>.png, where the shell reads it
# like any other file. /var rather than /run because artwork is worth keeping:
# it survives reboots, so a machine that was online once renders a full store
# forever after, including offline.
#
# THE SHELL NEVER FETCHES. Same rule as netcheck and appscan: the shell is a
# renderer, it opens no sockets, and the desk harness runs it under
# --network=none to keep that true. The system fetches; the shell draws files.
#
# OFFLINE IS A QUIET NO-OP, and the answer is read rather than measured:
# marwanos-netcheck already probes the exact host this would download from,
# and a second probe here would be a second opinion about the same wire. No
# state file or an `offline` in it means "do not try" -- the timer that runs
# this re-fires soon enough, and icons are decoration, not something worth
# hammering a dead link for.
#
# ICONS ARE FETCHED ONCE AND NEVER REFRESHED. An icon that exists is skipped,
# so a machine that has them all does a handful of stats and exits. That is
# deliberate: application icons change on the timescale of rebrands, this list
# changes only with the image, and "refresh on missing only" means this can
# run every fifteen minutes forever without costing anything or being able to
# break artwork that already works. A rebrand ships by deleting the file from
# /var on the bench, or waiting for Phase 1, where marwand owns AppStream
# metadata wholesale and this script is deleted.
#
# STEAM GAME ART, and why it needs fetching at all. marwanos-appscan emits a
# home-rail row per installed Steam game and takes its portrait from Steam's
# own appcache/librarycache. That cache is a CLIENT cache, not an install
# artifact: it fills when Steam's UI has actually drawn the game. Install a
# game from the couch and go straight back to the rail and the librarycache
# entry does not exist yet, so appscan emits the row with an empty icon column
# and the card is a bare wash with a title on it -- the exact "shelves blank
# until you buy something" failure the Flathub half above exists to prevent,
# arriving through a different door.
#
# Valve serves the same portrait publicly, so this fetches it: the game's
# library_600x900 from the Steam CDN into /var/marwanos/store/icons, next to
# the Flathub PNGs, and appscan's steam_art() picks it up on its next poll.
#
# THE TWO SERVICES NEVER TALK. appscan publishes the gap (a `steam.<appid>`
# row with an empty icon column in /run/marwanos/apps.tsv), this fills it (a
# file appears in the icon directory), appscan's next ten-second poll finds
# the file and republishes the row with a path in it, and the shell -- which
# polls the same TSV -- redraws. Three processes, no RPC, no signals, no
# ordering requirement between any two of them: each one only ever looks at a
# file the other one finished writing. Every step is idempotent and every step
# survives the other two being restarted mid-flight, which is the whole reason
# this project keeps choosing files over sockets.
#
# UNLIKE THE FLATHUB LIST, THIS ONE GROWS. The shipped-apps list only changes
# with the image, so the Flathub half can decide "nothing missing" and mean it
# forever. A new game can be installed at any moment, so the Steam half must
# re-read the TSV on EVERY run -- there is no fast path that skips that read.
# What it does skip is the network: an appid whose file already exists costs
# one stat, so the steady state of a full library is still stats and nothing
# else.
#
# Phase 1 note: same retirement plan as appscan and netcheck -- marwand serves
# real AppStream data (names, descriptions, screenshots, icons) over RPC, and
# this unit, its timer and its directory convention go away together.
#
set -uo pipefail

TAG=marwanos-storeart
STATE_DIR=/run/marwanos
STATE="$STATE_DIR/storeart.state"
NET_STATE="$STATE_DIR/network.state"
## Shared with marwanos-appctl -- see that file's header for why sharing it is
## safe and the list file's own header for what may go in it.
SHIPPED=/usr/lib/marwanos/shipped-apps
ICON_DIR=/var/marwanos/store/icons
## Flathub publishes every app's appstream icon at a predictable path; 128x128
## is the size the catalogue tree always carries. The store cards scale it --
## soft beats blank, and Phase 1 replaces this with real AppStream anyway.
ICON_BASE=https://dl.flathub.org/repo/appstream/x86_64/icons/128x128

## What marwanos-appscan published, and the only place this learns which games
## exist. Read-only here, and readable at all without any special arrangement:
## appscan runs as root under systemd's default UMask=0022 (its unit sets no
## UMask= of its own), so its `> "$APPS.tmp"` + `mv -f` leaves the file
## 0644 root:root inside a 0755 root:root /run/marwanos -- see
## tmpfiles.d/50-marwanos.conf. This script also runs as root, so the read is
## trivially allowed; the perms matter because the SHELL reads the same file as
## `player`, and that is what 0644 is there for.
APPS_TSV="$STATE_DIR/apps.tsv"

## Valve's public artwork host. `<appid>/library_600x900.jpg` is the portrait
## grid image -- the same asset Steam's own library draws as a tile, and the
## same one appscan prefers out of the local cache, so a card looks identical
## whichever source filled it. `header.jpg` is the landscape capsule and the
## fallback: it is the wrong aspect for a portrait card, but a stretched
## header with the game's logo on it beats a flat wash with nothing.
STEAM_ART_BASE=https://cdn.cloudflare.steamstatic.com/steam/apps
STEAM_ART_NAMES=(library_600x900.jpg header.jpg)

## The hero: the wide, text-free key art Steam's own library draws behind a
## game's page. Same CDN path family as the two capsules above, so it costs one
## more name and no new knowledge about Valve's hosting.
##
## WANTED FOR EVERY GAME, NOT ONLY THE ARTLESS ONES, which is the difference
## between this and the portrait fetch above. A portrait is fetched to fill a
## gap appscan reported -- if the card already has a picture there is nothing
## to fix. A hero is a different asset for a different job: it is what the
## shell puts full-bleed behind a focused game, and a card with a perfectly
## good portrait still has no background. So the hero list is built from every
## `steam.` row rather than from the empty-icon ones.
STEAM_HERO_NAME=library_hero.jpg

## Valve's public store API, and the one thing in this script that fetches text
## instead of pixels.
##
## THE RAW `data` OBJECT IS WHAT LANDS ON DISK, not the fields the shell draws
## today. Extracting short_description and name here would mean a second fetch
## of everything already downloaded the first time somebody wanted the header
## image url or the controller_support flag -- and this is a cache with no
## invalidation story, so "refetch to get one more field" means "delete the
## whole directory on the bench". Storing what Valve sent makes every later
## field free. The shell picks what it draws.
##
## `filters=basic` USED TO TRIM THIS, AND IT IS GONE, which is the one
## behaviour change here worth stating plainly. The filter returns the
## description block -- type, name, short_description, the capsule urls, the
## requirements -- and nothing else. That was the right trade when the only
## consumer was a one-paragraph subtitle on the details panel. It is the wrong
## one now: the panel resolves a game's metadata the way Playnite does, over an
## ordered chain of sources per field (see shell/src/gamemeta.gd), and EVERY
## field in that chain beyond the description is in the part `basic` removes --
## developers, publishers, genres, categories, release_date, metacritic,
## required_age, support_info. A filtered payload does not make those fields
## empty, it makes them absent, which the resolver cannot tell apart from a
## game Valve knows nothing about.
##
## The cost is real and it is small. Measured on appid 367520 (Hollow Knight):
## 19 KB filtered, 121 KB unfiltered, and the difference is mostly the
## `screenshots` and `movies` arrays. At 121 KB per game a hundred-game library
## is 12 MB in /var, fetched once, on a machine whose smallest concern in this
## file is the 2.6 GB of flatpak repo next to it.
STEAM_META_URL=https://store.steampowered.com/api/appdetails

## The cache format version, stamped into every document this writes and
## checked before one is trusted.
##
## WITHOUT THIS THE FILTER CHANGE ABOVE WOULD NEVER REACH AN INSTALLED MACHINE.
## `steam_fetch_meta` skips an appid whose file is already present, and it is
## right to: descriptions change on the timescale of a store page rewrite. But
## every machine that has ever run the old version has a directory full of
## `filters=basic` documents that are present, valid JSON, and missing eight of
## the eleven fields the resolver asks for -- so "present" stopped being the
## same question as "usable" the moment the payload's shape changed. A file
## whose stamp is older than this constant is refetched exactly once and then
## behaves like every other cached file forever after.
##
## Bump this when a future change makes an older document unusable, and NOT
## when one merely gains a field the shell can do without: the point of the
## number is to force network traffic on every installed machine, which is not
## a thing to spend on a subtitle.
##
##   1  filters=basic. Never written -- rev 2 is the first stamped document,
##      and an unstamped file reads as 0, which is what makes the upgrade work.
##   2  the full appdetails payload.
META_REV=2

## Root writes, player reads, 0755 -- the same one-way flow as the icons
## directory next door, and created by tmpfiles.d as well as here so its
## existence never depends on which got there first.
META_DIR=/var/marwanos/store/meta

## One appdetails request per second, at most.
##
## COURTESY, NOT CORRECTNESS. Valve publishes no rate limit for this endpoint
## and does not need to: a library of thirty games is thirty requests, once,
## and never again. But this runs every fifteen minutes forever on every
## machine this image is ever installed on, and an unpaced loop over a big
## library is the shape of thing that gets an appliance's user agent blocked
## for everybody. A second between requests makes the worst case boring.
STEAM_META_DELAY=1

info() { printf '<6>%s: %s\n' "$TAG" "$*"; }
err()  { printf '<3>%s: %s\n' "$TAG" "$*" >&2; }

## One line for the shell, same seam as netcheck's network.state: `done N`
## (N icons on disk), `offline` (missing icons, no network to fetch them), or
## `failed` (tried and could not). /run empties every boot so a stale claim
## cannot outlive the boot that wrote it. Atomic via rename: the shell may
## poll this and must never read half a line.
state() {
    { printf '%s\n' "$*" > "$STATE.tmp" && mv -f "$STATE.tmp" "$STATE"; } \
        || err "cannot write $STATE"
}

## Field N (1-based) of a tab-separated record, or nothing.
##
## Hand-walked rather than the obvious `IFS=$'\t' read -r id name comment icon`,
## and that is a correctness fix rather than a style choice. Tab counts as IFS
## WHITESPACE in the shell's field-splitting rules even when IFS holds nothing
## else, so a run of tabs collapses into one delimiter and every field after an
## empty one shifts left. appscan emits empty fields as a matter of course --
## a Steam row's comment column is ALWAYS empty, and it sits immediately before
## the icon column this has to read -- so the obvious read would hand back the
## icon path as the comment, find the icon field holding the exec line, and
## conclude that every game already has art. Walking the tabs by hand keeps
## empties empty.
tsv_field() {
    local record="$1" want="$2" i=1
    while [ "$i" -lt "$want" ]; do
        case "$record" in
            *$'\t'*) record="${record#*$'\t'}" ;;
            *) return 0 ;;
        esac
        i=$(( i + 1 ))
    done
    printf '%s' "${record%%$'\t'*}"
}


## The Steam appids that appscan says have no art, one per line, or nothing.
##
## THE GAP IS READ, NOT GUESSED. This could have walked Steam's steamapps
## directory itself and worked out which manifests exist -- and then there
## would be two files in this tree that both know how to read Valve's install
## records, disagreeing the first time one of them was fixed. appscan already
## did that work and wrote the answer down, including its own art lookup, so
## this reads the answer: a row whose id starts `steam.` and whose icon column
## is empty is precisely "appscan found this game and could not find a picture
## for it". No TSV at all means appscan has not run yet, which reads the same
## as no games.
##
## An appid whose file is already here is dropped before the network is ever
## considered, so a full library costs one stat per game and no requests.
steam_wanted() {
    local line id icon appid

    [ -f "$APPS_TSV" ] || return 0

    while IFS= read -r line || [ -n "$line" ]; do
        id="$(tsv_field "$line" 1)"
        case "$id" in steam.*) ;; *) continue ;; esac

        icon="$(tsv_field "$line" 4)"
        [ -n "$icon" ] && continue

        # Digits only, and this is the load-bearing check in the whole
        # function: the appid goes into a URL and into a filename, and it
        # arrives from a file written by another process. Numeric means it can
        # be neither a path traversal nor a query string nor a shell word.
        appid="${id#steam.}"
        case "$appid" in ''|*[!0-9]*) continue ;; esac

        [ -f "$ICON_DIR/steam.$appid.jpg" ] && continue

        printf '%s\n' "$appid"
    done < "$APPS_TSV"
}


## Every Steam appid appscan has published, one per line, or nothing.
##
## THE ICON COLUMN IS NOT CONSULTED, and that is the whole difference from
## steam_wanted above. That function answers "which cards have no picture",
## which is a question about a gap somebody reported. This one answers "which
## games are installed", because the hero and the description are wanted for
## every game whether or not its card already draws something -- see
## STEAM_HERO_NAME's note.
##
## Same digits-only check for the same load-bearing reason: the appid goes into
## a URL and into a filename and it arrives from a file another process wrote.
## Numeric means it can be neither a path traversal nor a query string nor a
## shell word.
steam_appids() {
    local line id appid

    [ -f "$APPS_TSV" ] || return 0

    while IFS= read -r line || [ -n "$line" ]; do
        id="$(tsv_field "$line" 1)"
        case "$id" in steam.*) ;; *) continue ;; esac

        appid="${id#steam.}"
        case "$appid" in ''|*[!0-9]*) continue ;; esac

        printf '%s\n' "$appid"
    done < "$APPS_TSV"
}


## Fetch one game's hero image. Same three outcomes, and the same discipline,
## as steam_fetch below: 0 if a file landed, 1 if the network failed, 2 if
## Valve simply publishes no hero for this appid.
##
## Present means skipped before the network is considered, so a machine whose
## library is fully cached costs one stat per game here and no requests. Not
## every appid has a hero -- older titles predate the asset entirely -- and
## like the portrait's missing header that answer is not written down, so it is
## re-asked every fifteen minutes and re-answered with a 404 that costs
## nothing. The alternative is a tombstone file with its own invalidation story
## for the day Valve backfills.
steam_fetch_hero() {
    local appid="$1" dest tmp rc

    dest="$ICON_DIR/steam.$appid.hero.jpg"
    [ -f "$dest" ] && return 0
    tmp="$dest.tmp"

    # stderr discarded and the exit code kept, exactly as steam_fetch does it
    # and for the same reason: --retry makes curl narrate a 404 even under -s,
    # and a 404 is a NORMAL outcome here, every fifteen minutes, forever, for
    # every game Valve never made a hero for.
    curl -fsSL --max-time 30 --retry 2 -o "$tmp" "$STEAM_ART_BASE/$appid/$STEAM_HERO_NAME" 2>/dev/null
    rc=$?
    if [ "$rc" -ne 0 ]; then
        rm -f "$tmp"
        # 22 is --fail on a >=400 status: Valve answered, the answer was no.
        [ "$rc" -eq 22 ] && return 2
        err "could not fetch $STEAM_HERO_NAME for Steam appid $appid (curl exit $rc)"
        return 1
    fi

    # FFD8FF is the JPEG SOI marker plus the first byte of the next one. -f
    # keeps out the 404s; this keeps out the CDN edge that answers 200 with an
    # error page, which would otherwise surface as a broken texture on the TV.
    if [ "$(od -An -tx1 -N3 "$tmp" | tr -d ' \n')" != "ffd8ff" ]; then
        err "the $STEAM_HERO_NAME download for appid $appid is not a JPEG -- discarding it"
        rm -f "$tmp"
        return 1
    fi

    chmod 0644 "$tmp"
    mv -f "$tmp" "$dest"
    info "fetched $STEAM_HERO_NAME for Steam appid $appid"
    return 0
}


## True when a cached metadata document exists AND was written by a version of
## this script whose payload shape the shell can still use. See META_REV.
##
## PARSED RATHER THAN GREPPED, and not for the reason you would expect. A grep
## for the stamp's key is safe from false positives: JSON escapes a quote
## inside a string as \", so `"_marwanos_meta_rev"` cannot appear in any value
## Valve sends, only as the real key. It was checked rather than assumed.
##
## What a grep cannot do is COMPARE. The question is not "is there a stamp", it
## is "is the stamp at least this rev" -- a grep for the key would call a rev-2
## document current under a future rev 3 and never refetch the one library that
## most needs it, and a grep for the key AND the literal 2 would call a rev-3
## document stale and refetch a whole library after a rollback. Both failures
## are silent and both are permanent. `>=` on a parsed number is the predicate
## this actually wants, and jq is already a hard build-time dependency of the
## fetch it guards.
##
## Every non-zero exit means refetch, deliberately folding three different
## answers into one: no file, a file with no stamp (every document written
## before rev 2), and a file that does not parse at all. jq -e exits 1 on false
## and 5 on a parse error; there is nothing this caller could usefully do
## differently about either, and a document it cannot read is a document it
## must replace.
##
## NO jq MEANS "CURRENT", which looks like the wrong default until you follow
## it through. Without a parser this script cannot write a metadata document at
## all -- the guard before the fetch loop says so and skips the whole half -- so
## a "stale" answer here could not lead to a refetch, only to a survey that
## never comes up empty, a run that therefore never takes its early exit, and a
## fully cached machine going to the network every fifteen minutes forever to
## fetch nothing. Answering "current" costs a machine with no jq the one thing
## it could not have had anyway, and keeps the rest of this script's no-op path
## intact.
meta_current() {
    local file="$1"

    [ -f "$file" ] || return 1
    command -v jq >/dev/null 2>&1 || return 0
    jq -e --argjson rev "$META_REV" \
        '(._marwanos_meta_rev // 0) >= $rev' "$file" >/dev/null 2>&1
}


## Fetch one game's store metadata. 0 if a file landed, 1 if the network or the
## parse failed, 2 if Steam has no store page for this appid.
##
## THE PARSER IS jq, AND IT WAS CHECKED RATHER THAN ASSUMED. The base image
## (ghcr.io/ublue-os/base-main:43, pinned by digest in the Containerfile) ships
## jq-1.8.1-3.fc43 and python3-3.14.6-1.fc43; nothing this image does removes
## either. So the honest choice was between a real JSON parser already on the
## disk and hand-rolled grep/sed, and there was no contest: the field wanted
## most is short_description, whose value routinely contains escaped quotes,
## commas, braces and unicode escapes, and every regex that survives a
## fixture's worth of those fails on the next game. The Containerfile's verify
## block now asserts `command -v jq` beside curl and flatpak so that a base
## bump which dropped it fails the BUILD rather than quietly leaving every game
## card without a description.
##
## `success` IS THE GATE, and it is not the same thing as an HTTP status. Valve
## answers 200 with `{"<appid>":{"success":false}}` for an appid that has no
## store page -- delisted titles, and anything installed from outside the store
## -- so curl is perfectly happy and there is nothing to cache. Verified
## against appid 999999999, which returns exactly that. Treating it as a
## failure would put a permanently red unit on a machine where nothing is
## wrong, so it is outcome 2, like a game Valve has no art for.
##
## A CURRENT file is never refetched, and "current" is a stamp rather than a
## stat -- see META_REV and meta_current below. Descriptions change on the
## timescale of a store page rewrite, this cache has no invalidation story, and
## "refresh on missing or stale only" is what lets this run every fifteen
## minutes forever without being able to break metadata that already works.
## Same escape hatch as the icons: delete the file on the bench.
steam_fetch_meta() {
    local appid="$1" dest raw tmp rc name

    dest="$META_DIR/steam.$appid.json"
    meta_current "$dest" && return 0
    raw="$dest.raw"
    tmp="$dest.tmp"

    # The appid is digits-only by the time it reaches here (steam_appids), so
    # it cannot smuggle a second query parameter into this URL.
    curl -fsSL --max-time 30 --retry 2 -o "$raw" \
        "$STEAM_META_URL?appids=$appid" 2>/dev/null
    rc=$?
    if [ "$rc" -ne 0 ]; then
        rm -f "$raw"
        [ "$rc" -eq 22 ] && return 2
        err "could not fetch store metadata for Steam appid $appid (curl exit $rc)"
        return 1
    fi

    # jq -e exits 1 when the expression is false and 5 when the input does not
    # parse at all, and both mean the same thing to this caller: there is
    # nothing here worth keeping. Folding them together is deliberate -- an
    # HTML error page from an interception proxy and an honest `success:false`
    # are equally not-a-description, and the difference is not something this
    # machine could act on differently.
    if ! jq -e --arg id "$appid" '.[$id].success == true' "$raw" >/dev/null 2>&1; then
        rm -f "$raw"
        return 2
    fi

    # The `data` object, unwrapped from the appid key it arrived under, so the
    # shell reads `.name` and `.short_description` rather than having to know
    # the appid twice -- once in the filename and once inside it.
    #
    # Plus the format stamp, merged in rather than wrapped around: a wrapper
    # object would move every field the shell reads down a level and break the
    # panel on a machine that upgraded the image without this script having run
    # yet, which is precisely the window this stamp exists to survive. `+` on
    # two objects is jq's right-hand-wins merge, and the key is underscored so
    # it cannot collide with a field Valve adds later.
    if ! jq --arg id "$appid" --argjson rev "$META_REV" \
        '.[$id].data + {_marwanos_meta_rev: $rev}' "$raw" > "$tmp" 2>/dev/null; then
        err "the store metadata for appid $appid did not parse -- discarding it"
        rm -f "$raw" "$tmp"
        return 1
    fi
    rm -f "$raw"

    # Atomic via rename and 0644 explicitly rather than by umask, matching
    # every other file this script publishes: the shell may open this at the
    # exact moment it lands, and it reads as `player`.
    chmod 0644 "$tmp"
    mv -f "$tmp" "$dest"
    # First line only: a title is Valve's text and this is a log line, not a
    # record, so the journal's one-line-per-event shape wins over completeness.
    name="$(jq -r '.name // ""' "$dest" 2>/dev/null | head -n 1)"
    info "cached store metadata for Steam appid $appid${name:+ ($name)}"
    return 0
}


## Fetch one game's portrait. 0 if a file landed, 1 if the network failed,
## 2 if Valve simply has no art under either name.
##
## THE THREE OUTCOMES ARE KEPT APART because two of them mean "come back later"
## and one means "stop asking". A timeout or a DNS failure is the link, and the
## run should end in `failed` so the timer's retry is honest. An HTTP error
## from both names is Valve answering clearly: this appid has no published
## artwork -- a handful of appids never do -- and treating that as a failure
## would put a permanent red unit on a machine where nothing is wrong. curl's
## exit 22 is `--fail` seeing a >=400 status, which is exactly that distinction
## already made for us.
##
## It DOES ask again in fifteen minutes, because nothing on disk records the
## no-art answer. That is a deliberate trade: two 404s per artless game per
## quarter hour is nothing, and the alternative -- a tombstone file -- is
## cache state that would then need its own invalidation story for the day
## Valve backfills the art.
##
## THE HEADER LANDS UNDER ITS OWN NAME, and that is what keeps the trade
## honest (review caught the first version storing it as the portrait's
## filename, which turned the landscape capsule into exactly the permanent
## tombstone this comment forswears). Portrait missing means the portrait is
## still WANTED: a game that has only a header today keeps being asked about,
## and the day Valve backfills the 600x900 it replaces the fallback in one
## run. appscan prefers the portrait name and falls back to the header name,
## so the card upgrades itself with no invalidation story at all.
steam_fetch() {
    local appid="$1" name dest tmp rc http_only=1

    for name in "${STEAM_ART_NAMES[@]}"; do
        dest="$ICON_DIR/steam.$appid.jpg"
        [ "$name" = "header.jpg" ] && dest="$ICON_DIR/steam.$appid.header.jpg"
        # A fallback already on disk is not re-fetched; only the portrait's
        # absence keeps this appid on the wanted list at all.
        [ -f "$dest" ] && continue
        tmp="$dest.tmp"
        # stderr discarded, which the Flathub loop below does not do, and the
        # difference is the word "quiet". `--retry` makes curl narrate its
        # failures even under `-s`, so a 404 prints `curl: (22) ...` -- and
        # this loop asks for a name that does not exist as a NORMAL outcome,
        # every fifteen minutes, forever, for any appid Valve has no art for.
        # Left alone that is two unexplained red lines per artless game per
        # run in a journal nobody can then read. The exit code below is the
        # only part of curl's opinion this needs, and everything worth saying
        # gets said in this script's own voice.
        curl -fsSL --max-time 30 --retry 2 -o "$tmp" "$STEAM_ART_BASE/$appid/$name" 2>/dev/null
        rc=$?
        if [ "$rc" -ne 0 ]; then
            rm -f "$tmp"
            # 22 is `--fail` on a >=400 status: Valve answered, the answer was
            # no. Anything else is the wire, and that one gets a line, because
            # having silenced curl above this is now the only place it can be
            # said.
            if [ "$rc" -ne 22 ]; then
                err "could not fetch $name for Steam appid $appid (curl exit $rc)"
                http_only=0
            fi
            continue
        fi

        # The same argument as the PNG check below, for the same reason: -f
        # keeps out the 404s, but a CDN edge that answers 200 with an error
        # page would land HTML in a .jpg and the failure would surface as a
        # broken texture on the TV. FFD8FF is the JPEG SOI marker plus the
        # first byte of the next one, which is what every JFIF and Exif file
        # Valve serves starts with.
        if [ "$(od -An -tx1 -N3 "$tmp" | tr -d ' \n')" != "ffd8ff" ]; then
            err "the $name download for appid $appid is not a JPEG -- discarding it"
            rm -f "$tmp"
            http_only=0
            continue
        fi

        # Atomic via rename, and here the reader is appscan rather than the
        # shell: its next poll stats this path and puts it in the TSV, so a
        # half-written file would be published as art and drawn as a corrupt
        # texture. 0644 explicitly rather than by umask, matching the Flathub
        # icons -- the shell reads these as `player`.
        chmod 0644 "$tmp"
        mv -f "$tmp" "$dest"
        info "fetched $name for Steam appid $appid"
        return 0
    done

    [ "$http_only" -eq 1 ] && return 2
    return 1
}


install -d "$STATE_DIR" || err "cannot create $STATE_DIR"

# 0755 root-owned, matching tmpfiles.d/50-marwanos.conf, which also creates
# it: the shell (player) only ever reads here, and root writing what player
# reads is the same one-way flow as every other seam in this tree. Created
# here as well so a run never depends on which of the two got there first.
if ! install -d -m 0755 "$ICON_DIR"; then
    err "cannot create $ICON_DIR -- the store will draw fallback washes"
    state failed
    exit 1
fi

# The metadata directory, same arrangement and same tmpfiles.d line as the
# icons. NOT fatal, unlike the icons above: a machine with no descriptions
# still draws every card it drew before this existed, so failing the whole run
# over it would turn a missing subtitle into a red unit and an `offline`
# claim the network never earned.
if ! install -d -m 0755 "$META_DIR"; then
    err "cannot create $META_DIR -- game cards will have titles and no descriptions"
fi

# The allow-list, one id per line, comments and blanks stripped. An empty
# result is a broken image rather than an empty store -- the file ships with
# ids -- so it is loud, not a quiet zero-icon success.
mapfile -t apps < <(grep -Ev '^[[:space:]]*(#|$)' "$SHIPPED" 2>/dev/null)
if [ "${#apps[@]}" -eq 0 ]; then
    err "$SHIPPED is missing or empty -- no artwork to fetch, and appctl is refusing everything too"
    state failed
    exit 1
fi

# What is actually missing, before touching the network: the common case after
# the first successful run is "nothing", and that case must cost stats only.
# Both halves are surveyed BEFORE either fetches, so the network gate below is
# asked once and the "nothing to do" exit can speak for the whole run.
missing=()
for app in "${apps[@]}"; do
    [ -f "$ICON_DIR/$app.png" ] || missing+=("$app")
done

# Re-read every run, never cached: the Flathub list above is fixed by the
# image, this one changes the moment somebody installs a game. See the header.
mapfile -t games < <(steam_wanted)

# The other two per-game lists, surveyed the same way and for the same reason:
# the steady state of a fully cached library must cost stats and nothing else,
# and the network gate below has to be able to speak for the whole run.
#
# Built from EVERY installed game rather than from the ones appscan reported
# without art -- a card with a portrait still has no hero behind it and no
# sentence under it. Two stats per game; a thirty-game library is sixty stats
# and then an exit.
mapfile -t appids < <(steam_appids)
heroes=()
metas=()
for appid in "${appids[@]}"; do
    [ -f "$ICON_DIR/steam.$appid.hero.jpg" ] || heroes+=("$appid")
    # The metadata half asks meta_current rather than -f, so a library cached
    # by an older version of this script is surveyed as stale and refetched
    # once. That makes the steady state one jq parse per game per run instead
    # of one stat -- a hundred-KB document read fifty times a day, which is
    # noise next to the fetch it is deciding against, and the only way the
    # question "is this document usable" can be asked honestly at all.
    meta_current "$META_DIR/steam.$appid.json" || metas+=("$appid")
done

if [ "${#missing[@]}" -eq 0 ] && [ "${#games[@]}" -eq 0 ] \
    && [ "${#heroes[@]}" -eq 0 ] && [ "${#metas[@]}" -eq 0 ]; then
    state "done ${#apps[@]}"
    exit 0
fi

# netcheck's answer, not a probe of our own -- see the header. A missing file
# is a boot too young to have answered yet, which reads the same as offline:
# do not try, the timer comes back.
net="$(cat "$NET_STATE" 2>/dev/null)" || net=""
if [ "$net" != "online" ]; then
    info "${#missing[@]} store icon(s), ${#games[@]} game portrait(s), ${#heroes[@]} hero image(s) and ${#metas[@]} description(s) missing and the network is not there; waiting for a later run"
    state offline
    exit 0
fi

failed=0
for app in "${missing[@]}"; do
    tmp="$ICON_DIR/.$app.png.tmp"
    # Atomic via rename, like every state file here, but for a better reason
    # than polling: the shell may load this PNG at the exact moment it lands,
    # and a half-written image is a corrupt-texture error on the TV where a
    # missing one is just the fallback wash a moment longer.
    if ! curl -fsSL --max-time 30 --retry 2 -o "$tmp" "$ICON_BASE/$app.png"; then
        err "could not fetch the icon for $app"
        rm -f "$tmp"
        failed=$(( failed + 1 ))
        continue
    fi
    # Prove it is a PNG rather than trust the exit code, in the spirit of the
    # Containerfile's ELF check on the shell binary: -f catches a 404, but a
    # CDN that answers 200 with an error page would land HTML in a .png, and
    # the failure would surface as a broken texture on the TV instead of here.
    if [ "$(od -An -tx1 -N8 "$tmp" | tr -d ' \n')" != "89504e470d0a1a0a" ]; then
        err "the download for $app is not a PNG -- discarding it"
        rm -f "$tmp"
        failed=$(( failed + 1 ))
        continue
    fi
    chmod 0644 "$tmp"
    mv -f "$tmp" "$ICON_DIR/$app.png"
    info "fetched the icon for $app"
done

# The Steam half, run after the shipped icons rather than before them: the
# store screen's shelves are the thing a first boot stares at, and a library of
# games is by definition a machine somebody has already been using.
for appid in "${games[@]}"; do
    steam_fetch "$appid"
    case $? in
        0) ;;
        2) info "Valve publishes no library art for appid $appid; leaving that card to its wash" ;;
        *) failed=$(( failed + 1 )) ;;
    esac
done

# The heroes, after the portraits and for the same ordering argument the
# portraits get after the shipped icons: a card with no picture at all is a
# worse thing to look at than a card with a picture and no background behind
# it, so the asset that fixes the first failure goes first.
for appid in "${heroes[@]}"; do
    steam_fetch_hero "$appid"
    case $? in
        0) ;;
        2) info "Valve publishes no hero image for appid $appid; the shell will fall back to the portrait" ;;
        *) failed=$(( failed + 1 )) ;;
    esac
done

# The descriptions last, because they are the only thing here that is not a
# picture and the only thing that is paced.
#
# jq is asserted at build time (see steam_fetch_meta's note and the
# Containerfile's verify block), so reaching this branch means a base image
# changed underneath a machine that is already installed. It says so once per
# run and keeps every other job in this script working, which is the right
# trade for a subtitle.
if [ "${#metas[@]}" -gt 0 ] && ! command -v jq >/dev/null 2>&1; then
    err "jq is not installed, so store metadata cannot be parsed -- ${#metas[@]} description(s) skipped"
    metas=()
fi

for appid in "${metas[@]}"; do
    steam_fetch_meta "$appid"
    case $? in
        0) ;;
        2) info "Steam has no store page for appid $appid; there is no description to cache" ;;
        *) failed=$(( failed + 1 )) ;;
    esac
    # The courtesy pause, taken after every appid this run considered rather
    # than only after the ones that succeeded: a 404 is a request too, and it
    # is the artless-appid case that would otherwise sprint through a library.
    # See STEAM_META_DELAY.
    sleep "$STEAM_META_DELAY"
done

if [ "$failed" -gt 0 ]; then
    err "$failed image(s) could not be fetched; the timer will retry"
    state failed
    exit 1
fi

# The count is the SHIPPED icons only, unchanged from before the Steam half
# existed: this number answers "is the store screen fully stocked", which is a
# question about a fixed list. Game portraits have no denominator -- the answer
# would be N of however many games happen to be installed this minute -- so
# they say their piece in the journal and stay out of the state file.
present=0
for app in "${apps[@]}"; do
    [ -f "$ICON_DIR/$app.png" ] && present=$(( present + 1 ))
done
info "store artwork complete: $present icon(s) on disk"
state "done $present"
