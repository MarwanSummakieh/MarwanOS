#!/bin/sh
#
# MarwanOS session -- D4 (which compositor), D5 (where the client comes from),
# and the supervision loop M3 specifies.
#
# The compositor is gamescope, owning DRM directly. That was plan A of the M1
# spike, and it is now the decision: see docs/adr/0005. cage was plan B, and the
# fallback to it -- along with the /var/marwanos/compositor lever that let a
# machine-local file choose between them -- is deliberately gone.
#
# Removing it is the point rather than a tidy-up. ADR 0004 said so before the
# spike ran: an automatic fallback "is right for a spike and wrong for a product:
# an appliance that silently changes compositor is an appliance whose behaviour
# cannot be reasoned about from the image." A session that quietly lands on a
# different compositor is one where every later measurement has to first
# establish which one it was talking about.
#
# So a gamescope that cannot take the display is now a hard stop that says so,
# not a silent downgrade. On a machine with no console the honest black screen
# with a journal entry beats the working-but-unexplained one.
#
# greetd runs this as `/bin/sh -c "exec /usr/lib/marwanos/session/marwanos-session"`,
# as `player`. The messages below carry systemd's <N> syslog-level prefixes: <3>
# is err, <4> is warning, <6> is info, so a failure is findable with
# `journalctl -p err -t marwanos-session` rather than being one more line of chatter in a
# machine that by design shows no text.
#
# That only works because of the re-exec through systemd-cat below. This script
# does NOT inherit journal-connected descriptors from greetd.service, which is
# what the first hardware run assumed and disproved: /etc/greetd/config.toml sets
# `vt = 1`, and greetd opens that VT and hands it to the session as stdin, stdout
# and stderr. So every line this script printed, plus every line gamescope
# printed, went to the laptop's internal panel -- a wall of scrolling text on the
# one display D6 says must never show any, while `journalctl` held none of it and
# the only way to read a compositor failure was a phone camera pointed at the
# screen. Redirecting fds 1 and 2 into the journal fixes both halves at once, and
# doing it here rather than in a greetd drop-in is deliberate: greetd reopens the
# tty for the child itself, so StandardOutput= on the unit does not reach us.

set -u

readonly TAG="marwanos-session"

# Hardcoded rather than taken from $0 so the path is the same however the script
# was entered. Only the systemd-cat re-exec below uses it now that plan B's
# cage-runs-this-script-as-its-client path is gone.
readonly SELF="/usr/lib/marwanos/session/marwanos-session"

# Point stdout and stderr at the journal before anything writes to them. See the
# header for why this cannot be a greetd drop-in. systemd-cat execs the program
# after redirecting, so this costs no extra process and every descendant --
# gamescope, cage, the client -- inherits journal-connected descriptors.
#
# --level-prefix=true is explicit rather than left to the default, because
# `journalctl -p err -t marwanos-session` finding anything depends entirely on the <N>
# prefixes still being parsed.
#
# stdin is deliberately not redirected: fds 1 and 2 are what leaked to the panel,
# and the VT on fd 0 is the session's controlling terminal.
#
# Guarded two ways. The environment variable makes the re-exec happen once, and
# it is kept even though plan B's re-entry is gone -- greetd's default_session
# points back at this same script, so a session that ends and is restarted must
# not stack another systemd-cat. And a missing systemd-cat skips the redirect
# rather than killing the session: text on screen is a failed acceptance
# criterion, no session at all is a brick.
if [ -z "${MARWANOS_SESSION_LOGGING:-}" ] && command -v systemd-cat >/dev/null 2>&1; then
    MARWANOS_SESSION_LOGGING=1
    export MARWANOS_SESSION_LOGGING
    exec systemd-cat --level-prefix=true -t "$TAG" "$SELF" "$@"
fi

# D5. The client is baked into the image; the override is a directory under
# /var so a fresh Godot export can be scp'd onto a running target and restarted
# in seconds, instead of costing an image rebuild and a reboot per UI tweak.
# Both halves are required -- an executable at the override path AND the devmode
# flag -- so a forgotten dev build cannot quietly become what the appliance
# ships.
readonly DEVMODE_FLAG="/var/marwanos/devmode"
readonly DEV_CLIENT="/var/marwanos/dev-shell/marwanos-shell"

# The baked client. M1 ran vkcube here; from M3 it is the Godot export that the
# Containerfile builds in a separate stage and installs at exactly this path.
#
# The name is a contract this file cannot enforce and three other places have to
# honour. The Containerfile installs the export as marwanos-shell; D5's override
# above is the same basename under /var/marwanos/dev-shell; and the export preset
# sets binary_format/embed_pck=true so that both of them are one self-contained
# executable. An export that ships a binary plus a sibling .pck would pass the
# [ -x ] check in supervise_client, start, and then fail to find its own content
# -- a black screen indistinguishable from a compositor failure, on a machine
# with no console to say otherwise.
#
# vkcube stays installed. It is still the fastest way to tell a compositor
# problem apart from a shell problem, and it is what ADR 0004's spike commands
# use before the shell is trusted.
readonly BAKED_CLIENT="/usr/lib/marwanos/shell/marwanos-shell"

# M3's loop guard. Five client crashes inside sixty seconds means the client is
# broken rather than unlucky, and restarting it faster will not fix it.
readonly CRASH_LIMIT=5
readonly CRASH_WINDOW=60

# BACKGROUND STEAM, and why the session owns it rather than the shell.
#
# `flatpak run com.valvesoftware.Steam -silent` starts the client with no
# window. Under gamescope that means nothing reaches the TV at all, which is
# the entire point: this is furniture, not an application, and D6's "no text
# visible at any point" is not softened by it.
#
# What it buys is everything only a WARM client can give. The home menu
# launches games as `steam://rungameid/<appid>`, and against a client that has
# already started, logged in, mounted its libraries and read its manifests that
# URL is handled in a couple of seconds; against no client it is a cold Steam
# start first, which on this machine is the difference between pressing A and
# watching a black screen wondering whether the press registered. It also fills
# Steam's own appcache/librarycache as a side effect -- the square icons and
# hero art marwanos-appscan publishes in gameart.tsv come from exactly that
# cache, and before this existed the cache only filled if somebody had opened
# Steam's own UI by hand.
readonly STEAM_FLATPAK_ID="com.valvesoftware.Steam"

# Thirty seconds between attempts; five attempts inside five minutes and then
# nothing until the next boot.
#
# The delay is deliberately unlike the client's, which restarts with no backoff
# at all because somebody is staring at a blank TV until it comes back. Nobody
# is looking at Steam -- it has no window -- so there is nothing to be quick
# for, and half a minute is still short enough that a game launched a minute
# later finds a warm client.
#
# The cap is what keeps a broken Steam out of the journal. An install that
# cannot start at all would otherwise print a line every thirty seconds for the
# life of the session, on a machine whose only triage surface is journalctl.
# Five lines and one final explanation is the whole of what this is allowed to
# cost, and it does not get a second budget until the machine reboots.
readonly STEAM_RESTART_DELAY=30
readonly STEAM_EXIT_LIMIT=5
readonly STEAM_EXIT_WINDOW=300

# How long to wait for the compositor to say it is up. See start_gamescope for
# why this is a readiness handshake and not a check for a nonzero exit.
#
# Twenty, not five. gamescope writes the ready fd very late: after Vulkan device
# and ICD enumeration, after the DRM open and the initial modeset, after wlserver,
# and after every Xwayland server it starts is up. On a cold boot from USB with a
# cold page cache and the NVIDIA ICD, five seconds does not reliably cover that --
# and the 2026-08-05 film's own timings say this machine is slow in exactly that
# window: the external display goes black at t=43s and the shell's first frame
# lands at t=74s.
#
# The trade is real and it is the right way round. This appliance's acceptance
# criterion is "no text", not "fast", and a gamescope that was merely slow being
# scored as one that failed now costs a held black screen rather than a wrong
# fallback -- which makes the generous timeout matter more, not less, than it did
# when D4 was still open.
readonly READY_TIMEOUT=20

# The TV is the display this project is about; the laptop's internal panel is
# not, and on a hybrid chassis the HDMI port is what routes to the dGPU.
# gamescope takes an ordered connector list, so name HDMI first and let it fall
# through -- a target booted with the TV unplugged should still show something.
: "${MARWANOS_OUTPUT_CONNECTOR:=HDMI-A-1,HDMI-A-2,DP-1,*}"

# How long the pointer stays visible after it stops moving, in milliseconds.
#
# This was 1, which is as close to "never show a cursor" as the flag goes, and
# it was right when nothing on this machine had a pointer: the shell is driven
# entirely by a d-pad and hides its own cursor anyway. It stopped being right
# the moment a browser landed on the rail. A DualSense's touchpad is a real
# libinput pointer device, so the hardware to move a cursor is already in
# everyone's hands -- 1 ms just meant the cursor vanished between motions and
# looked broken.
#
# Three seconds is the usual desktop compromise: visible while you are moving
# it, gone while you are reading. The shell is unaffected either way; it never
# shows a pointer.
: "${MARWANOS_CURSOR_HIDE_MS:=3000}"

# ---------------------------------------------------------------------------
# THE DISPLAY PROFILE
#
# "the screen is so flickery it's giving me a headache" -- the owner, 2026-08-10,
# about the only display on a machine whose only user cannot open a terminal, on
# a bench that was unreachable over SSH so not one theory could be tested live.
#
# There were four candidate causes and no way to tell them apart from here:
#
#   (a) VRR/adaptive-sync brightness pulsing. A UI that idles and then animates
#       delivers frames at a wildly variable rate, and on a VRR-capable gaming
#       ultrawide that walks the panel's refresh up and down -- which many
#       panels answer with a visible brightness pulse. Classic, and exactly the
#       kind that gives somebody a headache rather than looking obviously broken.
#   (b) The panel's preferred mode. Nothing here has ever specified a refresh, so
#       gamescope takes what the EDID prefers, which on a gaming ultrawide is
#       likely 100/144/165 Hz -- and high-refresh page flips under composition on
#       the NVIDIA DRM path is not a well-trodden road.
#   (c) --force-composition, added the same day to fix a separate ghosting
#       defect. The flicker predates it and survived it, so it is unlikely -- but
#       "unlikely" is a thing to test, not a thing to assume.
#   (d) The shell. Ruled out by reading it: Kiosk.set_overlay is called exactly
#       twice per app-overlay open/close and is guarded against repeats, and
#       nothing else writes GAMESCOPE_EXTERNAL_OVERLAY except one proof-of-
#       plumbing write on the first frame.
#
# So the image ships the EXPERIMENT rather than a guess. One word in
# /var/marwanos/display.profile picks a named gamescope configuration; the
# settings screen cycles it from the couch; whoever has the headache runs the
# bisect in minutes instead of waiting for the bench to come back.
#
# UNDER /var, NOT /usr, and no default file is baked. In bootc /var is populated
# once at install and never touched by an upgrade, so a file the build left there
# would be a first-boot-only default that drifts from the image forever -- the
# trap 50-marwanos.conf's header spells out. So: the DIRECTORY comes from
# tmpfiles.d, the file only exists once somebody has chosen something, and
# "absent" is a first-class answer meaning "use the default".
#
# WHAT THE FLAGS ACTUALLY ARE, verified on 2026-08-10 against the gamescope in
# ghcr.io/marwansummakieh/marwanos:latest rather than against its man page --
# `podman run --rm --cap-add SYS_NICE <image> gamescope --help`, and each
# candidate flag additionally fed to the real getopt table to see whether it was
# rejected. (--cap-add SYS_NICE is needed because gamescope carries
# cap_sys_nice+ep and otherwise refuses to exec in a container at all, which is
# the same trap gamescope_has_option's header describes.) Two findings decided
# the design and neither was what the plan assumed:
#
#   * THERE IS NO --output-refresh. The parser rejects it and the string is not
#     in the binary. The only refresh input this gamescope has is
#     `-r/--nested-refresh`, documented as "game refresh rate (frames per
#     second)". It is listed in the general options, NOT under "Nested mode
#     options" -- and "Embedded mode options" carries --generate-drm-mode, whose
#     only purpose is synthesising a mode for a requested resolution and refresh
#     that the connector does not list. So -r is the refresh figure the DRM path
#     has to be using; there is no other. That is inference from the binary's own
#     help, not a bench measurement, so it is stated here rather than assumed:
#     what -r certainly does is pace frame delivery at a constant 60, which is
#     what kills (a) whether or not it also programs the mode.
#
#     A HARD MODE PIN IS A KARG, not a flag, and cannot be a profile: it would be
#     `video=HDMI-A-1:3440x1440@60` in kargs.d/00-marwanos.toml, the same
#     mechanism as the `video=eDP-1:d` already there. That is an image rebuild
#     plus `bootc upgrade` plus a reboot, which is exactly the loop this switch
#     exists to avoid, so it is documented and not shipped. If -r turns out not
#     to move the mode, that karg is the next move and the profiles say which.
#
#   * ADAPTIVE SYNC CANNOT BE TURNED OFF, because it is never on. `--adaptive-
#     sync` is an ENABLE flag ("Enable adaptive sync if available"); the parser
#     rejects --no-adaptive-sync and --disable-adaptive-sync. This session has
#     never passed it, so gamescope has never set the KMS VRR property. "Disable
#     adaptive sync" is therefore implemented by continuing not to ask for it,
#     which is honest, and the profiles say so rather than shipping a flag that
#     does nothing.
readonly PROFILE_FILE="/var/marwanos/display.profile"

# steady, and it is a change of default rather than a new option. It is the
# combination that kills (a) and (b) at once while keeping (c)'s ghosting fix,
# so it is what the machine should be doing while somebody works out whether it
# was enough.
readonly PROFILE_DEFAULT="steady"

# Where a rejected profile lands. native is today's exact behaviour -- the
# configuration this machine has actually booted, repeatedly -- so it is the one
# thing here with evidence behind it.
readonly PROFILE_FALLBACK="native"

# In the order the settings screen cycles them, which walks from the most likely
# fix through the two discriminators and ends at today's behaviour and the bare
# baseline. Kept identical to the PROFILES list in /usr/lib/marwanos/display/
# profile so "the next one" means the same thing on both sides of the seam.
readonly PROFILE_LIST="steady sixty-raw flat native raw"

# 60 because it is the one refresh every panel ever made supports and the one no
# NVIDIA flip path can find exotic. This is a headache, not a frame-rate budget.
readonly PROFILE_REFRESH=60

# ---------------------------------------------------------------------------
# THE STEAM PROFILE
#
# "the moment steam ran in the background the screen turns off for a second then
# starts flickering" -- the owner, 2026-08-11.
#
# READ THAT SENTENCE CAREFULLY, because the first version of this block did not
# and got the layer wrong. Two words in it decide everything:
#
#   IN THE BACKGROUND. That client is started `-silent` by start_background_steam
#   below, on EVERY boot, seconds after the shell -- and it has no window at all.
#   Nothing about window management, focus heuristics or fullscreen candidates
#   can explain a client that never maps anything.
#   TURNS OFF FOR A SECOND. A screen going black and coming back is a MODESET.
#   It is the display being reprogrammed, which is a layer below every flag in
#   the window list and a layer below --force-composition too.
#
# So the question this axis answers is not "how does the compositor arrange
# Steam's windows" but "what does the compositor do when Steam ATTACHES to it".
# The window-arrangement profiles are kept because they are cheap, already
# written and still the right answer if the flicker ever turns out to have a
# second cause during games -- but they are no longer the ones to try first.
#
# AND IT LIKELY EXPLAINS 2026-08-10. The display profile block above lists four
# candidate causes for a screen that was "so flickery it's giving me a headache",
# and every one of them assumes an IDLE machine. This machine is never idle:
# background Steam attaches a few seconds into every boot and stays. That is why
# none of the five display profiles fixed it, and it means the two reports are
# probably one bug rather than two.
#
# WHAT ATTACHES, AND WHAT THAT COSTS. Steam is a Vulkan/GL client and this
# session exports ENABLE_GAMESCOPE_WSI=1 globally, so Steam's present path runs
# through gamescope's own WSI layer rather than one it infers. Steam also detects
# gamescope and negotiates with it -- refresh included. Either is a plausible
# route from "a windowless client started" to "the panel was reprogrammed", and
# neither needs a window to happen.
#
# THAT IS STILL A THEORY, NOT A MEASUREMENT -- the bench has been unreachable for
# this whole investigation. Which is exactly why this ships as a switch: seven
# configurations, each removing a different part of the above, and whichever one
# the owner stops on names the cause.
#
#   no-bg-steam  The session starts NO background client. THE CLEAN
#                DISCRIMINATOR, and the first thing to try: if the screen is calm
#                until a game is launched by hand, the background client's
#                attachment is the cause and everything below is noise. If it
#                still flickers with no Steam process on the machine at all, the
#                cause was never Steam and the display axis is where to look.
#                THE COST IS REAL AND IT IS ONLY LATENCY: the warm client is what
#                makes `steam://rungameid/` resolve in a couple of seconds, so
#                the first game launched on this profile waits out a cold Steam.
#                Nothing breaks; the rail, the library and the storefront are all
#                unaffected, because appscan reads manifests off disk and the
#                storefront is drawn by the shell.
#   no-wsi       Background Steam runs with ENABLE_GAMESCOPE_WSI=0, so its
#                Vulkan never attaches to gamescope's WSI layer. One step
#                narrower than no-bg-steam: the client still starts and stays
#                warm, it just presents the way it would without gamescope's
#                help. If this is calm and no-bg-steam was too, the WSI layer is
#                the modeset and the warm client can be kept.
#   steam-split  -e AND --xwayland-count 2. What a Steam Deck actually runs.
#                Steam's gamepadui expects two X servers -- its own UI on one,
#                the game it launches on the other -- and this session has
#                always given it one, so the client's windows and the game's
#                windows share a single focus stack. This is the configuration
#                closest to the one Valve tests, and the only theory here that
#                has never been tried on this machine. FIRST IN THE CYCLE.
#   loose        Drops --force-windows-fullscreen. If the flicker is Steam's
#                transients being blown up to fullscreen one after another, this
#                is the one flag responsible, and nothing else here removes it.
#                The cost is real and worth knowing before choosing it: other
#                applications go back to opening at whatever size they like.
#   steam-aware  -e alone. Teaches steamcompmgr Steam's window hierarchy (the
#                STEAM_GAME / STEAM_BIGPICTURE / STEAM_OVERLAY atoms) so it seats
#                the one window that is the UI and leaves the transients alone.
#                Half of what 58cc0e3 shipped, on its own so it can be judged.
#   yield        The other half of 58cc0e3: the shell unmaps its own window once
#                something else is provably drawing, leaving the compositor
#                exactly one fullscreen candidate. No gamescope flags at all --
#                this word is read by the SHELL, not by this script. See
#                shell/src/window_profile.gd and Kiosk.yield_screen.
#   plain        Today's exact behaviour, and THE DEFAULT. Every other word here
#                is a theory about a flicker nobody has reproduced off the
#                bench, and a theory is not a thing to boot somebody's only
#                machine into without being asked.
#
# Under /var and no default file baked, for PROFILE_FILE's reason verbatim.
readonly WINDOW_PROFILE_FILE="/var/marwanos/window.profile"

# Today's behaviour. See `plain` above: this changes nothing until somebody
# chooses otherwise from the couch.
readonly WINDOW_DEFAULT="plain"

# Where a rejected window profile lands, and the same word as the default
# because the same argument applies twice: `plain` is the configuration this
# machine has actually booted, repeatedly.
readonly WINDOW_FALLBACK="plain"

# In the order the settings screen cycles them, and the order IS the diagnosis:
# the two that address the symptom actually reported -- a windowless client
# blacking the screen -- come first, because they are the only ones that can
# explain it. The four window-arrangement profiles follow for the case where
# something still flickers once a game is on screen, and today's behaviour is
# last. Kept identical to the PROFILES list in /usr/lib/marwanos/window/profile
# so "the next one" means the same thing on both sides of the seam.
readonly WINDOW_LIST="no-bg-steam no-wsi steam-split loose steam-aware yield plain"

log()  { printf '<6>%s: %s\n' "$TAG" "$*" >&2; }
warn() { printf '<4>%s: %s\n' "$TAG" "$*" >&2; }
err()  { printf '<3>%s: %s\n' "$TAG" "$*" >&2; }

# Monotonic seconds. Wall clock is wrong for a sixty-second window: NTP steps
# the clock shortly after boot, which is exactly when a crash loop would be
# happening, and a step backwards would make the guard never trip.
uptime_seconds() {
    IFS=. read -r _up _rest < /proc/uptime
    printf '%s\n' "$_up"
}

# The hybrid-graphics trap, which the plan's risk table and ADR 0003 both call
# out: this chassis has an Intel iGPU alongside the NVIDIA dGPU, and gamescope
# Recommends mesa-vulkan-drivers, so both ICDs are installed and the compositor
# has a wrong card available to choose. A gamescope that came up on the iGPU
# would render a perfectly convincing green result about the card the project
# is not about. Pinning by PCI id makes that outcome impossible instead of
# merely detectable.
#
# ChimeraOS/gamescope-session solves the same problem with export-gpu, which
# prompts a human and writes the answer to a config file. An appliance has
# nobody to prompt, so it is resolved here. Read from sysfs rather than lspci
# because pciutils is not a dependency of anything this image installs. Class
# 0x0300 is a VGA controller and 0x0302 a 3D controller; 0x10de is NVIDIA.
detect_nvidia_vk_device() {
    for _dev in /sys/bus/pci/devices/*; do
        [ -r "$_dev/class" ] || continue
        [ -r "$_dev/vendor" ] || continue
        [ -r "$_dev/device" ] || continue

        read -r _class < "$_dev/class"
        case "$_class" in
            0x0300*|0x0302*) ;;
            *) continue ;;
        esac

        read -r _vendor < "$_dev/vendor"
        [ "$_vendor" = "0x10de" ] || continue

        read -r _device < "$_dev/device"
        printf '%s:%s\n' "${_vendor#0x}" "${_device#0x}"
        return 0
    done
    return 1
}

# Is there a display attached to the NVIDIA card specifically?
#
# The scoping is the whole point, and it is why this is not a one-line glob over
# /sys/class/drm/card*-HDMI-A-*. That glob would answer "yes" for an HDMI port on
# the Intel card while the NVIDIA card has nothing attached -- and that is exactly
# the case that must NOT pin wlroots to the NVIDIA node. Pinning wlroots to a
# device with zero connectors is the worst outcome available: wlroots' DRM
# backend_start() scans connectors and returns true with no count check, cage has
# no zero-output check of its own, and cage only terminates on losing an output
# that was NESTED. The result is a live compositor, a running client, no picture,
# and no nonzero exit for greetd to react to. A silent hang is worse than a black
# screen that ends.
#
# DP-* is in the list because MARWANOS_OUTPUT_CONNECTOR already claims it.
nvidia_output_connected() {
    for _dev in /sys/bus/pci/devices/*; do
        [ -r "$_dev/vendor" ] || continue
        read -r _vendor < "$_dev/vendor"
        [ "$_vendor" = "0x10de" ] || continue
        for _s in "$_dev"/drm/card[0-9]*/card[0-9]*-*/status; do
            [ -r "$_s" ] || continue
            _name="${_s%/status}"; _name="${_name##*/}"; _name="${_name#*-}"
            case "$_name" in
                HDMI-A-*|HDMI-B-*|DP-*|DVI-*) ;;
                *) continue ;;
            esac
            read -r _st < "$_s"
            [ "$_st" = "connected" ] && return 0
        done
    done
    return 1
}

# Borrowed from ChimeraOS/gamescope-session, and it earns its keep for one
# reason: M1 exists to judge plan A, and an unrecognised flag makes gamescope
# exit during argument parsing, which looks from the outside exactly like
# gamescope being unable to take DRM master. Guarding the optional flags means a
# plan A failure is a real one.
## Does this gamescope accept an option? Answers YES when it cannot tell.
##
## THIS FAILED CLOSED, AND THAT IS A SILENT WAY TO LOSE FULLSCREEN. The old
## body was one line -- `gamescope --help 2>&1 | grep -q -- "$1"` -- which
## cannot distinguish "gamescope ran and does not list this flag" from
## "gamescope did not run at all". Any failure to execute produces empty output,
## grep finds nothing, the caller silently drops the flag, and the session comes
## up with no window management: applications open at whatever size they like,
## on a TV, with nothing in the journal pointing at the cause.
##
## That is not hypothetical. gamescope carries `cap_sys_nice+ep` (see the
## Containerfile), and a binary with file capabilities refuses to exec wherever
## the permitted set does not allow them -- proven in a container, where
## `gamescope --help` answers "Operation not permitted" and nothing else.
## Whatever the bench's version of that is, the probe should not be the thing
## that decides.
##
## So: run the probe, and only believe a NEGATIVE answer if gamescope actually
## produced output. If it printed nothing, assume the flag exists and pass it.
## Failing open is the right direction here -- an unknown flag makes gamescope
## exit at startup with a message, which start_gamescope already turns into a
## hard stop that says why, whereas a dropped flag is invisible until someone
## notices a browser in a corner of the screen.
gamescope_has_option() {
    _help="$(gamescope --help 2>&1)"
    if [ -z "$_help" ]; then
        warn "could not read gamescope --help; assuming $1 is supported"
        return 0
    fi
    printf '%s' "$_help" | grep -q -- "$1"
}

# Which display profile this session runs, as one word from PROFILE_LIST.
#
# EVERY UNUSABLE ANSWER IS THE DEFAULT, and says so. Absent, unreadable, empty,
# a word this image does not ship, a file somebody edited by hand and left a
# stray character in -- all of them land on PROFILE_DEFAULT with a line naming
# what was found. The alternative, refusing to start on a bad profile, would let
# one mistyped word in a file under /var brick the appliance into a black screen
# with no console to fix it from, which is the exact failure this whole mechanism
# is supposed to make impossible.
#
# Written to stderr like every other message here, which is also why logging
# inside this function is safe: the caller reads stdout through a command
# substitution and the journal gets the rest.
read_display_profile() {
    _want=""
    if [ -r "$PROFILE_FILE" ]; then
        IFS= read -r _want < "$PROFILE_FILE" 2>/dev/null || _want=""
    fi

    # Whitespace and carriage returns only. Anything left is matched against the
    # list below, so this is normalising a trailing newline rather than trying to
    # make untrusted text safe.
    _want="$(printf '%s' "$_want" | tr -d '[:space:]')"

    case " $PROFILE_LIST " in
        *" $_want "*)
            log "display profile '$_want' (from $PROFILE_FILE)"
            printf '%s' "$_want"
            return 0
            ;;
    esac

    if [ -z "$_want" ]; then
        log "no display profile set; using the default '$PROFILE_DEFAULT'"
    else
        warn "$PROFILE_FILE names a profile this image does not ship; using '$PROFILE_DEFAULT'"
        warn "the profiles this image knows are: $PROFILE_LIST"
    fi
    printf '%s' "$PROFILE_DEFAULT"
}

# Which window profile this session runs, as one word from WINDOW_LIST.
#
# EVERY UNUSABLE ANSWER IS THE DEFAULT, and says so -- read_display_profile's
# argument verbatim, and it matters more here rather than less: `plain` is
# today's behaviour, so a machine that cannot read this file boots exactly as it
# did before the file existed.
read_window_profile() {
    _want=""
    if [ -r "$WINDOW_PROFILE_FILE" ]; then
        IFS= read -r _want < "$WINDOW_PROFILE_FILE" 2>/dev/null || _want=""
    fi

    _want="$(printf '%s' "$_want" | tr -d '[:space:]')"

    case " $WINDOW_LIST " in
        *" $_want "*)
            log "window profile '$_want' (from $WINDOW_PROFILE_FILE)"
            printf '%s' "$_want"
            return 0
            ;;
    esac

    if [ -z "$_want" ]; then
        log "no window profile set; using the default '$WINDOW_DEFAULT' (today's behaviour)"
    else
        warn "$WINDOW_PROFILE_FILE names a profile this image does not ship; using '$WINDOW_DEFAULT'"
        warn "the window profiles this image knows are: $WINDOW_LIST"
    fi
    printf '%s' "$WINDOW_DEFAULT"
}


# Re-resolved on every restart, not once at startup: D5's ten-second loop is
# scp the new build, kill the old process, and have the new one come back.
resolve_client() {
    if [ -e "$DEVMODE_FLAG" ] && [ -x "$DEV_CLIENT" ]; then
        printf '%s\n' "$DEV_CLIENT"
        return 0
    fi
    printf '%s\n' "$BAKED_CLIENT"
}

# Nothing here ever exits into a text console. When the guard trips the session
# holds the compositor up instead of returning, because returning would hand
# control back to greetd, which would start the session, which would start the
# client -- the same respawn loop one level up, running at boot speed.
hold_forever() {
    while :; do
        sleep 3600
    done
}

# M3's error screen, and the reason the hold above is no longer the last word.
#
# The guard tripping used to leave the compositor up with nothing drawn: a black
# TV, indefinitely, on a machine with no console, no getty and no visible text.
# Every other failure on this appliance announces itself in the journal; this one
# announced itself as furniture.
#
# THE BAKED CLIENT, NEVER THE DEV OVERRIDE, and that is deliberate. D5's override
# is the most likely thing to have just crashed five times -- it is whatever
# someone scp'd onto the machine two minutes ago. The image's own binary is the
# one with a build behind it, so it is the one asked to draw the apology.
#
# Not supervised, and not restarted if it dies. A respawn loop around the thing
# that reports a respawn loop is how a diagnostic becomes the fault. One attempt;
# if it exits or was never executable, fall through to the silent hold, which is
# exactly the behaviour that was there before this existed. The journal has the
# reason either way -- that is the part that never depended on a picture.
show_error_screen() {
    if [ ! -x "$BAKED_CLIENT" ]; then
        err "no baked client to draw an error screen with; holding a blank screen"
        hold_forever
    fi

    log "drawing the error screen with $BAKED_CLIENT"
    MARWANOS_SHELL_ERROR_SCREEN=1 "$BAKED_CLIENT"
    err "the error screen itself exited with status $? -- holding a blank screen"
    hold_forever
}

# Is Steam actually on this machine?
#
# ASKED, NEVER ASSUMED. A fresh stick has no Steam -- it is a flatpak
# marwanos-flatpak-install fetches on first boot, or that somebody installs
# from the store screen weeks later -- and `flatpak run` on an app that is not
# installed fails in milliseconds. Without this check every such machine would
# carry a spawn-fail-sleep loop for the life of its session, burning its whole
# exit budget in the first two and a half minutes and leaving five confusing
# lines in the journal of an appliance where nothing is wrong.
#
# `flatpak info --system` is the same question marwanos-appctl and
# marwanos-flatpak-install ask about every other app in this tree, so there is
# one answer to "is this installed" and this file did not invent a second one.
# --system rather than --user because that is the only installation this image
# has: the shell installs into it and nothing here ever writes a user remote.
steam_installed() {
    command -v flatpak >/dev/null 2>&1 || return 1
    flatpak info --system "$STEAM_FLATPAK_ID" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# THE SERVICE SEAM, and it needs no root at all.
#
# The shell's top bar shows one icon per background service -- lit when it is
# running, grey when it is not -- and its menu can start and stop them. Every
# other reverse channel in this project goes through a privileged consumer
# because the thing being changed belongs to root. This one does not: the
# background Steam client runs as `player`, this session runs as `player`, and
# the shell runs as `player`. Three processes, one uid, and the state they are
# arguing about is a flatpak owned by that uid.
#
# So the files live under $RUNTIME -- /run/user/1000/marwanos -- which logind
# created for this user and nothing else can write. No unit, no allow-list, no
# rename-then-read dance against a hostile writer, because there is no privilege
# boundary here to defend.
#
#   this writes   $RUNTIME/services/<id>.state    running | stopped | starting
#   the shell     $RUNTIME/services/<id>.wanted   1 | 0
#
# WHY `wanted` RATHER THAN THE SHELL KILLING THINGS ITSELF. The supervisor below
# restarts the client when it exits -- that is its whole job -- so a shell that
# killed Steam directly would watch it come back thirty seconds later and look
# broken. One owner of the lifecycle, and the shell expresses a WISH rather than
# performing an action.
SERVICE_DIR="$RUNTIME/services"

service_state() {
    install -d -m 0700 "$SERVICE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$2" > "$SERVICE_DIR/$1.state.tmp" 2>/dev/null \
        && mv -f "$SERVICE_DIR/$1.state.tmp" "$SERVICE_DIR/$1.state" 2>/dev/null
}

## Is a service wanted? ABSENT MEANS YES, which is the load-bearing default: a
## machine nobody has touched runs the client, exactly as it did before this
## seam existed, and the file only appears once somebody has chosen otherwise.
service_wanted() {
    _w=""
    [ -r "$SERVICE_DIR/$1.wanted" ] && IFS= read -r _w < "$SERVICE_DIR/$1.wanted" 2>/dev/null
    [ "$_w" != "0" ]
}

# The background client's own supervision loop, run as a child of the session
# so it inherits DISPLAY, the journal-connected descriptors and the session
# user without any of them being passed.
#
# THE SHELL KILLS THIS ON PURPOSE, AND THAT IS FINE. When a person closes a
# game from the home menu the shell runs `flatpak kill com.valvesoftware.Steam`
# -- the game and the client that launched it are one sandbox and there is no
# smaller thing to take down. This loop cannot tell that apart from a crash and
# does not try to: it counts an exit and comes back. Close costs a ~30s
# background respawn, which is invisible from the couch.
#
# Nothing here can delay or block the shell. It runs in the background, it is
# started after the client, and every path through it either sleeps or returns.
supervise_steam() {
    _steam_exits=0
    _steam_window_start="$(uptime_seconds)"

    while :; do
        # Steam's own output goes to /dev/null rather than to the journal, and
        # that is the difference between bounded log noise and a journal made
        # entirely of Steam. The client narrates asset loads, controller
        # enumeration and CEF chatter at info level; an hour of it would bury
        # every other service on this machine. What is worth knowing -- that it
        # started, that it stopped, that it is not coming back -- is said below
        # in this script's own voice, which is also the only voice
        # `journalctl -t marwanos-session` can be searched with.
        # THE WSI LEVER, and --env is how it has to be spelled. This session
        # exports ENABLE_GAMESCOPE_WSI=1 for everything, but Steam runs inside a
        # flatpak sandbox: setting a variable out here and hoping is how a
        # profile silently does nothing. `flatpak run --env=` puts it inside the
        # sandbox explicitly, which is the only place Steam will read it.
        #
        # Passed on EVERY profile except no-wsi rather than only on no-wsi, so
        # that what the client gets is stated by this line rather than inherited
        # from whatever the session's environment happened to contain -- the
        # difference between a lever and a coincidence.
        # STOPPED ON REQUEST, and this check is why the loop is shaped this way.
        # Somebody who turns Steam off from the shell's service menu must find it
        # still off a minute later; without this the supervisor would restart it
        # and the menu would read as a switch that does not switch.
        if ! service_wanted steam; then
            service_state steam stopped
            sleep 2
            continue
        fi

        # BACKGROUNDED, NOT BLOCKING, which is the other half of the same
        # requirement. `flatpak run` does not return until the client exits, so a
        # foreground call could not notice a stop request while the thing it
        # would be stopping was running -- the menu would do nothing until Steam
        # happened to quit on its own.
        if [ "$WINDOW_PROFILE" = "no-wsi" ]; then
            flatpak run --env=ENABLE_GAMESCOPE_WSI=0 "$STEAM_FLATPAK_ID" -silent >/dev/null 2>&1 &
        else
            flatpak run --env=ENABLE_GAMESCOPE_WSI=1 "$STEAM_FLATPAK_ID" -silent >/dev/null 2>&1 &
        fi
        _steam_pid=$!
        service_state steam running

        # Watch two things at once: the client, and the wish. `flatpak kill`
        # rather than killing _steam_pid, for stop_background_steam's reason --
        # `flatpak run` handed the sandbox to the session helper and is not the
        # client's parent, so signalling it would leave a logged-in Steam behind.
        while kill -0 "$_steam_pid" 2>/dev/null; do
            if ! service_wanted steam; then
                log "background Steam stopped from the shell's service menu"
                flatpak kill "$STEAM_FLATPAK_ID" >/dev/null 2>&1 || true
                break
            fi
            sleep 2
        done
        wait "$_steam_pid" 2>/dev/null
        _steam_status=$?
        service_state steam stopped

        # A stop that was ASKED FOR is not a crash, so it must not count against
        # the restart guard below -- otherwise toggling the menu five times would
        # exhaust the allowance and the service could never be started again this
        # boot. Back to the top, where the wanted check parks the loop cheaply.
        if ! service_wanted steam; then
            continue
        fi

        _steam_now="$(uptime_seconds)"
        if [ "$((_steam_now - _steam_window_start))" -ge "$STEAM_EXIT_WINDOW" ]; then
            _steam_exits=0
            _steam_window_start="$_steam_now"
        fi
        _steam_exits=$((_steam_exits + 1))

        # A fixed window rather than a sliding one, for the same reason the
        # client's guard uses one: a client that exits four times every five
        # minutes forever is broken in a way somebody can still see, and a
        # sliding window would silence it permanently on the fourth exit.
        if [ "$_steam_exits" -ge "$STEAM_EXIT_LIMIT" ]; then
            warn "background Steam exited $_steam_exits times in under ${STEAM_EXIT_WINDOW}s (last status $_steam_status); giving up until the next boot"
            warn "games still launch from the home menu -- they will just wait out a cold client first"
            return 0
        fi

        log "background Steam exited with status $_steam_status; restarting it in ${STEAM_RESTART_DELAY}s"
        sleep "$STEAM_RESTART_DELAY"
    done
}

# Start the background client, at most once per session.
#
# supervise_client calls this on every client restart, and a shell that crashed
# twice must not end up with two supervisors racing to run the same Steam. The
# guard is a flag rather than the pid, so a machine with no Steam answers
# `flatpak info` once instead of once per shell crash.
start_background_steam() {
    [ -z "${STEAM_STARTED:-}" ] || return 0
    STEAM_STARTED=1

    # THE DISCRIMINATOR, and it is checked before `steam_installed` so the
    # journal says which of the two reasons applied. The owner's report is that
    # the screen blacks and starts flickering the moment this client runs; this
    # is the profile that does not run it, and it is the only test that can tell
    # "Steam attaching reprograms the display" from "this panel flickers anyway".
    if [ "$WINDOW_PROFILE" = "no-bg-steam" ]; then
        # Said in the state file as well as the journal, so the shell's service
        # tray draws Steam grey rather than drawing nothing. "Off because
        # somebody chose a profile" and "off because this seam has never
        # reported" look identical on a television otherwise.
        service_state steam stopped
        log "the 'no-bg-steam' profile is set: NO background Steam this session"
        log "games still launch from the rail -- the first one waits out a cold client"
        log "if the screen is calm now, background Steam attaching to gamescope is the flicker"
        return 0
    fi

    if ! steam_installed; then
        service_state steam stopped
        log "Steam is not installed; the session starts no background client"
        return 0
    fi

    log "starting Steam in the background: -silent, no window, warm client for steam:// launches"
    supervise_steam &
    STEAM_SUPERVISOR_PID=$!
}

stop_background_steam() {
    [ -n "${STEAM_SUPERVISOR_PID:-}" ] || return 0
    kill "$STEAM_SUPERVISOR_PID" 2>/dev/null || true
    STEAM_SUPERVISOR_PID=""
    # Killing the loop does not kill the client: `flatpak run` handed the
    # sandbox to the flatpak session helper, so this shell is not its parent
    # and has no pid to signal. flatpak is the only thing that knows where it
    # went, so flatpak is asked -- otherwise a session that ends leaves a
    # logged-in Steam behind for the next one to collide with.
    flatpak kill "$STEAM_FLATPAK_ID" >/dev/null 2>&1 || true
}

# M3's supervision spec, scaffolded now because M1 is where the first client
# runs and a session that died to a console would fail D6 the first time the
# placeholder crashed.
#
# Restarts are immediate. "Back at the shell in under three seconds" is an exit
# criterion, so there is no backoff worth tuning; the guard is the only brake.
# The window is a fixed sixty seconds rather than a sliding one, deliberately:
# a client that crashes four times a minute forever is still broken, but it is
# broken in a way a human can see and fix, and a sliding window would trap it
# in the hold where nothing is visible at all.
supervise_client() {
    _crashes=0
    _window_start="$(uptime_seconds)"

    while :; do
        _client="$(resolve_client)"

        if [ ! -x "$_client" ]; then
            err "client $_client is missing or not executable"
            # Worth trying: the usual cause is a dev override that was deleted or
            # arrived without its executable bit, and show_error_screen reaches
            # for the baked client, which is a different file entirely.
            show_error_screen
        fi

        # BACKGROUNDED AND WAITED FOR, and ordering is the only reason.
        #
        # There has to be a moment where the shell process genuinely exists and
        # this loop is still executing, because the background Steam client is
        # allowed to start strictly after the shell and never in front of it --
        # a cold Steam start competing with the shell's first frame for a USB
        # stick's read bandwidth is exactly the boot the 2026-08-05 film already
        # measured at 74 seconds. `wait` hands back the same exit status the
        # foreground run did, so nothing below this line changed.
        log "starting client $_client"
        "$_client" &
        _client_pid=$!

        # After the shell exists, before anything blocks on it. Returns
        # immediately in every case: not installed is one log line, installed
        # is a `&`.
        start_background_steam

        # WAIT UNTIL THE CLIENT IS ACTUALLY GONE, not merely until `wait`
        # returns. POSIX has `wait` return as soon as a TRAPPED signal arrives,
        # whether or not the child has exited -- and this script traps TERM and
        # INT. Taking the first return at face value would read a SIGTERM on
        # session teardown as a client crash and answer it by starting a second
        # shell against a compositor that stop_gamescope had just killed. The
        # foreground run this replaced could not be fooled that way, so the
        # re-wait is what keeps the change to ordering and nothing else.
        while :; do
            wait "$_client_pid"
            _status=$?
            kill -0 "$_client_pid" 2>/dev/null || break
        done

        _now="$(uptime_seconds)"
        if [ "$((_now - _window_start))" -ge "$CRASH_WINDOW" ]; then
            _crashes=0
            _window_start="$_now"
        fi
        _crashes=$((_crashes + 1))

        err "client exited with status $_status (restart $_crashes of $CRASH_LIMIT within ${CRASH_WINDOW}s)"

        # A client cannot outlive its compositor, and restarting it against a
        # dead one would burn the whole crash budget in a second and land in the
        # hold for the wrong reason. Return instead: the session exits, greetd
        # starts it again, and the compositor comes back with it.
        if [ -n "${GAMESCOPE_PID:-}" ] && ! kill -0 "$GAMESCOPE_PID" 2>/dev/null; then
            err "compositor died underneath the client; ending the session so greetd restarts it"
            GAMESCOPE_PID=""
            return 1
        fi

        if [ "$_crashes" -ge "$CRASH_LIMIT" ]; then
            err "client crashed $_crashes times in under ${CRASH_WINDOW}s; not respawning"
            err "the compositor is still up; drawing the error screen"
            show_error_screen
        fi
    done
}

stop_gamescope() {
    [ -n "${GAMESCOPE_PID:-}" ] || return 0
    kill "$GAMESCOPE_PID" 2>/dev/null || true
    GAMESCOPE_PID=""
}

# gamescope as the DRM master.
#
# Returns nonzero if it did not come up, having already cleaned up after itself.
# There is nowhere for the caller to move to now (ADR 0005); the only thing left
# is to say why and hold.
## The connected output's preferred mode, as "WIDTHxHEIGHT", or nothing.
##
## WHY THIS HAS TO EXIST. gamescope has two resolutions, and only one of them
## defaults to something sensible. `--backend drm` picks the output's native
## mode for the OUTPUT (ADR 0005 measured 3440x1440), but the NESTED -- the
## surface clients actually render into -- defaults to 1280x720. With
## --force-windows-fullscreen sizing every window to "the size of the nested
## display", that means every application on this machine has been rendering at
## 720p and being upscaled to the panel. Reported from the bench on 2026-08-08
## as "Zen feels rendered at a very low resolution", which is exactly what it
## was. The shell hid it: its canvas_items stretch is resolution-independent by
## design, so soft text looked like a font choice rather than a scale factor.
##
## Read from sysfs rather than asked of gamescope, because it has to be known
## BEFORE gamescope starts. The first line of a connector's `modes` is its
## preferred mode, which is what a DRM client picks by default -- so this
## agrees with gamescope's own choice by construction rather than by luck.
##
## The connector preference list is walked in order, and only `connected` ones
## count. A bench with a different panel than the Predator's TV therefore gets
## its own native mode with no configuration.
detect_native_mode() {
    _pref="$MARWANOS_OUTPUT_CONNECTOR"
    # The list may end in '*', meaning "anything"; handled by the second pass.
    for _want in $(printf '%s' "$_pref" | tr ',' ' '); do
        [ "$_want" = "*" ] && continue
        for _c in /sys/class/drm/card*-"$_want"; do
            [ -r "$_c/status" ] || continue
            [ "$(cat "$_c/status" 2>/dev/null)" = "connected" ] || continue
            _mode="$(head -n 1 "$_c/modes" 2>/dev/null)"
            if [ -n "$_mode" ]; then printf '%s' "$_mode"; return 0; fi
        done
    done

    # Nothing in the preference list is connected; take the first connected
    # output that is not the internal panel. eDP is excluded because ADR 0007
    # disables it deliberately -- matching its mode would size the whole
    # session to a panel that is meant to stay dark.
    for _c in /sys/class/drm/card*-*; do
        case "$_c" in *eDP*|*LVDS*|*DSI*) continue ;; esac
        [ -r "$_c/status" ] || continue
        [ "$(cat "$_c/status" 2>/dev/null)" = "connected" ] || continue
        _mode="$(head -n 1 "$_c/modes" 2>/dev/null)"
        if [ -n "$_mode" ]; then printf '%s' "$_mode"; return 0; fi
    done
    return 1
}


start_gamescope() {
    _fifo="$RUNTIME/gamescope-ready"
    rm -f "$_fifo"
    mkfifo "$_fifo" || return 1

    # No client is handed to gamescope. gamescope shuts down when the child it
    # spawned exits, so passing the client would put the compositor inside the
    # supervision loop and take the whole screen down on every client crash.
    # Started bare, it stays up and only the client restarts -- which is what
    # M3's "no text visible at any point" actually requires. This is also how
    # ChimeraOS/gamescope-session does it, for the same reason.
    #
    # --backend drm is the standalone display session, as opposed to the nested
    # backends. It is the whole of what plan A is claiming.
    #
    # No --steam, no mangoapp, no HDR: those are the parts of the upstream
    # session that belong to Steam, not to a compositor taking DRM master.
    # --force-windows-fullscreen is what makes a placeholder satisfy M1's
    # acceptance wording rather than merely render: vkcube opens a small window
    # by default, and a 500x500 cube in the middle of a black TV proves the
    # compositor works while failing the gate. --hide-cursor-delay used to be 1
    # here as the "no cursor" half of the same gate; it is now
    # MARWANOS_CURSOR_HIDE_MS, because that gate was written when nothing on the
    # machine had a pointer and a browser now does. See the variable's own note.
    #
    # From M3 the shell sets its own fullscreen mode and hides its own cursor as
    # well, and that duplication is deliberate rather than sloppy: both flags are
    # plan A only. cage has no equivalent of either (ADR 0004 finding 9), so a
    # client that leans on the compositor for fullscreen and a hidden cursor
    # passes the gate under gamescope and fails it under cage -- which would read
    # as "Godot is broken under plan B" and is one of the criteria for flipping
    # the decision. Keep both flags anyway: they still cover anything run by hand.
    # THE X SERVER COUNT IS A WINDOW-PROFILE DECISION, which is why it is a
    # variable rather than the literal 1 it has been since M1. One server is
    # right for everything this session used to host: a single Godot client with
    # no second application in the picture. Steam's gamepadui is the case it was
    # never right for -- Valve's own session gives Steam two, one for the client
    # UI and one for the game it launches, so that a game mapping its window
    # cannot land in the same focus stack as the client's notifications. See the
    # WINDOW PROFILE block for why that is a candidate cause of the flicker.
    _xwayland_count=1
    case "$WINDOW_PROFILE" in
        steam-split) _xwayland_count=2 ;;
    esac

    set -- \
        --backend drm \
        --prefer-output "$MARWANOS_OUTPUT_CONNECTOR" \
        --xwayland-count "$_xwayland_count" \
        --hide-cursor-delay "$MARWANOS_CURSOR_HIDE_MS" \
        --ready-fd "$_fifo"

    if [ -n "${VK_DEVICE:-}" ]; then
        set -- "$@" --prefer-vk-device "$VK_DEVICE"
    fi

    # BOTH resolutions, explicitly. See detect_native_mode for why leaving the
    # nested one at its 1280x720 default made every application render at 720p.
    # Output and nested are set to the same value: this is an appliance on a
    # fixed panel, not a handheld trading resolution for frame rate, so there is
    # no reason for the compositing surface to differ from the display.
    if _mode="$(detect_native_mode)"; then
        _mw="${_mode%%x*}"
        _mh="${_mode##*x}"
        # Guard against a malformed modes file rather than passing junk to
        # gamescope, which would fail to start and take the session with it.
        case "$_mw$_mh" in
            *[!0-9]*|"") warn "unusable mode '$_mode' from sysfs; leaving gamescope to choose" ;;
            *)
                log "native mode ${_mw}x${_mh}; setting output and nested resolution to match"
                set -- "$@" -W "$_mw" -H "$_mh" -w "$_mw" -h "$_mh"
                ;;
        esac
    else
        warn "no connected output found in sysfs; leaving gamescope to choose its own resolution"
    fi

    # LOGGED EITHER WAY. Zen came up windowed on the bench and there was nothing
    # in the journal to say whether this flag had been passed -- so the next
    # boot answers that question in one line rather than by inference.
    #
    # `loose` is the one profile that drops it, and dropping it is not free: this
    # flag is what makes a placeholder satisfy M1's acceptance wording, and
    # without it Zen and Kodi open at whatever size they choose on a television.
    # It is a profile rather than a fix for that reason -- it is a diagnostic
    # question ("is forcing Steam's popups fullscreen the flicker?"), and the
    # answer being yes would mean finding a narrower way to keep it.
    if [ "$WINDOW_PROFILE" = "loose" ]; then
        log "window management: --force-windows-fullscreen is OFF for the 'loose' window profile"
        log "applications open at their own size; if Steam is calm now, that flag was the flicker"
    elif gamescope_has_option "--force-windows-fullscreen"; then
        set -- "$@" --force-windows-fullscreen
        log "window management: --force-windows-fullscreen is ON"
    else
        warn "gamescope --help ran and does NOT list --force-windows-fullscreen;"
        warn "applications will open at their own size and nothing will resize them"
    fi

    # STEAM INTEGRATION, AND THIS REVERSES A DECISION MADE ABOVE. The comment a
    # few lines up has said "No --steam ... that belongs to Steam, not to a
    # compositor taking DRM master" since M1, and it was right when it was
    # written: nothing on this machine was Steam, so a Steam-shaped flag was
    # somebody else's session leaking into ours. Steam is now the workload.
    #
    # -e is what teaches steamcompmgr Steam's window hierarchy -- the
    # STEAM_GAME / STEAM_BIGPICTURE / STEAM_OVERLAY atoms -- so it seats the one
    # window that is the UI and leaves the notifications, tooltips and CEF
    # helpers alone instead of treating each as another fullscreen candidate.
    #
    # PROBED AS --steam, PASSED AS -e, and they are the same option: the long
    # form is what appears in --help, the short form is what the getopt table
    # takes. Probing for the string that is actually printed is the whole point
    # of gamescope_has_option -- see its header for why a wrong answer here is a
    # silent loss of window management rather than a loud failure.
    case "$WINDOW_PROFILE" in
        steam-aware|steam-split)
            if gamescope_has_option "--steam"; then
                set -- "$@" -e
                log "steam integration: -e is ON (steamcompmgr knows Steam's windows)"
            else
                warn "gamescope --help ran and does NOT list --steam;"
                warn "the '$WINDOW_PROFILE' window profile cannot teach it Steam's window hierarchy"
            fi
            ;;
        *)
            log "steam integration: -e is OFF for the '$WINDOW_PROFILE' window profile"
            ;;
    esac

    # THE PROFILE'S OWN FLAGS. Everything above this line is the same under
    # every profile: the profile is a display configuration, not a different
    # session, and a switch that also moved the connector list or the resolution
    # would stop being an answer to "which of these four things is flickering".
    #
    # Each profile is chosen to kill a DIFFERENT theory, so that whichever one
    # the owner stops on names the cause:
    #
    #   steady     60 Hz + composited.  Kills (a) and (b) while keeping the
    #              ghosting fix. THE DEFAULT: the most likely fix, shipped.
    #   sixty-raw  60 Hz, NOT composited. Differs from steady by exactly one
    #              flag, so if this one is calm and steady is not, the cause is
    #              (c) -- --force-composition itself.
    #   flat       60 Hz + composited + no hardware planes. One step beyond
    #              steady for the case where the flicker is libliftoff handing
    #              the display hardware overlay planes it mishandles on this
    #              driver -- the one lever in the display pipeline none of the
    #              other four touch. Last resort, and the only reason it exists
    #              is that the bench is unreachable: without it, an owner for
    #              whom steady does not work has nothing else to try.
    #   native     Today's exact behaviour. The escape hatch back, and the
    #              fallback a rejected profile lands on.
    #   raw        Preferred refresh, nothing forced. The baseline every other
    #              profile is a delta from.
    #
    # Adaptive sync appears in none of them because it cannot: --adaptive-sync is
    # an enable-only flag and this session has never passed it, so VRR has been
    # off at the compositor the whole time. See the PROFILE_FILE block.
    case "$DISPLAY_PROFILE" in
        steady|sixty-raw|flat) _profile_refresh=1 ;;
        *)                     _profile_refresh=0 ;;
    esac
    case "$DISPLAY_PROFILE" in
        steady|flat|native) _profile_composite=1 ;;
        *)                  _profile_composite=0 ;;
    esac
    case "$DISPLAY_PROFILE" in
        flat) _profile_planes=1 ;;
        *)    _profile_planes=0 ;;
    esac

    # -r, and the honest name for it is "the only refresh figure this gamescope
    # takes". 3.16.23 has no --output-refresh at all -- the parser rejects it --
    # so this is both the frame-pacing rate and whatever the DRM path uses to
    # pick a mode. What it certainly does is deliver frames at a constant 60
    # instead of at whatever rate a UI that idles and then animates happens to
    # produce, and a constant delivery rate is what theory (a) needs removed.
    if [ "$_profile_refresh" = 1 ]; then
        if gamescope_has_option "--nested-refresh"; then
            set -- "$@" -r "$PROFILE_REFRESH"
            log "refresh: -r ${PROFILE_REFRESH} (fixed; no adaptive sync is asked for, so VRR stays off)"
        else
            warn "gamescope --help ran and does NOT list --nested-refresh;"
            warn "the '$DISPLAY_PROFILE' profile cannot pin a refresh rate and the panel keeps its preferred mode"
        fi
    else
        log "refresh: not specified -- the panel's preferred mode, whatever that is"
    fi

    # ALWAYS COMPOSITE; NEVER SCAN A CLIENT OUT DIRECTLY. Without this,
    # gamescope hands a fullscreen client's buffer straight to the display when
    # it thinks it can, and on this NVIDIA driver that path is where the
    # 2026-08-10 bench videos came from: the store screen composited twice at
    # two offsets, tween trails burned into the frame, the UI's left edge
    # hanging off the panel. Those are damage-tracking artifacts of the
    # scanout/composite handoff, a known weakness of that path on NVIDIA, and
    # forcing the compositor to actually composite every frame is the
    # documented way out. The cost is one blit per frame the GPU does not
    # notice; the benefit is that what is on the TV is what some client drew,
    # every frame, always.
    #
    # Profile-gated now rather than unconditional, because "the ghosting fix is
    # also the flicker cause" is a live theory and there was no way to test it
    # without a profile that drops it. sixty-raw and raw are that test.
    if [ "$_profile_composite" = 1 ]; then
        if gamescope_has_option "--force-composition"; then
            set -- "$@" --force-composition
            log "composition: --force-composition is ON"
        else
            warn "gamescope --help ran and does NOT list --force-composition;"
            warn "direct scanout stays possible, and with it the NVIDIA ghosting the"
            warn "2026-08-10 videos showed"
        fi
    else
        log "composition: --force-composition is OFF for the '$DISPLAY_PROFILE' profile"
        log "if the ghosting from the 2026-08-10 videos comes back, that flag was the fix"
    fi

    # libliftoff, off. Hardware overlay planes are the layer BELOW composition:
    # --force-composition stops a client's buffer being scanned out directly,
    # and this stops gamescope's own output being assembled by the display
    # controller's planes instead of by the GPU. On NVIDIA that assembly is the
    # least exercised path in the stack, and a plane that is programmed a frame
    # late is seen as a flash. Only `flat` asks for it: it costs GPU work every
    # frame and it is worth spending only once the cheaper theories are out.
    if [ "$_profile_planes" = 1 ]; then
        if gamescope_has_option "--disable-layers"; then
            set -- "$@" --disable-layers
            log "planes: --disable-layers is ON (the GPU assembles every frame, not the display hardware)"
        else
            warn "gamescope --help ran and does NOT list --disable-layers;"
            warn "the '$DISPLAY_PROFILE' profile is then the same as 'steady'"
        fi
    fi

    log "starting gamescope with the '$DISPLAY_PROFILE' display profile and the '$WINDOW_PROFILE' window profile: $*"
    gamescope "$@" &
    GAMESCOPE_PID=$!

    # gamescope opens the ready fd O_WRONLY while parsing arguments -- which on
    # a fifo blocks until a reader appears -- and writes "<x-display>
    # <wayland-display>" to it once the backend is genuinely up.
    #
    # Reading that with a timeout is a stronger test than watching for a nonzero
    # exit inside five seconds. The plausible NVIDIA failure is not a clean
    # crash; it is a gamescope that starts, takes DRM master, and then sits
    # there having drawn nothing, holding the display hostage. An exit-status
    # check calls that success and leaves a black TV. This does not.
    _handshake="$(timeout "$READY_TIMEOUT" head -n 1 "$_fifo" 2>/dev/null || true)"
    rm -f "$_fifo"

    if [ -z "$_handshake" ]; then
        # Which of the two it was decides whether raising READY_TIMEOUT again
        # would help, and the message this replaced could not tell them apart.
        # Still running means slow or wedged; already gone means it died during
        # startup and the timeout is irrelevant.
        if kill -0 "$GAMESCOPE_PID" 2>/dev/null; then
            err "gamescope is still running after ${READY_TIMEOUT}s but never reported ready"
            err "that is slow-or-wedged, not crashed: the ready fd is written only after every Xwayland server is up"
        else
            err "gamescope exited before reporting ready within ${READY_TIMEOUT}s"
        fi
        err "there is no fallback compositor any more -- see docs/adr/0005"
        stop_gamescope
        return 1
    fi

    if ! kill -0 "$GAMESCOPE_PID" 2>/dev/null; then
        err "gamescope reported ready and then exited"
        GAMESCOPE_PID=""
        return 1
    fi

    # WAYLAND_DISPLAY is deliberately not exported, and that omission is the whole
    # of how the shell chooses a display server. Godot's default linuxbsd driver
    # is x11 and it falls back in both directions: with DISPLAY set and
    # WAYLAND_DISPLAY unset it runs on gamescope's XWayland, which is the path
    # gamescope's window management -- including --force-windows-fullscreen --
    # actually acts on; under cage, where DISPLAY does not exist and cage sets
    # WAYLAND_DISPLAY for its own child, the same binary runs native Wayland on
    # wlroots. One export, correct under both plans, which is what D4 means when
    # it says the shell code is identical either way.
    #
    # Do not "modernise" this by adding gamescope's --expose-wayland and copying
    # GAMESCOPE_WAYLAND_DISPLAY into WAYLAND_DISPLAY. It moves the shell onto
    # gamescope's least-exercised path -- native Wayland clients under gamescope
    # are a long-standing broken area upstream -- to gain nothing a kiosk with no
    # decorations, no second window and no clipboard needs.
    # FIRST TOKEN AND LAST TOKEN, which is what makes this survive
    # --xwayland-count 2. With one server the handshake is "<x> <wayland>" and
    # the two expansions take one each. With two it gains an X display in the
    # middle, and first-and-last still lands on the primary X server -- the one
    # the shell must run on -- and on the wayland name. An index-based parse
    # would have picked the game's server for the shell the first time somebody
    # chose the steam-split profile, which is a black screen for a shell that
    # started perfectly well.
    DISPLAY="${_handshake%% *}"
    GAMESCOPE_WAYLAND_DISPLAY="${_handshake##* }"
    export DISPLAY GAMESCOPE_WAYLAND_DISPLAY

    log "gamescope ready on DISPLAY=$DISPLAY WAYLAND=$GAMESCOPE_WAYLAND_DISPLAY"
    return 0
}

# gamescope could not take the display. Returning here would hand control back to
# greetd, which would start the session again, which would fail again: an
# unbounded loop that buries its own diagnosis in repeated log spam. Hold
# instead, so the journal's first failure is the one still on screen.
#
# This is where the removed cage fallback used to lead, and the difference is the
# point of ADR 0005. The old path reached a picture by silently becoming a
# different appliance; this one stops and says why. On a machine whose only
# triage surface is the journal, a failure that is legible beats one that is
# survivable-but-mute.
compositor_dead_end() {
    err "gamescope could not take the display -- the session is holding rather than looping"
    err "there is no fallback compositor by design (docs/adr/0005)"
    err "read the first failure above; recover over tty2 or devmode ssh"
    hold_forever
}

# XDG_RUNTIME_DIR comes from pam_systemd. If it is missing there is no logind
# session, which means no seat, which means no DRM master and nothing that
# follows can work -- so say so plainly and carry on to fail somewhere the
# journal can explain, rather than dying here with no context.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    err "XDG_RUNTIME_DIR is unset: pam_systemd did not create a logind session"
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
fi

RUNTIME="$XDG_RUNTIME_DIR/marwanos"
mkdir -p "$RUNTIME"

# Environment.
#
# Mined from ChimeraOS/gamescope-session, which is the session bazzite forks --
# the `bazzite-org/gamescope-session` that the plan and ADR 0002 name no longer
# exists as a public repository (see ADR 0004). Almost everything that script
# exports is Steam, Proton, RADV and mangohud tuning that means nothing to a
# machine with no Steam on it, and copying it would be inventing constraints
# nobody here has. What is kept is the part that is about a compositor taking
# DRM master on NVIDIA.
#
# What is deliberately not set: __NV_PRIME_RENDER_OFFLOAD and
# __GLX_VENDOR_LIBRARY_NAME, because PRIME offload is the opposite of what this
# does -- the dGPU is the DRM master here, not a device being offloaded to. And
# WLR_NO_HARDWARE_CURSORS / WLR_RENDERER=vulkan, the classic wlroots-on-NVIDIA
# workarounds that only matter to plan B: Universal Blue deleted its copy of
# those in December 2025 alongside adding driver 590 support, which is the best
# evidence available that current drivers no longer need them. If cage misbehaves
# during the spike they are the first thing to try, not the first thing to ship.

# gamescope's Vulkan WSI layer, which gives the client a present path gamescope
# controls rather than one it has to infer. A no-op if the layer is not
# installed, so setting it early costs nothing.
export ENABLE_GAMESCOPE_WSI=1

# Godot's Wayland backend dlopens libdecor to draw client-side decorations, and
# upstream documents that loading it has quirks worth avoiding. Neither plan has
# anything to decorate -- gamescope forces its windows fullscreen, cage runs a
# single client -- so the code path is risk with no benefit. A no-op under plan A,
# where the shell talks to XWayland and never reaches the Wayland backend at all,
# which is why it is set unconditionally rather than per compositor.
export GODOT_WAYLAND_DISABLE_LIBDECOR=1

# THE NVIDIA GL KNOBS, AND EXACTLY WHAT THEY DO NOT COVER.
#
# Both are in the `__GL_` namespace, which is the proprietary driver's OpenGL
# configuration and nothing else. They bind GL clients -- Xwayland applications
# drawing with OpenGL, which on this machine is most games, Kodi, and the shell
# whenever it is run with --rendering-method gl_compatibility. They do NOT reach
# gamescope: gamescope composites with Vulkan and owns the KMS flip itself, so
# neither of these is the thing that decides whether the panel runs at a variable
# refresh. That decision is gamescope's --adaptive-sync, which is never passed.
#
# Set anyway, because on the theory that the flicker is variable presentation
# they remove one more source of it for free, they are inherited by every client
# without any of them being asked, and neither can misbehave: VRR_ALLOWED=0 is
# the conservative direction and SYNC_TO_VBLANK=1 is already the driver default,
# stated here so it cannot be changed underneath by a driver update or a stray
# profile in the NVIDIA application registry.
export __GL_VRR_ALLOWED=0
export __GL_SYNC_TO_VBLANK=1

# gamescope defaults these under $HOME. Naming them keeps the negotiated mode
# and the patched EDID somewhere stable across reboots, which matters most for
# the one display whose handshake is least predictable -- the TV.
export GAMESCOPE_MODE_SAVE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/modes.cfg"
export GAMESCOPE_PATCHED_EDID_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/edid.bin"
mkdir -p "$(dirname "$GAMESCOPE_MODE_SAVE_FILE")"

VK_DEVICE="$(detect_nvidia_vk_device || true)"
if [ -n "$VK_DEVICE" ]; then
    # "will be asked to prefer" rather than "pinned", because gamescope's
    # --prefer-vk-device is a preference and not a pin: if the NVIDIA ICD fails to
    # enumerate, gamescope takes whatever device it did find and says nothing
    # about it. The wording matters in exactly the journal someone reads when the
    # wrong GPU rendered. Measured working on 2026-08-05 -- the shell reported
    # adapter "NVIDIA GeForce RTX 3060 Laptop GPU" (ADR 0005).
    log "gamescope will be asked to prefer NVIDIA vulkan device $VK_DEVICE"
else
    warn "no NVIDIA PCI display device found; the compositor will choose a device itself"
    warn "on this chassis that may be the Intel iGPU, which is the wrong card entirely"
fi

# Pre-flight, and it is logging rather than control flow on purpose.
#
# gamescope with zero connected connectors on the device it opened is a FALSE
# GREEN: it logs that it cannot find any connected connector, unsets the connector
# and the mode, publishes a wlserver output described as a virtual screen, and
# returns success -- so it stays up and writes the ready fd. With the internal
# panel disabled and no TV attached, that is exactly the state this appliance
# boots into, and it is why compositor_dead_end is not reached by it. The session
# cannot fix it, but a black screen that says why in the journal is a different
# object from a black screen that reports healthy.
if nvidia_output_connected; then
    log "an external display is connected to the NVIDIA card"
else
    err "no display connected to the NVIDIA card -- the compositor will come up with no picture"
    err "gamescope reports success in this state (virtual screen), so a green session here means nothing"
fi

# WLR_DRM_DEVICES used to be exported here, and it is gone with cage. It only
# ever meant anything to wlroots, and nothing in this session runs wlroots any
# more -- an export that pins a GPU for a compositor that never starts is not
# harmless, it is a line someone reads later and reasons from.
#
# The reasoning it carried is worth keeping, so it lives in ADR 0005: unset,
# wlr_session_find_gpus() moves the PCI boot_vga device to index 0, which on this
# hybrid chassis is the iGPU, so plan B would have composited on Intel and fed the
# NVIDIA output by cross-GPU blits. That is one of the reasons gamescope won --
# it can be pinned by PCI id with a flag, and cage cannot.
#
# The internal panel is dropped by marwanos-panel.service, not by anything here.
# detect_nvidia_drm_node() went with this block for the same reason; the node is
# not needed now that the only consumer is gone.

GAMESCOPE_PID=""
STEAM_STARTED=""
STEAM_SUPERVISOR_PID=""
trap 'stop_gamescope; stop_background_steam' EXIT INT TERM

DISPLAY_PROFILE="$(read_display_profile)"
WINDOW_PROFILE="$(read_window_profile)"

# THE SHELL IS TOLD WHAT THIS SESSION ACTUALLY APPLIED, and that is a different
# fact from what /var/marwanos/window.profile says. Between somebody pressing A
# on the settings row and the machine being restarted, the file names the NEXT
# session's profile while this one is still running the old one -- and `yield` is
# a word the shell acts on, so a shell that read the file would start unmapping
# its own window the instant the row was pressed, several minutes before the
# compositor it is coordinating with had changed at all.
#
# An environment variable rather than a state file because the session runs as
# `player` and /run/marwanos is root's -- but it is also the honest shape: this
# is the running session telling its own child what it did, which is exactly the
# relationship DISPLAY and GAMESCOPE_WAYLAND_DISPLAY already have.
export MARWANOS_WINDOW_PROFILE="$WINDOW_PROFILE"

# A PROFILE CAN NEVER BRICK THIS MACHINE, and this is the whole of that promise.
#
# The flags a profile adds are the flags most likely to be refused: a gamescope
# that does not know -r, or a --disable-layers that turns out to be fatal on this
# driver, exits during startup or comes up wedged, and start_gamescope's ready
# handshake catches both. Without a retry that would be a black TV, permanently,
# chosen by a button somebody pressed on the couch to stop their headache -- the
# single worst outcome this feature could produce.
#
# So: one retry, with `native`, which is the configuration this machine has
# actually booted repeatedly. ONE, not a walk down the list -- a session that
# tried five configurations would take minutes of black screen to arrive
# somewhere unpredictable, and the point of ADR 0005 is that this appliance
# fails legibly rather than survives mutely.
#
# THE PROFILE FILE IS NOT REWRITTEN, deliberately, and it could not be: this
# session runs as `player` and /var/marwanos is root's. So the rejected choice
# survives the reboot and the settings screen still names it, which is what lets
# somebody see what they picked and pick again. A session that silently repaired
# the file would be the compositor lever ADR 0005 removed, wearing a new hat.
## BOTH AXES FALL BACK TOGETHER, and that is deliberate rather than lazy. The
## retry's whole job is to reach a picture, so it has to go to the one
## configuration this machine is known to boot -- and that is both known-good
## words at once, not a known-good display profile still carrying whichever
## window profile might have been what gamescope refused. `-e` on a gamescope
## that does not take it, or --xwayland-count 2 on one that cannot start a second
## server, fails in exactly the same place as a bad display flag does, and the
## handshake cannot say which of the two caused it.
##
## Naming both in the journal matters for the same reason: the person reading it
## has two settings rows to choose between and the message is what tells them
## which one they changed last.
start_gamescope_or_fall_back() {
    start_gamescope && return 0

    if [ "$DISPLAY_PROFILE" = "$PROFILE_FALLBACK" ] && [ "$WINDOW_PROFILE" = "$WINDOW_FALLBACK" ]; then
        err "the '$PROFILE_FALLBACK' display profile and '$WINDOW_FALLBACK' window profile could not start gamescope either"
        err "this is not a profile problem: there is nothing safer left to try"
        return 1
    fi

    err "gamescope REJECTED the '$DISPLAY_PROFILE' display profile with the '$WINDOW_PROFILE' window profile"
    err "retrying ONCE with '$PROFILE_FALLBACK' + '$WINDOW_FALLBACK', which is this machine's known-good configuration"
    err "$PROFILE_FILE still says '$DISPLAY_PROFILE' -- change it from Settings > Display"
    err "$WINDOW_PROFILE_FILE still says '$WINDOW_PROFILE' -- change it from Settings > Steam"
    DISPLAY_PROFILE="$PROFILE_FALLBACK"
    WINDOW_PROFILE="$WINDOW_FALLBACK"
    # RE-EXPORTED, because the shell has not started yet and what it is told has
    # to be what this session actually applied. Without this line a failed
    # `yield` boot would come up with the fallback's window handling and a shell
    # still unmapping itself for a compositor that was no longer expecting it.
    export MARWANOS_WINDOW_PROFILE="$WINDOW_PROFILE"
    start_gamescope
}

if start_gamescope_or_fall_back; then
    supervise_client
else
    compositor_dead_end
fi
