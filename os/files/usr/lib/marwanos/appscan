#!/usr/bin/env bash
#
# Enumerate the applications actually installed on this machine, the way a
# desktop's app launcher does, and write them where the shell can render them.
#
# WHY THIS EXISTS. The home rail used to show twelve hard-coded placeholders.
# They were honest scaffolding -- they proved the rail slid, clipped and
# traversed before there was anything real to put on it -- but a shipped
# appliance showing "Placeholder Seven" is a lie about what is installed. This
# replaces them with the truth, and the truth on a fresh stick is often
# "nothing", which the shell draws as an empty state rather than hiding.
#
# WHY A SYSTEM SERVICE AND NOT A SCAN IN THE SHELL. Same rule as netcheck: the
# shell is a renderer. It has no business walking XDG directories, parsing
# desktop entries or resolving icon themes, and the desk harness runs it under
# --network=none with no /usr/share/applications worth reading anyway. The
# system answers; the shell draws. This also retires cleanly -- Phase 1's
# marwand does exactly this job over JSON-RPC (`ListInstalled`, joined against
# AppStream), and when it lands this file and its unit are deleted whole.
#
# THE FILTER IS GNOME'S, because "like the apps launcher" is the brief and
# because the rules are the freedesktop spec's rather than invented here:
# Type=Application, not NoDisplay, not Hidden, and TryExec (if given) must
# resolve. Terminal=true is ALSO excluded, which GNOME does not do -- and that
# is deliberate. This appliance ships no terminal emulator, so launching htop
# would spawn a process with nowhere to draw: a card that does nothing when
# pressed, which is the exact failure this project keeps designing against.
#
# STORE APPS ARE IN THE LISTING, AND THE SHELL KEEPS THEM OFF THE RAIL. Steam
# has its own page under the stores screen, and putting it on the rail as well
# would give one thing two homes -- but that is a PLACEMENT decision, and this
# file used to make it by omission (an EXCLUDE_IDS list), which turned the TSV
# from "what is installed" into "what the rail shows". The stores screen reads
# this same file to answer "is Steam here yet", so the omission meant Steam
# could never BE here: its page offered to install it forever, its tab never
# found the real icon, and the rail offered it as a download it already had.
# Now every installed app is emitted and shell_root._populate filters store
# apps off the rail using the catalogue's own store list -- the system
# answers, the shell decides placement. Phase 1 keeps the same split.
#
# STEAM GAMES ARE IN THE LISTING TOO, because the rail's brief is the whole
# library and a game installed INSIDE Steam is invisible to every desktop-entry
# walk above: Steam on Linux does not drop a .desktop file per game (that is a
# per-title "create shortcut" action someone takes with a mouse, not an install
# side effect). So the scanner also reads Steam's own installation records --
# one appmanifest_<appid>.acf per installed app under steamapps/ -- and emits a
# card per fully-installed game that launches back through Steam. A machine
# without Steam, or with Steam and no games, simply contributes zero rows: no
# steamapps directory is the normal state of a fresh stick, not a warning.
#
# THE ART FOR THOSE CARDS ARRIVES FROM A SECOND SERVICE, and the seam between
# them is a file rather than a call. Steam's local art cache only fills once
# its own UI has drawn the game, so a freshly installed game is a row with an
# empty icon column -- and that empty column is the request. marwanos-storeart
# reads this TSV, downloads what is missing from Valve's CDN, and the next poll
# here republishes the row with a path in it. See steam_art() for the full
# choreography and why nothing has to be ordered against anything.
#
# GAMES ALSO GET A SECOND FILE, /run/marwanos/gameart.tsv, and apps.tsv did not
# change to make room for it. A game has three pictures worth naming and the
# record here has one icon field; growing a seventh column would break every
# shell that counts six. See the GAMEART constant below for the join the shell
# does instead, and scan_gameart for the row shape.
#
set -uo pipefail

TAG=marwanos-appscan
STATE_DIR=/run/marwanos
APPS="$STATE_DIR/apps.tsv"

# THE SECOND FILE, AND WHY IT IS A SECOND FILE.
#
# apps.tsv has exactly one icon column, and the shell has parsed six fields per
# record since the rail stopped being placeholders. Games now have THREE
# pictures worth naming -- the portrait a card draws as its tile, the square
# icon Steam's client caches, and the wide hero the shell wants full-bleed
# behind a focused card -- and there is no honest way to put three paths in one
# field. Adding a seventh column would have been the obvious move and it is a
# breaking change: installed.gd treats a record whose field count is not six as
# malformed and skips it, so a scanner that grew a column would empty the rail
# of every machine running an older shell, including one mid-upgrade.
#
# So apps.tsv is untouched, down to the byte: its icon column is still
# portrait-first exactly as steam_art() has always chosen it. The extra art
# rides in a file of its own, which nothing older than it knows to read and
# nothing older than it is broken by.
#
# THE SEAM: the shell joins apps.tsv rows with gameart.tsv rows BY ID. A
# gameart row is `steam.<appid>TAB<icon or empty>TAB<hero or empty>`, one per
# installed game, with the same id string that starts the game's apps.tsv
# record. A game with no gameart row, an empty column in the row it has, or no
# gameart.tsv at all are all the same answer -- "nothing extra to draw" -- and
# the card falls back to what apps.tsv gave it. That is the same join a
# database would call a left outer one, and it is deliberately the kind of join
# where the right-hand side missing costs nothing.
GAMEART="$STATE_DIR/gameart.tsv"

# How often to look for a CHANGE. The scan itself only re-runs when one of the
# watched paths has a newer mtime, so this is a stat of a handful of
# directories and manifest files, not a re-parse -- cheap enough at this
# interval on a USB stick, and fast enough that an app installed while the
# rail is on screen shows up without anyone rebooting.
INTERVAL=10

# Where applications come from, in the freedesktop order. The flatpak export
# directory is the one that matters after first boot: it is where Steam and
# anything else installed from Flathub lands.
APP_DIRS=(
    /usr/share/applications
    /usr/local/share/applications
    /var/lib/flatpak/exports/share/applications
    /var/home/player/.local/share/applications
    /var/home/player/.local/share/flatpak/exports/share/applications
)

# Icon theme roots, searched in this order. hicolor is the spec's fallback
# theme and the one flatpak exports into.
ICON_ROOTS=(
    /var/lib/flatpak/exports/share/icons/hicolor
    /var/home/player/.local/share/flatpak/exports/share/icons/hicolor
    /usr/share/icons/hicolor
)

# The sizes searched, split into the two the cards can use directly and the
# ones that lose to a scalable icon. See icon_path for the ordering argument.
# Largest first within each group: the cards are 200-340 px on a 1080p design
# surface, so a 256 px icon is the smallest that is not visibly soft.
ICON_SIZES_LARGE=(512x512 256x256)
ICON_SIZES_SMALL=(128x128 96x96 64x64 48x48)

# Steam's library state, which no desktop-entry walk can see. The root is the
# flatpak app's private home under the player user -- the same fixed
# /var/home/player the APP_DIRS above use, because the appliance has exactly
# one user, created by sysusers at uid 1000, and resolving it dynamically
# would be ceremony around a constant.
STEAM_DATA=/var/home/player/.var/app/com.valvesoftware.Steam/.local/share/Steam
STEAM_LIBCACHE="$STEAM_DATA/appcache/librarycache"

# TWO LIBRARIES ARE WALKED, NOT ONE, and the second is the one this appliance
# actually fills. Since the 2026-08-12 rebuild (ADR 0010) downloads are driven
# by marwanos-steam into ~player/Games, which is a Steam library folder in the
# ordinary sense -- steamapps/ with an appmanifest per game -- registered with
# the client through libraryfolders.vdf so the client can launch what we
# fetched. The client's own private steamapps is still walked because a game
# installed through the client itself before the rebuild, or by any future
# path, still belongs on the rail.
#
# THE MANIFEST FORMAT IS THE WHOLE INTEGRATION. marwanos-steam writes the same
# StateFlags / BytesDownloaded / BytesToDownload keys Valve's client writes, so
# the download-progress rendering below needs no second code path and the rail
# shows a percentage for a download this repo is performing itself.
#
# Order matters only for duplicates: a game present in both is emitted from
# whichever is walked first, and ours is walked first because ours is the copy
# this machine downloaded and the one the manifest describes accurately.
#
# THE NESTING IS NOT DECORATIVE. The library root is Games/SteamLibrary and not
# Games itself, because the flatpak client has to be granted the PARENT of a
# library folder to use it -- granted the root alone it fails to add it and says
# nothing (Valve issue #10487). So `Games` is what the override exposes and
# `Games/SteamLibrary` is what the client mounts. /var/home rather than /home
# for the same reason every other path here does: /home is a symlink on ostree
# and Steam does not follow symlinks in a library path.
STEAM_APPS_DIRS="/var/home/player/Games/SteamLibrary/steamapps $STEAM_DATA/steamapps"

# Where marwanos-steam lands artwork it fetched from the network, shared
# with the shipped applications' Flathub icons. Read-only from here: this
# scanner never downloads anything (the shell is not the only renderer in this
# tree that opens no sockets -- see this file's header), it just notices when a
# file has appeared. root-owned 0755, per tmpfiles.d/50-marwanos.conf.
STORE_ICON_DIR=/var/marwanos/store/icons

# WHERE THE GAME ARTWORK ACTUALLY COMES FROM NOW. marwanos-steam fetches a
# portrait and a hero per owned game into here, keyed by bare appid; the
# storeart-era names under STORE_ICON_DIR (steam.<appid>.jpg and its .header
# sibling) went out with the fetcher that wrote them, and leaving them in the
# fallback chains would have been three stat calls a scan against files nothing
# on this machine can ever create again.
#
# STORE_ICON_DIR itself is kept for the FLATHUB icons, which are a different
# thing with a different key (an application id, not an appid). It has no
# writer at the moment either -- storeart fetched both halves -- so an
# application that is not installed draws its fallback glyph until something
# fills it again. That is a smaller hole than it looks: every INSTALLED
# application resolves a real icon from its desktop entry, which is the walk
# this file is mostly about.
STEAM_ART_DIR=/var/marwanos/steam/art

info() { printf '<6>%s: %s\n' "$TAG" "$*"; }
err()  { printf '<3>%s: %s\n' "$TAG" "$*" >&2; }

install -d "$STATE_DIR" || err "cannot create $STATE_DIR -- the rail will stay empty"


## Reads one key from the [Desktop Entry] group of a desktop file.
##
## Pure bash rather than awk or a config parser, for two reasons: it keeps this
## script testable in environments without awk, and the parsing rules that
## matter are ones a general parser gets WRONG for this format -- only the
## first group counts (a [Desktop Action] group below it may repeat Name and
## Exec with different values), and localised keys like `Name[de]` must not
## satisfy a request for `Name`.
desktop_get() {
    local file="$1" key="$2" line in_entry=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '[Desktop Entry]') in_entry=1; continue ;;
            '['*)              [ "$in_entry" = 1 ] && return 0; continue ;;
        esac
        [ "$in_entry" = 1 ] || continue
        case "$line" in
            "$key="*) printf '%s' "${line#*=}"; return 0 ;;
        esac
    done < "$file"
    return 0
}


## Absolute path to an icon file for an icon name, or nothing.
##
## SVG IS ACCEPTED NOW, AND IT HAD TO BE. This was PNG-only on the reasoning
## that Godot loads PNG with certainty while SVG support depends on module
## availability -- so an application whose only icon is scalable fell back to
## the flat accent wash. That was not a rare edge: Zen (the browser then)
## shipped exactly one icon and it was an SVG, so its card on the TV was a
## coloured rectangle with no logo on it, which is what the rail looked like
## to the person using it.
##
## The shell rasterises SVG itself (see tile.gd) and falls back to the wash if
## its build cannot, so the failure this comment used to fear is still handled
## -- it is just handled at the end that can actually tell, rather than by
## refusing to name the file here.
##
## ORDER IS LARGE PNG, THEN SVG, THEN SMALL PNG, and that middle step is the
## point. A 48 px PNG scaled up into a 340 px focused card is visibly soft; the
## same icon as SVG is rasterised at whatever size is asked for. So a big PNG
## still wins -- it needs no rendering -- but scalable beats a small bitmap.
icon_path() {
    local name="$1" root size candidate

    [ -n "$name" ] || return 0

    # An absolute path is allowed by the spec and used by a few packages.
    case "$name" in
        /*)
            case "$name" in
                *.png|*.svg) [ -f "$name" ] && printf '%s' "$name" ;;
            esac
            return 0
            ;;
    esac

    for root in "${ICON_ROOTS[@]}"; do
        [ -d "$root" ] || continue
        for size in "${ICON_SIZES_LARGE[@]}"; do
            candidate="$root/$size/apps/$name.png"
            [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
        done
    done

    for root in "${ICON_ROOTS[@]}"; do
        [ -d "$root" ] || continue
        candidate="$root/scalable/apps/$name.svg"
        [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
    done

    for root in "${ICON_ROOTS[@]}"; do
        [ -d "$root" ] || continue
        for size in "${ICON_SIZES_SMALL[@]}"; do
            candidate="$root/$size/apps/$name.png"
            [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
        done
    done

    for candidate in "/usr/share/pixmaps/$name.png" "/usr/share/pixmaps/$name.svg"; do
        [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
    done

    return 0
}


## Turns a desktop Exec= into a command line the launcher can spawn.
##
## Field codes (%u %U %f %F %i %c %k and the rest) are dropped: they are
## placeholders for documents and icons that a launcher substitutes, and this
## appliance always launches an app with no arguments. A flatpak export is
## rewritten to `flatpak run <id>` from its X-Flatpak key rather than trusting
## the exported Exec line, which points at a wrapper path in the export
## directory that only exists while the export does.
exec_line() {
    local file="$1" flatpak_id exec_raw word out=""

    flatpak_id="$(desktop_get "$file" X-Flatpak)"
    if [ -n "$flatpak_id" ]; then
        printf 'flatpak run %s' "$flatpak_id"
        return 0
    fi

    exec_raw="$(desktop_get "$file" Exec)"
    [ -n "$exec_raw" ] || return 0

    for word in $exec_raw; do
        case "$word" in
            %*) continue ;;
            *)  out="${out:+$out }$word" ;;
        esac
    done
    [ -n "$out" ] || return 0

    # Resolve the program to an absolute path. Desktop entries routinely give
    # a bare name (Firefox ships `Exec=firefox`), which works for a launcher
    # that inherits a login shell's PATH -- and the shell spawns through
    # execvp, so it would in fact work here too. Resolving anyway means the
    # rail cannot be broken later by a PATH that differs between greetd's
    # session and this unit's, and it makes the journal line name the actual
    # binary rather than a word.
    local program="${out%% *}" rest_args="" resolved
    case "$out" in
        *" "*) rest_args="${out#* }" ;;
    esac
    case "$program" in
        /*) ;;
        *)
            resolved="$(command -v "$program" 2>/dev/null)"
            [ -n "$resolved" ] && program="$resolved"
            ;;
    esac
    printf '%s' "${program}${rest_args:+ $rest_args}"
}


## One TSV record per installed application, or nothing at all.
##
## Tab-separated because every field except the name is a path or an id, and a
## name containing a tab is not a thing that exists. The shell splits on tabs
## and treats a short record as a malformed one rather than guessing.
scan() {
    local dir file id name comment icon exec_cmd nodisplay hidden type terminal tryexec

    for dir in "${APP_DIRS[@]}"; do
        [ -d "$dir" ] || continue
        for file in "$dir"/*.desktop; do
            [ -f "$file" ] || continue

            id="$(basename "$file" .desktop)"

            type="$(desktop_get "$file" Type)"
            [ "$type" = "Application" ] || continue

            nodisplay="$(desktop_get "$file" NoDisplay)"
            [ "$nodisplay" = "true" ] && continue

            hidden="$(desktop_get "$file" Hidden)"
            [ "$hidden" = "true" ] && continue

            # See the header: a terminal app on a machine with no terminal is a
            # card that does nothing.
            terminal="$(desktop_get "$file" Terminal)"
            [ "$terminal" = "true" ] && continue

            # TryExec is the spec's own "is this actually installed" check, and
            # it is what stops a leftover desktop file from advertising a
            # binary that was removed underneath it.
            tryexec="$(desktop_get "$file" TryExec)"
            if [ -n "$tryexec" ]; then
                case "$tryexec" in
                    /*) [ -x "$tryexec" ] || continue ;;
                    *)  command -v "$tryexec" >/dev/null 2>&1 || continue ;;
                esac
            fi

            name="$(desktop_get "$file" Name)"
            [ -n "$name" ] || continue

            exec_cmd="$(exec_line "$file")"
            [ -n "$exec_cmd" ] || continue

            comment="$(desktop_get "$file" Comment)"
            [ -n "$comment" ] || comment="$(desktop_get "$file" GenericName)"

            icon="$(icon_path "$(desktop_get "$file" Icon)")"

            printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$id" "$name" "$comment" "$icon" "$exec_cmd" "installed"
        done
    done
}


## Reads one top-level value out of a Valve KeyValues (.acf) file.
##
## The format is line-oriented in practice -- `"key"		"value"`, one pair per
## line, nested in braces -- and the three keys this scanner asks for (appid,
## name, StateFlags) each occur exactly once at the AppState level of every
## manifest Steam writes, before any nested block repeats a word. So the same
## pure-bash line walk as desktop_get is enough, and a real KeyValues parser
## would be more code to be wrong in. First match wins; the value is what sits
## between the next pair of quotes, which survives apostrophes and ampersands
## in game names (a title containing a literal double quote would lose its
## tail, which trims a hypothetical name rather than breaking the record).
acf_get() {
    local file="$1" key="$2" line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            *"\"$key\""*)
                line="${line#*\""$key"\"}"
                case "$line" in
                    *\"*\"*)
                        line="${line#*\"}"
                        printf '%s' "${line%%\"*}"
                        return 0
                        ;;
                esac
                ;;
        esac
    done < "$file"
    return 0
}


## Absolute path to Steam's own art for one appid, or nothing.
##
## The portrait grid image (library_600x900) is preferred because it is what
## Steam's own library draws as a tile -- exactly this card's job -- and the
## small square icon is a fallback, not a choice. Each name is looked up in
## both layouts the client has used for this cache: flat `<appid>_*.jpg`
## files, and the per-app subdirectory newer clients write instead. Which one
## exists depends on the Steam version that populated the cache, and checking
## four paths costs four stats.
##
## THE FIFTH PATH IS THE ONE THAT MAKES THIS RELIABLE, and it comes from a
## different process. Steam's librarycache is a CLIENT cache: it fills when
## Steam's own UI has drawn the game, not when the game installs. Install
## something from the couch, back out to the rail before the library view ever
## rendered it, and all four paths above miss -- which is what put a card with
## no picture on it on the bench. So marwanos-storeart fetches the same
## portrait from Valve's public CDN into /var/marwanos/store/icons, and this
## looks there last.
##
## THE CHOREOGRAPHY IS ENTIRELY IN THE FILES, and it is worth naming because
## it looks like coordination and is not. This scanner publishes the GAP: it
## emits the row with an empty icon column, which is a fact about the machine
## and would be written that way whether or not anything were listening.
## storeart, on its own fifteen-minute timer, reads that TSV, sees the empty
## column, downloads the picture and writes the file. This scanner's next
## ten-second poll stats the path here, finds it, and republishes the row with
## art in it. The shell, polling the same TSV, redraws.
##
## No daemon calls another. Nothing is ordered against anything. Each of the
## three only ever reads a file another one had already finished writing, so
## any of them can be restarted, be slow, or not exist yet, and the worst
## outcome is a card that stays a wash for one more cycle. Note that the local
## cache still wins when it has an entry: Steam's own copy is the same asset
## without a round trip, and it is the one that is already there on a machine
## that has been used.
##
## Nothing found anywhere is nothing emitted -- the shell already draws its
## accent wash for a card with no icon, and that empty column is also the
## signal storeart is waiting for.
steam_art() {
    local appid="$1" candidate
    # The CDN pair comes after every local candidate, portrait before header:
    # the header is storeart's last resort (a landscape capsule on a portrait
    # card), kept under its own name precisely so the portrait stays wanted
    # and replaces it the day Valve backfills -- see steam_fetch's note.
    for candidate in \
        "$STEAM_LIBCACHE/${appid}_library_600x900.jpg" \
        "$STEAM_LIBCACHE/$appid/library_600x900.jpg" \
        "$STEAM_LIBCACHE/${appid}_icon.jpg" \
        "$STEAM_LIBCACHE/$appid/icon.jpg" \
        "$STEAM_ART_DIR/$appid.jpg"; do
        [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
    done
    return 0
}


## The SQUARE icon Steam's client caches for a game, or nothing.
##
## LOCAL ONLY, and that is not an oversight. marwanos-storeart fetches the
## portrait, the header and the hero from Valve's public CDN, but there is no
## public name for the little square icon -- it is a client-side asset, written
## by Steam when its own UI has drawn the game, and nothing on the network will
## serve it. So the only way this column is ever non-empty is a Steam client
## that has actually run on this machine.
##
## Which is why the session now keeps one running. marwanos-session starts
## `flatpak run com.valvesoftware.Steam -silent` after the shell is up: no
## window, nothing on the TV, and a librarycache that fills itself. Before
## that, this cache only filled if somebody had opened Steam's own interface by
## hand, which on an appliance with no desktop is a thing that never happens.
##
## Both layouts the client has used are checked -- flat `<appid>_icon.jpg` and
## the per-app subdirectory newer clients write -- because which one exists
## depends on the Steam version that populated the cache, and two stats are
## cheaper than knowing.
steam_icon() {
    local appid="$1" candidate
    for candidate in \
        "$STEAM_LIBCACHE/${appid}_icon.jpg" \
        "$STEAM_LIBCACHE/$appid/icon.jpg"; do
        [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
    done
    return 0
}


## The wide hero image for a game, or nothing.
##
## Local first, then storeart's download, which is the same preference order
## steam_art() gives the portrait and for the same reason: Steam's own copy is
## the identical asset without a round trip, and on a machine that has been
## used it is already there. The CDN copy is what covers the game installed ten
## minutes ago that the client has not drawn yet.
steam_hero() {
    local appid="$1" candidate
    for candidate in \
        "$STEAM_LIBCACHE/${appid}_library_hero.jpg" \
        "$STEAM_LIBCACHE/$appid/library_hero.jpg" \
        "$STEAM_ART_DIR/$appid.hero.jpg"; do
        [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
    done
    return 0
}


## Every fully-installed, non-tooling Steam game as `<appid>TAB<name>`, or
## nothing at all.
##
## SPLIT OUT SO THERE IS ONE ANSWER TO "WHICH MANIFESTS COUNT". Two files are
## built from this list now -- apps.tsv's game rows and gameart.tsv's art rows
## -- and the filter below is four judgement calls deep: a numeric appid, the
## StateFullyInstalled bit, a name that exists, and Valve's own tooling
## excluded by name. Two copies of that would agree right up until the first
## time one of them was fixed, and the symptom would be a rail and an art file
## that disagree about which games exist.
##
## No steamapps directory means Steam is absent or has never downloaded
## anything, and both are ordinary states of this appliance rather than
## faults: the function returns before its loop and logs nothing.
## Human-readable bytes, for a progress line read at three metres. GB once the
## number gets there, because "4700 MB" is a number somebody has to convert in
## their head while watching a download bar.
##
## Integer arithmetic throughout: this runs per manifest per scan cycle, and
## floating point in a shell is a subprocess. One decimal for GB is the whole of
## the precision anybody wants here.
human_bytes() {
    local bytes="$1"
    case "$bytes" in ''|*[!0-9]*) printf ''; return ;; esac
    if [ "$bytes" -ge 1073741824 ]; then
        printf '%s.%s GB' "$(( bytes / 1073741824 ))" "$(( (bytes % 1073741824) * 10 / 1073741824 ))"
    elif [ "$bytes" -ge 1048576 ]; then
        printf '%s MB' "$(( bytes / 1048576 ))"
    else
        printf '%s KB' "$(( bytes / 1024 ))"
    fi
}


steam_games() {
    local dir file appid flags name state detail done_bytes total_bytes percent
    local seen=" "

    for dir in $STEAM_APPS_DIRS; do
    [ -d "$dir" ] || continue
    for file in "$dir"/appmanifest_*.acf; do
        [ -f "$file" ] || continue

        # The filename carries the appid too, but the manifest is the record
        # being trusted here, so the manifest answers.
        appid="$(acf_get "$file" appid)"
        case "$appid" in ''|*[!0-9]*) continue ;; esac

        # One row per game even when both libraries hold a manifest for it.
        # Two rows would be two cards for one game on the rail, and the second
        # press would launch whichever the shell happened to keep.
        case "$seen" in *" $appid "*) continue ;; esac
        seen="$seen$appid "

        flags="$(acf_get "$file" StateFlags)"
        case "$flags" in ''|*[!0-9]*) continue ;; esac

        # BIT 4 IS StateFullyInstalled, AND A GAME WITHOUT IT IS NO LONGER
        # DISCARDED. It used to be: a manifest exists from the moment a download
        # STARTS, and emitting a half-arrived game as a launchable card is a
        # button that opens Steam's error dialog. That reasoning was right about
        # the CARD and wrong about the ROW -- it threw away the only record on
        # this machine of a download in progress, which is exactly what somebody
        # who just pressed Install is looking for.
        #
        # So a partial game is emitted as `downloading` with no exec. The rail
        # already knows what to do with that shape: installed.gd renders a
        # pending card from the comment column and tile.gd refuses to launch one.
        # It is the same contract the Flathub installs have used since M3, which
        # is why this needs no new state word anywhere downstream.
        state=installed
        detail=""
        if [ $(( flags & 4 )) -eq 0 ]; then
            state=downloading
            # BytesDownloaded / BytesToDownload sit at the AppState level beside
            # StateFlags. Both are absent on a manifest Steam has only just
            # created, which is a real moment and renders as the fallback
            # sentence rather than as "0%".
            done_bytes="$(acf_get "$file" BytesDownloaded)"
            total_bytes="$(acf_get "$file" BytesToDownload)"
            case "$done_bytes$total_bytes" in
                *[!0-9]*|'') ;;
                *)
                    if [ "$total_bytes" -gt 0 ]; then
                        percent=$(( done_bytes * 100 / total_bytes ))
                        detail="Downloading -- $percent%, $(human_bytes "$done_bytes") of $(human_bytes "$total_bytes")"
                    fi
                    ;;
            esac
        fi

        name="$(acf_get "$file" name)"
        [ -n "$name" ] || continue

        # Runtime plumbing lives in steamapps AS apps: Proton builds, the
        # Steam Linux Runtime containers, the redistributables bundle. The
        # manifest has no field that says "this is tooling, not a game" --
        # that type lives in appinfo.vdf, a binary cache that would need a
        # real parser -- so matching the names Valve gives its own tooling is
        # the honest filter actually available in these files. A third-party
        # game that names itself "Proton..." would be hidden by this; that
        # trade is smaller than a rail listing four Proton versions as games.
        case "$name" in
            'Proton'*) continue ;;
            'Steam Linux Runtime'*) continue ;;
            'Steamworks Common Redistributables'*) continue ;;
        esac

        # A tab in a title would shear this record into extra columns and a
        # newline would shear it into two records, so both become spaces.
        # acf_get's line-read cannot actually deliver a newline, but the
        # sanitising is cheap and the TSV's integrity is the one thing this
        # file must never gamble on.
        name="${name//$'\t'/ }"
        name="${name//$'\n'/ }"
        name="${name//$'\r'/}"

        # Four columns now, and the last two are why: `state` so the rail knows
        # whether the card can be pressed, `detail` so it can say how far along
        # a download is. Neither can contain a tab -- one is a word this script
        # chose and the other is built here out of numbers.
        printf '%s\t%s\t%s\t%s\n' "$appid" "$name" "$state" "$detail"
    done
    done
}


## One apps.tsv record per fully-installed Steam game, or nothing at all.
##
## The icon column is UNCHANGED by the arrival of gameart.tsv: steam_art()
## still chooses it, still portrait-first, still local-cache-before-CDN. See
## GAMEART at the top of this file for why the extra art went into a second
## file rather than a seventh column here.
scan_steam() {
    local appid name icon state detail exec_cmd

    # Piped rather than read into an array, so a machine with no Steam runs the
    # loop body zero times instead of once with an empty appid. The subshell a
    # pipeline creates costs nothing here: the body only prints.
    steam_games | while IFS=$'\t' read -r appid name state detail; do
        icon="$(steam_art "$appid")"

        # NO EXEC FOR A GAME THAT IS NOT HERE YET, and the empty string is the
        # load-bearing part. installed.gd skips an `installed` record with no
        # exec (a card that looks ready and does nothing) but accepts a PENDING
        # one, and tile.gd refuses to launch anything whose state is not
        # `installed`. So an empty exec here is what makes a downloading game a
        # card somebody can see and cannot press, without a line of new code
        # anywhere downstream.
        exec_cmd=""
        if [ "$state" = "installed" ]; then
            exec_cmd="/usr/lib/marwanos/steam/steamlaunch $appid"
        fi

        # THROUGH steamlaunch RATHER THAN STRAIGHT AT THE FLATPAK, and the
        # indirection is the whole point rather than a layer for its own sake.
        # This line used to read `flatpak run com.valvesoftware.Steam -silent
        # steam://rungameid/<appid>` -- which is still what happens for most
        # games, and is what steamlaunch's first tier does. What it could not
        # express is that a game has more than one way to start: a DRM-free
        # native title needs no client at all, and a Windows one needs Proton.
        # A scanner that walks manifests has no business deciding which; it
        # names a program that decides, and that program is testable on its own
        # (see steamlaunch's --explain and --dry-run).
        #
        # Written while the alternative was live: the tiers existed for half a
        # day as code nothing invoked, because this string still said flatpak.
        # A launch path with no caller is not a feature, it is a file.
        #
        # Directly under the session's gamescope, NOT inside a nested one -- the
        # nested wrapper shipped for one evening and its inner compositor
        # aborted on this NVIDIA driver three minutes into the first real game
        # (catalogue.gd carries the full story). Every word in this exec is
        # spaceless (the appid is numeric), which the space-joined, space-split
        # exec field requires -- the title, which may contain anything, never
        # rides in it.
        #
        # -silent, NOT -gamepadui, AND THAT IS THE WHOLE POINT OF THE SHELL.
        # This line used to raise Big Picture and then launch the game inside
        # it, so playing anything meant Valve's CEF UI arriving on the
        # television first. There is no longer a reason for that: the shell
        # draws the storefront, the search, the account and the wishlist itself,
        # and the rail IS the library -- so Big Picture has nothing left to show
        # here that this machine cannot draw with its own pad. What it does have
        # is the flicker the owner reported, and a UI nobody asked to see.
        #
        # -silent means "start with no window". It is right in both states the
        # client can be in, which is why it replaces the flag rather than merely
        # dropping it: against a WARM client `flatpak run` hands the URL over
        # and exits, and against a COLD one Steam starts windowless and then
        # launches the game. Removing -gamepadui and passing nothing would have
        # started the cold client in DESKTOP mode -- a mouse UI on a machine
        # whose only pointer is a thumbstick, which is worse than what this
        # replaces.
        #
        # So the only window that reaches the screen is the game's, and quitting
        # it lands back on the rail rather than in somebody else's menu.
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "steam.$appid" "$name" "$detail" "$icon" "$exec_cmd" "$state"
    done
}


## One gameart.tsv record per fully-installed Steam game, or nothing at all.
##
## `steam.<appid>TAB<icon or empty>TAB<hero or empty>`, three fields, joined by
## the shell against the apps.tsv record with the same id. Emitted for every
## game even when both columns are empty, deliberately: a row of two empties is
## the machine saying "this game has no extra art yet", which is a different
## and more useful statement than a missing row, and it is what makes the file
## a complete picture of the library rather than a partial index of it.
##
## Every path here is a stat of something another process wrote -- Steam's own
## cache, or storeart's download directory -- so this is the same
## no-coordination handshake steam_art() describes at length: nobody is called,
## nothing is ordered, and the worst outcome of any of the three services being
## restarted mid-flight is a card that stays plain for one more ten-second
## poll.
scan_gameart() {
    local appid

    steam_games | while IFS=$'\t' read -r appid _; do
        printf '%s\t%s\t%s\n' \
            "steam.$appid" "$(steam_icon "$appid")" "$(steam_hero "$appid")"
    done
}


## Applications that are on their way but not here yet.
##
## marwanos-flatpak-install writes `<state>TAB<name>` per app it is working on,
## and deletes the file once the install is proven. Emitting those as records
## is what stops a first boot looking broken: the browser is a several-hundred-
## megabyte download, and without this the rail would sit empty for minutes
## with nothing anywhere saying why -- which is the exact complaint that
## started this whole line of work.
##
## They carry no icon and no exec, because neither exists yet. The shell
## renders them as cards that describe themselves and refuse to launch.
pending() {
    local file id line state name detail rest

    for file in "$STATE_DIR"/install.*.state; do
        [ -f "$file" ] || continue

        id="${file##*/install.}"
        id="${id%.state}"

        # Store apps' pending records are emitted like everyone else's: the
        # 2026-08-07 boot put Steam on the rail as a pending card while its
        # store page narrated the same install, and the fix then was to hide it
        # here -- but hiding it made this file stop being the truth (see the
        # header). The rail-side filter in shell_root._populate is what keeps
        # a pending store app off the rail now, in every state at once.
        IFS= read -r line < "$file" || continue
        # `<state>TAB<name>TAB<detail>`; detail is the live progress text and
        # may be empty.
        state="${line%%$'\t'*}"
        rest="${line#*$'\t'}"
        [ "$rest" = "$line" ] && rest=""
        name="${rest%%$'\t'*}"
        detail="${rest#*$'\t'}"
        [ "$detail" = "$rest" ] && detail=""

        [ -n "$state" ] || continue
        [ -n "$name" ] || name="$id"

        # The progress text rides in the COMMENT column, which is exactly what
        # that column is for: the one line under the title. The shell prefers
        # it over its own wording when it is present.
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$detail" "" "" "$state"
    done
}


## A cheap value that changes when anything worth rescanning does. Compared
## against the previous one so the parse only runs when something moved.
##
## The install state files are in here by CONTENT, not by mtime, and that is
## the difference between a rail that narrates an install and one that shows
## one stale word for the whole download: a state file's mtime changes on
## every rewrite, but so does its content, and reading four short lines is
## cheaper than being wrong. The application directories stay on mtime because
## re-parsing a hundred desktop entries every ten seconds is exactly what the
## signature exists to avoid.
dirs_signature() {
    local dir
    for dir in "${APP_DIRS[@]}"; do
        if [ -d "$dir" ]; then
            printf '%s:%s ' "$dir" "$(stat -c %Y "$dir" 2>/dev/null || echo 0)"
        fi
    done
}


## The Steam library's signature, and it watches FILE mtimes, not just the
## directory's. The change that matters most -- a download finishing -- flips
## StateFlags by rewriting an appmanifest that already exists, which moves
## that file's mtime and leaves the directory's alone; a directory-only watch
## would show every game exactly one install late. Uninstalls delete the
## manifest, so the file simply falls out of this listing and the value
## changes that way. A library holds tens of manifests at most, so this is
## tens of stats per cycle -- the same order of cheap as dirs_signature.
##
## THE ARTWORK DIRECTORY IS IN HERE TOO, and without it the whole storeart
## handshake in steam_art() would be a story that never finishes. The library
## does not change when storeart lands a portrait -- no manifest is touched --
## so a signature built only from steamapps would hold the cached listing with
## its empty icon column until the next time somebody installed or removed a
## game, which could be never. A directory's mtime moves when an entry is
## created in it, which is exactly what storeart's `mv` into that directory
## does, so one more stat per cycle is the entire cost of the rail noticing.
## The Flathub icons share that directory, so one landing re-runs scan_steam
## as a side effect -- NOT the desktop-entry walk, whose own signature did
## not move (installed apps resolve icons from the theme roots, never from
## here). The re-run produces the same Steam rows and the atomic write
## republishes them to nobody's harm; that is the entire cost of sharing.
##
## STEAM'S OWN CACHE IS WATCHED TOO, and it has to be watched two ways.
##
## gameart.tsv's icon column can only ever be filled by the Steam client (see
## steam_icon), and the client fills it minutes or hours after the game was
## installed -- whenever its UI first draws that title. No manifest is touched
## when that happens and no file lands in storeart's directory, so a signature
## built from the two blocks above would hold a gameart.tsv full of empty
## columns until the next install, which could be never.
##
## The directory's own mtime catches the flat layout, where the client creates
## `<appid>_icon.jpg` directly in it. It does NOT catch the per-app
## subdirectory layout: once `<appid>/` exists, a file created inside it moves
## that subdirectory's mtime and leaves the parent's alone. So the subdirectories
## are stat'ed as well. There is one per game the client has drawn -- the same
## order of cheap as the manifest walk below, and the alternative is an art
## column that is right on some Steam versions and permanently empty on others.
steam_signature() {
    local dir file
    printf '%s:%s ' "$STORE_ICON_DIR" "$(stat -c %Y "$STORE_ICON_DIR" 2>/dev/null || echo 0)"
    printf '%s:%s ' "$STEAM_LIBCACHE" "$(stat -c %Y "$STEAM_LIBCACHE" 2>/dev/null || echo 0)"
    for file in "$STEAM_LIBCACHE"/*/; do
        [ -d "$file" ] && printf '%s:%s ' "$file" "$(stat -c %Y "$file" 2>/dev/null || echo 0)"
    done
    # BOTH libraries, and a `return` on the first missing one would have been
    # the bug: ~player/Games does not exist until the first download, so
    # returning there would stop the client's own library from ever being
    # signed -- and a download landing in a directory nobody signs is a rail
    # that never notices the game arrived.
    for dir in $STEAM_APPS_DIRS; do
        [ -d "$dir" ] || continue
        printf '%s:%s ' "$dir" "$(stat -c %Y "$dir" 2>/dev/null || echo 0)"
        for file in "$dir"/appmanifest_*.acf; do
            [ -f "$file" ] && printf '%s:%s ' "$file" "$(stat -c %Y "$file" 2>/dev/null || echo 0)"
        done
    done
}


## By CONTENT, not mtime -- the progress line inside these files is the thing
## that has to reach the rail, and it changes without the set of files
## changing. They are two short files on a tmpfs, so reading them every cycle
## costs nothing; it is the desktop-file walk that must not repeat this often.
pending_signature() {
    local file
    for file in "$STATE_DIR"/install.*.state; do
        [ -f "$file" ] && printf '%s:%s ' "$file" "$(cat "$file" 2>/dev/null)"
    done
}


# EACH SOURCE IS WATCHED SEPARATELY, and that split is a performance fix
# rather than tidiness. Pending state now carries a progress line that is
# rewritten every ten seconds during a download, so a single combined signature
# would re-walk every desktop file in every XDG directory on that same cadence
# -- reading hundreds of small files off a USB stick that is simultaneously
# absorbing a multi-gigabyte download. The installed set only changes when a
# directory's mtime moves, so its expensive scan is cached and only the cheap
# read of two small state files repeats. The Steam library gets the same
# treatment for the same reason: its manifests are stat'ed every cycle, and
# the acf re-parse only runs when one of them actually moved -- which is also
# what makes a game land on the rail within one poll of Steam finishing its
# download, with no new unit and no new trigger.
last_dirs=""
last_pending=""
last_steam=""
installed_listing=""
steam_listing=""
while :; do
    dirs_now="$(dirs_signature)"
    pending_now="$(pending_signature)"
    steam_now="$(steam_signature)"

    if [ "$dirs_now" != "$last_dirs" ] || [ "$pending_now" != "$last_pending" ] \
        || [ "$steam_now" != "$last_steam" ]; then
        if [ "$dirs_now" != "$last_dirs" ]; then
            last_dirs="$dirs_now"
            installed_listing="$(scan)"
        fi
        if [ "$steam_now" != "$last_steam" ]; then
            last_steam="$steam_now"
            steam_listing="$(scan_steam)"

            # Published here rather than beside apps.tsv below, because this is
            # the only branch whose inputs it depends on: gameart rows are made
            # of Steam manifests, Steam's cache and storeart's directory, and
            # all three are exactly what steam_signature watches. A pending
            # install finishing or a desktop file appearing changes apps.tsv
            # and cannot change this.
            #
            # Written on the first cycle whatever the machine looks like --
            # last_steam starts empty and no real signature is -- so the shell
            # finds an empty file rather than no file on a stick with no Steam,
            # and never has to tell "no games" apart from "the scanner has not
            # run". Atomic via rename for the usual reason: the shell polls it
            # and must never read half a row.
            gameart_listing="$(scan_gameart)"
            { printf '%s' "${gameart_listing:+$gameart_listing$'\n'}" > "$GAMEART.tmp" \
                && mv -f "$GAMEART.tmp" "$GAMEART"; } \
                || err "cannot write $GAMEART -- game cards will fall back to their apps.tsv icon"
        fi
        last_pending="$pending_now"

        # Sorted by name so the rail's order is stable across rescans -- a rail
        # whose cards reshuffle when an unrelated app is installed would move
        # the selection out from under the person holding the pad. Pending
        # entries sort in among the installed ones rather than clustering at
        # one end, so an app does not jump across the rail at the moment its
        # install finishes.
        listing="$( { printf '%s' "${installed_listing:+$installed_listing$'\n'}"; \
                      printf '%s' "${steam_listing:+$steam_listing$'\n'}"; \
                      pending; } \
            | grep -v '^$' | sort -t"$(printf '\t')" -k2,2f)"
        count=0
        [ -n "$listing" ] && count="$(printf '%s\n' "$listing" | wc -l)"

        info "scan found $count application(s), including Steam games and pending installs"

        # Atomic via rename: the shell polls this file and must never read a
        # half-written listing. Logged rather than fatal, same as netcheck --
        # under `set -uo pipefail` without -e the failure would otherwise be
        # discarded and the journal would claim a scan that never landed.
        { printf '%s' "${listing:+$listing$'\n'}" > "$APPS.tmp" \
            && mv -f "$APPS.tmp" "$APPS"; } \
            || err "cannot write $APPS -- the rail will not see this scan"
    fi

    sleep "$INTERVAL"
done
