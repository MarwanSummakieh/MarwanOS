# M3's shell, from the shell-export stage. The position is load-bearing in both
# directions and both failures are quiet ones.
#
# It has to be AFTER the session-wiring RUN above, because that RUN's find
# recurses through /usr/lib/marwanos and chmods every file to 0644. Placed any
# earlier, this binary loses its executable bit, resolve_client hands
# supervise_client a path that fails `[ -x ]`, the session logs "missing or not
# executable" and holds -- a black TV on a machine with no console. Same family
# as the greetd EACCES failure ADR 0004 finding 6 records, one level down.
#
# For the same reason /usr/lib/marwanos/shell must never be added to that find
# list. Nothing here comes through os/files, so it never arrives 0777 from the
# drvfs bridge and needs none of the normalisation that list exists for.
#
# It has to be BEFORE the MARWANOS_* ARGs below, because those change on every
# single build and a layer declared after them is re-committed every time. This
# one is ~90 MB, so below the ARGs a version bump would re-copy it and every
# `bootc upgrade` would transfer it. Above them, the measured 70 s warm rebuild
# is unchanged and only a real shell edit moves these bytes.
#
# The mode comes from the `install -m 0755` in shell-export, which COPY --from
# preserves. If the bit is ever missing here the fix is the placement above, not
# a chmod added underneath.
COPY --from=shell-export /out/ /

RUN set -euxo pipefail; \
    test -x /usr/lib/marwanos/shell/marwanos-shell; \
    test -s /usr/lib/marwanos/shell/marwanos-shell; \
    : "THE EXTENSION TRAVELS WITH THE BINARY, asserted HERE rather than with"; \
    : "the rest of the mowser payload -- which is three hundred lines earlier"; \
    : "and, importantly, before the shell is copied into the image at all."; \
    : "Godot's exporter puts a GDExtension library beside the executable"; \
    : "(a pack member cannot be dlopen'd), so this is the copy the shell"; \
    : "actually loads, and it arrives with the binary rather than with the"; \
    : "engine. Asserted because if a future Godot stopped emitting it, the"; \
    : "symptom would be a browser screen politely saying the engine is not"; \
    : "installed, on an image that contains every byte of it."; \
    test -s /usr/lib/marwanos/shell/libmowser.so; \
    : "THE SMOKE RUN, and it exists because of a bug that got all the way to a"; \
    : "verification round: 0o600 is not valid GDScript, so an autoload failed"; \
    : "to parse -- and NOTHING in this build noticed. The export packs a script"; \
    : "with a parse error without complaint, the binary is the right size, the"; \
    : "ELF is valid, and every assertion above passes. On the appliance the"; \
    : "symptom is a shell that starts, looks correct, and has silently lost a"; \
    : "whole feature; for a parse error in a different file it is the black TV"; \
    : "this project keeps designing against."; \
    : ""; \
    : "--headless uses the dummy display server, so this needs no X and no GPU."; \
    : "--quit exits after the first frame, by which point every autoload has"; \
    : "run its _ready and every script has been parsed. HOME is forced because"; \
    : "Godot creates a user data directory before it draws anything."; \
    : ""; \
    : "Only SCRIPT-level failures fail the build. The exit code is deliberately"; \
    : "ignored: a headless start has plenty of benign reasons to be non-zero on"; \
    : "a machine with no display, and making those fatal would be a flaky build"; \
    : "that teaches people to distrust the check."; \
    mkdir -p /tmp/shell-smoke; \
    smoke_log=/tmp/shell-smoke/out.txt; \
    HOME=/tmp/shell-smoke XDG_RUNTIME_DIR=/tmp/shell-smoke \
        MARWANOS_SHELL_WINDOWED=1 \
        /usr/lib/marwanos/shell/marwanos-shell \
        --headless --quit --audio-driver Dummy > "$smoke_log" 2>&1 || true; \
    cat "$smoke_log"; \
    : "'ERROR: Can.t open file' is in the fatal set because of the icon font:"; \
    : "a resource missing from the pack logs exactly that, at plain ERROR"; \
    : "severity, while every script parses and the rail builds -- so the shell"; \
    : "passed this gate with every glyph on screen rendered as tofu. A missing"; \
    : "file at startup is never benign on this machine."; \
    if grep -qE 'SCRIPT ERROR|Parse Error|Failed to load script|does not inherit from|ERROR: Can.t open file' "$smoke_log"; then \
        echo "FATAL: the shell logged a script error on a headless start (above)."; \
        echo "A parse error here means an autoload never instantiated."; \
        exit 1; \
    fi; \
    grep -q 'home rail ready with' "$smoke_log" \
        || { echo "FATAL: the shell started but never built its home rail."; exit 1; }; \
    rm -rf /tmp/shell-smoke

# These ARGs are declared here, not at the top, and the placement is load-bearing.
# A changed ARG invalidates every layer after its declaration. MARWANOS_VERSION
# is timestamped, so it changes on every single build -- declared at the top it
# re-ran the dnf install and the dracut regen every time, which measured at 4 of
# 12 steps cached and blew most of M0's 15-minute loop budget on work whose
# inputs had not changed. Down here, only the three cheap layers below rebuild.
ARG MARWANOS_VERSION="0.0.0-dev"
ARG MARWANOS_COMMIT="unknown"
ARG MARWANOS_BUILD_DATE="unknown"

# M0's acceptance gate needs something trivial to change and observe on the
# target. This is that something: bump the version, rebuild, upgrade, `cat` it.
RUN set -euxo pipefail; \
    install -d /usr/share/marwanos; \
    printf 'MARWANOS_VERSION=%s\nMARWANOS_COMMIT=%s\nMARWANOS_BUILD_DATE=%s\n' \
        "${MARWANOS_VERSION}" "${MARWANOS_COMMIT}" "${MARWANOS_BUILD_DATE}" \
        > /usr/share/marwanos/build-info

# Identity. The login banner, hostname and os-release all said "Fedora", which
# during bring-up made a genuine MarwanOS boot indistinguishable from stale
# leftovers of previous Fedora/Bazzite installs on the same machine. NAME and
# PRETTY_NAME are ours; ID stays fedora deliberately -- tooling that keys off
# ID (packagekit, third-party scripts) keeps working, ID_LIKE would be the
# next step if that ever changes.
#
# /etc/issue ships as a file from os/files (the block-letter banner). It uses
# only full-block glyphs on purpose: agetty treats backslashes in issue as
# escape sequences, so figlet-style art made of slashes renders as garbage.
RUN set -euxo pipefail; \
    sed -i \
        -e 's/^NAME=.*/NAME="MarwanOS"/' \
        -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"MarwanOS (Phase 0, ${MARWANOS_VERSION})\"/" \
        /usr/lib/os-release; \
    grep -q 'MarwanOS' /etc/issue; \
    printf 'marwanos\n' > /etc/hostname

# In bootc, /var is machine-local state that is populated once at install and
# then never updated by an image upgrade. Anything we leave there becomes a
# first-boot-only default that silently drifts from the image forever, so the
# build's own droppings have to come out. /run must simply be empty.
#
# Note the /run paths are named individually rather than globbed: podman
# bind-mounts /run/secrets and /run/systemd during the build, so `rm -rf /run/*`
# fails on a busy mount. Those mounts are not part of the committed layer
# anyway; only what dnf and the selinux policy scriptlets left behind is.
RUN set -euxo pipefail; \
    rm -rf \
        /var/lib/dnf \
        /var/log/* \
        /var/cache/* \
        /var/tmp/* \
        /tmp/* \
        /run/dnf \
        /run/selinux-policy; \
    mkdir -p /var/log /var/cache /var/tmp

RUN bootc container lint
