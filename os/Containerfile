    ln -sf ../marwanos-plymouth-quit.path \
        /usr/lib/systemd/system/multi-user.target.wants/marwanos-plymouth-quit.path; \
    : "The devmode sudo rule's installer. Enabled UNCONDITIONALLY and gated"; \
    : "inside the script instead, because the boot that matters most is the"; \
