# syntax=docker/dockerfile:1
#
# MarwanOS — Phase 0: the factory, plus M1's session bring-up.
#
# Base pair, and why it is a pair:
#   ghcr.io/ublue-os/base-nvidia is dead (last real tags are from 2023). The
#   supported Universal Blue path for a custom NVIDIA image is now a minimal
#   base plus prebuilt akmods RPMs copied from a sidecar image. We still never
#   compile an NVIDIA module ourselves, which was the point of D1.
#
# The akmods tag MUST match the base's Fedora major and kernel flavour
# (base-main:43 -> akmods-nvidia-open:main-43). Mismatched pairs produce an
# image that builds fine and then boots to a black screen. scripts/bump-base.sh
# re-resolves both digests together so they can never drift apart.

ARG BASE_IMAGE="ghcr.io/ublue-os/base-main"
ARG BASE_TAG="43"
ARG BASE_DIGEST="sha256:0a7036f6c63744e974f022125e67fb03f892cd543ba54ec589cb38932a768997"

ARG AKMODS_IMAGE="ghcr.io/ublue-os/akmods-nvidia-open"
ARG AKMODS_TAG="main-43"
ARG AKMODS_DIGEST="sha256:b73a194f8d9d74bc2bca763be2dedde193b77956f4c83cb5eb3978150ff1f11f"

# Godot, pinned by exact version plus checksums for the same reason the base is
# pinned by digest: the engine exports the shell at build time, so the engine
# version is an input to what ships, and an engine that moved under us would
# change the appliance's only UI without any change on this side.
#
# `dnf install godot` is not the shortcut it looks like. Fedora's package is
# unpinned within F43 -- it has already gone 4.4 -> 4.4.1 -> 4.5 inside one
# release -- and it ships no export templates, which exist only as the official
# ~1.2 GB .tpz. The download is unavoidable either way, so the official binary,
# which is what the published checksums actually cover, is the honest choice.
#
# The two sums are the release's own SHA512-SUMS.txt, which upstream does not
# sign (godot-proposals#6042 is open), so copying them here is
# trust-on-first-use at the moment they were resolved -- the same trust model as
# BASE_DIGEST, which also came from one unauthenticated response. Resolved
# 2026-08-05 against godot-builds 4.7.1-stable (published 2026-07-14); 4.7.2-rc1
# exists, so expect a bump, and a bump must move the version and BOTH sums
# together or the export fails on a template/editor mismatch.
#
# These sit at the top rather than with the MARWANOS_* block at the bottom, and
# that is not a contradiction of the comment down there. An ARG declared before
# the first FROM is only visible to a stage that redeclares it; these four are
# redeclared only inside shell-export, so they cannot reach the dnf or dracut
# layers of the final stage. They also change once per deliberate Godot bump,
# which is exactly the churn profile BASE_DIGEST has.
ARG GODOT_VERSION="4.7.1"
ARG GODOT_RELEASE="stable"
ARG GODOT_EDITOR_SHA512="4ccdab7a48eeccbe8819a2fc1f6262f8d72065d98601bcb3743fcbd7ebd39f373758a788ee3293a05ec5b2c48538266c437404312e372225cd2df273945a2de9"
ARG GODOT_TEMPLATES_SHA512="afcc83d8d3d298038f19c58744a0d660fa75dd4baa33cb55d1011bb2565a2a8c2381728924564cb909e37c205a23f21b521b23bd057993afd43ae4da0b2f9d47"


FROM ${AKMODS_IMAGE}:${AKMODS_TAG}@${AKMODS_DIGEST} AS akmods


# M3's shell, exported here and nowhere else. No hand-exported binary is ever
# committed, which is the M3 checklist item this stage exists to satisfy.
#
# The toolchain stays in a discarded stage, and size is the smaller half of the
# reason: the editor binary is a GDScript interpreter with --script and
# --headless, which is to say a general-purpose arbitrary-code-execution engine,
# on a machine whose entire thesis (D6) is that no such thing is reachable. It
# is the same category of object as a shell. Only the exported binary crosses
# into the image.
#
# The base is reused rather than a fresh fedora tag so this adds no second
# multi-GB pull and no third digest anyone has to remember to bump. Nothing here
# needs the X11 or Wayland stacks: official Godot builds are compiled with
# use_sowrap=yes, so every display, audio and input library is dlopen'd at
# runtime by the *exported* binary rather than linked into the editor.
FROM ${BASE_IMAGE}:${BASE_TAG}@${BASE_DIGEST} AS shell-export

ARG GODOT_VERSION
ARG GODOT_RELEASE
ARG GODOT_EDITOR_SHA512
ARG GODOT_TEMPLATES_SHA512

# Godot finds its editor data and its export templates through XDG, defaulting
# under $HOME. Naming all three removes any dependence on HOME being set or
# writable, which is otherwise a silent source of "no export template found" in
# a container build -- the export then fails for a reason that has nothing to do
# with the project.
#
# /godot rather than /opt/godot, and not as a style preference: in an ostree
# base /opt is a SYMLINK to /var/opt, the same trap as /usr/local. `install -d`
# mkdirs every path component, hits the symlink, and dies with "cannot create
# directory '/opt': File exists" -- after the 1.2 GB download has already been
# paid. A top-level directory in a stage that gets discarded owes nothing to
# FHS convention.
ENV XDG_DATA_HOME=/godot/data \
    XDG_CONFIG_HOME=/godot/config \
    XDG_CACHE_HOME=/godot/cache

# unzip only. curl is already here as curl-minimal, and `dnf install curl` does
# not no-op on that -- it tries to swap the two packages and fails on the
# conflict. Asserted instead.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install unzip; \
    dnf clean all; \
    command -v curl >/dev/null

# Fetch, verify, unpack. The cache mount keeps the 1.2 GB .tpz across local
# rebuilds even though none of it is committed to a shipped layer. CI is cold
# every time and pays the download once per build; if that ever hurts, the
# escalation is a separately published toolchain image consumed by digest, not a
# looser pin.
#
# The cached copy is checksummed BEFORE it is trusted, and a mismatch deletes
# and refetches rather than failing forever. A corrupt or half-written cache
# entry would otherwise wedge every later build behind an error that points at
# the pin instead of at the cache.
#
# Two members come out of the .tpz and no more. It carries a template for every
# platform Godot supports, so unpacking it whole would put ~2 GB into this stage
# for nothing.
#
# The version.txt check is the direct analogue of bump-base.sh's base/akmods
# pair check: an export template from a different release than the editor is a
# hard export failure, so the pair is asserted rather than assumed to have been
# bumped together.
RUN --mount=type=cache,dst=/godot-dl,sharing=locked \
    set -euxo pipefail; \
    base_url="https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}-${GODOT_RELEASE}"; \
    editor_zip="Godot_v${GODOT_VERSION}-${GODOT_RELEASE}_linux.x86_64.zip"; \
    templates_tpz="Godot_v${GODOT_VERSION}-${GODOT_RELEASE}_export_templates.tpz"; \
    for spec in "${editor_zip} ${GODOT_EDITOR_SHA512}" \
                "${templates_tpz} ${GODOT_TEMPLATES_SHA512}"; do \
        set -- ${spec}; \
        if ! printf '%s  %s\n' "$2" "/godot-dl/$1" | sha512sum -c --status - 2>/dev/null; then \
            rm -f "/godot-dl/$1"; \
            curl -fsSL --retry 3 -o "/godot-dl/$1" "${base_url}/$1"; \
            printf '%s  %s\n' "$2" "/godot-dl/$1" | sha512sum -c -; \
        fi; \
    done; \
    install -d /godot/bin; \
    unzip -j -o "/godot-dl/${editor_zip}" -d /godot/bin; \
    mv /godot/bin/Godot_v*_linux.x86_64 /godot/bin/godot; \
    chmod 0755 /godot/bin/godot; \
    unzip -j -o "/godot-dl/${templates_tpz}" \
        'templates/version.txt' 'templates/linux_release.x86_64' -d /tmp/tpl; \
    tpl_version="$(cat /tmp/tpl/version.txt)"; \
    test "${tpl_version}" = "${GODOT_VERSION}.${GODOT_RELEASE}"; \
    install -D -m 0755 /tmp/tpl/linux_release.x86_64 \
        "${XDG_DATA_HOME}/godot/export_templates/${tpl_version}/linux_release.x86_64"; \
    rm -rf /tmp/tpl; \
    /godot/bin/godot --version > /tmp/godot-version.txt; \
    grep -q "^${GODOT_VERSION}\.${GODOT_RELEASE}\." /tmp/godot-version.txt; \
    rm -f /tmp/godot-version.txt

# The project arrives last, deliberately. It is the only input a UI change
# touches, so the dnf install, the 1.2 GB download and the unpack above all stay
# cached across shell edits -- and because this is a separate stage, none of it
# reaches the final stage's dnf or dracut layers at all.
COPY shell/ /build/shell/

# Everything the export depends on, checked before the export runs, so a problem
# names its own cause instead of surfacing later as a missing or half-working
# binary on a machine with no console.
#
# "Linux" is the contract between this file and shell/export_presets.cfg. It is
# the preset name --export-release resolves, and Godot's error for an unknown
# preset does not say which names it does know.
#
# binary_format/embed_pck=true is what makes the export ONE file. Off (its
# default) Godot writes marwanos-shell plus a sibling .pck, and BAKED_CLIENT in
# the session script and D5's `[ -x "$DEV_CLIENT" ]` are both single paths -- so
# a preset re-saved in the Godot editor GUI with that box unticked ships a
# binary whose data was never copied. The .pck assertion after the export is the
# same guard from the other side.
#
# .godot is the import cache and is regenerated below. A copy carried in from a
# developer's machine is host state with absolute host paths in it, and this
# build's whole claim is that the binary is a function of the repo.
RUN set -euxo pipefail; \
    grep -q '^name="Linux"$' /build/shell/export_presets.cfg; \
    grep -q '^binary_format/embed_pck=true$' /build/shell/export_presets.cfg; \
    rm -rf /build/shell/.godot

# Import and export are two steps because only --export-debug and --export-pack
# are documented to imply an import. Without one, the export fails with "make
# sure resources have been imported by opening the project in the editor at
# least once" (godot#71521) -- advice aimed at a human, in a place where there
# is none.
#
# --network=none turns "the export fetches nothing" from a belief into a
# build-time fact: everything needed is already in this stage and checksummed.
# The day the shell needs something fetched at export time -- C# would, it needs
# the mono templates and a NuGet restore -- this gets revisited deliberately
# rather than deleted in frustration.
#
# timeout is not paranoia. godot#95287 is a headless export that hangs forever
# instead of failing, and a hang on a CI runner burns the whole job budget
# before failing uselessly.
RUN --network=none set -euxo pipefail; \
    timeout 600 /godot/bin/godot --headless --path /build/shell --import

# The export is guarded rather than trusted, because Godot's headless export has
# a documented history of lying about its own success: godot#83042 returned exit
# 0 on failure for years, and godot#99284 crashed while still writing a
# plausible-looking executable. Nothing downstream can tell a good binary from a
# bad one, and the machine that finds out is a TV showing black.
#
# The output keeps the .x86_64 extension Godot's Linux exporter expects and is
# renamed by the install, rather than fighting the extension check.
RUN --network=none set -euxo pipefail; \
    install -d /build/out; \
    timeout 900 /godot/bin/godot --headless --path /build/shell \
        --export-release "Linux" /build/out/marwanos-shell.x86_64; \
    test -s /build/out/marwanos-shell.x86_64; \
    test "$(stat -c%s /build/out/marwanos-shell.x86_64)" -gt 20000000; \
    test "$(od -An -tx1 -N4 /build/out/marwanos-shell.x86_64 | tr -d ' ')" = "7f454c46"; \
    test ! -e /build/out/marwanos-shell.pck; \
    install -D -m 0755 /build/out/marwanos-shell.x86_64 \
        /out/usr/lib/marwanos/shell/marwanos-shell


FROM ${BASE_IMAGE}:${BASE_TAG}@${BASE_DIGEST}

# nvidia-open requires Turing (RTX 20 / GTX 16) or newer: the open modules lean
# on the GSP coprocessor, which does not exist on Pascal and older. NVIDIA's 590
# branch dropped Maxwell/Pascal/Volta entirely, so this is now the floor for any
# machine that expects current drivers. See docs/adr/0002.
COPY --from=akmods /rpms/ /tmp/rpms/

# Fail loudly and early if the akmods layout ever changes upstream, rather than
# letting a glob silently match nothing and shipping an image with no driver.
# The nvidia/ directory carries the userspace driver and is as load-bearing as
# the kmod -- see the install step below for what happened when it was missed.
RUN set -euxo pipefail; \
    ls -1 /tmp/rpms/ublue-os/ublue-os-nvidia*.rpm >/dev/null; \
    ls -1 /tmp/rpms/kmods/kmod-nvidia*.rpm >/dev/null; \
    ls -1 /tmp/rpms/nvidia/nvidia-driver-libs-*.x86_64.rpm >/dev/null

# Kernel module AND userspace driver, from the same sidecar.
#
# The userspace line exists because its absence cost a near-miss: the image
# originally installed only the kmod and the ublue addons, which yields loaded
# nvidia.ko modules and no Vulkan ICD, no EGL, no nvidia-smi -- a machine on
# which gamescope fails in a way indistinguishable from the compositor problem
# M1's spike exists to investigate. Upstream ublue's own installer script
# installs /rpms/nvidia/* from this sidecar; we take the subset a Wayland
# appliance needs. The ICD assertion at the end is the regression guard.
#
# i686 userspace (32-bit GL/Vulkan for Proton's 32-bit games) is deliberately
# deferred to Phase 1: it drags multilib glibc into the image and nothing in
# Phase 0 runs 32-bit code.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install \
        /tmp/rpms/ublue-os/ublue-os-nvidia*.rpm \
        /tmp/rpms/kmods/kmod-nvidia*.rpm \
        /tmp/rpms/nvidia/nvidia-driver-[0-9]*.x86_64.rpm \
        /tmp/rpms/nvidia/nvidia-driver-common-[0-9]*.x86_64.rpm \
        /tmp/rpms/nvidia/nvidia-driver-libs-[0-9]*.x86_64.rpm; \
    rm -rf /tmp/rpms; \
    dnf clean all; \
    rpm -q nvidia-driver-libs >/dev/null; \
    ls /usr/share/vulkan/icd.d/nvidia_icd*.json >/dev/null

# M1's packages. Every one of these is in Fedora 43 proper -- checked against
# packages.fedoraproject.org before this line existed -- so no COPR is involved,
# and none should be added here without an ADR saying why:
#
#   greetd 0.10.3    autologin daemon (D3). Its rich dependency pulls
#                    greetd-selinux automatically wherever selinux-policy is
#                    installed, which is here, so the policy module is not
#                    named explicitly.
#   gamescope 3.16   plan A: the DRM-master session compositor (D4). Requires
#                    xorg-x11-server-Xwayland, so XWayland arrives with it and
#                    does not need naming either.
#   cage 0.2.0       plan B (D4).
#   vulkan-tools     vkcube. Not the shell -- M3's Godot export is -- but kept
#                    deliberately: it is the one client that can tell a
#                    compositor problem apart from a shell problem, and ADR
#                    0004's step-4 commands still use it.
#   egl-wayland      NVIDIA's EGL external platform for Wayland. Named
#                    explicitly rather than trusted to arrive as a dependency,
#                    because a compositor on the NVIDIA driver without it fails
#                    exactly like the driver problem the spike is looking for.
#
# M3's additions, all of them for the exported Godot shell rather than the
# compositor. Official Godot builds are compiled with use_sowrap=yes, so the
# binary dlopens these instead of linking them -- which means a missing one
# never produces a link error, only a feature that silently does not exist.
# That is why they are named here and asserted below rather than left to arrive
# as somebody else's dependency:
#
#   libX11, libXcursor, libXinerama, libXext, libXrandr, libXrender, libXi
#                    the X11 CLIENT libraries. gamescope drags in
#                    xorg-x11-server-Xwayland, but that is the X SERVER, and
#                    nothing in that chain promises the client side. Under plan
#                    A the shell runs on gamescope's XWayland, so their absence
#                    is a shell that starts and never opens a window --
#                    indistinguishable from a compositor failure, which is the
#                    exact class of bug ADR 0004 finding 2 was written about.
#   libxkbcommon     keyboard handling for the same client. It does arrive via
#                    gamescope and cage today; a dependency that happens to be
#                    there is not a guarantee.
#
# Deliberately NOT added, so nobody adds them later thinking it was an
# oversight: fontconfig (Godot embeds its own UI font; only SystemFont lookups
# need it) and any audio library (Phase 0 has no sound, so Godot selects the
# Dummy audio driver and says so once). Both would grow an appliance whose
# thesis is that nothing extra is reachable, and both are M4 audit questions
# rather than things to pre-empt. Gamepad input needs neither: it goes to
# /dev/input/event* directly through libudev, which systemd-libs already
# provides, and the player account is already in the input group.
#
# gamescope Recommends mesa-vulkan-drivers and weak dependencies are on by
# default, so this laptop ends up with two Vulkan ICDs installed. That is
# wanted -- the iGPU still needs a driver -- but it means the compositor has a
# wrong card available to pick, which is the false-green the plan's risk table
# and ADR 0003 both warn about. The session script pins the device by PCI id
# rather than trimming the recommend.
#
# The loop at the end is the regression guard for the dlopen'd set, and it
# covers two libraries nothing above installs directly: libudev, without which
# SDL3 (which is what Godot 4.5+ uses for gamepads) falls back to polling and
# controller hotplug stops working -- an explicit M3 checklist item that would
# still pass any test where the pad was plugged in at boot; and libvulkan, the
# loader every renderer path here goes through. ldconfig writes to a file rather
# than a pipe for the same SIGPIPE reason the initramfs greps below spell out.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install \
        greetd \
        gamescope \
        cage \
        vulkan-tools \
        egl-wayland \
        plymouth-plugin-script \
        libX11 \
        libXcursor \
        libXinerama \
        libXext \
        libXrandr \
        libXrender \
        libXi \
        libxkbcommon; \
    dnf clean all; \
    ldconfig -p > /tmp/ldcache.txt; \
    for lib in libX11.so.6 libXcursor.so.1 libXinerama.so.1 libXext.so.6 \
               libXrandr.so.2 libXrender.so.1 libXi.so.6 libxkbcommon.so.0 \
               libudev.so.1 libvulkan.so.1; do \
        grep -q "$lib" /tmp/ldcache.txt \
            || { echo "the Godot shell dlopens $lib and it is not installed"; exit 1; }; \
    done; \
    rm -f /tmp/ldcache.txt

# Everything under os/files lands in the image here, and the position is
# deliberate: it must be before the dracut run below, because
# /usr/lib/dracut/dracut.conf.d/50-marwanos-usb.conf only affects an initramfs
# if it exists in the filesystem at the moment dracut reads its config. Dracut
# picks up /usr/lib/dracut/dracut.conf.d/*.conf on its own; there is no flag to
# add.
#
# The cost is that editing anything under os/files now invalidates the dracut
# layer and the session-wiring layer below it. That is the honest trade -- a
# drop-in there can change what the initramfs contains -- but it is why a config
# edit rebuilds slower than a version bump, which still only touches the three
# cheap layers at the bottom.
#
# The source path is os/files rather than files because M3 moved the build
# context from os/ to the repo root. It had to move: the Godot project lives at
# shell/ (phase-0 M3, and phase-1 puts daemon/ and proto/ beside it), a COPY
# cannot reach outside its context, and doing it now costs three one-line edits
# instead of also moving shell/ later. The context is passed in
# scripts/build-push.sh and .github/workflows/build.yml; that workflow's paths:
# filter must list shell/** as well, or a shell edit stops triggering CI with
# nothing anywhere to say so. The repo root also needs a .containerignore --
# .git alone is 7 MB and this context is read over drvfs from /mnt/c.
COPY os/files/ /

# The nvidia kmod is built against the base's kernel but the initramfs shipped
# in the base predates it. Without this regen, plymouth has no NVIDIA driver to
# draw on in early boot -- which is exactly the M2 flash we are trying to avoid.
#
# --add ostree is load-bearing and was learned the hard way: without it this
# image boots straight into dracut emergency mode.
#
# The ostree dracut module is what reads the ostree= kernel argument and
# assembles /sysroot for the booted deployment. Its check() probes for a live
# ostree deployment, which does not exist inside a container build, so a plain
# `dracut` run silently omits it -- producing an initramfs that is byte-for-byte
# reasonable, passes every lint, and cannot mount root. Diffing our module list
# against the base's showed ostree as the single difference.
#
# The three greps below are the regression guard. A broken initramfs is
# invisible until boot, so the build has to be the thing that refuses.
#
# The uas.ko check guards the USB stack: a USB 3.x stick attaches over UAS, and
# the drivers are named in os/files/usr/lib/dracut/dracut.conf.d/
# 50-marwanos-usb.conf and nowhere else, so this grep doubles as proof that
# dracut actually read the drop-in.
#
# They read from files rather than pipes on purpose. `lsinitrd | grep -q` makes
# grep exit on the first match, lsinitrd then dies of SIGPIPE, and `set -o
# pipefail` turns that into exit 141 -- a guard that fails precisely when it
# should pass. Do not turn these back into pipelines.
#
# The .ko patterns are deliberately unanchored at the end: Fedora ships
# compressed modules, so the file in the initramfs is uas.ko.xz, not uas.ko.
# plymouth-set-default-theme runs before dracut because the plymouth dracut
# module bundles the CURRENT default theme into the initramfs -- set after the
# regen, the splash a user sees would be whatever bgrt showed (the vendor's
# firmware logo), not ours. The splash.png grep proves the bundling happened.
RUN set -euxo pipefail; \
    plymouth-set-default-theme marwanos; \
    KERNEL_VERSION="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core | tail -1)"; \
    dracut --force --no-hostonly --kver "${KERNEL_VERSION}" \
        --add ostree \
        --add-drivers " nvidia nvidia-modeset nvidia-drm nvidia-uvm " \
        "/lib/modules/${KERNEL_VERSION}/initramfs.img"; \
    lsinitrd --mod "/lib/modules/${KERNEL_VERSION}/initramfs.img" > /tmp/ir-mods.txt; \
    lsinitrd "/lib/modules/${KERNEL_VERSION}/initramfs.img" > /tmp/ir-files.txt; \
    grep -qx ostree /tmp/ir-mods.txt; \
    grep -q 'nvidia\.ko' /tmp/ir-files.txt; \
    grep -q '/uas\.ko' /tmp/ir-files.txt; \
    grep -q 'themes/marwanos/splash\.png' /tmp/ir-files.txt; \
    rm -f /tmp/ir-mods.txt /tmp/ir-files.txt

# Session wiring. Separate from the package install so that editing a session
# file does not re-run dnf, and after COPY because every line acts on something
# COPY put there.
#
# The find normalises everything COPY brought in to 0644 first. Checked out on
# Windows and read through the drvfs bridge, every file under os/files arrives
# in the build context as 0777 -- executable, world-writable config. systemd
# warns about it on every boot ("marked executable... marked world-writable...
# Proceeding anyway") and stricter parsers refuse outright. Fixed here, at the
# one place the real modes are decided.
#
# The chmod after it is not belt and braces. This repo is authored on Windows
# with core.filemode false -- an executable bit cannot survive a checkout here
# and has to be applied where the file is consumed. Without it greetd's `exec`
# of the session fails with EACCES on tty1, where nothing can report it. Same
# family of problem as the line endings .gitattributes exists to fix.
#
# systemd-sysusers is run against our file rather than bare, so this step
# creates exactly the account 50-marwanos.conf declares and cannot quietly
# depend on some other package's sysusers entry. The declaration is what bootc
# wants and what `bootc container lint` checks for; running it here as well just
# means the account exists in the image and not only after the first boot, where
# systemd-sysusers.service is gated on ConditionNeedsUpdate=/etc.
#
# The group loop exists because three different tools silently refuse this job.
# Fedora ships video, render and input in /usr/lib/group, not /etc/group. getent
# resolves them fine, but every shadow-utils tool reads and writes /etc/group
# only: sysusers' `m` lines and `usermod -aG` both exit 0 having added no
# membership, and gpasswd is the only one honest enough to say why ("group
# 'video' does not exist in /etc/group"). So the group is materialised into
# /etc/group at its real GID first, and then usermod has something to modify.
#
# The cost of getting this wrong is a session that boots, logs in, and cannot
# open /dev/dri/renderD* -- which on an appliance with no terminal reads as a
# driver failure. Hence the three id greps below: this must never ship silent
# again.
#
# The preset is applied explicitly rather than left to greetd's rpm scriptlet:
# %systemd_post runs presets on first install, which happened in the dnf layer
# above, before COPY landed 50-marwanos.preset.
#
# The wants symlink exists because greetd's [Install] section is nothing but
# Alias=display-manager.service. That gets it started under graphical.target
# (systemd's graphical.target carries Wants=display-manager.service) and
# nowhere else, so an appliance that stops at multi-user.target would boot to
# no session at all. It is created here rather than shipped under os/files/
# because git in this repo has core.symlinks false and would check a tracked
# symlink out as a text file containing its own target.
#
# getty@tty1 and autovt@tty1 are masked now rather than in M2, because D6 says
# no getty on tty1 ever and this is the cheapest possible moment to mean it.
# greetd's unit does declare Conflicts=getty@tty1.service, but a Conflicts is a
# race that systemd resolves after both units have been asked to start; a mask
# is the unit not existing. A preset file cannot express this -- systemd.preset
# understands only enable and disable, and disable would not touch the
# getty.target.wants symlink that systemd itself ships. autovt@tty1 is masked
# separately because autovt@.service is its own alias of getty@.service and is
# what logind starts on VT activation, so masking one does not mask the other.
#
# serial-getty@ttyS0 is masked for the same D6 reason and one practical one.
# `console=ttyS0` is on the kernel command line so QEMU can capture kernel output
# (ADR 0003), and systemd-getty-generator instantiates a serial getty on every
# console it finds there. This chassis has no serial port, so agetty opens the
# device, fails with EIO, and systemd restarts it -- measured on hardware at a
# restart every ~10s, `restart counter is at 7` inside a 75-second session. Two
# costs: a respawn loop forever, and `journalctl -p err` filling with
# "failed to get terminal attributes" when that command is the only triage
# surface this appliance has (see marwanos-session's header). Masking the ttyS0
# instance rather than dropping the karg keeps the kernel console on serial,
# which is what the QEMU targets actually use, and removes only the login prompt
# -- which D6 forbids regardless of whether the port exists.
#
# marwanos-panel.service gets a hand-made wants symlink under /usr/lib for the
# same reason greetd's is hand-made: `systemctl enable` and `systemctl preset`
# write into /etc/systemd/system, and bootc three-way merges /etc on upgrade, so
# enabling a unit that way ships machine-local state where image state belongs.
# The unit is still listed in 50-marwanos.preset, which is what stops a future
# `systemctl preset-all` on a target from turning it back off.
#
# /usr/lib/systemd/logind.conf.d is in the find list for the same reason every
# other entry is: it arrives through os/files/ and therefore lands 0777 from the
# drvfs bridge, and systemd warns about world-writable configuration on every
# boot. /usr/lib/systemd/system is deliberately NOT in the list -- it holds the
# entire base unit set, none of which came through os/files/, and chmodding the
# directory would force an overlayfs copy-up of hundreds of files into the
# MarwanOS layer on every build. The one unit that is ours is normalised by name.
RUN set -euxo pipefail; \
    find /etc/greetd /etc/issue /usr/lib/marwanos /usr/lib/sysusers.d \
         /usr/lib/tmpfiles.d /usr/lib/dracut/dracut.conf.d /usr/lib/bootc \
         /usr/lib/systemd/journald.conf.d /usr/lib/systemd/system-preset \
         /usr/lib/systemd/logind.conf.d \
         /usr/share/plymouth/themes/marwanos \
         -type f -exec chmod 0644 {} +; \
    chmod 0644 /usr/lib/systemd/system/marwanos-panel.service; \
    chmod 0755 /usr/lib/marwanos/session/marwanos-session; \
    chmod 0755 /usr/lib/marwanos/display/panel-policy; \
    systemd-sysusers /usr/lib/sysusers.d/50-marwanos.conf; \
    for g in video render input; do \
        gid="$(getent group "$g" | cut -d: -f3)"; \
        [ -n "$gid" ] || { echo "group $g does not exist at all"; exit 1; }; \
        grep -q "^${g}:" /etc/group || printf '%s:x:%s:\n' "$g" "$gid" >> /etc/group; \
    done; \
    usermod -aG video,render,input player; \
    systemctl --no-reload preset greetd.service; \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants; \
    ln -sf ../greetd.service \
        /usr/lib/systemd/system/multi-user.target.wants/greetd.service; \
    ln -sf ../marwanos-panel.service \
        /usr/lib/systemd/system/multi-user.target.wants/marwanos-panel.service; \
    systemctl --no-reload mask getty@tty1.service autovt@tty1.service \
                               serial-getty@ttyS0.service; \
    test -x /usr/lib/marwanos/session/marwanos-session; \
    test -x /usr/lib/marwanos/display/panel-policy; \
    test -L /usr/lib/systemd/system/multi-user.target.wants/marwanos-panel.service; \
    test -f /usr/lib/systemd/logind.conf.d/50-marwanos-lid.conf; \
    test -L /etc/systemd/system/getty@tty1.service; \
    test -L /etc/systemd/system/autovt@tty1.service; \
    test -L /etc/systemd/system/serial-getty@ttyS0.service; \
    getent passwd player; \
    test "$(id -u player)" = "1000"; \
    id -nG player | grep -qw video; \
    id -nG player | grep -qw render; \
    id -nG player | grep -qw input

# M3's shell, from the shell-export stage. The position is load-bearing in both
# directions and both failures are quiet ones.
#
# It has to be AFTER the session-wiring RUN above, because that RUN's find
# recurses through /usr/lib/marwanos and chmods every file to 0644. Placed any
# earlier, this binary loses its executable bit, resolve_client hands
# supervise_client a path that fails `[ -x ]`, the session logs "missing or not
# executable" and holds -- a black TV on a machine with no console. Same family
# as the greetd EACCES failure ADR 0004 finding 6 records, one level down.
#
# For the same reason /usr/lib/marwanos/shell must never be added to that find
# list. Nothing here comes through os/files, so it never arrives 0777 from the
# drvfs bridge and needs none of the normalisation that list exists for.
#
# It has to be BEFORE the MARWANOS_* ARGs below, because those change on every
# single build and a layer declared after them is re-committed every time. This
# one is ~90 MB, so below the ARGs a version bump would re-copy it and every
# `bootc upgrade` would transfer it. Above them, the measured 70 s warm rebuild
# is unchanged and only a real shell edit moves these bytes.
#
# The mode comes from the `install -m 0755` in shell-export, which COPY --from
# preserves. If the bit is ever missing here the fix is the placement above, not
# a chmod added underneath.
COPY --from=shell-export /out/ /

RUN set -euxo pipefail; \
    test -x /usr/lib/marwanos/shell/marwanos-shell; \
    test -s /usr/lib/marwanos/shell/marwanos-shell

# These ARGs are declared here, not at the top, and the placement is load-bearing.
# A changed ARG invalidates every layer after its declaration. MARWANOS_VERSION
# is timestamped, so it changes on every single build -- declared at the top it
# re-ran the dnf install and the dracut regen every time, which measured at 4 of
# 12 steps cached and blew most of M0's 15-minute loop budget on work whose
# inputs had not changed. Down here, only the three cheap layers below rebuild.
ARG MARWANOS_VERSION="0.0.0-dev"
ARG MARWANOS_COMMIT="unknown"
ARG MARWANOS_BUILD_DATE="unknown"

# M0's acceptance gate needs something trivial to change and observe on the
# target. This is that something: bump the version, rebuild, upgrade, `cat` it.
RUN set -euxo pipefail; \
    install -d /usr/share/marwanos; \
    printf 'MARWANOS_VERSION=%s\nMARWANOS_COMMIT=%s\nMARWANOS_BUILD_DATE=%s\n' \
        "${MARWANOS_VERSION}" "${MARWANOS_COMMIT}" "${MARWANOS_BUILD_DATE}" \
        > /usr/share/marwanos/build-info

# Identity. The login banner, hostname and os-release all said "Fedora", which
# during bring-up made a genuine MarwanOS boot indistinguishable from stale
# leftovers of previous Fedora/Bazzite installs on the same machine. NAME and
# PRETTY_NAME are ours; ID stays fedora deliberately -- tooling that keys off
# ID (packagekit, third-party scripts) keeps working, ID_LIKE would be the
# next step if that ever changes.
#
# /etc/issue ships as a file from os/files (the block-letter banner). It uses
# only full-block glyphs on purpose: agetty treats backslashes in issue as
# escape sequences, so figlet-style art made of slashes renders as garbage.
RUN set -euxo pipefail; \
    sed -i \
        -e 's/^NAME=.*/NAME="MarwanOS"/' \
        -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"MarwanOS (Phase 0, ${MARWANOS_VERSION})\"/" \
        /usr/lib/os-release; \
    grep -q 'MarwanOS' /etc/issue; \
    printf 'marwanos\n' > /etc/hostname

# In bootc, /var is machine-local state that is populated once at install and
# then never updated by an image upgrade. Anything we leave there becomes a
# first-boot-only default that silently drifts from the image forever, so the
# build's own droppings have to come out. /run must simply be empty.
#
# Note the /run paths are named individually rather than globbed: podman
# bind-mounts /run/secrets and /run/systemd during the build, so `rm -rf /run/*`
# fails on a busy mount. Those mounts are not part of the committed layer
# anyway; only what dnf and the selinux policy scriptlets left behind is.
RUN set -euxo pipefail; \
    rm -rf \
        /var/lib/dnf \
        /var/log/* \
        /var/cache/* \
        /var/tmp/* \
        /tmp/* \
        /run/dnf \
        /run/selinux-policy; \
    mkdir -p /var/log /var/cache /var/tmp

RUN bootc container lint
