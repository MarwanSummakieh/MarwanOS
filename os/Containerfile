    : "flag would skip exactly that boot and leave the grant behind forever."; \
    ln -sf ../marwanos-devmode-sudo.service \
        /usr/lib/systemd/system/multi-user.target.wants/marwanos-devmode-sudo.service; \
    systemctl --no-reload mask getty@tty1.service autovt@tty1.service \
