# syntax=docker/dockerfile:1
#
# MarwanOS — Phase 0: the factory, plus M1's session bring-up.
#
# Base pair, and why it is a pair:
#   ghcr.io/ublue-os/base-nvidia is dead (last real tags are from 2023). The
#   supported Universal Blue path for a custom NVIDIA image is now a minimal
#   base plus prebuilt akmods RPMs copied from a sidecar image. We still never
#   compile an NVIDIA module ourselves, which was the point of D1.
#
# The akmods tag MUST match the base's Fedora major and kernel flavour
# (base-main:43 -> akmods-nvidia-open:main-43). Mismatched pairs produce an
# image that builds fine and then boots to a black screen. scripts/bump-base.sh
# re-resolves both digests together so they can never drift apart.

ARG BASE_IMAGE="ghcr.io/ublue-os/base-main"
ARG BASE_TAG="43"
ARG BASE_DIGEST="sha256:0a7036f6c63744e974f022125e67fb03f892cd543ba54ec589cb38932a768997"

ARG AKMODS_IMAGE="ghcr.io/ublue-os/akmods-nvidia-open"
ARG AKMODS_TAG="main-43"
ARG AKMODS_DIGEST="sha256:b73a194f8d9d74bc2bca763be2dedde193b77956f4c83cb5eb3978150ff1f11f"
# THIS PAIR IS PINNED BACKWARDS ON PURPOSE, and the newer one is a known-bad
# build rather than a bump nobody got round to. Do not "freshen" it without
# reading docs/flicker-nvidia-610.md first.
#
# 2026-08-11: the bench's tearing was traced by elimination to the NVIDIA
# 610.43.03 flip path, so this pair was moved forward to 610.57.04 (base
# kernel 7.1.5 -> 7.1.8; the akmods kmod is built against one exact kernel, so
# base and sidecar are welded and can only move together). The image built,
# deployed and booted clean -- driver loaded, no Xid, GPU in D0, the flatpak
# GL extension for the new version present -- and the owner reported that GAME
# PERFORMANCE COLLAPSED across the board. Reverted here to the last pair known
# to run games well.
#
# What that costs and what it does not: the tearing is back with it, and the
# ~4 GB of image churn either way is why this is not a thing to flip casually.
# The confound is recorded honestly in the doc: base and driver moved as one,
# so "610.57.04 is slow" and "kernel 7.1.8 is slow" are not yet separated.

# Godot, pinned by exact version plus checksums for the same reason the base is
# pinned by digest: the engine exports the shell at build time, so the engine
# version is an input to what ships, and an engine that moved under us would
# change the appliance's only UI without any change on this side.
#
# `dnf install godot` is not the shortcut it looks like. Fedora's package is
# unpinned within F43 -- it has already gone 4.4 -> 4.4.1 -> 4.5 inside one
# release -- and it ships no export templates, which exist only as the official
# ~1.2 GB .tpz. The download is unavoidable either way, so the official binary,
# which is what the published checksums actually cover, is the honest choice.
#
# The two sums are the release's own SHA512-SUMS.txt, which upstream does not
# sign (godot-proposals#6042 is open), so copying them here is
# trust-on-first-use at the moment they were resolved -- the same trust model as
# BASE_DIGEST, which also came from one unauthenticated response. Resolved
# 2026-08-05 against godot-builds 4.7.1-stable (published 2026-07-14); 4.7.2-rc1
# exists, so expect a bump, and a bump must move the version and BOTH sums
# together or the export fails on a template/editor mismatch.
#
# These sit at the top rather than with the MARWANOS_* block at the bottom, and
# that is not a contradiction of the comment down there. An ARG declared before
# the first FROM is only visible to a stage that redeclares it; these four are
# redeclared only inside shell-export, so they cannot reach the dnf or dracut
# layers of the final stage. They also change once per deliberate Godot bump,
# which is exactly the churn profile BASE_DIGEST has.
ARG GODOT_VERSION="4.7.1"
ARG GODOT_RELEASE="stable"
ARG GODOT_EDITOR_SHA512="4ccdab7a48eeccbe8819a2fc1f6262f8d72065d98601bcb3743fcbd7ebd39f373758a788ee3293a05ec5b2c48538266c437404312e372225cd2df273945a2de9"
ARG GODOT_TEMPLATES_SHA512="afcc83d8d3d298038f19c58744a0d660fa75dd4baa33cb55d1011bb2565a2a8c2381728924564cb909e37c205a23f21b521b23bd057993afd43ae4da0b2f9d47"

# MOWSER'S ENGINE: the CEF binary distribution, pinned exactly as Godot is and
# for the same reason -- this is 306 MB of somebody else's compiler output that
# ends up inside the thing the owner runs, and "latest stable" is not a version.
#
# The '+' characters are part of the upstream filename and have to be
# percent-encoded in the URL; see the download below, which is the one place
# that transformation happens.
#
# THE SHA-512 IS OURS, COMPUTED ON A DOWNLOAD WHOSE PUBLISHED SHA-1 WE CHECKED.
# The CEF build index publishes SHA-1 only, which is not a hash to pin a
# quarter-gigabyte of engine on in 2026. So the flow is: fetch once, verify the
# published SHA-1 (that is what upstream attests), then record the SHA-512 of
# the verified bytes here. Every build after that checks the stronger one.
ARG CEF_VERSION="151.3.16+gbe1e15d+chromium-151.0.7922.109"
ARG CEF_SHA512="6e57a5ebdd80ee5f2fdaaa168ebe19551b5c459b0170bacac2a14a2e79a4ce0cdab419c72188454c1cb7a35f7c723cbc60313b95004c312f4880cd1433a6aa42"


FROM ${AKMODS_IMAGE}:${AKMODS_TAG}@${AKMODS_DIGEST} AS akmods


# M3's shell, exported here and nowhere else. No hand-exported binary is ever
# committed, which is the M3 checklist item this stage exists to satisfy.
#
# The toolchain stays in a discarded stage, and size is the smaller half of the
# reason: the editor binary is a GDScript interpreter with --script and
# --headless, which is to say a general-purpose arbitrary-code-execution engine,
# on a machine whose entire thesis (D6) is that no such thing is reachable. It
# is the same category of object as a shell. Only the exported binary crosses
# into the image.
#
# The base is reused rather than a fresh fedora tag so this adds no second
# multi-GB pull and no third digest anyone has to remember to bump. Nothing here
# needs the X11 or Wayland stacks: official Godot builds are compiled with
# use_sowrap=yes, so every display, audio and input library is dlopen'd at
# runtime by the *exported* binary rather than linked into the editor.
# SPLIT OUT OF shell-export, AND THE BUILD ORDER IS WHY. mowser's GDExtension
# has to exist before the shell is exported -- a .gd script naming MowserView
# with no extension present is a PARSE ERROR that fails the export, not a
# missing feature -- and mowser in turn needs this Godot binary to dump the
# GDExtension API it is compiled against. Two stages depending on one download
# is a third stage holding it; the alternative is a cycle.
FROM ${BASE_IMAGE}:${BASE_TAG}@${BASE_DIGEST} AS godot-sdk

ARG GODOT_VERSION
ARG GODOT_RELEASE
ARG GODOT_EDITOR_SHA512
ARG GODOT_TEMPLATES_SHA512

# Godot finds its editor data and its export templates through XDG, defaulting
# under $HOME. Naming all three removes any dependence on HOME being set or
# writable, which is otherwise a silent source of "no export template found" in
# a container build -- the export then fails for a reason that has nothing to do
# with the project.
#
# /godot rather than /opt/godot, and not as a style preference: in an ostree
# base /opt is a SYMLINK to /var/opt, the same trap as /usr/local. `install -d`
# mkdirs every path component, hits the symlink, and dies with "cannot create
# directory '/opt': File exists" -- after the 1.2 GB download has already been
# paid. A top-level directory in a stage that gets discarded owes nothing to
# FHS convention.
ENV XDG_DATA_HOME=/godot/data \
    XDG_CONFIG_HOME=/godot/config \
    XDG_CACHE_HOME=/godot/cache

# unzip only. curl is already here as curl-minimal, and `dnf install curl` does
# not no-op on that -- it tries to swap the two packages and fails on the
# conflict. Asserted instead.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install unzip; \
    dnf clean all; \
    command -v curl >/dev/null

# Fetch, verify, unpack. The cache mount keeps the 1.2 GB .tpz across local
# rebuilds even though none of it is committed to a shipped layer. CI is cold
# every time and pays the download once per build; if that ever hurts, the
# escalation is a separately published toolchain image consumed by digest, not a
# looser pin.
#
# The cached copy is checksummed BEFORE it is trusted, and a mismatch deletes
# and refetches rather than failing forever. A corrupt or half-written cache
# entry would otherwise wedge every later build behind an error that points at
# the pin instead of at the cache.
#
# Two members come out of the .tpz and no more. It carries a template for every
# platform Godot supports, so unpacking it whole would put ~2 GB into this stage
# for nothing.
#
# The version.txt check is the direct analogue of bump-base.sh's base/akmods
# pair check: an export template from a different release than the editor is a
# hard export failure, so the pair is asserted rather than assumed to have been
# bumped together.
RUN --mount=type=cache,dst=/godot-dl,sharing=locked \
    set -euxo pipefail; \
    base_url="https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}-${GODOT_RELEASE}"; \
    editor_zip="Godot_v${GODOT_VERSION}-${GODOT_RELEASE}_linux.x86_64.zip"; \
    templates_tpz="Godot_v${GODOT_VERSION}-${GODOT_RELEASE}_export_templates.tpz"; \
    for spec in "${editor_zip} ${GODOT_EDITOR_SHA512}" \
                "${templates_tpz} ${GODOT_TEMPLATES_SHA512}"; do \
        set -- ${spec}; \
        if ! printf '%s  %s\n' "$2" "/godot-dl/$1" | sha512sum -c --status - 2>/dev/null; then \
            rm -f "/godot-dl/$1"; \
            curl -fsSL --retry 3 -o "/godot-dl/$1" "${base_url}/$1"; \
            printf '%s  %s\n' "$2" "/godot-dl/$1" | sha512sum -c -; \
        fi; \
    done; \
    install -d /godot/bin; \
    unzip -j -o "/godot-dl/${editor_zip}" -d /godot/bin; \
    mv /godot/bin/Godot_v*_linux.x86_64 /godot/bin/godot; \
    chmod 0755 /godot/bin/godot; \
    unzip -j -o "/godot-dl/${templates_tpz}" \
        'templates/version.txt' 'templates/linux_release.x86_64' -d /tmp/tpl; \
    tpl_version="$(cat /tmp/tpl/version.txt)"; \
    test "${tpl_version}" = "${GODOT_VERSION}.${GODOT_RELEASE}"; \
    install -D -m 0755 /tmp/tpl/linux_release.x86_64 \
        "${XDG_DATA_HOME}/godot/export_templates/${tpl_version}/linux_release.x86_64"; \
    rm -rf /tmp/tpl; \
    /godot/bin/godot --version > /tmp/godot-version.txt; \
    grep -q "^${GODOT_VERSION}\.${GODOT_RELEASE}\." /tmp/godot-version.txt; \
    rm -f /tmp/godot-version.txt


# ---------------------------------------------------------------------------
# MOWSER: the appliance's browser, which is Chromium's engine and this
# project's code, with no browser UI in between. See mowser/src/mowser.h for
# the whole argument; this stage is only how it gets built.
#
# WHY THE ENGINE IS EMBEDDED RATHER THAN INSTALLED. The three browsers this
# image has shipped tell the story: Zen (a browser nobody could drive with a
# pad), then Chromium in kiosk mode (the same UI, hidden rather than absent --
# somebody else's application one changed default away from a window this
# machine cannot dismiss), and now this. The owner asked for "my own custom
# made chromium that is only the engine inside my launcher"; an embedded engine
# is the only one of the three where the browser's behaviour is this repo's to
# decide.
FROM ${BASE_IMAGE}:${BASE_TAG}@${BASE_DIGEST} AS mowser-build

ARG CEF_VERSION
ARG CEF_SHA512

# g++ and make build mowser; cmake builds CEF's own C++ wrapper; scons builds
# godot-cpp. Four build systems for two outputs is not a design, it is what
# happens when three upstreams each chose one -- and all of it stays in this
# discarded stage.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install gcc-c++ make cmake python3 scons git binutils; \
    dnf clean all

# The engine's own binary, verified before a single byte of it is unpacked.
RUN --mount=type=cache,dst=/cef-dl,sharing=locked \
    set -euxo pipefail; \
    tarball="cef_binary_${CEF_VERSION}_linux64_minimal.tar.bz2"; \
    : "The '+' in the version is legal in a filename and not in a URL path,"; \
    : "so it is percent-encoded here and nowhere else."; \
    url_name="$(printf '%s' "$tarball" | sed 's/+/%2B/g')"; \
    if ! printf '%s  %s\n' "$CEF_SHA512" "/cef-dl/$tarball" | sha512sum -c --status - 2>/dev/null; then \
        rm -f "/cef-dl/$tarball"; \
        curl -fsSL --retry 3 -o "/cef-dl/$tarball" \
            "https://cef-builds.spotifycdn.com/${url_name}"; \
        printf '%s  %s\n' "$CEF_SHA512" "/cef-dl/$tarball" | sha512sum -c -; \
    fi; \
    mkdir -p /build/cef; \
    tar -xjf "/cef-dl/$tarball" -C /build/cef --strip-components=1; \
    test -f /build/cef/Release/libcef.so; \
    test -f /build/cef/include/cef_version.h

# The GDExtension API, from the engine that will actually load the extension.
#
# THERE IS NO godot-cpp BRANCH FOR THIS ENGINE -- upstream's release branches
# stop at 4.5 and this image runs 4.7.1 -- so the binding cannot be pinned by
# version tag the way everything else here is. Dumping the API from the pinned
# binary is better than a tag would have been anyway: the binding matches the
# engine BY CONSTRUCTION rather than by somebody remembering to bump two
# numbers together. Same argument the flatpak extension branches get.
COPY --from=godot-sdk /godot/bin/godot /build/godot
RUN set -euxo pipefail; \
    : "A WRITABLE HOME, and it is not optional even for a dump that writes"; \
    : "its two files into the current directory. Godot creates its user data"; \
    : "directory before it does anything else, and aborts (SIGABRT, exit 134)"; \
    : "if it cannot -- so this stage, which does NOT inherit godot-sdk's XDG"; \
    : "environment because it starts from the base image, otherwise fails on"; \
    : "a path under /root that has nothing to do with what was asked for."; \
    install -d /build/godot-home; \
    export HOME=/build/godot-home; \
    export XDG_DATA_HOME=/build/godot-home/data; \
    export XDG_CONFIG_HOME=/build/godot-home/config; \
    export XDG_CACHE_HOME=/build/godot-home/cache; \
    cd /build; \
    ./godot --headless --dump-extension-api --dump-gdextension-interface; \
    test -s /build/extension_api.json; \
    test -s /build/gdextension_interface.h; \
    grep -q '"version_major": 4' /build/extension_api.json; \
    grep -q '"version_minor": 7' /build/extension_api.json

# godot-cpp, generated from the dump above.
RUN set -euxo pipefail; \
    git clone https://github.com/godotengine/godot-cpp /build/godot-cpp; \
    cd /build/godot-cpp; \
    : "Recorded rather than pinned to a commit: there is no godot-cpp release"; \
    : "that matches this engine, so the reproducibility that matters is the"; \
    : "API dump above -- the bindings are GENERATED from it, and a generator"; \
    : "that produced different bindings for the same API would fail the"; \
    : "shell's export, which runs immediately after."; \
    git rev-parse HEAD > /build/godot-cpp-commit.txt; \
    cat /build/godot-cpp-commit.txt; \
    cp /build/gdextension_interface.h /build/godot-cpp/gdextension/gdextension_interface.h; \
    : "NOT PIPED. A pipeline reports its LAST command's status, so a scons"; \
    : "failure behind a pipe into tail is invisible and surfaces ten minutes"; \
    : "later as a link error naming a file nobody wrote."; \
    : ""; \
    : "TWO CHARACTERS ARE FORBIDDEN IN THESE : \"prose\" LINES, and both cost a"; \
    : "build to learn: a backtick is command substitution (a syntax error"; \
    : "printed from a COMMENT, on every build), and an unescaped dollar is a"; \
    : "variable expansion that set -u turns into a fatal unbound-variable"; \
    : "error. Escape the dollar, spell the backtick out."; \
    scons platform=linux target=template_release arch=x86_64 \
        custom_api_file=/build/extension_api.json generate_bindings=yes \
        -j"$(nproc)" > /build/godot-cpp.log 2>&1 \
        || { echo "godot-cpp failed:"; tail -40 /build/godot-cpp.log; exit 1; }; \
    ls /build/godot-cpp/bin/libgodot-cpp*.a

# CEF's C++ wrapper, which the distribution ships as SOURCE rather than as a
# library precisely so it is compiled with the same compiler and flags as the
# code calling it. Only the wrapper target: the distribution's sample apps
# want GTK and are not built.
RUN set -euxo pipefail; \
    mkdir -p /build/cef/build; \
    cd /build/cef/build; \
    cmake -DCMAKE_BUILD_TYPE=Release .. > /build/cef-cmake.log 2>&1 \
        || { tail -30 /build/cef-cmake.log; exit 1; }; \
    make -j"$(nproc)" libcef_dll_wrapper > /build/cef-make.log 2>&1 \
        || { tail -40 /build/cef-make.log; exit 1; }; \
    test -f /build/cef/build/libcef_dll_wrapper/libcef_dll_wrapper.a

COPY mowser/ /build/mowser/

RUN set -euxo pipefail; \
    cd /build/mowser; \
    make CEF_ROOT=/build/cef GODOT_CPP=/build/godot-cpp OUT=/build/out; \
    test -s /build/out/libmowser.so; \
    test -s /build/out/mowser-helper; \
    : "The extension and the helper must both find libcef.so BESIDE"; \
    : "themselves. Without RUNPATH=\$ORIGIN the extension fails to load with a"; \
    : "message that names libcef.so and no path, on a machine with no console."; \
    objdump -p /build/out/libmowser.so | grep -q 'RUNPATH.*ORIGIN'; \
    objdump -p /build/out/mowser-helper | grep -q 'RUNPATH.*ORIGIN'

# THE PAYLOAD, ASSEMBLED AND CUT DOWN TO WHAT RUNS.
#
# libcef.so arrives at 1.4 GB because it carries full debug symbols. Stripped
# it is 256 MB, and the whole payload below -- engine, V8 snapshot, resource
# packs, ICU tables, one locale, the sandbox helper -- is about 290 MB. For
# scale, this image DELETED Firefox at 344 MB for being the largest thing in it
# that nothing used. The browser that replaced it weighs less than it did, and
# everything on this machine that shows a web page goes through it.
#
# ONE LOCALE. The distribution ships 220 locale packs at 49 MB; the shell is
# English and nothing selects between them, so shipping the other 219 would be
# 48 MB of strings no code path can reach. This is the line to change on the
# day the shell speaks anything else.
# A FLAT DIRECTORY, AND THE TIDIER SHAPE IS THE ONE THAT CRASHES.
#
# The first version of this put the .pak files, icudtl.dat and locales/ under a
# resources/ subdirectory and pointed CefSettings::resources_dir_path at it,
# which reads better and is wrong. Chromium locates its ICU data relative to
# the MODULE -- libcef.so's own directory -- and passes the resulting file
# descriptor down to the renderer it forks. Get that wrong and the browser
# process comes up, the renderer does not, and the whole thing aborts with
#
#   ERROR:base/i18n/icu_util.cc:232] Invalid file descriptor to ICU data received.
#
# which on this appliance was the SHELL dying the moment somebody pressed Buy
# -- a black television, because the browser is inside the shell's process.
#
# So the layout is CEF's own sample layout: everything in one directory beside
# libcef.so. locales/ stays a subdirectory because that is where CEF looks for
# it (locales_dir_path), and it is the only thing that gets one.
RUN set -euxo pipefail; \
    install -d /payload/locales; \
    install -m 0755 /build/cef/Release/libcef.so /payload/libcef.so; \
    strip --strip-unneeded /payload/libcef.so; \
    install -m 0644 /build/cef/Release/v8_context_snapshot.bin /payload/; \
    : "chrome-sandbox is installed by the FINAL stage, not here: it needs to"; \
    : "be SUID root and a mode set in a discarded stage is a mode nobody"; \
    : "keeps. Carried across as an ordinary file."; \
    install -m 0755 /build/cef/Release/chrome-sandbox /payload/chrome-sandbox; \
    install -m 0644 /build/cef/Resources/icudtl.dat /payload/; \
    install -m 0644 /build/cef/Resources/resources.pak /payload/; \
    install -m 0644 /build/cef/Resources/chrome_100_percent.pak /payload/; \
    install -m 0644 /build/cef/Resources/chrome_200_percent.pak /payload/; \
    install -m 0644 /build/cef/Resources/locales/en-US.pak /payload/locales/; \
    install -m 0755 /build/out/mowser-helper /payload/mowser-helper; \
    install -m 0755 /build/out/libmowser.so /payload/libmowser.so; \
    : "The size is asserted in BOTH directions. Too big means the strip"; \
    : "silently did nothing -- a 1.4 GB library would not fit beside the OS on"; \
    : "a 15.4 GiB root and the failure would be a stick that will not install."; \
    : "Too small means the strip ate something it should not have, which is a"; \
    : "library that loads and then cannot resolve its own symbols."; \
    size_mb="$(du -sm /payload | cut -f1)"; \
    echo "mowser payload: ${size_mb} MB"; \
    test "$size_mb" -lt 400 || { echo "the mowser payload is too large -- did the strip run?"; exit 1; }; \
    test "$size_mb" -gt 150 || { echo "the mowser payload is too small -- something did not get installed"; exit 1; }


# ---------------------------------------------------------------------------
# M3's shell, exported here and nowhere else. Resumes from godot-sdk so the
# editor, the templates and their checksums are not downloaded twice.
FROM godot-sdk AS shell-export

# The project arrives last, deliberately. It is the only input a UI change
# touches, so the dnf install, the 1.2 GB download and the unpack above all stay
# cached across shell edits -- and because this is a separate stage, none of it
# reaches the final stage's dnf or dracut layers at all.
COPY shell/ /build/shell/

# MOWSER'S EXTENSION, STAGED INTO THE PROJECT BEFORE THE EXPORT, because the
# exporter will not run without it.
#
# Godot does not merely record the .gdextension's library path -- it OPENS the
# file and copies it next to the exported binary, and an unreadable path fails
# the export outright ("Failed to copy shared object"). So the library has to
# be inside the project here, even though the copy Godot makes is the one that
# actually runs. See shell/bin/mowser.gdextension for the whole shape.
#
# Godot ALSO tries to dlopen it during the export and logs "Can't open dynamic
# library ... libcef.so" when it cannot, because the engine is not in this
# stage. That is a warning and not a failure, and it is harmless here:
# browser_screen.gd reaches MowserView through ClassDB by name rather than as a
# static type -- which it has to do anyway, to survive an image whose payload
# did not land -- so no script needs the class to exist in order to compile.
COPY --from=mowser-build /payload/libmowser.so /build/shell/bin/libmowser.so

# Everything the export depends on, checked before the export runs, so a problem
# names its own cause instead of surfacing later as a missing or half-working
# binary on a machine with no console.
#
# "Linux" is the contract between this file and shell/export_presets.cfg. It is
# the preset name --export-release resolves, and Godot's error for an unknown
# preset does not say which names it does know.
#
# binary_format/embed_pck=true is what makes the export ONE file. Off (its
# default) Godot writes marwanos-shell plus a sibling .pck, and BAKED_CLIENT in
# the session script and D5's `[ -x "$DEV_CLIENT" ]` are both single paths -- so
# a preset re-saved in the Godot editor GUI with that box unticked ships a
# binary whose data was never copied. The .pck assertion after the export is the
# same guard from the other side.
#
# .godot is the import cache and is regenerated below. A copy carried in from a
# developer's machine is host state with absolute host paths in it, and this
# build's whole claim is that the binary is a function of the repo.
RUN set -euxo pipefail; \
    grep -q '^name="Linux"$' /build/shell/export_presets.cfg; \
    grep -q '^binary_format/embed_pck=true$' /build/shell/export_presets.cfg; \
    rm -rf /build/shell/.godot

# Import and export are two steps because only --export-debug and --export-pack
# are documented to imply an import. Without one, the export fails with "make
# sure resources have been imported by opening the project in the editor at
# least once" (godot#71521) -- advice aimed at a human, in a place where there
# is none.
#
# --network=none turns "the export fetches nothing" from a belief into a
# build-time fact: everything needed is already in this stage and checksummed.
# The day the shell needs something fetched at export time -- C# would, it needs
# the mono templates and a NuGet restore -- this gets revisited deliberately
# rather than deleted in frustration.
#
# timeout is not paranoia. godot#95287 is a headless export that hangs forever
# instead of failing, and a hang on a CI runner burns the whole job budget
# before failing uselessly.
RUN --network=none set -euxo pipefail; \
    timeout 600 /godot/bin/godot --headless --path /build/shell --import

# The export is guarded rather than trusted, because Godot's headless export has
# a documented history of lying about its own success: godot#83042 returned exit
# 0 on failure for years, and godot#99284 crashed while still writing a
# plausible-looking executable. Nothing downstream can tell a good binary from a
# bad one, and the machine that finds out is a TV showing black.
#
# The output keeps the .x86_64 extension Godot's Linux exporter expects and is
# renamed by the install, rather than fighting the extension check.
RUN --network=none set -euxo pipefail; \
    install -d /build/out; \
    timeout 900 /godot/bin/godot --headless --path /build/shell \
        --export-release "Linux" /build/out/marwanos-shell.x86_64; \
    test -s /build/out/marwanos-shell.x86_64; \
    test "$(stat -c%s /build/out/marwanos-shell.x86_64)" -gt 20000000; \
    test "$(od -An -tx1 -N4 /build/out/marwanos-shell.x86_64 | tr -d ' ')" = "7f454c46"; \
    test ! -e /build/out/marwanos-shell.pck; \
    install -D -m 0755 /build/out/marwanos-shell.x86_64 \
        /out/usr/lib/marwanos/shell/marwanos-shell; \
    : "THE EXTENSION TRAVELS WITH THE BINARY, because that is where Godot"; \
    : "looks for it: the exporter puts a GDExtension library beside the"; \
    : "executable rather than in the pack (a pack member cannot be dlopen'd),"; \
    : "so the shell resolves res://bin/libmowser.so to its own directory at"; \
    : "runtime. Asserted rather than assumed -- if a future Godot stopped"; \
    : "emitting this copy, the symptom would be a browser screen politely"; \
    : "saying the engine is not installed, on an image that contains it."; \
    test -s /build/out/libmowser.so; \
    install -D -m 0755 /build/out/libmowser.so \
        /out/usr/lib/marwanos/shell/libmowser.so


FROM ${BASE_IMAGE}:${BASE_TAG}@${BASE_DIGEST}

# nvidia-open requires Turing (RTX 20 / GTX 16) or newer: the open modules lean
# on the GSP coprocessor, which does not exist on Pascal and older. NVIDIA's 590
# branch dropped Maxwell/Pascal/Volta entirely, so this is now the floor for any
# machine that expects current drivers. See docs/adr/0002.
COPY --from=akmods /rpms/ /tmp/rpms/

# Fail loudly and early if the akmods layout ever changes upstream, rather than
# letting a glob silently match nothing and shipping an image with no driver.
# The nvidia/ directory carries the userspace driver and is as load-bearing as
# the kmod -- see the install step below for what happened when it was missed.
RUN set -euxo pipefail; \
    ls -1 /tmp/rpms/ublue-os/ublue-os-nvidia*.rpm >/dev/null; \
    ls -1 /tmp/rpms/kmods/kmod-nvidia*.rpm >/dev/null; \
    ls -1 /tmp/rpms/nvidia/nvidia-driver-libs-*.x86_64.rpm >/dev/null

# Kernel module AND userspace driver, from the same sidecar.
#
# The userspace line exists because its absence cost a near-miss: the image
# originally installed only the kmod and the ublue addons, which yields loaded
# nvidia.ko modules and no Vulkan ICD, no EGL, no nvidia-smi -- a machine on
# which gamescope fails in a way indistinguishable from the compositor problem
# M1's spike exists to investigate. Upstream ublue's own installer script
# installs /rpms/nvidia/* from this sidecar; we take the subset a Wayland
# appliance needs. The ICD assertion at the end is the regression guard.
#
# i686 userspace (32-bit GL/Vulkan for Proton's 32-bit games) is deliberately
# deferred to Phase 1: it drags multilib glibc into the image and nothing in
# Phase 0 runs 32-bit code.
# THE NVIDIA SET IS INSTALLED WHOLE, AND THE FLOATING REPO IS LOCKED OUT OF IT.
#
# This broke on 2026-08-08 and the failure is worth recording, because nothing
# in this repo changed to cause it. The akmods sidecar is pinned by digest at
# 610.43.03. `fedora-multimedia` is NOT pinned -- it is a live repo, and it
# moved to 610.57.04. Two packages were being left to dnf to find:
#
#   nvidia-kmod-common      required by nvidia-driver, exact version match
#   nvidia-driver-cuda-libs provides libcuda.so.1, required by nvidia-driver-libs
#
# While the repo happened to carry the same version as the sidecar, dnf resolved
# both from the repo and everything worked. The moment the repo moved ahead,
# there was no 610.43.03 to find and the only candidates conflicted with the
# 610.43.03 packages already on the command line:
#
#   nothing provides nvidia-kmod-common = 3:610.43.03
#   cannot install both nvidia-driver-common-3:610.43.03 (@commandline)
#                   and nvidia-driver-common-3:610.57.04 (fedora-multimedia)
#
# So a pinned digest was never actually pinning the driver: two of its packages
# were floating, and the pin held only by coincidence. Both fixes below are
# needed and neither is sufficient alone.
#
#   1. Install the complete set from the sidecar, so nothing has to be found.
#      The sidecar ships a self-consistent 610.43.03 collection; taking a subset
#      and hoping for the rest is what created the hole.
#   2. Exclude from fedora-multimedia EXACTLY the packages the sidecar ships,
#      so a future version skew cannot silently pull a mismatched one back in.
#
# THE EXCLUDE LIST IS NAMES, NOT A GLOB, and that is the second thing this
# fix got wrong before it got right. `nvidia*` also excludes
# nvidia-driver-selinux, which is version 0.1-2 -- independent of the driver
# version, absent from the sidecar, and a weak dependency of nvidia-kmod-common
# under selinux-policy-targeted. Blocking it made the transaction unsolvable
# for a package that was never part of the conflict. The rule that is actually
# wanted is "the sidecar is authoritative for what the sidecar ships, and
# nothing else", which only a name list can express.
#
# i686 userspace is still deliberately absent (Phase 1) -- only x86_64 and the
# one noarch are installed, so the sidecar's .i686 files stay unused.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install \
        --setopt=fedora-multimedia.excludepkgs='kmod-nvidia,libnvidia-fbc,nvidia-driver,nvidia-driver-common,nvidia-driver-cuda,nvidia-driver-cuda-libs,nvidia-driver-libs,nvidia-kmod-common,nvidia-libXNVCtrl,nvidia-modprobe,nvidia-persistenced,nvidia-settings,nvidia-xconfig,xorg-x11-nvidia' \
        /tmp/rpms/ublue-os/ublue-os-nvidia*.rpm \
        /tmp/rpms/kmods/kmod-nvidia*.rpm \
        /tmp/rpms/nvidia/nvidia-kmod-common-[0-9]*.noarch.rpm \
        /tmp/rpms/nvidia/nvidia-modprobe-[0-9]*.x86_64.rpm \
        /tmp/rpms/nvidia/nvidia-driver-[0-9]*.x86_64.rpm \
        /tmp/rpms/nvidia/nvidia-driver-common-[0-9]*.x86_64.rpm \
        /tmp/rpms/nvidia/nvidia-driver-libs-[0-9]*.x86_64.rpm \
        /tmp/rpms/nvidia/nvidia-driver-cuda-libs-[0-9]*.x86_64.rpm; \
    rm -rf /tmp/rpms; \
    dnf clean all; \
    rpm -q nvidia-driver-libs >/dev/null; \
    ls /usr/share/vulkan/icd.d/nvidia_icd*.json >/dev/null; \
    : "The DRIVER packages must all be one version -- a mixed set is what this"; \
    : "block exists to prevent, and it would otherwise surface only as a kernel"; \
    : "module that loads beside a userspace that does not match it."; \
    : ""; \
    : "Named explicitly rather than globbed as nvidia*, because"; \
    : "nvidia-driver-selinux is version 0.1 and always will be: it is policy,"; \
    : "not driver, and it is correct for it to differ. Globbing counted it as a"; \
    : "second version and failed a build whose install was perfect."; \
    test "$(rpm -q --qf '%{VERSION}\n' \
        nvidia-driver nvidia-driver-common nvidia-driver-libs \
        nvidia-driver-cuda-libs nvidia-kmod-common nvidia-modprobe \
        | sort -u | wc -l)" = 1; \
    ldconfig -p | grep -q 'libcuda\.so\.1'

# M1's packages. Every one of these is in Fedora 43 proper -- checked against
# packages.fedoraproject.org before this line existed -- so no COPR is involved,
# and none should be added here without an ADR saying why:
#
#   greetd 0.10.3    autologin daemon (D3). Its rich dependency pulls
#                    greetd-selinux automatically wherever selinux-policy is
#                    installed, which is here, so the policy module is not
#                    named explicitly.
#   gamescope 3.16   plan A: the DRM-master session compositor (D4). Requires
#                    xorg-x11-server-Xwayland, so XWayland arrives with it and
#                    does not need naming either.
#   cage 0.2.0       plan B (D4).
#   vulkan-tools     vkcube. Not the shell -- M3's Godot export is -- but kept
#                    deliberately: it is the one client that can tell a
#                    compositor problem apart from a shell problem, and ADR
#                    0004's step-4 commands still use it.
#   egl-wayland      NVIDIA's EGL external platform for Wayland. Named
#                    explicitly rather than trusted to arrive as a dependency,
#                    because a compositor on the NVIDIA driver without it fails
#                    exactly like the driver problem the spike is looking for.
#
# M3's additions, all of them for the exported Godot shell rather than the
# compositor. Official Godot builds are compiled with use_sowrap=yes, so the
# binary dlopens these instead of linking them -- which means a missing one
# never produces a link error, only a feature that silently does not exist.
# That is why they are named here and asserted below rather than left to arrive
# as somebody else's dependency:
#
#   libX11, libXcursor, libXinerama, libXext, libXrandr, libXrender, libXi
#                    the X11 CLIENT libraries. gamescope drags in
#                    xorg-x11-server-Xwayland, but that is the X SERVER, and
#                    nothing in that chain promises the client side. Under plan
#                    A the shell runs on gamescope's XWayland, so their absence
#                    is a shell that starts and never opens a window --
#                    indistinguishable from a compositor failure, which is the
#                    exact class of bug ADR 0004 finding 2 was written about.
#   libxkbcommon     keyboard handling for the same client. It does arrive via
#                    gamescope and cage today; a dependency that happens to be
#                    there is not a guarantee.
#
# Deliberately NOT added, so nobody adds them later thinking it was an
# oversight: fontconfig (Godot embeds its own UI font; only SystemFont lookups
# need it) and any audio library (Phase 0 has no sound, so Godot selects the
# Dummy audio driver and says so once). Both would grow an appliance whose
# thesis is that nothing extra is reachable, and both are M4 audit questions
# rather than things to pre-empt. Gamepad input needs neither: it goes to
# /dev/input/event* directly through libudev, which systemd-libs already
# provides, and the player account is already in the input group.
#
# gamescope Recommends mesa-vulkan-drivers and weak dependencies are on by
# default, so this laptop ends up with two Vulkan ICDs installed. That is
# wanted -- the iGPU still needs a driver -- but it means the compositor has a
# wrong card available to pick, which is the false-green the plan's risk table
# and ADR 0003 both warn about. The session script pins the device by PCI id
# rather than trimming the recommend.
#
# The loop at the end is the regression guard for the dlopen'd set, and it
# covers two libraries nothing above installs directly: libudev, without which
# SDL3 (which is what Godot 4.5+ uses for gamepads) falls back to polling and
# controller hotplug stops working -- an explicit M3 checklist item that would
# still pass any test where the pad was plugged in at boot; and libvulkan, the
# loader every renderer path here goes through. ldconfig writes to a file rather
# than a pipe for the same SIGPIPE reason the initramfs greps below spell out.
# xdotool is the pad-keys bridge's injector (shell/src/pad_keys.gd): the shell
# translates gamepad presses into XTEST key events for desktop applications
# that have no controller support of their own -- Dolphin was the first, and
# the bridge outlives Dolphin's 2026-08-10 exit from the shipped set. It is
# a tool, not a library, so the dlopen loop below rightly does not know it;
# the verify block asserts it next to xprop, its sibling in "small X clients
# the shell shells out to".
#
# THE LAST THREE ARE THE DEVMODE TERMINAL, and they are the first packages in
# this image whose whole purpose is to be reachable by a person. See
# /usr/lib/marwanos/terminal for what the flag gates and ADR 0009 for why the
# exception to D6 is a narrowing of it rather than a hole in it.
#
#   xterm                    an X11 client that wants nothing this session does
#                            not already have -- no GPU context, no D-Bus, no
#                            portal, no desktop. Every prettier emulator wants
#                            at least one of those, and foot wants a Wayland
#                            display the shell deliberately does not use.
#                            ITS DESKTOP ENTRY DOES NOT SURVIVE THE INSTALL:
#                            the rm below takes /usr/share/applications/
#                            xterm.desktop out, because marwanos-appscan walks
#                            that directory with the freedesktop rules and
#                            xterm's entry passes every one of them -- so the
#                            terminal, which ADR 0009 admits ONLY as a devmode
#                            settings row, was also sitting on every machine's
#                            rail as an ordinary "xterm" card (seen live on
#                            the bench, 2026-08-11). Deleting the entry is the
#                            same honesty argument as deleting Firefox's RPM
#                            below: the scanner has no deny-list by design,
#                            so what it must not report must not exist. The
#                            settings row does not care -- it launches the
#                            wrapper by path, no desktop entry involved.
#   dejavu-sans-mono-fonts   named rather than left to fontconfig, because the
#                            wrapper asks for this face BY NAME and
#                            fontconfig's answer to a missing family is a
#                            silent substitution -- on a TV that is a terminal
#                            rendered in a proportional face, which is not a
#                            terminal. It also drags in fontconfig itself,
#                            which is why the "deliberately NOT added" note
#                            above no longer holds for it: the exclusion was
#                            about Godot never needing it, and this does.
#   sudo                     journalctl, nmcli, systemctl and bootc are all
#                            root's, and the player account is a locked nologin
#                            one. Asserted rather than assumed: it comes from
#                            the base image today, and a terminal that cannot
#                            escalate is a terminal that cannot fix the machine
#                            it is running on. The RULE is not shipped here --
#                            marwanos-devmode-sudo.service installs it per boot
#                            off the same flag.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install \
        greetd \
        gamescope \
        cage \
        xdotool \
        qrencode \
        xterm \
        dejavu-sans-mono-fonts \
        sudo \
        vulkan-tools \
        egl-wayland \
        plymouth-plugin-script \
        libX11 \
        libXcursor \
        libXinerama \
        libXext \
        libXrandr \
        libXrender \
        libXi \
        libxkbcommon; \
    dnf clean all; \
    : "xterm's launcher entry, removed -- see the xterm note above. uxterm's"; \
    : "is named too in case a future Fedora ships one (Debian's package"; \
    : "does); rm -f on a file that does not exist is the cheap way to keep"; \
    : "that from ever becoming a second card."; \
    rm -f /usr/share/applications/xterm.desktop \
          /usr/share/applications/uxterm.desktop; \
    ldconfig -p > /tmp/ldcache.txt; \
    for lib in libX11.so.6 libXcursor.so.1 libXinerama.so.1 libXext.so.6 \
               libXrandr.so.2 libXrender.so.1 libXi.so.6 libxkbcommon.so.0 \
               libudev.so.1 libvulkan.so.1; do \
        grep -q "$lib" /tmp/ldcache.txt \
            || { echo "the Godot shell dlopens $lib and it is not installed"; exit 1; }; \
    done; \
    rm -f /tmp/ldcache.txt; \
    setcap cap_sys_nice+ep /usr/bin/gamescope; \
    getcap /usr/bin/gamescope | grep -q cap_sys_nice \
        || { echo "setcap did not take on gamescope"; exit 1; }

# THE BROWSER IS CHROMIUM, AND IT IS NOT AN RPM.
#
# The ublue base image ships Firefox -- 295 MB plus 49 MB of langpacks, on a
# root filesystem with about 7 GiB spare. Nothing here asked for it and the
# appliance's browser is Chromium, installed as a flatpak on first boot by
# marwanos-flatpak-install@org.chromium.Chromium.service, so the RPM is both
# unwanted and the largest single thing in the image that nothing uses.
# (The browser was Zen from 2026-08-07 to 2026-08-11 -- rail-hidden on its
# last day, then removed; see shipped-apps for the headstone.)
#
# WHY REMOVED RATHER THAN HIDDEN. marwanos-appscan lists what is installed, by
# design and with no deny-list for "things we would rather you did not see" --
# so an image that still carried Firefox would put it on the rail, and the only
# alternatives would be lying in the scanner or shipping a browser the owner
# did not choose. Deleting the package makes the scanner's honesty free.
#
# firefox-langpacks is named explicitly because it REQUIRES firefox, so dnf
# would otherwise refuse the removal rather than cascade it. Only that one
# package depends on Firefox here -- checked with `rpm -q --whatrequires`
# before this line existed -- so nothing else follows it out.
#
# Chromium is not installed here for the reason no flatpak is: /var is per-stick
# and outside the ostree commit, so a baked-in flatpak would bloat every image
# and still not survive as an installed app. See flatpak-install's header.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y remove firefox firefox-langpacks; \
    dnf clean all; \
    : "The || exit is load-bearing on every negated assertion in this file:"; \
    : "set -e deliberately ignores a pipeline that starts with !, so a bare"; \
    : "'! grep' or '! rpm -q' is an assertion that can never fire. Found"; \
    : "2026-08-11 when the shipped-apps kodi grep provably matched (the"; \
    : "file quotes the owner's words) on builds that stayed green."; \
    ! rpm -q firefox || { echo "firefox survived its removal"; exit 1; }; \
    ! test -f /usr/share/applications/org.mozilla.firefox.desktop \
        || { echo "firefox's desktop entry survived its removal"; exit 1; }

# ---------------------------------------------------------------------------
# MOWSER, INSTALLED. The engine, its resources, the helper, and the extension
# the shell loads -- all under one directory, because libcef.so is one
# application's engine rather than a system library and putting it in
# /usr/lib64 would offer 256 MB of Chromium to everything else on the machine.
# The binaries carry RUNPATH=$ORIGIN so they find it here (asserted in
# mowser-build).
COPY --from=mowser-build /payload/ /usr/lib/marwanos/mowser/

# THE LIBRARIES libcef.so ITSELF NEEDS, and this list is MEASURED rather than
# guessed: it is objdump's DT_NEEDED output for the exact libcef.so above,
# minus what the base image already carries. Chromium needs NSS to validate a
# certificate, which is to say a checkout will not load without it -- and the
# failure mode for any of these missing is the extension failing to dlopen,
# which on this machine is a browser screen that says the engine is not
# installed. Better to fail the build.
RUN --mount=type=cache,dst=/var/cache/libdnf5,sharing=locked \
    set -euxo pipefail; \
    dnf -y install nss nspr atk at-spi2-atk at-spi2-core cairo pango \
        cups-libs alsa-lib libXcomposite libXdamage libXfixes libxcb \
        mesa-libgbm expat; \
    dnf clean all

# Proven present, one at a time, the same way the Godot shell's dlopen list is.
# A grep of ldconfig is the cheapest possible check and it is the difference
# between a build that fails here and a television that says the browser is
# missing for a reason nobody can see.
RUN set -euxo pipefail; \
    ldconfig -p > /tmp/ldcache.txt; \
    for lib in libnss3.so libnspr4.so libnssutil3.so libsmime3.so \
               libatk-1.0.so.0 libatk-bridge-2.0.so.0 libatspi.so.0 \
               libcairo.so.2 libpango-1.0.so.0 libcups.so.2 libasound.so.2 \
               libdbus-1.so.3 libexpat.so.1 libgbm.so.1 libxcb.so.1 \
               libX11.so.6 libXcomposite.so.1 libXdamage.so.1 libXext.so.6 \
               libXfixes.so.3 libXrandr.so.2 libxkbcommon.so.0 libudev.so.1 \
               libglib-2.0.so.0 libgobject-2.0.so.0 libgio-2.0.so.0; do \
        grep -q "$lib" /tmp/ldcache.txt \
            || { echo "libcef.so needs $lib at runtime and it is not installed"; exit 1; }; \
    done; \
    rm -f /tmp/ldcache.txt

# THE SANDBOX, AND IT IS THE ONE MODE IN THIS FILE THAT IS A SECURITY BOUNDARY.
#
# mowser renders arbitrary web content -- a Steam checkout, and whatever else
# somebody navigates to -- inside the shell's own process tree. Chromium's
# renderer sandbox is what stands between a hostile page and the session user's
# home directory, and CefSettings.no_sandbox=false (see mowser_runtime.cpp)
# asks for it. On Linux that needs this helper SUID root.
#
# --no-sandbox would be one line in the C++ and would make every one of these
# concerns go away by removing the boundary. It is deliberately not taken.
#
# Set HERE and not in mowser-build for the reason the akmods modes are set
# here: /usr is composefs-backed and read-only at runtime, so a mode has to be
# right in the image, and a mode set in a stage that gets discarded is a mode
# nobody keeps. Same class of build-time-only fix as gamescope's CAP_SYS_NICE
# below.
RUN set -euxo pipefail; \
    chown root:root /usr/lib/marwanos/mowser/chrome-sandbox; \
    chmod 4755 /usr/lib/marwanos/mowser/chrome-sandbox; \
    test -u /usr/lib/marwanos/mowser/chrome-sandbox \
        || { echo "chrome-sandbox is not SUID -- mowser would have to run unsandboxed"; exit 1; }

# CAP_SYS_NICE on gamescope, and it is a measured fix rather than a precaution.
#
# Without it gamescope says so itself, on every boot:
#
#   No CAP_SYS_NICE, falling back to regular-priority compute and threads.
#   Performance will be affected.
#
# It wants the capability to put its compute and render threads at real-time
# priority; denied that, frame pacing degrades, and the appliance is perceptibly
# laggy in exactly the way the 2026-08-05 hardware runs felt (ADR 0005, open
# question 3).
#
# It has to be set at build time. /usr is composefs-backed and read-only at
# runtime, so this is one of the few classes of fix that cannot be tested by
# injecting into a deployment on a stick -- it needs a rebuild, which is why it
# was batched with the other rebuild-only changes rather than shipped alone.
#
# File capabilities live in the security.capability xattr, which ostree records
# and composefs carries through; the getcap assertion above is what proves the
# build actually set it rather than silently no-op'ing on a filesystem that
# dropped the xattr.
#
# This is a real privilege grant, narrowly scoped: CAP_SYS_NICE permits raising
# scheduling priority and nothing else -- no device access, no filesystem
# override, no capability to gain further capabilities. gamescope is already the
# DRM master on this machine, so it is not a new trust boundary.

# Everything under os/files lands in the image here, and the position is
# deliberate: it must be before the dracut run below, because
# /usr/lib/dracut/dracut.conf.d/50-marwanos-usb.conf only affects an initramfs
# if it exists in the filesystem at the moment dracut reads its config. Dracut
# picks up /usr/lib/dracut/dracut.conf.d/*.conf on its own; there is no flag to
# add.
#
# The cost is that editing anything under os/files now invalidates the dracut
# layer and the session-wiring layer below it. That is the honest trade -- a
# drop-in there can change what the initramfs contains -- but it is why a config
# edit rebuilds slower than a version bump, which still only touches the three
# cheap layers at the bottom.
#
# The source path is os/files rather than files because M3 moved the build
# context from os/ to the repo root. It had to move: the Godot project lives at
# shell/ (phase-0 M3, and phase-1 puts daemon/ and proto/ beside it), a COPY
# cannot reach outside its context, and doing it now costs three one-line edits
# instead of also moving shell/ later. The context is passed in
# scripts/build-push.sh and .github/workflows/build.yml; that workflow's paths:
# filter must list shell/** as well, or a shell edit stops triggering CI with
# nothing anywhere to say so. The repo root also needs a .containerignore --
# .git alone is 7 MB and this context is read over drvfs from /mnt/c.
COPY os/files/ /

# The nvidia kmod is built against the base's kernel but the initramfs shipped
# in the base predates it. Without this regen, plymouth has no NVIDIA driver to
# draw on in early boot -- which is exactly the M2 flash we are trying to avoid.
#
# --add ostree is load-bearing and was learned the hard way: without it this
# image boots straight into dracut emergency mode.
#
# The ostree dracut module is what reads the ostree= kernel argument and
# assembles /sysroot for the booted deployment. Its check() probes for a live
# ostree deployment, which does not exist inside a container build, so a plain
# `dracut` run silently omits it -- producing an initramfs that is byte-for-byte
# reasonable, passes every lint, and cannot mount root. Diffing our module list
# against the base's showed ostree as the single difference.
#
# The three greps below are the regression guard. A broken initramfs is
# invisible until boot, so the build has to be the thing that refuses.
#
# The uas.ko check guards the USB stack: a USB 3.x stick attaches over UAS, and
# the drivers are named in os/files/usr/lib/dracut/dracut.conf.d/
# 50-marwanos-usb.conf and nowhere else, so this grep doubles as proof that
# dracut actually read the drop-in.
#
# They read from files rather than pipes on purpose. `lsinitrd | grep -q` makes
# grep exit on the first match, lsinitrd then dies of SIGPIPE, and `set -o
# pipefail` turns that into exit 141 -- a guard that fails precisely when it
# should pass. Do not turn these back into pipelines.
#
# The .ko patterns are deliberately unanchored at the end: Fedora ships
# compressed modules, so the file in the initramfs is uas.ko.xz, not uas.ko.
# plymouth-set-default-theme runs before dracut because the plymouth dracut
# module bundles the CURRENT default theme into the initramfs -- set after the
# regen, the splash a user sees would be whatever bgrt showed (the vendor's
# firmware logo), not ours. The splash.png grep proves the bundling happened.
RUN set -euxo pipefail; \
    plymouth-set-default-theme marwanos; \
    KERNEL_VERSION="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core | tail -1)"; \
    dracut --force --no-hostonly --kver "${KERNEL_VERSION}" \
        --add ostree \
        --add-drivers " nvidia nvidia-modeset nvidia-drm nvidia-uvm " \
        "/lib/modules/${KERNEL_VERSION}/initramfs.img"; \
    lsinitrd --mod "/lib/modules/${KERNEL_VERSION}/initramfs.img" > /tmp/ir-mods.txt; \
    lsinitrd "/lib/modules/${KERNEL_VERSION}/initramfs.img" > /tmp/ir-files.txt; \
    grep -qx ostree /tmp/ir-mods.txt; \
    grep -q 'nvidia\.ko' /tmp/ir-files.txt; \
    grep -q '/uas\.ko' /tmp/ir-files.txt; \
    grep -q 'themes/marwanos/splash\.png' /tmp/ir-files.txt; \
    : "THE /boot BUDGET, asserted, because exceeding it does not fail here --"; \
    : "it fails on somebody's television, months later, as a bootloader entry"; \
    : "that boots to black. anaconda's autopart gives this machine a 1 GiB"; \
    : "/boot; bootc keeps a kernel and an initramfs there per deployment, and"; \
    : "an upgrade briefly holds THREE of them. 250 MB of initramfs plus an"; \
    : "18 MB kernel is 268 MB a deployment, so three fit in 804 MB with room"; \
    : "to spare. At the 342 MB this image shipped on 2026-08-10 the same sum"; \
    : "was 1080 MB, the write ran out of partition, and the deployment that"; \
    : "resulted booted to nothing. See 51-marwanos-nouveau.conf for where the"; \
    : "weight went and why nouveau was the right 100 MB to cut."; \
    ir_bytes="$(stat -c %s "/lib/modules/${KERNEL_VERSION}/initramfs.img")"; \
    echo "initramfs: ${ir_bytes} bytes"; \
    test "${ir_bytes}" -lt 262144000; \
    : "The two halves of that cut, each asserted in its own direction: the"; \
    : "blacklisted driver's firmware must be GONE, and the proprietary"; \
    : "driver's -- which nvidia-drm.modeset needs to light the panel before"; \
    : "plymouth draws -- must still be THERE. A dracut that started ignoring"; \
    : "the drop-in would pass a size check by luck and fail this one."; \
    : "|| exit because set -e ignores !-pipelines -- see the firefox removal."; \
    ! grep -q 'firmware/nvidia/ga102' /tmp/ir-files.txt \
        || { echo "nouveau firmware is still in the initramfs"; exit 1; }; \
    grep -q 'firmware/nvidia/610\.43\.03' /tmp/ir-files.txt; \
    rm -f /tmp/ir-mods.txt /tmp/ir-files.txt

# Session wiring. Separate from the package install so that editing a session
# file does not re-run dnf, and after COPY because every line acts on something
# COPY put there.
#
# The find normalises everything COPY brought in to 0644 first. Checked out on
# Windows and read through the drvfs bridge, every file under os/files arrives
# in the build context as 0777 -- executable, world-writable config. systemd
# warns about it on every boot ("marked executable... marked world-writable...
# Proceeding anyway") and stricter parsers refuse outright. Fixed here, at the
# one place the real modes are decided.
#
# The chmod after it is not belt and braces. This repo is authored on Windows
# with core.filemode false -- an executable bit cannot survive a checkout here
# and has to be applied where the file is consumed. Without it greetd's `exec`
# of the session fails with EACCES on tty1, where nothing can report it. Same
# family of problem as the line endings .gitattributes exists to fix.
#
# systemd-sysusers is run against our file rather than bare, so this step
# creates exactly the account 50-marwanos.conf declares and cannot quietly
# depend on some other package's sysusers entry. The declaration is what bootc
# wants and what `bootc container lint` checks for; running it here as well just
# means the account exists in the image and not only after the first boot, where
# systemd-sysusers.service is gated on ConditionNeedsUpdate=/etc.
#
# The group loop exists because three different tools silently refuse this job.
# Fedora ships video, render and input in /usr/lib/group, not /etc/group. getent
# resolves them fine, but every shadow-utils tool reads and writes /etc/group
# only: sysusers' `m` lines and `usermod -aG` both exit 0 having added no
# membership, and gpasswd is the only one honest enough to say why ("group
# 'video' does not exist in /etc/group"). So the group is materialised into
# /etc/group at its real GID first, and then usermod has something to modify.
#
# The cost of getting this wrong is a session that boots, logs in, and cannot
# open /dev/dri/renderD* -- which on an appliance with no terminal reads as a
# driver failure. Hence the three id greps below: this must never ship silent
# again.
#
# The preset is applied explicitly rather than left to greetd's rpm scriptlet:
# %systemd_post runs presets on first install, which happened in the dnf layer
# above, before COPY landed 50-marwanos.preset.
#
# The wants symlink exists because greetd's [Install] section is nothing but
# Alias=display-manager.service. That gets it started under graphical.target
# (systemd's graphical.target carries Wants=display-manager.service) and
# nowhere else, so an appliance that stops at multi-user.target would boot to
# no session at all. It is created here rather than shipped under os/files/
# because git in this repo has core.symlinks false and would check a tracked
# symlink out as a text file containing its own target.
#
# getty@tty1 and autovt@tty1 are masked now rather than in M2, because D6 says
# no getty on tty1 ever and this is the cheapest possible moment to mean it.
# greetd's unit does declare Conflicts=getty@tty1.service, but a Conflicts is a
# race that systemd resolves after both units have been asked to start; a mask
# is the unit not existing. A preset file cannot express this -- systemd.preset
# understands only enable and disable, and disable would not touch the
# getty.target.wants symlink that systemd itself ships. autovt@tty1 is masked
# separately because autovt@.service is its own alias of getty@.service and is
# what logind starts on VT activation, so masking one does not mask the other.
#
# serial-getty@ttyS0 is masked for the same D6 reason and one practical one.
# `console=ttyS0` used to be on the kernel command line (a bib default; QEMU
# capture relied on it, ADR 0003), and systemd-getty-generator instantiates a
# serial getty on every console it finds there. This chassis has no serial port,
# so agetty opens the device, fails with EIO, and systemd restarts it -- measured
# on hardware at a restart every ~10s, `restart counter is at 7` inside a
# 75-second session. Two costs: a respawn loop forever, and `journalctl -p err`
# filling with "failed to get terminal attributes" when that command is the only
# triage surface this appliance has (see marwanos-session's header). The karg is
# gone now -- make-installer.sh passes --no-default-kernel-args (M2) -- but the
# mask stays: a QEMU run may add console=ttyS0 back via EXTRA_KARGS for serial
# capture, and the login prompt it would spawn is what D6 forbids regardless of
# whether the port exists.
#
# xdg-desktop-portal-gtk is masked for the same reason serial-getty@ttyS0 is: it
# fails repeatedly at err priority in the one place this appliance can be
# triaged. Measured on the 2026-08-05 hardware runs -- eleven consecutive
# "Failed to start xdg-desktop-portal-gtk.service - Portal service (GTK/GNOME
# implementation)" lines inside a single session. It is a GNOME desktop portal
# pulled in as a transitive dependency; there is no desktop here, nothing asks it
# for a file chooser, and it has no business starting.
#
# The mask is a /dev/null symlink over the unit in /usr/lib/systemd/user rather
# than `systemctl --global mask`, which writes into /etc/systemd/user -- and /etc
# is three-way merged on upgrade, so that would ship machine-local state where
# image state belongs. This is a USER unit: it is the per-user systemd that was
# failing to start it, so masking the system instance would have done nothing.
#
# It is masked rather than removed because the package is a dependency of things
# that are wanted; uninstalling it would drag out more than it fixes. Note the
# portal is also D-Bus activatable, so this stops systemd starting it but not a
# client that asks dbus for it by name -- nothing in this image does.
#
# marwanos-panel.service gets a hand-made wants symlink under /usr/lib for the
# same reason greetd's is hand-made: `systemctl enable` and `systemctl preset`
# write into /etc/systemd/system, and bootc three-way merges /etc on upgrade, so
# enabling a unit that way ships machine-local state where image state belongs.
# The unit is still listed in 50-marwanos.preset, which is what stops a future
# `systemctl preset-all` on a target from turning it back off.
#
# /usr/lib/systemd/logind.conf.d is in the find list for the same reason every
# other entry is: it arrives through os/files/ and therefore lands 0777 from the
# drvfs bridge, and systemd warns about world-writable configuration on every
# boot. /usr/lib/systemd/system is deliberately NOT in the list -- it holds the
# entire base unit set, none of which came through os/files/, and chmodding the
# directory would force an overlayfs copy-up of hundreds of files into the
# MarwanOS layer on every build. The one unit that is ours is normalised by name.
RUN set -euxo pipefail; \
    : "MOWSER'S DIRECTORY IS PRUNED, and it is the one exception in this"; \
    : "sweep. Everything else under these roots is configuration that arrived"; \
    : "through os/files -- 0644 is the right answer and the executables among"; \
    : "them are chmodded back by name below. The mowser payload is the"; \
    : "opposite: it is BINARIES, and normalising them to 0644 would strip +x"; \
    : "from the helper CEF re-executes for every renderer and -- much worse,"; \
    : "and silently -- the SUID bit from chrome-sandbox, leaving a browser"; \
    : "that renders arbitrary web pages with its sandbox quietly disabled."; \
    : "That is exactly the kind of failure this file exists to make loud, so"; \
    : "the modes are set once where the payload is installed and nothing"; \
    : "downstream is allowed to walk over them."; \
    find /etc/greetd /etc/issue /usr/lib/marwanos /usr/lib/sysusers.d \
         /usr/lib/tmpfiles.d /usr/lib/dracut/dracut.conf.d /usr/lib/bootc \
         /usr/lib/systemd/journald.conf.d /usr/lib/systemd/system-preset \
         /usr/lib/systemd/logind.conf.d \
         /usr/share/plymouth/themes/marwanos \
         -path /usr/lib/marwanos/mowser -prune -o \
         -type f -exec chmod 0644 {} +; \
    chmod 0644 /usr/lib/systemd/system/marwanos-panel.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-netcheck.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-appscan.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-wifi.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-update.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-appctl.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-media.service; \
    chmod 0644 "/usr/lib/systemd/system/marwanos-usbmount@.service"; \
    chmod 0644 /usr/lib/udev/rules.d/99-marwanos-usb.rules; \
    chmod 0644 /usr/lib/systemd/system/marwanos-storeart.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-storeart.timer; \
    chmod 0644 /usr/lib/systemd/system/marwanos-steamfront.service; \
    chmod 0644 /usr/lib/systemd/system/sshd.service.d/50-marwanos-persist.conf; \
    chmod 0644 /usr/lib/systemd/system/marwanos-flightrec.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-flightrec.timer; \
    chmod 0644 /usr/lib/systemd/system/marwanos-plymouth-hold.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-plymouth-quit.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-plymouth-quit.path; \
    chmod 0644 /usr/lib/systemd/system/marwanos-boot-success.service; \
    chmod 0644 /usr/lib/systemd/system/marwanos-boot-success.timer; \
    : "By name rather than via the find list, like the sshd drop-in: the"; \
    : "find list's directories are all wholly ours, and these two live in"; \
    : "directories the base image populates."; \
    chmod 0644 /usr/lib/systemd/system/flatpak-system-update.timer.d/50-marwanos-defer.conf; \
    chmod 0644 /usr/lib/bootupd/grub2-static/configs.d/12_menu_auto_hide.cfg; \
    chmod 0755 /usr/lib/marwanos/flightrec; \
    chmod 0644 "/usr/lib/systemd/system/marwanos-flatpak-install@.service"; \
    chmod 0755 /usr/lib/marwanos/session/marwanos-session; \
    chmod 0644 /usr/lib/systemd/system/marwanos-display-profile.service; \
    chmod 0755 /usr/lib/marwanos/display/panel-policy; \
    chmod 0755 /usr/lib/marwanos/display/profile; \
    chmod 0644 /usr/lib/systemd/system/marwanos-window-profile.service; \
    chmod 0755 /usr/lib/marwanos/window/profile; \
    chmod 0644 /usr/lib/systemd/system/marwanos-devmode-sudo.service; \
    chmod 0755 /usr/lib/marwanos/devmode-sudo; \
    chmod 0755 /usr/lib/marwanos/terminal; \
    : "sudoers.devmode is deliberately NOT in the 0755 list, for the same"; \
    : "reason shipped-apps is not: it is DATA read by a program, never run."; \
    : "The find above has already normalised it to 0644, and the copy that"; \
    : "sudo actually reads is installed 0440 into /etc/sudoers.d per boot by"; \
    : "marwanos-devmode-sudo -- a mode sudo enforces itself."; \
    chmod 0755 /usr/lib/marwanos/flatpak-install; \
    chmod 0755 /usr/lib/marwanos/netcheck; \
    chmod 0755 /usr/lib/marwanos/appscan; \
    chmod 0755 /usr/lib/marwanos/wifi; \
    chmod 0755 /usr/lib/marwanos/update; \
    chmod 0755 /usr/lib/marwanos/appctl; \
    chmod 0755 /usr/lib/marwanos/usbmount; \
    chmod 0755 /usr/lib/marwanos/storeart; \
    chmod 0755 /usr/lib/marwanos/steamfront; \
    chmod 0755 /usr/lib/marwanos/steamproto; \
    : "shipped-apps is deliberately NOT in the 0755 list: it is data both"; \
    : "appctl and storeart read, not a program, and the find above has"; \
    : "already normalised it to 0644."; \
    systemd-sysusers /usr/lib/sysusers.d/50-marwanos.conf; \
    for g in video render input; do \
        gid="$(getent group "$g" | cut -d: -f3)"; \
        [ -n "$gid" ] || { echo "group $g does not exist at all"; exit 1; }; \
        grep -q "^${g}:" /etc/group || printf '%s:x:%s:\n' "$g" "$gid" >> /etc/group; \
    done; \
    usermod -aG video,render,input player; \
    systemctl --no-reload preset greetd.service; \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants; \
    ln -sf ../greetd.service \
        /usr/lib/systemd/system/multi-user.target.wants/greetd.service; \
    ln -sf ../marwanos-panel.service \
        /usr/lib/systemd/system/multi-user.target.wants/marwanos-panel.service; \
    : "The apps the appliance ships with, each an instance of the templated"; \
    : "installer. A .wants symlink whose NAME carries the instance is how"; \
    : "systemd enables a template without an [Install] alias per app --"; \
    : "the link name is what %i resolves from, and the target is the"; \
    : "template itself. Adding an app is one more line here."; \
    ln -sf ../marwanos-flatpak-install@.service \
        "/usr/lib/systemd/system/multi-user.target.wants/marwanos-flatpak-install@com.valvesoftware.Steam.service"; \
    : "THERE IS NO BROWSER INSTALL UNIT ANY MORE, and that is the point"; \
